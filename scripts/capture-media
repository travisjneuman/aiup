def xterm_256(index: int) -> tuple[int, int, int]:
    base = (
        (0, 0, 0), (205, 49, 49), (13, 188, 121), (229, 229, 16),
        (36, 114, 200), (188, 63, 188), (17, 168, 205), (229, 229, 229),
        (102, 102, 102), (241, 76, 76), (35, 209, 139), (245, 245, 67),
        (59, 142, 234), (214, 112, 214), (41, 184, 219), (255, 255, 255),
    )
    if index < 16:
        return base[index]
    if index < 232:
        value = index - 16
        levels = (0, 95, 135, 175, 215, 255)
        return levels[value // 36], levels[(value // 6) % 6], levels[value % 6]
    gray = 8 + (index - 232) * 10
    return gray, gray, gray


def rgb_hex(rgb: tuple[int, int, int]) -> str:
    return "#" + "".join(f"{component:02x}" for component in rgb)


def raw_indexed_sgr(raw: bytes) -> tuple[collections.Counter[int], dict[int, set[str]]]:
    counts: collections.Counter[int] = collections.Counter()
    forms: dict[int, set[str]] = collections.defaultdict(set)
    for match in re.finditer(rb"\x1b\[([0-9;]*)m", raw):
        raw_params = match.group(1).decode("ascii")
        params = [int(value) if value else 0 for value in raw_params.split(";")]
        for offset in range(len(params) - 2):
            if params[offset:offset + 2] == [38, 5]:
                index = params[offset + 2]
                counts[index] += 1
                forms[index].add(f"CSI {raw_params} m")
    return counts, forms


def visible_style_counts(term: "Terminal", attribute: str) -> collections.Counter[tuple[int, int, int]]:
    return collections.Counter(
        getattr(cell.style, attribute)
        for row in term.cells
        for cell in row
        if cell.char.strip()
    )


def semantic_palette_evidence(
    label: str,
    session: "Session",
    expected_fg: dict[str, tuple[int, int, int]],
    expected_bg: dict[str, tuple[int, int, int]] | None = None,
    required_text: tuple[str, ...] = (),
    expected_indexes: dict[str, int] | None = None,
) -> dict[str, object]:
    text = session.term.text()
    for needle in required_text:
        if needle not in text:
            raise RuntimeError(f"{label} semantic capture omitted {needle!r}")
    fg_counts = visible_style_counts(session.term, "fg")
    bg_counts = visible_style_counts(session.term, "bg")
    observed_fg: dict[str, object] = {}
    for name, rgb in expected_fg.items():
        count = fg_counts[rgb]
        if count == 0:
            raise RuntimeError(f"{label} semantic capture omitted foreground {name} {rgb_hex(rgb)}")
        observed_fg[name] = {"rgb": rgb_hex(rgb), "styled_cells": count}
    observed_bg: dict[str, object] = {}
    for name, rgb in (expected_bg or {}).items():
        count = bg_counts[rgb]
        if count == 0:
            raise RuntimeError(f"{label} semantic capture omitted background {name} {rgb_hex(rgb)}")
        observed_bg[name] = {"rgb": rgb_hex(rgb), "styled_cells": count}
    raw_counts, raw_forms = raw_indexed_sgr(bytes(session.raw))
    observed_sgr: dict[str, object] = {}
    for name, index in (expected_indexes or {}).items():
        count = raw_counts[index]
        if count == 0:
            raise RuntimeError(f"{label} raw PTY omitted indexed SGR 38;5;{index} for {name}")
        observed_sgr[name] = {
            "escape_forms": sorted(raw_forms[index]),
            "occurrences": count,
        }
    return {
        "foreground": observed_fg,
        "background": observed_bg,
        "raw_expected_sgr": observed_sgr,
        "raw_indexed_sgr_counts": {str(index): count for index, count in sorted(raw_counts.items())},
        "required_text": list(required_text),
    }


def color_distance(left: tuple[int, int, int], right: tuple[int, int, int]) -> int:
    return sum((a - b) ** 2 for a, b in zip(left, right))


def raster_palette_evidence(
    label: str,
    image: Image.Image,
    expected: dict[str, tuple[int, int, int]],
    tolerance: int = 12,
) -> dict[str, object]:
    rgb_image = image.convert("RGB")
    counts = collections.Counter(rgb_image.get_flattened_data())
    colors = tuple(counts)
    evidence: dict[str, object] = {}
    for name, target in expected.items():
        nearest = min(colors, key=lambda candidate: color_distance(candidate, target))
        distance = color_distance(nearest, target) ** 0.5
        count = sum(
            pixel_count for pixel, pixel_count in counts.items()
            if color_distance(pixel, target) <= tolerance ** 2
        )
        if count == 0:
            raise RuntimeError(
                f"{label} raster omitted {name} {rgb_hex(target)}; "
                f"nearest was {rgb_hex(nearest)} at distance {distance:.1f}"
            )
        evidence[name] = {
            "expected_rgb": rgb_hex(target),
            "matching_pixels": count,
            "nearest_rgb": rgb_hex(nearest),
            "nearest_distance": round(distance, 2),
        }
    return evidence


def expected_raster_palettes() -> dict[str, dict[str, tuple[int, int, int]]]:
    collapsed = {
        name: xterm_256(index) for name, index in CATEGORY_INDEXES.items()
    }
    collapsed.update({
        "header": FZF_RGB["header"],
        "prompt": FZF_RGB["prompt"],
        "selected-row": FZF_RGB["selected-bg"],
    })
    search = {
        "coding-agents": xterm_256(CATEGORY_INDEXES["coding-agents"]),
        "installed-action": STATE_GREEN,
        "query-highlight": FZF_RGB["highlight"],
        "prompt": FZF_RGB["prompt"],
        "selected-row": FZF_RGB["selected-bg"],
    }
    homebrew = {
        name: xterm_256(index) for name, index in HOMEBREW_INDEXES.items()
    }
    homebrew.update({
        "on-disk-action": STATE_GREEN,
        "absent-action": ABSENT_GRAY,
        "prompt": FZF_RGB["prompt"],
        "selected-row": FZF_RGB["selected-bg"],
    })
    adoption = {"terminal-text": DEFAULT_FG, "cursor": CURSOR_RGB}
    return {
        "collapsed": collapsed,
        "search": search,
        "homebrew": homebrew,
        "adoption": adoption,
    }


@dataclasses.dataclass
class Style:
    fg: tuple[int, int, int] = DEFAULT_FG
    bg: tuple[int, int, int] = DEFAULT_BG
    bold: bool = False
    reverse: bool = False


@dataclasses.dataclass
class Cell:
    char: str = " "
    style: Style = dataclasses.field(default_factory=Style)


class Terminal:
    def __init__(self, cols: int = COLS, rows: int = ROWS) -> None:
        self.cols = cols
        self.rows = rows
        self.cells = [[Cell() for _ in range(cols)] for _ in range(rows)]
        self.row = 0
        self.col = 0
        self.saved = (0, 0)
        self.scroll_top = 0
        self.scroll_bottom = rows - 1
        self.style = Style()
        self.cursor_visible = True
        self.decoder = codecs.getincrementaldecoder("utf-8")("replace")
        self.pending = ""

    def clear(self) -> None:
        self.cells = [[Cell() for _ in range(self.cols)] for _ in range(self.rows)]
        self.row = self.col = 0

    def blank_cell(self) -> Cell:
        return Cell(" ", dataclasses.replace(self.style))

    def feed(self, payload: bytes) -> None:
        self.pending += self.decoder.decode(payload)
        text = self.pending
        self.pending = ""
        i = 0
        while i < len(text):
            char = text[i]
            if char == "\x1b":
                if i + 1 >= len(text):
                    self.pending = text[i:]
                    break
                nxt = text[i + 1]
                if nxt == "[":
                    end = i + 2
                    while end < len(text) and not ("@" <= text[end] <= "~"):
                        end += 1
                    if end >= len(text):
                        self.pending = text[i:]
                        break
                    self.csi(text[i + 2:end], text[end])
                    i = end + 1
                    continue
                if nxt == "]":
                    end = i + 2
                    while end < len(text):
                        if text[end] == "\x07":
                            end += 1
                            break
                        if text[end:end + 2] == "\x1b\\":
                            end += 2
                            break
                        end += 1
                    if end > len(text):
                        self.pending = text[i:]
                        break
                    i = end
                    continue
                if nxt in "78":
                    if nxt == "7":
                        self.saved = (self.row, self.col)
                    else:
                        self.row, self.col = self.saved
                    i += 2
                    continue
                if nxt == "c":
                    self.clear()
                    self.style = Style()
                    i += 2
                    continue
                if nxt in "()" and i + 2 < len(text):
                    i += 3
                    continue
                i += 2
                continue
            if char == "\r":
                self.col = 0
            elif char == "\n":
                self.newline()
            elif char == "\b":
                self.col = max(0, self.col - 1)
            elif char == "\t":
                self.col = min(self.cols - 1, ((self.col // 8) + 1) * 8)
            elif ord(char) >= 32 and char != "\x7f":
                self.put(char)
            i += 1

    def put(self, char: str) -> None:
        if unicodedata.combining(char):
            if self.col:
                self.cells[self.row][self.col - 1].char += char
            return
        if self.col >= self.cols:
            self.col = 0
            self.newline()
        self.cells[self.row][self.col] = Cell(char, dataclasses.replace(self.style))
        width = 2 if unicodedata.east_asian_width(char) in {"W", "F"} else 1
        if width == 2 and self.col + 1 < self.cols:
            self.cells[self.row][self.col + 1] = Cell("", dataclasses.replace(self.style))
        self.col += width

    def newline(self) -> None:
        if self.row == self.scroll_bottom:
            del self.cells[self.scroll_top]
            self.cells.insert(self.scroll_bottom, [Cell() for _ in range(self.cols)])
        else:
            self.row = min(self.rows - 1, self.row + 1)

    @staticmethod
    def number(value: str, default: int = 1) -> int:
        try:
            return int(value) if value else default
        except ValueError:
            return default

    def csi(self, raw: str, final: str) -> None:
        private = raw.startswith("?")
        if private:
            raw = raw[1:]
        parts = raw.split(";") if raw else [""]
        nums = [self.number(part) for part in parts]
        if final in "Hf":
            self.row = max(0, min(self.rows - 1, nums[0] - 1))
            self.col = max(0, min(self.cols - 1, (nums[1] if len(nums) > 1 else 1) - 1))
        elif final == "A":
            self.row = max(self.scroll_top, self.row - nums[0])
        elif final in "BE":
            self.row = min(self.scroll_bottom, self.row + nums[0])
            if final == "E": self.col = 0
        elif final == "C":
            self.col = min(self.cols - 1, self.col + nums[0])
        elif final in "DF":
            self.row = max(self.scroll_top, self.row - nums[0])
            if final == "F": self.col = 0
        elif final in "G`":
            self.col = max(0, min(self.cols - 1, nums[0] - 1))
        elif final == "d":
            self.row = max(0, min(self.rows - 1, nums[0] - 1))
        elif final == "J":
            mode = nums[0] if raw else 0
            if mode in (2, 3):
                self.clear()
            elif mode == 0:
                self.erase_line(self.row, self.col, self.cols)
                for row in range(self.row + 1, self.rows): self.erase_line(row, 0, self.cols)
            elif mode == 1:
                for row in range(0, self.row): self.erase_line(row, 0, self.cols)
                self.erase_line(self.row, 0, self.col + 1)
        elif final == "K":
            mode = nums[0] if raw else 0
            if mode == 0: self.erase_line(self.row, self.col, self.cols)
            elif mode == 1: self.erase_line(self.row, 0, self.col + 1)
            elif mode == 2: self.erase_line(self.row, 0, self.cols)
        elif final == "m":
            self.sgr(raw)
        elif final == "s":
            self.saved = (self.row, self.col)
        elif final == "u":
            self.row, self.col = self.saved
        elif final == "r":
            top = nums[0] - 1 if raw else 0
            bottom = (nums[1] - 1) if len(nums) > 1 else self.rows - 1
            self.scroll_top = max(0, min(self.rows - 1, top))
            self.scroll_bottom = max(self.scroll_top, min(self.rows - 1, bottom))
            self.row, self.col = self.scroll_top, 0
        elif final == "S":
            for _ in range(nums[0]):
                del self.cells[self.scroll_top]
                self.cells.insert(self.scroll_bottom, [Cell() for _ in range(self.cols)])
        elif final == "T":
            for _ in range(nums[0]):
                del self.cells[self.scroll_bottom]
                self.cells.insert(self.scroll_top, [Cell() for _ in range(self.cols)])
        elif final == "P":
            count = nums[0]
            line = self.cells[self.row]
            del line[self.col:self.col + count]
            line.extend(Cell() for _ in range(count))
        elif final == "@":
            count = nums[0]
            line = self.cells[self.row]
            for _ in range(count): line.insert(self.col, Cell())
            del line[self.cols:]
        elif final in "hl" and private:
            if 25 in nums:
                self.cursor_visible = final == "h"
            if 1049 in nums and final == "h":
                self.clear()

    def erase_line(self, row: int, start: int, end: int) -> None:
        for col in range(max(0, start), min(self.cols, end)):
            self.cells[row][col] = self.blank_cell()

    def sgr(self, raw: str) -> None:
        params = [self.number(part, 0) for part in raw.split(";")] if raw else [0]
        i = 0
        while i < len(params):
            value = params[i]
            if value == 0: self.style = Style()
            elif value == 1: self.style.bold = True
            elif value == 22: self.style.bold = False
            elif value == 7: self.style.reverse = True
            elif value == 27: self.style.reverse = False
            elif value == 39: self.style.fg = DEFAULT_FG
            elif value == 49: self.style.bg = DEFAULT_BG
            elif 30 <= value <= 37: self.style.fg = xterm_256(value - 30)
            elif 90 <= value <= 97: self.style.fg = xterm_256(value - 90 + 8)
            elif 40 <= value <= 47: self.style.bg = xterm_256(value - 40)
            elif 100 <= value <= 107: self.style.bg = xterm_256(value - 100 + 8)
            elif value in (38, 48) and i + 1 < len(params):
                target = "fg" if value == 38 else "bg"
                if params[i + 1] == 5 and i + 2 < len(params):
                    setattr(self.style, target, xterm_256(params[i + 2]))
                    i += 2
                elif params[i + 1] == 2 and i + 4 < len(params):
                    setattr(self.style, target, tuple(params[i + 2:i + 5]))
                    i += 4
            i += 1

    def text(self) -> str:
        return "\n".join("".join(cell.char for cell in row).rstrip() for row in self.cells)

    def render(
        self,
        font: ImageFont.FreeTypeFont,
        bold_font: ImageFont.FreeTypeFont,
        fallback_font: ImageFont.FreeTypeFont,
        title_font: ImageFont.FreeTypeFont,
    ) -> Image.Image:
        content_width = self.cols * CELL_W
        content_height = self.rows * CELL_H
        content = Image.new("RGB", (content_width, content_height), DEFAULT_BG)
        draw = ImageDraw.Draw(content)
        for row_index, row in enumerate(self.cells):
            for col_index, cell in enumerate(row):
                fg, bg = cell.style.fg, cell.style.bg
                if cell.style.reverse: fg, bg = bg, fg
                x, y = col_index * CELL_W, row_index * CELL_H
                if bg != DEFAULT_BG:
                    draw.rectangle((x, y, x + CELL_W - 1, y + CELL_H - 1), fill=bg)
                if cell.char:
                    selected_font = bold_font if cell.style.bold else font
                    if (
                        cell.char in "▸▾↳"
                        or "\u2500" <= cell.char <= "\u257f"
                        or "\u2800" <= cell.char <= "\u28ff"
                    ):
                        selected_font = fallback_font
                    bbox = draw.textbbox((0, 0), cell.char, font=selected_font)
                    text_w = bbox[2] - bbox[0]
                    draw.text((x + max(0, (CELL_W - text_w) / 2), y), cell.char, font=selected_font, fill=fg)
        if self.cursor_visible:
            cursor_x = min(self.cols - 1, self.col) * CELL_W
            cursor_y = min(self.rows - 1, self.row) * CELL_H
            draw.rectangle(
                (
                    cursor_x,
                    cursor_y + SCALE,
                    cursor_x + CELL_W - 1,
                    cursor_y + CELL_H - 2 * SCALE,
                ),
                fill=CURSOR_RGB,
            )

        width = content_width + WINDOW_PAD * 2
        height = content_height + TITLEBAR_H + WINDOW_PAD
        image = Image.new("RGB", (width, height), (10, 10, 13))
        window = ImageDraw.Draw(image)
        window.rounded_rectangle(
            (0, 0, width - 1, height - 1),
            radius=10 * SCALE,
            fill=WINDOW_CHROME_RGB,
            outline=WINDOW_BORDER_RGB,
        )
        window.line(
            (0, TITLEBAR_H - SCALE, width, TITLEBAR_H - SCALE),
            fill=(7, 7, 10),
            width=SCALE,
        )
        for center_x, color in (
            (15 * SCALE, (255, 95, 87)),
            (35 * SCALE, (255, 189, 46)),
            (55 * SCALE, (40, 201, 64)),
        ):
            window.ellipse(
                (
                    center_x - 6 * SCALE,
                    9 * SCALE,
                    center_x + 6 * SCALE,
                    21 * SCALE,
                ),
                fill=color,
            )
        title = f"aiup — fzf ‹ aiup list — {self.cols}×{self.rows}"
        title_box = window.textbbox((0, 0), title, font=title_font)
        title_width = title_box[2] - title_box[0]
        window.text(
            ((width - title_width) / 2, 7 * SCALE),
            title,
            font=title_font,
            fill=(168, 168, 176),
        )
        image.paste(content, (WINDOW_PAD, TITLEBAR_H))
        return image


class Session:
    def __init__(self, work: pathlib.Path, args: list[str], cols: int = COLS, rows: int = ROWS) -> None:
        self.cols = cols
        self.rows = rows
        self.term = Terminal(cols, rows)
        self.raw = bytearray()
        self.work = work
        self.command_log = work / "commands.log"
        env = os.environ.copy()
        # The capture harness may itself run with NO_COLOR. The real aiup TUI is
        # chromatic, and fzf honors this variable by discarding ANSI input
        # styles before emitting its PTY stream. Keep the fixture equivalent to
        # the documented xterm-256color production surface.
        env.pop("NO_COLOR", None)
        env.update({
            "HOME": str(work / "home"),
            "TMPDIR": str(work / "tmp"),
            "AIUP_STATE_DIR": str(work / "state"),
            "AIUP_CAPTURE_FIXTURE_DIR": str(FIXTURE),
            "AIUP_CAPTURE_COMMAND_LOG": str(self.command_log),
            "AIUP_INVENTORY_CACHE_TTL": "0",
            "FZF_DEFAULT_OPTS": FZF_DEFAULT_OPTS,
            "TERM": "xterm-256color",
            "COLORTERM": "truecolor",
            "LANG": "en_US.UTF-8",
            "LC_ALL": "en_US.UTF-8",
            "PATH": f"{FIXTURE / 'bin'}:{ROOT / 'macos'}:/opt/homebrew/bin:/usr/bin:/bin",
        })
        for directory in (work / "home", work / "tmp", work / "state"):
            directory.mkdir(parents=True, exist_ok=True)
        self.pid, self.fd = pty.fork()
        if self.pid == 0:
            os.chdir(ROOT)
            os.execve("/bin/bash", ["bash", str(ROOT / "macos" / "aiup"), *args], env)
        fcntl.ioctl(self.fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
        os.set_blocking(self.fd, False)
        self.closed = False

    def resize(self, cols: int, rows: int) -> None:
        self.cols = cols
        self.rows = rows
        self.term = Terminal(cols, rows)
        fcntl.ioctl(self.fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))

    def pump(self, seconds: float) -> None:
        deadline = time.monotonic() + seconds
        while time.monotonic() < deadline and not self.closed:
            ready, _, _ = select.select([self.fd], [], [], min(0.05, max(0, deadline - time.monotonic())))
            if not ready:
                continue
            try:
                payload = os.read(self.fd, 65536)
            except (BlockingIOError, OSError):
                payload = b""
            if payload:
                self.raw.extend(payload)
                self.term.feed(payload)
            else:
                self.closed = True

    def wait_for(self, needle: str, timeout: float = 10.0) -> None:
        deadline = time.monotonic() + timeout
        while needle not in self.term.text():
            if time.monotonic() >= deadline:
                raw_tail = bytes(self.raw[-12000:]).decode("utf-8", "replace")
                raise RuntimeError(f"capture timed out waiting for {needle!r}\nSCREEN:\n{self.term.text()}\nRAW:\n{raw_tail}")
            self.pump(0.1)

    def send(self, value: bytes) -> None:
        os.write(self.fd, value)

    def finish(self) -> None:
        self.pump(0.3)
        if not self.closed:
            try: os.kill(self.pid, signal.SIGTERM)
            except ProcessLookupError: pass
        try: os.waitpid(self.pid, 0)
        except ChildProcessError: pass
        try: os.close(self.fd)
        except OSError: pass
        self.closed = True


def png_info(source_commit: str, state: str) -> PngImagePlugin.PngInfo:
    info = PngImagePlugin.PngInfo()
    info.add_text("aiup-source-commit", source_commit)
    info.add_text("aiup-capture-state", state)
    info.add_text("aiup-terminal", f"{COLS}x{ROWS} cells; {WIDTH}x{HEIGHT}px")
    return info


def save_png(image: Image.Image, path: pathlib.Path, source_commit: str, state: str) -> None:
    image.save(path, format="PNG", optimize=True, pnginfo=png_info(source_commit, state))


def check_public_text(label: str, text: str) -> None:
    banned = [
        "/Users/", str(pathlib.Path.home()), socket.gethostname(), "tjn", "TJNMPM",
        "settings always stay", "~/Library is never deleted",
        "The app stays. Notes, vaults, and settings stay.", "omp", "plandex",
    ]
    lowered = text.lower()
    for needle in banned:
        if needle and needle.lower() in lowered:
            raise RuntimeError(f"{label} capture contained forbidden text: {needle}")


LAYOUT_MATRIX = ((60, 18), (80, 24), (100, 30), (128, 40), (167, 47))


def visible_catalog_rows(term: Terminal) -> int:
    category_colors = {xterm_256(index) for index in CATEGORY_INDEXES.values()}
    return sum(
        any(cell.char.strip() and cell.style.fg in category_colors for cell in row)
        for row in term.cells
    )


def assert_layout_state(session: Session, cols: int, rows: int) -> dict[str, object]:
    text = session.term.text()
    expected_header = (
        "search · enter act · ctrl-/ preview · esc close"
        if cols < 96
        else "type search · enter act/expand · ctrl-g categories · ctrl-/ preview · esc close"
    )
    if expected_header not in text:
        raise RuntimeError(f"{cols}x{rows} omitted responsive header: {text}")
    preview_visible = "category  infra" in text
    if rows < 22 and preview_visible:
        raise RuntimeError(f"{cols}x{rows} should start with its preview hidden")
    if rows >= 22 and not preview_visible:
        raise RuntimeError(f"{cols}x{rows} should show the responsive preview: {text}")
    catalog_rows = visible_catalog_rows(session.term)
    if catalog_rows < 8:
        raise RuntimeError(f"{cols}x{rows} exposed only {catalog_rows} useful catalog rows")
    if any(len(line) > cols for line in text.splitlines()):
        raise RuntimeError(f"{cols}x{rows} produced a cropped logical row")
    return {
        "terminal_cells": [cols, rows],
        "catalog_rows_visible": catalog_rows,
        "preview_default": "visible" if preview_visible else "hidden",
        "header_variant": "compact" if cols < 96 else "normal",
    }


def validate_layout_matrix(work: pathlib.Path) -> list[dict[str, object]]:
    results: list[dict[str, object]] = []
    for cols, rows in LAYOUT_MATRIX:
        session = Session(work / f"{cols}x{rows}", ["list"], cols=cols, rows=rows)
        try:
            session.wait_for("aiup browse>")
            if rows >= 22:
                session.wait_for("category  infra")
            session.pump(0.5)
            result = assert_layout_state(session, cols, rows)
            if rows < 22:
                session.send(b"\x1f")
                session.wait_for("category  infra")
                result["preview_toggle"] = "verified"
                session.send(b"\x1f")
                session.pump(0.3)
            results.append(result)
            session.send(b"\x1b")
        finally:
            session.finish()

    resized = Session(work / "live-resize", ["list"], cols=167, rows=47)
    try:
        resized.wait_for("category  infra")
        resized.resize(60, 18)
        resized.wait_for("search · enter act · ctrl-/ preview · esc close")
        resized.pump(0.5)
        assert_layout_state(resized, 60, 18)
        resized.resize(100, 30)
        resized.wait_for("type search · enter act/expand")
        resized.wait_for("category  infra")
        resized.pump(0.5)
        assert_layout_state(resized, 100, 30)
        resized.send(b"\x1b")
    finally:
        resized.finish()
    return results


def capture(source_commit: str, work: pathlib.Path) -> dict[str, object]:
    font = ImageFont.truetype(str(FONT), FONT_SIZE)
    bold_font = font
    fallback_font = ImageFont.truetype(str(FALLBACK_FONT), FONT_SIZE)
    title_font = ImageFont.truetype(str(TITLE_FONT), 13 * SCALE)
    layout_evidence = validate_layout_matrix(work / "layout")
    states: dict[str, Image.Image] = {}
    semantic_evidence: dict[str, object] = {}

    collapsed_fg = {
        name: xterm_256(index) for name, index in CATEGORY_INDEXES.items()
    }
    collapsed_fg.update({
        "header": FZF_RGB["header"],
        "prompt": FZF_RGB["prompt"],
    })
    search_fg = {
        "coding-agents": xterm_256(CATEGORY_INDEXES["coding-agents"]),
        "installed-action": STATE_GREEN,
        "query-highlight": FZF_RGB["highlight"],
        "prompt": FZF_RGB["prompt"],
    }
    homebrew_fg = {
        name: xterm_256(index) for name, index in HOMEBREW_INDEXES.items()
    }
    homebrew_fg.update({
        "on-disk-action": STATE_GREEN,
        "absent-action": ABSENT_GRAY,
        "prompt": FZF_RGB["prompt"],
    })

    main = Session(work / "main", ["list"])
    try:
        main.wait_for("aiup browse>")
        main.wait_for("category  infra")
        main.pump(0.5)
        states["collapsed"] = main.term.render(font, bold_font, fallback_font, title_font)
        check_public_text("collapsed", main.term.text())
        semantic_evidence["collapsed"] = semantic_palette_evidence(
            "collapsed", main, collapsed_fg,
            {"selected-row": FZF_RGB["selected-bg"]},
            ("detected software", "2 apps · 2 npm · 1 uv · 3 PATH"),
            CATEGORY_INDEXES,
        )
        query = ""
        for char in "gemini":
            query += char
            main.send(char.encode())
            main.wait_for(f"aiup browse> {query}")
            main.pump(0.7)
        main.wait_for("gemini · coding-agents · installed · active")
        main.pump(0.35)
        states["search"] = main.term.render(font, bold_font, fallback_font, title_font)
        check_public_text("search", main.term.text())
        semantic_evidence["search"] = semantic_palette_evidence(
            "search", main, search_fg,
            {"selected-row": FZF_RGB["selected-bg"]},
            ("gemini · coding-agents · installed · active", "action   update"),
            {"coding-agents": CATEGORY_INDEXES["coding-agents"]},
        )
        main.send(b"\x1b")
        main.wait_for("cancelled")
        main.pump(0.25)
        check_public_text("cancelled", main.term.text())
    finally:
        main.finish()

    homebrew = Session(work / "homebrew", ["list", "--category", "homebrew"])
    try:
        homebrew.wait_for("aiup browse>")
        homebrew.wait_for("category  homebrew")
        for _ in range(5):
            homebrew.send(b"\x0e")
            homebrew.pump(0.15)
        homebrew.wait_for("category  homebrew/recommended")
        homebrew.send(b"\x05")
        homebrew.wait_for("Raycast launcher")
        homebrew.send(b"\x0e")
        homebrew.wait_for("action   switch to Homebrew")
        homebrew.send(b"\x10")
        homebrew.wait_for("state     expanded")
        homebrew.pump(0.4)
        check_public_text("homebrew hierarchy", homebrew.term.text())
        semantic_evidence["homebrew-hierarchy"] = semantic_palette_evidence(
            "homebrew hierarchy", homebrew, homebrew_fg,
            {"selected-row": FZF_RGB["selected-bg"]},
            ("recommended", "state     expanded", "full Homebrew catalog not loaded"),
            HOMEBREW_INDEXES,
        )
        states["homebrew-hierarchy"] = homebrew.term.render(
            font, bold_font, fallback_font, title_font
        )
        homebrew.send(b"\x0e")
        homebrew.wait_for("action   switch to Homebrew")
        homebrew.pump(0.4)
        check_public_text("homebrew", homebrew.term.text())
        semantic_evidence["raycast"] = semantic_palette_evidence(
            "raycast", homebrew, homebrew_fg,
            {"selected-row": FZF_RGB["selected-bg"]},
            ("recommended", "switch to Homebrew", "does not directly delete ~/Library"),
            HOMEBREW_INDEXES,
        )
        states["homebrew"] = homebrew.term.render(font, bold_font, fallback_font, title_font)
        homebrew.send(b"\x1b")
    finally:
        homebrew.finish()

    adopt = Session(work / "adopt", ["list", "--category", "homebrew/recommended"])
    try:
        adopt.wait_for("aiup browse>")
        for char in "raycast":
            adopt.send(char.encode())
            adopt.pump(0.7)
        adopt.wait_for("found    /Applications/Raycast.app")
        adopt.pump(0.5)
        adopt.send(b"\r")
        adopt.wait_for("Switch raycast to Homebrew without requesting a data zap?")
        adopt.pump(0.3)
        check_public_text("adopt", adopt.term.text())
        semantic_evidence["adoption"] = semantic_palette_evidence(
            "adoption", adopt, {}, required_text=(
                "[INFO] Letting Homebrew manage raycast.",
                "aiup will not pass --zap",
                "delete ~/Library.",
                "[WARN] Homebrew and vendor-specific installer behavior may vary.",
                "Switch raycast to Homebrew without requesting a data zap? [y/N]",
            ),
        )
        states["adopt"] = adopt.term.render(font, bold_font, fallback_font, title_font)
        adopt.send(b"n\n")
        adopt.wait_for("aiup browse>")
        adopt.send(b"\x1b")
    finally:
        adopt.finish()

    final = Session(work / "final", ["list"])
    try:
        final.wait_for("aiup browse>")
        final.wait_for("category  infra")
        final.pump(0.5)
        check_public_text("final overview", final.term.text())
        semantic_evidence["final"] = semantic_palette_evidence(
            "final overview", final, collapsed_fg,
            {"selected-row": FZF_RGB["selected-bg"]},
            ("detected software", "2 apps · 2 npm · 1 uv · 3 PATH"),
            CATEGORY_INDEXES,
        )
        states["final"] = final.term.render(font, bold_font, fallback_font, title_font)
        final.send(b"\x1b")
    finally:
        final.finish()

    command_logs = []
    for log_path in work.rglob("commands.log"):
        if log_path.exists(): command_logs.extend(log_path.read_text(encoding="utf-8").splitlines())
    forbidden_commands = (" install", " upgrade", " uninstall", " trust")
    if any(any(word in line for word in forbidden_commands) for line in command_logs):
        raise RuntimeError(f"capture attempted a mutating fixture command: {command_logs}")

    DOCS_MEDIA.mkdir(parents=True, exist_ok=True)
    save_png(states["collapsed"], DOCS_MEDIA / "aiup-list-collapsed.png", source_commit, "collapsed overview")
    save_png(states["search"], DOCS_MEDIA / "aiup-list-search.png", source_commit, "collapsed-category search")
    save_png(states["search"], DOCS_MEDIA / "aiup-list-poster.png", source_commit, "reduced-motion poster")
    save_png(states["homebrew"], DOCS_MEDIA / "aiup-list-homebrew.png", source_commit, "Homebrew recommended")
    save_png(states["adopt"], DOCS_MEDIA / "aiup-list-adopt.png", source_commit, "pre-action adoption confirmation")
    gif_frames = [states[state] for _, state, _ in GIF_SEQUENCE]
    gif_durations = [duration for _, _, duration in GIF_SEQUENCE]
    gif_palette_frames = [
        frame.quantize(
            colors=256,
            method=Image.Quantize.MAXCOVERAGE,
            dither=Image.Dither.NONE,
        )
        for frame in gif_frames
    ]
    gif_palette_frames[0].save(
        DOCS_MEDIA / "aiup-list.gif", save_all=True, append_images=gif_palette_frames[1:],
        duration=gif_durations, disposal=1, optimize=False, loop=0,
        include_color_table=True,
    )
    if (DOCS_MEDIA / "aiup-list.gif").stat().st_size >= 5 * 1024 * 1024:
        raise RuntimeError("aiup-list.gif exceeded the 5 MiB target")

    raster_evidence = {
        "collapsed": raster_palette_evidence("collapsed", states["collapsed"], collapsed_fg),
        "search": raster_palette_evidence("search", states["search"], search_fg),
        "poster": raster_palette_evidence("poster", states["search"], search_fg),
        "homebrew-hierarchy": raster_palette_evidence(
            "homebrew hierarchy", states["homebrew-hierarchy"], homebrew_fg
        ),
        "homebrew": raster_palette_evidence("homebrew", states["homebrew"], homebrew_fg),
        "adoption": raster_palette_evidence(
            "adoption", states["adopt"], expected_raster_palettes()["adoption"]
        ),
        "final": raster_palette_evidence("final overview", states["final"], collapsed_fg),
    }
    with Image.open(DOCS_MEDIA / "aiup-list.gif") as gif:
        encoded_frames = [frame.convert("RGB") for frame in ImageSequence.Iterator(gif)]
    gif_palettes = (
        collapsed_fg,
        search_fg,
        homebrew_fg,
        homebrew_fg,
        expected_raster_palettes()["adoption"],
        collapsed_fg,
    )
    for (semantic_name, _, _), frame, palette in zip(GIF_SEQUENCE, encoded_frames, gif_palettes):
        raster_evidence[f"gif-{semantic_name}"] = raster_palette_evidence(
            f"GIF {semantic_name}", frame, palette, tolerance=8,
        )

    SITE_MEDIA.mkdir(parents=True, exist_ok=True)
    for name in MEDIA_NAMES:
        shutil.copyfile(DOCS_MEDIA / name, SITE_MEDIA / name)

    assets = {}
    for name in MEDIA_NAMES:
        payload = (DOCS_MEDIA / name).read_bytes()
        assets[name] = {
            "sha256": hashlib.sha256(payload).hexdigest(),
            "bytes": len(payload),
            "dimensions": [WIDTH, HEIGHT],
        }
    manifest = {
        "schema": 3,
        "source_commit": source_commit,
        "runtime_version": "2026.08.25-02",
        "capture_contract_version": "2026-08-26-05",
        "managed_entries": 81,
        "terminal_cells": [COLS, ROWS],
        "output_pixels": [WIDTH, HEIGHT],
        "font": str(FONT.name),
        "font_sha256": hashlib.sha256(FONT.read_bytes()).hexdigest(),
        "fallback_font": str(FALLBACK_FONT.name),
        "fallback_font_sha256": hashlib.sha256(FALLBACK_FONT.read_bytes()).hexdigest(),
        "font_size_px": FONT_SIZE,
        "retina_scale": SCALE,
        "locale": "en_US.UTF-8",
        "terminal_profile": {
            "name": "Homebrew",
            "source": "macOS Terminal profile readback",
            "background": "#000000",
            "background_alpha": 0.9,
            "foreground": "#28fe14",
            "bold_foreground": "#00f900",
            "selection": "#0c2eee",
            "selection_alpha": 0.65,
            "cursor": "#38fe27",
            "cursor_type": "block",
            "cursor_blinks": True,
            "font": "AndaleMono",
            "font_size_points": 16,
            "font_antialias": True,
        },
        "window_chrome": {
            "kind": "reproduced macOS Terminal frame",
            "title": f"aiup — fzf ‹ aiup list — {COLS}×{ROWS}",
            "host_metadata": "sanitized",
        },
        "fzf_palette": FZF_COLORS,
        "color_fidelity": {
            "capture_environment": "NO_COLOR removed; TERM=xterm-256color; COLORTERM=truecolor",
            "shell_profile_match": "live FZF_DEFAULT_OPTS palette replayed without capture-only chrome labels or colors",
            "semantic_cells": semantic_evidence,
            "rendered_pixels": raster_evidence,
            "adoption_roles": "production output distinguishes INFO, WARN, and the confirmation prompt textually; it emits no role-specific SGR",
        },
        "layout_matrix": layout_evidence,
        "visual_reference": {
            "kind": "owner-provided macOS Terminal capture",
            "sha256": "67a6594f32556b1126c05916474f5c24826ff0c3d51a5202a3e7591b1cf67583",
            "dimensions": [4158, 2394],
            "color_profile": "Display P3",
            "measured_fzf_background_srgb": "#1e1e2c",
        },
        "gif_frames": len(gif_frames),
        "gif_duration_ms": sum(gif_durations),
        "gif_sequence": [
            {"state": semantic_name, "duration_ms": duration}
            for semantic_name, _, duration in GIF_SEQUENCE
        ],
        "gif_playback": {
            "mode": "continuous",
            "plays": "infinite",
            "netscape_loop_extension": True,
        },
        "gif_retiming": {
            "baseline_multiplier": 1.15,
            "retained_state_basis_ms": {
                "collapsed-overview": 900,
                "gemini-search-update": 1800,
                "stable-final-overview": 1300,
            },
        },
        "fixture": "scripts/fixtures/capture",
        "external_commands_observed": command_logs,
        "software_mutation": "none; fake Homebrew rejects mutating verbs and adoption was cancelled at the first confirmation",
        "assets": assets,
    }
    manifest_path = DOCS_MEDIA / "capture-manifest.json"
    manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return manifest


def validate_existing() -> None:
    manifest = json.loads((DOCS_MEDIA / "capture-manifest.json").read_text(encoding="utf-8"))
    if manifest.get("schema") != 3:
        raise RuntimeError("capture manifest lacks Terminal-fidelity schema 3 evidence")
    palettes = expected_raster_palettes()
    for name in MEDIA_NAMES:
        docs = DOCS_MEDIA / name
        site = SITE_MEDIA / name
        if not docs.is_file() or not site.is_file(): raise RuntimeError(f"missing media asset: {name}")
        if docs.read_bytes() != site.read_bytes(): raise RuntimeError(f"docs/site media drift: {name}")
        with Image.open(docs) as image:
            if image.size != (WIDTH, HEIGHT): raise RuntimeError(f"wrong dimensions for {name}: {image.size}")
        digest = hashlib.sha256(docs.read_bytes()).hexdigest()
        if digest != manifest["assets"][name]["sha256"]: raise RuntimeError(f"manifest hash drift: {name}")
    png_states = {
        "aiup-list-collapsed.png": ("collapsed", palettes["collapsed"]),
        "aiup-list-search.png": ("search", palettes["search"]),
        "aiup-list-poster.png": ("poster", palettes["search"]),
        "aiup-list-homebrew.png": ("homebrew", palettes["homebrew"]),
    }
    for name, (label, expected) in png_states.items():
        with Image.open(DOCS_MEDIA / name) as image:
            raster_palette_evidence(label, image, expected)
    with Image.open(DOCS_MEDIA / "aiup-list-search.png") as search_image, \
         Image.open(DOCS_MEDIA / "aiup-list-poster.png") as poster_image:
        if search_image.convert("RGB").tobytes() != poster_image.convert("RGB").tobytes():
            raise RuntimeError("reduced-motion poster pixels drift from the accepted search state")
    gif_path = DOCS_MEDIA / "aiup-list.gif"
    with Image.open(gif_path) as gif:
        frames = []
        durations = []
        for frame in ImageSequence.Iterator(gif):
            durations.append(frame.info.get("duration", 0))
            frames.append(frame.convert("RGB"))
        loop = gif.info.get("loop")
    expected_sequence = [
        {"state": semantic_name, "duration_ms": duration}
        for semantic_name, _, duration in GIF_SEQUENCE
    ]
    if manifest.get("gif_sequence") != expected_sequence:
        raise RuntimeError("GIF semantic sequence or duration contract drifted")
    if len(frames) != manifest["gif_frames"] or len(frames) != len(GIF_SEQUENCE):
        raise RuntimeError(f"wrong GIF frame count: {len(frames)}")
    if durations != [duration for _, _, duration in GIF_SEQUENCE]:
        raise RuntimeError(f"wrong GIF frame durations: {durations}")
    if sum(durations) != manifest["gif_duration_ms"]:
        raise RuntimeError(f"wrong GIF duration: {sum(durations)} ms")
    if loop != 0 or b"NETSCAPE2.0" not in gif_path.read_bytes():
        raise RuntimeError(f"GIF is not continuous infinite-loop media: loop={loop!r}")
    if manifest.get("gif_playback") != {
        "mode": "continuous", "plays": "infinite", "netscape_loop_extension": True,
    }:
        raise RuntimeError("GIF playback manifest drifted")
    frame_palettes = (
        palettes["collapsed"], palettes["search"], palettes["homebrew"],
        palettes["homebrew"], palettes["adoption"], palettes["collapsed"],
    )
    for (semantic_name, _, _), frame, palette in zip(GIF_SEQUENCE, frames, frame_palettes):
        raster_palette_evidence(f"GIF {semantic_name}", frame, palette, tolerance=8)
    fidelity = manifest.get("color_fidelity", {})
    for state in ("collapsed", "search", "homebrew-hierarchy", "raycast", "adoption", "final"):
        if state not in fidelity.get("semantic_cells", {}):
            raise RuntimeError(f"manifest omitted semantic cell evidence for {state}")
    for state in (
        "collapsed", "search", "poster", "homebrew-hierarchy", "homebrew", "adoption", "final",
        *(f"gif-{semantic_name}" for semantic_name, _, _ in GIF_SEQUENCE),
    ):
        if state not in fidelity.get("rendered_pixels", {}):
            raise RuntimeError(f"manifest omitted rendered palette evidence for {state}")
    matrix = manifest.get("layout_matrix", [])
    if [entry.get("terminal_cells") for entry in matrix] != [list(size) for size in LAYOUT_MATRIX]:
        raise RuntimeError("capture manifest omitted the required PTY-size matrix")


def git_output(*args: str) -> str:
    return subprocess.check_output(["git", *args], cwd=ROOT, text=True).strip()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--check-layout", action="store_true")
    parser.add_argument("--source-commit")
    args = parser.parse_args()
    if args.check:
        validate_existing()
        print("capture media: ok")
        return 0
    if args.check_layout:
        work = ROOT / f".layout-work.{os.getpid()}"
        if work.exists(): raise RuntimeError(f"layout work path already exists: {work}")
        work.mkdir()
        try:
            results = validate_layout_matrix(work)
        finally:
            shutil.rmtree(work)
        print("tui layout matrix: ok")
        for result in results:
            cols, rows = result["terminal_cells"]
            print(
                f"  {cols}x{rows}: {result['catalog_rows_visible']} catalog rows, "
                f"preview {result['preview_default']}, {result['header_variant']} header"
            )
        return 0
    if not FONT.is_file(): raise RuntimeError(f"required fixed font is unavailable: {FONT}")
    for command in ("fzf",):
        if shutil.which(command) is None: raise RuntimeError(f"required existing capture command is unavailable: {command}")
    source_commit = args.source_commit or git_output("rev-parse", "HEAD")
    tracked_sources = ["macos/aiup", "macos/catalog/manifest.tsv", "scripts/capture-media", "scripts/fixtures/capture"]
    if subprocess.run(["git", "diff", "--quiet", source_commit, "--", *tracked_sources], cwd=ROOT).returncode:
        raise RuntimeError("capture sources differ from the named source commit")
    work = ROOT / f".capture-work.{os.getpid()}"
    if work.exists(): raise RuntimeError(f"capture work path already exists: {work}")
    work.mkdir()
    try:
        manifest = capture(source_commit, work)
        validate_existing()
    finally:
        shutil.rmtree(work)
    print(f"capture media: ok ({manifest['gif_frames']} frames, {manifest['gif_duration_ms']} ms)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
