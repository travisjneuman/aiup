#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AIUP="$ROOT/macos/aiup"
TEST_DIR="$(mktemp -d "$ROOT/.aiup-test.XXXXXX")"
trap 'rm -rf "$TEST_DIR"' EXIT

bash -n "$AIUP"

AIUP_STATE_DIR="$TEST_DIR/state" "$AIUP" catalog --json > "$TEST_DIR/catalog.json"
AIUP_STATE_DIR="$TEST_DIR/state" "$AIUP" inventory --json > "$TEST_DIR/inventory.json"
AIUP_STATE_DIR="$TEST_DIR/state" "$AIUP" help > "$TEST_DIR/help.txt"
grep -Fq 'Limit `aiup list` to one category' "$TEST_DIR/help.txt"
! grep -q '^== infra ==$' "$TEST_DIR/help.txt"
AIUP_STATE_DIR="$TEST_DIR/state" "$AIUP" --sort label --view managed list --plain > "$TEST_DIR/managed.txt"
AIUP_STATE_DIR="$TEST_DIR/state" "$AIUP" --view detected list --plain > "$TEST_DIR/detected.txt"
AIUP_STATE_DIR="$TEST_DIR/state" "$AIUP" --view managed list --plain > /dev/null
AIUP_STATE_DIR="$TEST_DIR/state" "$AIUP" __fzf-rows > "$TEST_DIR/rows-collapsed.tsv"
! grep -q '^chatgpt[[:space:]]' "$TEST_DIR/rows-collapsed.tsv"
printf 'chatgpt' > "$TEST_DIR/state/list-query"
AIUP_STATE_DIR="$TEST_DIR/state" "$AIUP" __fzf-rows > "$TEST_DIR/rows-search.tsv"
grep -q '^chatgpt[[:space:]]' "$TEST_DIR/rows-search.tsv"

CAPTURE_FIXTURE="$ROOT/scripts/fixtures/capture"
CAPTURE_STATE="$TEST_DIR/capture-state"
CAPTURE_PATH="$CAPTURE_FIXTURE/bin:/opt/homebrew/bin:/usr/bin:/bin"
env AIUP_CAPTURE_FIXTURE_DIR="$CAPTURE_FIXTURE" AIUP_STATE_DIR="$CAPTURE_STATE" PATH="$CAPTURE_PATH" \
  "$AIUP" list --plain > "$TEST_DIR/capture-list.txt"
grep -q '^== detected software ==$' "$TEST_DIR/capture-list.txt"
env AIUP_CAPTURE_FIXTURE_DIR="$CAPTURE_FIXTURE" AIUP_STATE_DIR="$CAPTURE_STATE" PATH="$CAPTURE_PATH" \
  "$AIUP" __fzf-rows > "$TEST_DIR/capture-rows.txt"
grep -q '8 detected software · 2 apps · 2 npm · 1 uv · 3 PATH' "$TEST_DIR/capture-rows.txt"
env AIUP_CAPTURE_FIXTURE_DIR="$CAPTURE_FIXTURE" AIUP_STATE_DIR="$CAPTURE_STATE" PATH="$CAPTURE_PATH" \
  "$AIUP" preview gemini > "$TEST_DIR/capture-gemini.txt"
grep -q '^gemini · coding-agents · installed · active$' "$TEST_DIR/capture-gemini.txt"
grep -q '^installed 0.10.0$' "$TEST_DIR/capture-gemini.txt"
grep -q '^available 0.11.0$' "$TEST_DIR/capture-gemini.txt"
grep -q '^action   update$' "$TEST_DIR/capture-gemini.txt"
env AIUP_CAPTURE_FIXTURE_DIR="$CAPTURE_FIXTURE" AIUP_STATE_DIR="$CAPTURE_STATE" PATH="$CAPTURE_PATH" \
  "$AIUP" preview gpt4all > "$TEST_DIR/capture-gpt4all.txt"
grep -q '^gpt4all · local-ai · installed · maintenance$' "$TEST_DIR/capture-gpt4all.txt"
grep -q '^installed 3.11.1$' "$TEST_DIR/capture-gpt4all.txt"
! grep -q '^available ' "$TEST_DIR/capture-gpt4all.txt"
env AIUP_CAPTURE_FIXTURE_DIR="$CAPTURE_FIXTURE" AIUP_STATE_DIR="$CAPTURE_STATE" PATH="$CAPTURE_PATH" \
  "$AIUP" preview bc:raycast > "$TEST_DIR/capture-raycast.txt"
grep -q 'aiup passes no --zap and does not directly delete ~/Library' "$TEST_DIR/capture-raycast.txt"
env AIUP_CAPTURE_FIXTURE_DIR="$CAPTURE_FIXTURE" AIUP_STATE_DIR="$CAPTURE_STATE" PATH="$CAPTURE_PATH" \
  "$AIUP" preview __cat:infra > "$TEST_DIR/capture-category.txt"
grep -q '^state     collapsed$' "$TEST_DIR/capture-category.txt"
grep -q '^action    expand this category$' "$TEST_DIR/capture-category.txt"
grep -q '^keys     enter/ctrl-e toggle · pgup/pgdn category · ctrl-g jump$' "$TEST_DIR/capture-category.txt"
! grep -Eq 'alt-e|check all visible|detected-only = no aiup updater' "$TEST_DIR/capture-category.txt"
! grep -Eiq '(/Users/|TJNMPM|travis|(^|[^[:alnum:]])(omp|plandex)([^[:alnum:]]|$))' "$TEST_DIR"/capture-*.txt
python3 -c 'compile(open(__import__("sys").argv[1], encoding="utf-8").read(), __import__("sys").argv[1], "exec")' \
  "$ROOT/scripts/capture-media"
python3 - "$TEST_DIR/catalog.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    data = json.load(handle)

tools = data["tools"]
assert tools, "catalog is empty"
assert all(tool["kind"] != "unknown" for tool in tools), "catalog contains an unknown installer kind"
screenpipe = next(tool for tool in tools if tool["id"] == "screenpipe")
assert screenpipe["kind"] == "app"
assert screenpipe["docs"] == "https://github.com/screenpipe/screenpipe"
assert "updater" in screenpipe["label"]
assert next(tool for tool in tools if tool["id"] == "vibe")["kind"] == "uv-tool"
assert next(tool for tool in tools if tool["id"] == "llama-cpp")["kind"] == "brew-formula"
for tool_id in ("bun", "pnpm", "jq", "yq", "ripgrep", "fd", "just", "shellcheck", "actionlint", "whisper-cpp"):
    tool = next(tool for tool in tools if tool["id"] == tool_id)
    assert tool["kind"] == "brew-formula"
PY

python3 - "$TEST_DIR/inventory.json" <<'PY'
import json, sys

with open(sys.argv[1], encoding="utf-8") as handle:
    data = json.load(handle)

assert "items" in data
assert all(item["id"].startswith("di:") for item in data["items"])
assert all(item["search"].startswith("https://www.google.com/search?q=") for item in data["items"])
PY

test -s "$TEST_DIR/state/inventory-cache.meta"
! grep -q '^== detected ==' "$TEST_DIR/managed.txt"
grep -q '^item .*found via .*location' "$TEST_DIR/detected.txt"

grep -q '^catalog_validate()' "$AIUP"
grep -q '^brew_review_installed_taps()' "$AIUP"
grep -q '^catalog_brew_index_init()' "$AIUP"
grep -q '^category_nav_action()' "$AIUP"
grep -q '^catalog_manifest_load()' "$AIUP"
grep -q '^scan_inventory_index()' "$AIUP"
grep -q '^inventory_cache_valid()' "$AIUP"
grep -q '^inventory_cache_write()' "$AIUP"
grep -q '^print_inventory_definition()' "$AIUP"
grep -q '^category_jump_action()' "$AIUP"
grep -q '^catalog_ui_state_save()' "$AIUP"
grep -q '^catalog_dependency_preview()' "$AIUP"
grep -q '^catalog_preview_window()' "$AIUP"
grep -q '^catalog_header_text()' "$AIUP"
grep -q '^catalog_preview_controls()' "$AIUP"
grep -q '^emit_brew_available_rows()' "$AIUP"
grep -q '^detected_search_url()' "$AIUP"
grep -q '^detected_cleanup_paths()' "$AIUP"
grep -q '^cmd_cleanup()' "$AIUP"
grep -q 'full Homebrew catalog not loaded' "$AIUP"
grep -q 'available font casks' "$AIUP"
grep -q '^print_result_summary()' "$AIUP"
grep -q 'LIST_VIEW_MODE' "$AIUP"
grep -q 'CATEGORY_ORDER=.*homebrew detected' "$AIUP"
grep -q 'detected-only' "$AIUP"
grep -q 'detected) printf' "$AIUP"
grep -q 'aiup inventory' "$AIUP"
grep -q '^refresh_fzf_listfile()' "$AIUP"
grep -q '^clear_terminal_screen()' "$AIUP"
grep -q '^list_search_active()' "$AIUP"
grep -q '__search-query' "$AIUP"
grep -q 'change:reload($fast rows {q})' "$AIUP"
grep -q 'left:reload($fast collapse {1} {q})' "$AIUP"
grep -q 'right:reload($fast expand {1} {q})' "$AIUP"
grep -q 'pgup:transform:$fast nav previous' "$AIUP"
grep -q 'pgdn:transform:$fast nav next' "$AIUP"
grep -q 'ctrl-g:transform.*__cat-jump' "$AIUP"
grep -q "ctrl-/:toggle-preview" "$AIUP"
grep -q 'resize:transform-header($fast header)+refresh-preview' "$AIUP"
grep -q -- '--track --id-nth=1' "$AIUP"
grep -q -- '--no-hscroll' "$AIUP"
grep -q -- '--print-query' "$AIUP"
grep -q 'enter_action_for "\${args\[1\]:-}" "\${args\[2\]:-}"' "$AIUP"
grep -q '^update_screenpipe()' "$AIUP"
grep -q '^official_app_update_endpoint()' "$AIUP"
grep -q '^official_app_latest_version()' "$AIUP"
grep -q 'official update metadata endpoint template' "$ROOT/macos/catalog/manifest.tsv"
grep -q 'RESULT_CURRENT' "$AIUP"
grep -q 'update_status_set skipped' "$AIUP"
grep -q 'ACP adapter remains installed independently' "$AIUP"
grep -q 'NPM_CONFIG_PREFIX="\$sys_prefix"' "$AIUP"
grep -q 'brew trust --tap' "$AIUP"
grep -q 'would trust already-installed Homebrew tap' "$AIUP"
grep -q 'Trusting already-installed Homebrew tap.*prior user approval' "$AIUP"
grep -q 'would ask whether to add and trust Homebrew tap' "$AIUP"
if grep -q 'would ask whether to trust installed Homebrew tap' "$AIUP"; then
  echo 'aiup tests: installed taps must not prompt' >&2
  exit 1
fi

printf 'aiup tests: ok (%s catalog tools)\n' "$(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1]))["tools"]))' "$TEST_DIR/catalog.json")"
"$ROOT/scripts/check-catalog-contracts"
"$ROOT/scripts/test-aiup-launcher"
"$ROOT/scripts/test-aiup-tui-performance"
"$ROOT/scripts/test-aiup-tui-lazy"
"$ROOT/scripts/test-aiup-tui-updates"
