#!/usr/bin/env python3
"""Exercise the update report with fake updaters; never update installed software."""
import os
import pty
import fcntl
import termios
import struct
import threading
from pathlib import Path
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]
runtime = (root / 'macos/aiup').read_text().rsplit('\nprofile_begin\n', 1)[0]
bootstrap = 'source "$REPORT_RUNTIME_PATH"\n'
stubs = r'''
ensure_managed_paths() { :; }
mutation_authoritative_preflight() { :; }
tui_cache_invalidate() { :; }
brew_cache_invalidate() { :; }
catalog_category() { printf 'coding-agents\n'; }
tool_is_present() { [ "$1" != missing ]; }
version_of_tool() {
  case "$1" in
    changed) printf '%s\n' "$changed_version" ;;
    unknown) printf 'unknown\n' ;;
    *) printf '1.0.0\n' ;;
  esac
}
update_by_kind() {
  case "$1" in
    changed) changed_version=2.0.0 ;;
    skipped) warn 'Not managed by this provider'; update_status_set skipped ;;
    failed) printf 'Error: provider unavailable\n' >&2; return 1 ;;
    warning) printf 'npm warn install-scripts Review esbuild scripts\n' ;;
  esac
  printf 'routine provider chatter\n'
}
changed_version=1.0.0
update_report_begin changed same skipped failed unknown warning
for tool in changed same skipped failed unknown warning; do run_tool_update "$tool" || true; done
print_update_report
DRY_RUN=1
UPDATE_REPORT_ROWS=()
UPDATE_REPORT_NOTE=''
update_report_record changed completed
print_update_report
'''
with tempfile.TemporaryDirectory(prefix='.aiup-report-', dir=root) as folder:
    source = Path(folder) / 'functions.bash'
    source.write_text(runtime)
    env = dict(os.environ, REPORT_RUNTIME_PATH=str(source), AIUP_STATE_DIR=folder, NO_COLOR='1')
    result = subprocess.run(['/bin/bash'], input=bootstrap+stubs, env=env, text=True,
                            capture_output=True, timeout=20)
    assert result.returncode == 0, result.stderr
    out = result.stdout
    for text in ('updated', '1.0.0 → 2.0.0', 'unchanged', 'skipped',
                 'Not managed by this provider', 'failed', 'unverified',
                 'npm warn install-scripts', 'planned'):
        assert text in out, (text, out)
    assert 'Detected tool versions' not in out
    assert 'routine provider chatter' not in out
    assert '\x1b' not in out
    assert 'routine provider chatter' in next(Path(folder).glob('logs/*')).read_text()
    print(out)
    master, slave = pty.openpty()
    fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack('HHHH', 40, 52, 0, 0))
    def terminal_session():
        os.setsid()
        fcntl.ioctl(1, termios.TIOCSCTTY, 0)
    env.pop('NO_COLOR', None)
    proc = subprocess.Popen(['/bin/bash'], stdin=subprocess.PIPE, stdout=slave, stderr=slave,
                            env=env, text=True, preexec_fn=terminal_session)
    os.close(slave)
    chunks = []
    def drain():
        while True:
            try:
                chunk = os.read(master, 65536)
                if not chunk: break
                chunks.append(chunk)
            except OSError:
                break
    reader = threading.Thread(target=drain, daemon=True)
    reader.start()
    try:
        proc.communicate(bootstrap+stubs, timeout=20)
    finally:
        if proc.poll() is None:
            proc.kill()
            proc.wait()
        reader.join(timeout=2)
        os.close(master)
    captured = b"".join(chunks)
    assert proc.returncode == 0, captured
    assert b'\x1b[38;5;171m' in captured, captured
    assert b'\x1b[38;2;57;255;20m' in captured, captured
    assert b'TOOL               RESULT' not in captured, captured
    print('PASS: 52-column terminal stacks rows and uses the catalog palette')
print('PASS: transitions, unchanged, skips, failure, unknown versions, warnings, dry-run, plain output, and retained details')
