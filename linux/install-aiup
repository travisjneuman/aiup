#!/bin/sh
# aiup installer for Linux.
#
#   curl -fsSL https://raw.githubusercontent.com/travisjneuman/aiup/main/linux/install-aiup | sh
#
# Options (after "sh -s --" when piped, for example "| sh -s -- --uninstall"):
#   --system     also add /usr/local/bin/aiup so every shell and every
#                one-off "ssh host aiup ..." finds it (asks for sudo)
#   --uninstall  remove the aiup command, the launcher and the PATH blocks
#                this installer added (add --system to remove the shared copy)
#
# Environment:
#   AIUP_PYTHON=/path/to/python3   use this Python (3.9 or newer)
#   AIUP_NO_MODIFY_PATH=1          leave shell startup files alone
#   AIUP_ALLOW_ROOT=1              allow installing as root (containers)
#
# The script runs only once it has been read in full: everything below is a
# function and the last line calls it.

AIUP_LAUNCHER_URL_DEFAULT='https://raw.githubusercontent.com/travisjneuman/aiup/main/runtime/launcher/aiup_launcher.py'
AIUP_INSTALL_MAX_BYTES=1048576
AIUP_PATH_BEGIN='# >>> aiup PATH >>>'
AIUP_PATH_END='# <<< aiup PATH <<<'
AIUP_SHIM_MARKER='# aiup shim (generated by install-aiup)'
AIUP_SYSTEM_BIN='/usr/local/bin'
AIUP_SYSTEM_LIB='/usr/local/lib/aiup'

say() {
  printf '%s\n' "$*"
}

warn() {
  printf 'aiup installer: %s\n' "$*" >&2
}

die() {
  warn "$*"
  exit 1
}

# A terminal is available when /dev/tty can be opened. "curl | sh" keeps the
# terminal even though stdin is the pipe; ssh commands and CI jobs have none.
have_tty() {
  ( : < /dev/tty ) 2>/dev/null
}

# ask QUESTION: true only when a person at the terminal answers yes.
ask() {
  have_tty || return 1
  printf '%s [y/N] ' "$1" > /dev/tty
  answer=''
  read -r answer < /dev/tty || return 1
  case "$answer" in
    y|Y|yes|YES|Yes) return 0 ;;
  esac
  return 1
}

# run_visible CMD...: show the command, then run it with the terminal as stdin.
run_visible() {
  say "+ $*"
  if have_tty; then
    "$@" < /dev/tty
  else
    "$@" < /dev/null
  fi
}

# Single-quote a value for a generated sh script.
sh_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

has_newline() {
  case "$1" in
    *'
'*) return 0 ;;
  esac
  return 1
}

# xdg_dir VAR DEFAULT: the XDG folder, ignoring values that are not absolute.
xdg_dir() {
  eval "xdg_value=\${$1:-}"
  case "$xdg_value" in
    /*) printf '%s' "$xdg_value" ;;
    *) printf '%s' "$2" ;;
  esac
}

is_root() {
  [ "$(id -u)" = 0 ]
}

sudo_prefix() {
  if is_root; then
    printf ''
  else
    printf 'sudo'
  fi
}

# --- package manager -------------------------------------------------------

package_manager() {
  for pm in apt-get dnf zypper pacman; do
    if command -v "$pm" >/dev/null 2>&1; then
      printf '%s' "$pm"
      return 0
    fi
  done
  return 1
}

# package_command PM PACKAGE: the install command, one word per line.
package_command() {
  case "$1" in
    apt-get) printf '%s\n' apt-get install -y "$2" ;;
    dnf) printf '%s\n' dnf install -y "$2" ;;
    zypper) printf '%s\n' zypper --non-interactive install "$2" ;;
    pacman) printf '%s\n' pacman -S --needed --noconfirm "$2" ;;
  esac
}

python_package() {
  case "$1" in
    pacman) printf 'python' ;;
    *) printf 'python3' ;;
  esac
}

# offer_package WHAT PACKAGE: print the install command, then run it with sudo
# when a person agrees. Returns 1 when nothing was installed.
offer_package() {
  what="$1"
  package="$2"
  pm="$(package_manager)" || {
    warn "$what was not found and no supported package manager (apt-get, dnf, zypper, pacman) is available."
    return 1
  }
  prefix="$(sudo_prefix)"
  # shellcheck disable=SC2046
  set -- $(package_command "$pm" "$package")
  if [ -n "$prefix" ]; then
    set -- "$prefix" "$@"
    if ! command -v sudo >/dev/null 2>&1; then
      warn "$what was not found. Install it as root with: $(printf '%s ' "$@" | sed 's/^sudo //')"
      return 1
    fi
  fi
  say "$what was not found. This installs it:"
  say "  $*"
  if ! ask "Run it now?"; then
    if have_tty; then
      say "Skipped. Run that command yourself later."
    else
      say "No terminal to ask on, so it was not run. Run that command yourself."
    fi
    return 1
  fi
  run_visible "$@" || {
    warn "the package manager did not finish."
    return 1
  }
  return 0
}

# --- Python ----------------------------------------------------------------

# python_path CANDIDATE: print the interpreter to record when CANDIDATE runs
# Python 3.9 or newer, else nothing. Version-manager shims (pyenv, asdf, mise)
# pick a Python from the current folder, and a virtualenv can be deleted, so
# for those the real interpreter is recorded instead.
python_path() {
  "$1" -I -c 'import os, sys
if sys.version_info[:2] >= (3, 9):
    path = sys.argv[1]
    if sys.prefix != sys.base_prefix or "/shims/" in path:
        path = os.path.realpath(sys.executable)
    print(path)' "$1" < /dev/null 2>/dev/null
}

# find_python: print the absolute path of the first Python 3.9 or newer.
find_python() {
  for candidate in "${AIUP_PYTHON:-}" python3 python3.15 python3.14 python3.13 python3.12 python3.11 \
    python3.10 python3.9; do
    [ -n "$candidate" ] || continue
    resolved="$(command -v "$candidate" 2>/dev/null)" || continue
    case "$resolved" in
      /*) ;;
      *) continue ;;
    esac
    found="$(python_path "$resolved")" || continue
    case "$found" in
      /*) ;;
      *) continue ;;
    esac
    if [ -x "$found" ] && ! has_newline "$found"; then
      printf '%s' "$found"
      return 0
    fi
  done
  return 1
}

ensure_python() {
  if python="$(find_python)"; then
    return 0
  fi
  if [ -n "${AIUP_PYTHON:-}" ]; then
    warn "AIUP_PYTHON=$AIUP_PYTHON is not Python 3.9 or newer; looking for another."
  fi
  pm="$(package_manager)" || pm=''
  if offer_package "Python 3.9 or newer" "$(python_package "$pm")"; then
    if python="$(find_python)"; then
      return 0
    fi
  fi
  die "aiup needs Python 3.9 or newer. Install it, then run this installer again."
}

# The aiup menus need a recent fzf. Arch and Fedora ship one; Debian, Ubuntu
# and openSUSE releases usually lag, so there aiup installs fzf itself later.
ensure_fzf() {
  command -v fzf >/dev/null 2>&1 && return 0
  pm="$(package_manager)" || pm=''
  case "$pm" in
    pacman|dnf)
      offer_package "fzf (used by the aiup menus)" fzf && return 0
      ;;
  esac
  say "Continuing without fzf. Run \"aiup only fzf\" later to get it for the aiup menus."
  return 0
}

# --- launcher download -----------------------------------------------------

validate_launcher() {
  file="$1"
  [ -s "$file" ] || die "the downloaded launcher was empty"
  bytes="$(wc -c < "$file" | tr -d ' ')"
  [ "$bytes" -le "$AIUP_INSTALL_MAX_BYTES" ] || die "the downloaded launcher was larger than 1 MiB"
  [ "$(head -n 1 "$file")" = '#!/usr/bin/env python3' ] || die "the downloaded launcher had an unexpected first line"
  grep -Fq 'AIUP_LAUNCHER_REVISION =' "$file" || die "the downloaded file was missing the launcher revision marker"
  grep -Fq 'AIUP_RELEASE_URL' "$file" || die "the downloaded file was missing the release pointer marker"
  grep -Fq 'def validate_generation(' "$file" || die "the downloaded file was missing launcher validation"
  "$python" -I -B -c 'import sys
with open(sys.argv[1], encoding="utf-8") as handle:
    compile(handle.read(), sys.argv[1], "exec", dont_inherit=True)' "$file" < /dev/null ||
    die "the downloaded launcher failed the Python syntax check"
}

download_launcher() {
  command -v curl >/dev/null 2>&1 || die "curl is required"
  command -v mktemp >/dev/null 2>&1 || die "mktemp is required"
  mkdir -p "$launcher_dir" || die "could not create $launcher_dir"
  chmod 700 "$launcher_dir" 2>/dev/null || true
  tmp_launcher="$(mktemp "$launcher_dir/.aiup-install.XXXXXX")" || die "could not create a temporary file"
  if ! curl -fsSL --proto '=https' --proto-redir '=https' --retry 2 --retry-max-time 40 --connect-timeout 10 \
    --max-time 30 --max-filesize "$AIUP_INSTALL_MAX_BYTES" \
    "${AIUP_LAUNCHER_URL:-$AIUP_LAUNCHER_URL_DEFAULT}" -o "$tmp_launcher" < /dev/null; then
    die "could not download the aiup launcher"
  fi
  validate_launcher "$tmp_launcher"
  chmod 600 "$tmp_launcher" || die "could not set launcher permissions"
  mv -f "$tmp_launcher" "$launcher" || die "could not move the launcher into place"
  tmp_launcher=''
}

# --- shims -----------------------------------------------------------------

# write_shim FILE PYTHON LAUNCHER
write_shim() {
  printf '%s\n' \
    '#!/bin/sh' \
    "$AIUP_SHIM_MARKER" \
    "aiup_python=$(sh_quote "$2")" \
    "aiup_launcher=$(sh_quote "$3")" \
    '[ -n "${AIUP_PYTHON:-}" ] && aiup_python="$AIUP_PYTHON"' \
    '[ -x "$aiup_python" ] || aiup_python="$(command -v python3 2>/dev/null)"' \
    'if [ -z "$aiup_python" ] || [ ! -f "$aiup_launcher" ]; then' \
    "  echo 'aiup: Python 3 or the aiup launcher is missing. Run the aiup installer again.' >&2" \
    '  exit 127' \
    'fi' \
    'exec "$aiup_python" -I -B "$aiup_launcher" "$@"' > "$1"
}

is_our_shim() {
  [ -f "$1" ] && sed -n 2p "$1" 2>/dev/null | grep -Fqx "$AIUP_SHIM_MARKER"
}

install_user_shim() {
  mkdir -p "$bin_dir" || die "could not create $bin_dir"
  if [ -e "$shim" ] || [ -L "$shim" ]; then
    if ! is_our_shim "$shim"; then
      backup="$shim.aiup-backup-$stamp"
      mv "$shim" "$backup" || die "could not move the existing $shim aside"
      say "Moved the existing $shim to $backup"
    fi
  fi
  tmp_shim="$(mktemp "$bin_dir/.aiup-shim.XXXXXX")" || die "could not create a temporary file"
  write_shim "$tmp_shim" "$python" "$launcher" || die "could not write the aiup command"
  chmod 700 "$tmp_shim" || die "could not set the aiup command permissions"
  mv -f "$tmp_shim" "$shim" || die "could not move the aiup command into place"
  tmp_shim=''
}

# run_privileged CMD...: run as root through sudo. With a terminal, sudo asks
# for a password there. Without one, only sudo -n (no password) is tried.
run_privileged() {
  prefix="$(sudo_prefix)"
  if [ -z "$prefix" ]; then
    run_visible "$@"
  elif have_tty; then
    run_visible sudo "$@"
  else
    run_visible sudo -n "$@"
  fi
}

install_system_shim() {
  system_shim="$AIUP_SYSTEM_BIN/aiup"
  system_launcher="$AIUP_SYSTEM_LIB/aiup_launcher.py"
  if { [ -e "$system_shim" ] || [ -L "$system_shim" ]; } && ! is_our_shim "$system_shim"; then
    die "$system_shim exists and was not made by this installer. Remove it first, then run with --system again."
  fi
  case "$python" in
    "$HOME"/*) warn "the Python at $python is inside your home folder, so other users cannot run the shared aiup command." ;;
  esac
  if [ -n "$(sudo_prefix)" ] && ! command -v sudo >/dev/null 2>&1; then
    die "--system needs sudo, which was not found"
  fi
  tmp_system_shim="$(mktemp "$bin_dir/.aiup-system-shim.XXXXXX")" || die "could not create a temporary file"
  write_shim "$tmp_system_shim" "$python" "$system_launcher" || die "could not write the shared aiup command"
  say "Adding the shared aiup command at $system_shim. This runs:"
  say "  sudo install -d -m 755 $AIUP_SYSTEM_LIB"
  say "  sudo install -m 644 $launcher $system_launcher"
  say "  sudo install -m 755 <generated shim> $system_shim"
  if ! run_privileged install -d -m 755 "$AIUP_SYSTEM_LIB" ||
    ! run_privileged install -m 644 "$launcher" "$system_launcher" ||
    ! run_privileged install -m 755 "$tmp_system_shim" "$system_shim"; then
    rm -f "$tmp_system_shim"
    tmp_system_shim=''
    die "could not add the shared aiup command. Run this installer with --system from a terminal where sudo can ask for your password."
  fi
  rm -f "$tmp_system_shim"
  tmp_system_shim=''
  say "Added $system_shim"
}

remove_system_shim() {
  system_shim="$AIUP_SYSTEM_BIN/aiup"
  system_launcher="$AIUP_SYSTEM_LIB/aiup_launcher.py"
  if [ ! -e "$system_shim" ] && [ ! -e "$system_launcher" ]; then
    say "No shared aiup command to remove."
    return 0
  fi
  if [ -e "$system_shim" ] && ! is_our_shim "$system_shim"; then
    warn "$system_shim was not made by this installer; left in place."
    return 1
  fi
  if [ -n "$(sudo_prefix)" ] && ! command -v sudo >/dev/null 2>&1; then
    die "--system needs sudo, which was not found"
  fi
  say "Removing the shared aiup command. This runs:"
  say "  sudo rm -f $system_shim $system_launcher"
  say "  sudo rmdir $AIUP_SYSTEM_LIB"
  run_privileged rm -f "$system_shim" "$system_launcher" || die "could not remove the shared aiup command"
  if [ -d "$AIUP_SYSTEM_LIB" ]; then
    run_privileged rmdir "$AIUP_SYSTEM_LIB" || warn "$AIUP_SYSTEM_LIB was not empty; left in place."
  fi
}

# --- PATH ------------------------------------------------------------------

setup_path() {
  if [ "${AIUP_NO_MODIFY_PATH:-}" = 1 ]; then
    say "AIUP_NO_MODIFY_PATH=1 is set, so no startup files were changed."
    return 0
  fi
  "$python" -I -B "$launcher" setup-path "$bin_dir" < /dev/null ||
    warn "some startup files could not be updated. See the messages above."
}

# Remove marked blocks with awk when the launcher cannot run. Each file is
# copied to a backup first and rewritten in place, so links and modes stay.
strip_blocks_fallback() {
  config_home="$(xdg_dir XDG_CONFIG_HOME "$HOME/.config")"
  for file in "$HOME/.profile" "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.bashrc" "$HOME/.zshenv"; do
    [ -f "$file" ] || continue
    grep -Fqx "$AIUP_PATH_BEGIN" "$file" || continue
    cp -p "$file" "$file.aiup-backup-$stamp" || { warn "could not back up $file; left as it is"; continue; }
    tmp_strip="$(mktemp "${TMPDIR:-/tmp}/aiup-strip.XXXXXX")" || continue
    awk -v begin="$AIUP_PATH_BEGIN" -v end="$AIUP_PATH_END" '
      $0 == begin { skip = 1; next }
      skip && $0 == end { skip = 0; next }
      !skip { print }
    ' "$file" > "$tmp_strip" && cat "$tmp_strip" > "$file" && say "$file: updated (backup: $file.aiup-backup-$stamp)"
    rm -f "$tmp_strip"
  done
  for file in "$config_home/fish/conf.d/aiup.fish" "$config_home/environment.d/60-aiup.conf"; do
    [ -f "$file" ] || continue
    if grep -Fqx "$AIUP_PATH_BEGIN" "$file"; then
      rm -f "$file" && say "$file: removed"
    fi
  done
}

remove_path_blocks() {
  if [ -f "$launcher" ] && python="$(find_python)"; then
    "$python" -I -B "$launcher" setup-path --remove --all < /dev/null && return 0
    warn "the launcher could not remove the PATH blocks; removing them directly."
  fi
  strip_blocks_fallback
}

# --- install and uninstall -------------------------------------------------

print_path_hint() {
  case ":${PATH:-}:" in
    *":$bin_dir:"*) return 0 ;;
  esac
  case "$bin_dir" in
    "$HOME"/*) hint_dir="\$HOME${bin_dir#"$HOME"}" ;;
    *) hint_dir="$bin_dir" ;;
  esac
  say "Open a new terminal, or run this in the current one:"
  say "  export PATH=\"$hint_dir:\$PATH\""
}

do_install() {
  ensure_python
  ensure_fzf
  download_launcher
  install_user_shim
  setup_path
  say "Installed aiup at $shim (Python: $python)"
  if [ "$want_system" = 1 ]; then
    install_system_shim
  elif is_our_shim "$AIUP_SYSTEM_BIN/aiup"; then
    say "The shared $AIUP_SYSTEM_BIN/aiup from an earlier install was not refreshed. Run this again with --system to refresh it."
  else
    say "Some systems read no startup file for one-off ssh commands such as \"ssh host aiup check\"."
    say "If aiup is not found there, run this installer again with --system to add $AIUP_SYSTEM_BIN/aiup."
  fi
  print_path_hint
}

do_uninstall() {
  remove_path_blocks
  if [ -e "$shim" ] || [ -L "$shim" ]; then
    if is_our_shim "$shim"; then
      rm -f "$shim" && say "Removed $shim"
    else
      warn "$shim was not made by this installer; left in place."
    fi
  fi
  if [ -f "$launcher" ]; then
    rm -f "$launcher" && say "Removed $launcher"
  fi
  rmdir "$launcher_dir" 2>/dev/null || true
  if [ "$want_system" = 1 ]; then
    remove_system_shim
  elif is_our_shim "$AIUP_SYSTEM_BIN/aiup"; then
    say "The shared $AIUP_SYSTEM_BIN/aiup is still there. Run this again with --uninstall --system to remove it."
  fi
  left=''
  if [ -n "${AIUP_STATE_DIR:-}" ] && [ -d "$AIUP_STATE_DIR" ]; then
    left="$AIUP_STATE_DIR"
  fi
  for dir in "$data_dir" \
    "$(xdg_dir XDG_STATE_HOME "$HOME/.local/state")/aiup" \
    "$(xdg_dir XDG_CACHE_HOME "$HOME/.cache")/aiup" \
    "$(xdg_dir XDG_CONFIG_HOME "$HOME/.config")/aiup"; do
    [ -d "$dir" ] && left="$left
$dir"
  done
  if [ -n "$left" ]; then
    say "Your aiup settings, history and downloads were kept. To remove them too:"
    printf '%s\n' "$left" | while IFS= read -r dir; do
      [ -n "$dir" ] && say "  rm -rf $(sh_quote "$dir")"
    done
  fi
  say "aiup was uninstalled."
}

cleanup() {
  [ -n "${tmp_launcher:-}" ] && rm -f "$tmp_launcher"
  [ -n "${tmp_shim:-}" ] && rm -f "$tmp_shim"
  [ -n "${tmp_system_shim:-}" ] && rm -f "$tmp_system_shim"
  return 0
}

usage() {
  say "usage: install-aiup [--system] [--uninstall]"
  say "  --system     also add $AIUP_SYSTEM_BIN/aiup for every shell and ssh command (uses sudo)"
  say "  --uninstall  remove what this installer added"
}

main() {
  set -u
  want_system=0
  want_uninstall=0
  for arg in "$@"; do
    case "$arg" in
      --system) want_system=1 ;;
      --uninstall) want_uninstall=1 ;;
      -h|--help) usage; exit 0 ;;
      *) usage >&2; die "unknown option: $arg" ;;
    esac
  done

  [ "$(uname -s)" = Linux ] || die "this installer is for Linux. On macOS use macos/install-aiup; on Windows use windows/install-aiup.ps1."
  case "${HOME:-}" in
    /*) ;;
    *) die "HOME must be set to an absolute path" ;;
  esac
  if is_root && [ "${AIUP_ALLOW_ROOT:-}" != 1 ]; then
    die "refusing to install as root. Run it as your own user (AIUP_ALLOW_ROOT=1 allows root, for containers)."
  fi

  stamp="$(date +%Y%m%d-%H%M%S)"
  data_dir="$(xdg_dir XDG_DATA_HOME "$HOME/.local/share")/aiup"
  launcher_dir="$data_dir/launcher"
  launcher="$launcher_dir/aiup_launcher.py"
  bin_dir="$HOME/.local/bin"
  shim="$bin_dir/aiup"
  python=''
  tmp_launcher=''
  tmp_shim=''
  tmp_system_shim=''
  if has_newline "$HOME" || has_newline "$data_dir"; then
    die "folders with a newline in their name are not supported"
  fi

  trap cleanup EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  if [ "$want_uninstall" = 1 ]; then
    do_uninstall
  else
    do_install
  fi
}

main "$@"
