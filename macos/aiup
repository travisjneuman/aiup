DETECTED_CLEANUP_SEEN='|'

detected_cleanup_add() {
  local path="$1"
  [ -e "$path" ] || [ -L "$path" ] || return 0
  case "$DETECTED_CLEANUP_SEEN" in
    *"|$path|"*) return 0 ;;
  esac
  DETECTED_CLEANUP_SEEN="${DETECTED_CLEANUP_SEEN}${path}|"
  printf '%s\n' "$path"
}

detected_cleanup_paths() {
  local id="$1" record label app bundle_id app_leaf
  local support_name
  record="$(inventory_record "$id" 2>/dev/null || true)"
  [ -n "$record" ] || return 1
  IFS=$'\t' read -r _ _ _ label _ _ app <<< "$record"
  case "$id" in
    di:app:*) bundle_id="${id#di:app:}" ;;
    *) return 1 ;;
  esac
  case "$app" in
    /Applications/*.app|"$HOME"/Applications/*.app) ;;
    *) return 1 ;;
  esac
  [ -d "$app" ] || return 1
  app_leaf="$(basename "$app" .app)"
  DETECTED_CLEANUP_SEEN='|'
  detected_cleanup_add "$app"
  for support_name in "$app_leaf" "$(inventory_item_name "$label")"; do
    [ -n "$support_name" ] || continue
    detected_cleanup_add "$HOME/Library/Application Support/$support_name"
    detected_cleanup_add "$HOME/Library/Caches/$support_name"
    detected_cleanup_add "$HOME/Library/Logs/$support_name"
  done
  detected_cleanup_add "$HOME/Library/Application Support/$bundle_id"
  detected_cleanup_add "$HOME/Library/Caches/$bundle_id"
  detected_cleanup_add "$HOME/Library/Logs/$bundle_id"
  detected_cleanup_add "$HOME/Library/Preferences/$bundle_id.plist"
  detected_cleanup_add "$HOME/Library/Saved Application State/$bundle_id.savedState"
  detected_cleanup_add "$HOME/Library/Containers/$bundle_id"
}

cmd_cleanup() {
  local id="${1:-}" apply="${2:-0}" record label version source app name path leaf target
  local -a paths=()
  if [ -z "$id" ]; then
    error "usage: aiup cleanup <detected-app-id> [--apply]"
    return 1
  fi
  case "$id" in
    di:app:*) ;;
    di:*)
      scan_inventory_index >/dev/null 2>&1 || true
      record="$(inventory_record "$id" 2>/dev/null || true)"
      if [ -n "$record" ]; then
        IFS=$'\t' read -r _ _ _ label version source app <<< "$record"
        printf '%s is detected via %s, but aiup has no reviewed generic remover for it.\n' "$(inventory_item_name "$label")" "$source"
        printf 'Use ctrl-o in aiup list or: aiup docs --print %s\n' "$id"
        return 0
      fi
      error "Detected inventory row is not available: $id"
      return 1
      ;;
    *)
      error "cleanup accepts a detected app id such as di:app:com.example.App"
      return 1
      ;;
  esac
  scan_inventory_index >/dev/null 2>&1 || true
  record="$(inventory_record "$id" 2>/dev/null || true)"
  [ -n "$record" ] || { error "Detected inventory row is not available: $id"; return 1; }
  IFS=$'\t' read -r _ _ _ label version source app <<< "$record"
  name="$(inventory_item_name "$label")"
  while IFS= read -r path; do
    [ -n "$path" ] && paths+=("$path")
  done < <(detected_cleanup_paths "$id")
  printf 'Cleanup preview: %s (%s, %s)\n' "$name" "${version:-unknown}" "$id"
  printf 'Only exact paths associated with this app bundle are candidates; group containers and unrelated files are excluded.\n'
  if [ "${#paths[@]}" -eq 0 ]; then
    printf 'No cleanup candidates found. Nothing changed.\n'
    return 0
  fi
  for path in "${paths[@]}"; do
    printf '  %s\t%s\n' "$(du -sh "$path" 2>/dev/null | awk '{print $1}' || printf '?')" "$path"
  done
  if [ "$apply" -ne 1 ]; then
    printf 'Nothing changed. Re-run with: aiup cleanup %s --apply\n' "$id"
    return 0
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'DRY-RUN: these paths would be moved to %s\n' "$HOME/.Trash"
    return 0
  fi
  confirm_tty "Move these ${#paths[@]} exact paths to Trash? [y/N] " || {
    info "Cleanup cancelled"
    return 0
  }
  ensure_dir "$HOME/.Trash"
  for path in "${paths[@]}"; do
    leaf="$(basename "$path")"
    target="$HOME/.Trash/aiup-$(date +%Y%m%d%H%M%S)-$leaf"
    while [ -e "$target" ] || [ -L "$target" ]; do
      target="$HOME/.Trash/aiup-$(date +%Y%m%d%H%M%S)-$$-$leaf"
    done
    if mv "$path" "$target"; then
      info "Moved to Trash: $path"
    else
      error "Could not move to Trash: $path"
    fi
  done
  printf 'Cleanup complete. Files remain recoverable in %s.\n' "$HOME/.Trash"
}

