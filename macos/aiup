  uv="$(awk -F '\t' '$2=="detected" && $6=="uv tool" {n++} END {print n+0}' "$INVENTORY_INDEX" 2>/dev/null)"
  path="$(awk -F '\t' '$2=="detected" && $6=="PATH executable" {n++} END {print n+0}' "$INVENTORY_INDEX" 2>/dev/null)"
  printf '%s detected software · %s apps · %s npm · %s uv · %s PATH' "$total" "$apps" "$npm" "$uv" "$path"
