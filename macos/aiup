update_brew() {
  local brew_bin="" installer=""
  if command_exists brew; then
    brew_bin="$(command_path brew)"
  elif [ -x /opt/homebrew/bin/brew ]; then
    brew_bin=/opt/homebrew/bin/brew
  elif [ -x /usr/local/bin/brew ]; then
    brew_bin=/usr/local/bin/brew
  fi
  if [ -n "$brew_bin" ]; then
    info "Homebrew at $brew_bin"
    brew_review_installed_taps || return 1
    if [ -z "${_AIUP_BREW_UPDATED:-}" ]; then
      run_with_heartbeat "brew update" env HOMEBREW_NO_ENV_HINTS=1 "$brew_bin" update || return 1
      _AIUP_BREW_UPDATED=1
    else
      info "Homebrew already refreshed during this run"
    fi
    hash_refresh
    set_state_method brew installer
    return 0
  fi
  if ! command_exists xcode-select || ! xcode-select -p >/dev/null 2>&1; then
    error "Homebrew's supported macOS setup requires Xcode Command Line Tools; run: xcode-select --install"
    return 1
  fi
  tty_usable || {
    error "Homebrew installation requires an interactive terminal for its confirmation and administrator authentication"
    return 1
  }
  info "Starting Homebrew's official interactive installer (it may request confirmation and administrator authentication)"
  installer="$(curl -fsSL "$HOMEBREW_INSTALL_URL")" || {
    error "Could not fetch Homebrew's official installer"
    return 1
  }
  [ -n "$installer" ] || {
    error "Homebrew's official installer download was empty"
    return 1
  }
  /bin/bash -c "$installer" || return 1
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
    export PATH="/opt/homebrew/bin:$PATH"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
    export PATH="/usr/local/bin:$PATH"
  fi
  hash_refresh
  if ! command_exists brew; then
    error "Homebrew installed but brew is not on PATH in this session. Open a new shell and retry."
    return 1
  fi
  set_state_method brew installer
}

remove_brew() {
