    os.kill(int(meta["owner_pid"]), 0)
except Exception: fail()
runtime = pathlib.Path(os.environ.get("AIUP_ACTIVE_RUNTIME", ""))
manifest = pathlib.Path(os.environ.get("AIUP_CATALOG_MANIFEST", ""))
context_names = ["catalog-index.tsv", "brew-index.tsv", "inventory-index.tsv", "versions-index.tsv",
                 "preview-local.tsv", "preview-remote.tsv", "preview-docs.tsv", "fast-helper.py",
                 "rows-base.tsv", "rows-collapsed.tsv"]
try:
    if not runtime.is_file() or runtime.is_symlink() or not manifest.is_file() or manifest.is_symlink(): fail()
    if not all(regular(name) for name in context_names): fail()
    if meta.get("runtime_hash") != hashlib.sha256(runtime.read_bytes()).hexdigest(): fail()
    if meta.get("manifest_hash") != hashlib.sha256(manifest.read_bytes()).hexdigest(): fail()
    if meta.get("catalog_hash") != digest("catalog-index.tsv"): fail()
    if meta.get("brew_hash") != digest("brew-index.tsv"): fail()
    if meta.get("inventory_hash") != digest("inventory-index.tsv"): fail()
