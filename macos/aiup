confirm_tty() {
  local prompt="$1"
  local answer=""
  if [ "${AIUP_TUI_TESTING:-0}" = 1 ] && [ -n "${AIUP_TUI_TEST_CONFIRM_RESPONSE:-}" ]; then
    [ -n "${AIUP_TUI_TEST_CONFIRM_LOG:-}" ] && printf '%s\n' "$prompt" >> "$AIUP_TUI_TEST_CONFIRM_LOG"
    case "$AIUP_TUI_TEST_CONFIRM_RESPONSE" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
  fi
  tty_usable || return 1
  printf '%s' "$prompt" >/dev/tty
  read -r answer </dev/tty || return 1
  case "$answer" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

pick_catalog_tools() {
  local mode="$1"
  local filter="all"
  export AIUP_CATEGORY_FILTER="$LIST_CATEGORY_FILTER"
  export AIUP_VIEW_MODE="$LIST_VIEW_MODE"
  ensure_dir "$STATE_DIR"
  [ -f "$EXPAND_FILE" ] || : > "$EXPAND_FILE"
  case "$mode" in
    install) filter='all' ;;
    remove) filter='installed' ;;
    browse) filter='all' ;;
  esac
  scan_catalog_index "$filter" || return 1

  # Selection IDs go to stdout (often a pipe). The UI must use /dev/tty.
  # Do not test -t 1 — `aiup install` captures this function via process
  # substitution, so stdout is a pipe even in a real terminal.
  if ! tty_usable; then
    error "aiup $mode needs a controlling terminal (/dev/tty)"
    error "Use: aiup only <tools...> / aiup remove <tools...>"
    return 1
  fi

  tui_session_create || {
    error "Could not create a validated aiup TUI session"
    return 1
  }
  export AIUP_CATALOG_MANIFEST="$CATALOG_MANIFEST"
  export AIUP_ACTIVE_RUNTIME="$(tui_runtime_path)"
  local -a rows=()
  local line
  while IFS= read -r line; do
    [ -n "$line" ] && rows+=("$line")
  done < <(tui_session_emit_rows)
  if [ "${#rows[@]}" -eq 0 ]; then
    error "Nothing to $mode"
    tui_session_cleanup
    return 1
  fi
  profile_mark "picker-ready"

  prepare_tty_for_fzf

  local selected=""
  local key="enter"
  local query_line second_line selected_id raw_selected_id initial_pos tty_columns header_text
  local self fast
  self="$(tui_helper_command)"
  fast="$(tui_fast_helper_command)"
  if command_exists fzf; then
    # --no-height overrides FZF_DEFAULT_OPTS --height=45% and uses the full
    # screen (height=100% is "below the cursor" and vanishes after brew output).
    local fzf_rc=0
    local listfile listfile_q
    local last_query
    local -a fzf_state_args=()
    listfile="$AIUP_TUI_SESSION_DIR/list.tsv"
    AIUP_TUI_LISTEN_SOCKET="$AIUP_TUI_SESSION_DIR/fzf.sock"
    export AIUP_TUI_LISTEN_SOCKET
    listfile_q="$(shell_quote "$listfile")"
    printf '%s\n' "${rows[@]}" > "$listfile"
    last_query="$(catalog_ui_state_read "$LIST_QUERY_FILE")"
    initial_pos="$(catalog_ui_state_position "$listfile")"
    tty_columns="$(stty size </dev/tty 2>/dev/null | awk '{print $2}')"
    header_text="$(catalog_header_text "$tty_columns")"
    [ -n "$last_query" ] && fzf_state_args+=(--query "$last_query")
    [ -n "$initial_pos" ] && fzf_state_args+=(--bind "start:pos($initial_pos)")
    [ -z "$last_query" ] || "$AIUP_TUI_SESSION_DIR/fast-helper.py" rows "$last_query" > /dev/null
    tui_prefetch_start
    selected="$(FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:-} --no-height" fzf --ansi --disabled --no-sort --multi --delimiter=$'\t' --with-nth=2 \
      --track --id-nth=1 \
      --listen-unsafe="$AIUP_TUI_LISTEN_SOCKET" \
      --no-height \
      --no-hscroll \
      --print-query \
      --prompt "aiup ${mode}> " \
      --header "$header_text" \
      --preview "$fast preview {1}" \
      --preview-window "$(catalog_preview_window)" \
      --bind 'space:toggle' \
      --bind 'ctrl-a:toggle-all' \
      --bind 'ctrl-/:toggle-preview' \
      --bind "resize:transform-header($fast header)+refresh-preview" \
      --bind "change:reload($fast rows {q})" \
      --bind "load:transform-header($fast header)" \
      --bind "enter:transform:$self __enter-action {1} {q}" \
      --bind "left:reload($fast collapse {1} {q})" \
      --bind "right:reload($fast expand {1} {q})" \
      --bind "pgup:transform:$fast nav previous {1}" \
      --bind "pgdn:transform:$fast nav next {1}" \
      --bind "ctrl-g:transform:$self __cat-jump {1} $listfile_q" \
      --bind "ctrl-e:reload($fast toggle {1} {q})" \
      --bind "alt-e:reload($fast expand-all {q})" \
      --bind "alt-c:reload($fast collapse-all {q})" \
      --bind "ctrl-o:execute-silent($self docs {1})+clear-screen+refresh-preview" \
      --bind "f3:execute-silent($self docs {1})+clear-screen+refresh-preview" \
      --bind "alt-o:execute-silent($self docs {1})+clear-screen+refresh-preview" \
      --bind "ctrl-y:execute-silent($self docs --print {1} | pbcopy)" \
      --expect=ctrl-d,ctrl-r \
      ${fzf_state_args[@]+"${fzf_state_args[@]}"} \
      < "$listfile")" || fzf_rc=$?
    rm -f "$listfile"
    if [ "$fzf_rc" -eq 130 ] || [ "$fzf_rc" -eq 1 ]; then
      tui_session_cleanup
      return 130
    fi
    if [ "$fzf_rc" -ne 0 ]; then
      tui_session_cleanup
      return 1
    fi
    query_line="$(printf '%s\n' "$selected" | awk 'NR==1{print; exit}')"
    second_line="$(printf '%s\n' "$selected" | awk 'NR==2{print; exit}')"
    case "$second_line" in
      ctrl-d|ctrl-r)
        key="$second_line"
        selected="$(printf '%s\n' "$selected" | awk 'NR>2')"
        ;;
      *)
        key='enter'
        selected="$(printf '%s\n' "$selected" | awk 'NR>1')"
        ;;
    esac
  else
    error "fzf is required for aiup $mode. Re-run without --no-install, or: aiup only fzf"
    tui_session_cleanup
    return 1
  fi

  if [ -z "$selected" ]; then
    tui_session_cleanup
    return 130
  fi
  case "$key" in
    ctrl-d) PICK_ACTION='remove' ;;
    ctrl-r) PICK_ACTION='update' ;;
    *) PICK_ACTION='apply' ;;
  esac
  PICK_TOOLS=()
  PICK_UPDATE_ALL=0
  PICK_UPDATE_SYNTHETIC=0
  PICK_UPDATE_SNAPSHOT=()
  local id
  while IFS= read -r id; do
    [ -n "$id" ] && PICK_TOOLS+=("$id")
  done < <(printf '%s\n' "$selected" | awk -F '\t' '{print $1}')
  raw_selected_id="${PICK_TOOLS[0]:-}"
  tui_resolve_update_selection || { tui_session_cleanup; return 1; }
  selected_id="${raw_selected_id:-${PICK_TOOLS[0]:-}}"
  AIUP_TUI_ACTION_BASE_GENERATION="$(awk -F '\t' '$1=="snapshot_generation" {print $2; exit}' "$AIUP_TUI_SESSION_DIR/meta.tsv")"
  catalog_ui_state_save "$query_line" "$selected_id"
  tui_session_cleanup
  return 0
}

tui_incremental_post_action_refresh() {
  local action="$1"
  shift
  local generation="$AIUP_TUI_ACTION_BASE_GENERATION" base tool kind state next installed
  [ -n "$generation" ] || return 1
  case "$generation" in snapshot-[A-Za-z0-9._-]*) ;; *) return 1 ;; esac
  base="$TUI_CACHE_GENERATIONS/$generation"
  tui_snapshot_files_valid "$base" || return 1
  [ "$#" -gt 0 ] || return 1
  for tool in "$@"; do
    case "$tool" in __cat:*|bc:*|bf:*|di:*) return 1 ;; esac
    kind="$(catalog_kind "$tool")"
    # Dedicated app updates are exact. Package managers, installers, removals,
    # cleanup, adoption, and PATH-affecting actions deliberately rebuild wider.
    [ "$kind" = app ] && [ "$action" != remove ] || return 1
  done
  cp "$base/catalog-index.tsv" "$DEFAULT_CATALOG_INDEX" || return 1
  cp "$base/brew-index.tsv" "$DEFAULT_BREW_INDEX" || return 1
  cp "$base/inventory-index.tsv" "$DEFAULT_INVENTORY_INDEX" || return 1
  cp "$base/versions-index.tsv" "$DEFAULT_VERSIONS_INDEX" || return 1
  CATALOG_INDEX="$DEFAULT_CATALOG_INDEX"; BREW_INDEX="$DEFAULT_BREW_INDEX"; INVENTORY_INDEX="$DEFAULT_INVENTORY_INDEX"; VERSIONS_INDEX="$DEFAULT_VERSIONS_INDEX"
  for tool in "$@"; do
    state="$(catalog_state_for_tool "$tool")"
    next="${CATALOG_INDEX}.incremental.$$"
    awk -F '\t' -v id="$tool" -v state="$state" 'BEGIN{OFS="\t"} $3==id {$2=state} {print}' "$CATALOG_INDEX" > "$next" && mv "$next" "$CATALOG_INDEX"
    installed=''
    case "$state" in installed|on-disk) installed="$(version_of_tool "$tool" || true)" ;; esac
    next="${VERSIONS_INDEX}.incremental.$$"
    awk -F '\t' -v id="$tool" '$1!=id {print}' "$VERSIONS_INDEX" > "$next" || : > "$next"
    [ -n "$installed" ] && printf '%s\t%s\n' "$tool" "$installed" >> "$next"
    mv "$next" "$VERSIONS_INDEX"
    rm -f "$(available_cache_file "$tool")"
  done
  AIUP_TUI_SCAN_FILTER=all
  tui_cache_publish all || return 1
  profile_note "post-action refresh=incremental action=$action items=$*"
}

read_pick_result() {
  PICK_ACTION=""
  PICK_TOOLS=()
  local line first=1
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    if [ "$first" -eq 1 ]; then
      PICK_ACTION="$line"
      first=0
      continue
    fi
    PICK_TOOLS+=("$line")
  done
}

tui_resolve_update_selection() {
  local id canonical row has_synthetic=0 has_all=0 seen='|'
  local -a original=("${PICK_TOOLS[@]}") resolved=() snapshot=()
  for id in "${original[@]}"; do
    case "$id" in
      __update:*|__updates:*) has_synthetic=1 ;;
    esac
    [ "$id" = '__updates:all' ] && has_all=1
  done
  [ "$has_synthetic" -eq 1 ] || return 0
  tui_updates_index_valid "$AIUP_TUI_SESSION_DIR" || {
    error "The dynamic Updates snapshot is invalid or changed; no update was started"
    return 1
  }
  if [ "$has_all" -eq 1 ]; then
    while IFS= read -r row; do
      [ -n "$row" ] || continue
      canonical="${row%%$'\t'*}"
      case "$seen" in *"|$canonical|"*) continue ;; esac
      seen="${seen}${canonical}|"; resolved+=("$canonical"); snapshot+=("$row")
    done < <(awk -F '\t' '$4=="newer" && $5=="eligible" {print}' "$AIUP_TUI_SESSION_DIR/updates-index.tsv")
    PICK_UPDATE_ALL=1
  else
    for id in "${original[@]}"; do
      case "$id" in
        __cat:*) continue ;;
        __updates:*) error "Unknown Updates action identity: $id"; return 1 ;;
        __update:*) canonical="${id#__update:}" ;;
        *) canonical="$id" ;;
      esac
      row="$(awk -F '\t' -v id="$canonical" '$1==id && $4=="newer" {print; exit}' "$AIUP_TUI_SESSION_DIR/updates-index.tsv")"
      if [ -z "$row" ]; then
        case "$id" in
          __update:*) error "Updates identity is malformed, unknown, or no longer verified: $id"; return 1 ;;
          *) warn "Ignoring unverified ordinary selection in Updates action: $id"; continue ;;
        esac
      fi
      # Canonical rows selected alongside update aliases must themselves be a
      # verified update; unverified ordinary rows never piggyback on ctrl-r.
      case "$seen" in *"|$canonical|"*) continue ;; esac
      seen="${seen}${canonical}|"; resolved+=("$canonical"); snapshot+=("$row")
    done
  fi
  [ "${#resolved[@]}" -gt 0 ] || {
    error "No verified eligible updates remain in the selected snapshot"
    return 1
  }
  PICK_TOOLS=("${resolved[@]}")
  PICK_UPDATE_SNAPSHOT=("${snapshot[@]}")
  PICK_UPDATE_SYNTHETIC=1
  PICK_ACTION=update
}

update_candidate_label() {
  case "$1" in
    bc:*) brew_extra_label cask "${1#bc:}" ;;
    bf:*) brew_extra_label formula "${1#bf:}" ;;
    *) catalog_label "$1" ;;
  esac
}

update_candidate_version() {
  local id="$1" name
  if capture_fixture_enabled; then
    version_of_tool "$id"
    return $?
  fi
  case "$id" in
    bc:*)
      name="${id#bc:}"; brew_cask_installed "$name" || return 1
      brew list --cask --versions "$name" 2>/dev/null | awk 'NF {$1=""; sub(/^ /, ""); print; exit}'
      ;;
    bf:*)
      name="${id#bf:}"; brew_formula_installed "$name" || return 1
      brew list --versions "$name" 2>/dev/null | awk 'NF {$1=""; sub(/^ /, ""); print; exit}'
      ;;
    *) version_of_tool "$id" ;;
  esac
}

update_candidate_live_revalidate() {
  local candidate_id="$1" id="$1" expected_installed="${2:-}" current available label dep lifecycle
  mutation_authoritative_preflight "$id verified update candidate" || {
    printf 'unavailable\t%s\t\t\t%s\tpreflight failed\n' "$id" "$(update_candidate_label "$id")"
    return 0
  }
  id="$candidate_id"
  local policy
  policy="$(policy_reason "$id")" || policy="Preferences unreadable"
  if [ -n "$policy" ]; then printf 'unavailable\t%s\t\t\t%s\t%s\n' "$id" "$(update_candidate_label "$id")" "$policy"; return 0; fi
  case "$id" in
    bc:*) brew_cask_installed "${id#bc:}" || { printf 'no-longer\t%s\t\t\t%s\tnot installed via Homebrew\n' "$id" "$(update_candidate_label "$id")"; return 0; } ;;
    bf:*) brew_formula_installed "${id#bf:}" || { printf 'no-longer\t%s\t\t\t%s\tnot installed via Homebrew\n' "$id" "$(update_candidate_label "$id")"; return 0; } ;;
    *)
      catalog_manifest_field "$id" 1 >/dev/null 2>&1 || { printf 'unavailable\t%s\t\t\t%s\tunknown catalog item\n' "$id" "$id"; return 0; }
      [ "$(catalog_state_for_tool "$id")" = installed ] || { printf 'no-longer\t%s\t\t\t%s\tnot installed under its update contract\n' "$id" "$(update_candidate_label "$id")"; return 0; }
      while IFS= read -r dep; do
        [ -n "$dep" ] || continue
        tool_is_present "$dep" || { printf 'unavailable\t%s\t\t\t%s\tmissing dependency %s\n' "$id" "$(update_candidate_label "$id")" "$dep"; return 0; }
      done < <(catalog_dep_closure "$id" | awk 'NF && !seen[$0]++')
      ;;
  esac
  current="$(update_candidate_version "$id" || true)"
  label="$(update_candidate_label "$id")"
  case "$current" in ''|unknown|'not installed'|'app present') printf 'unavailable\t%s\t%s\t\t%s\tinstalled version unavailable\n' "$id" "$current" "$label"; return 0 ;; esac
  [ -z "$expected_installed" ] || [ "$current" = "$expected_installed" ] || rm -f "$(available_cache_file "$id")"
  if available="$(available_version_uncached "$id" "$current")"; then
    if [ -z "$available" ]; then
      printf 'no-longer\t%s\t%s\t\t%s\talready current\n' "$id" "$current" "$label"
      return 0
    fi
  else
    printf 'unavailable\t%s\t%s\t\t%s\tprovider unavailable to verify\n' "$id" "$current" "$label"
    return 0
  fi
  lifecycle=active
  case "$id" in bc:*|bf:*) ;; *) lifecycle="$(catalog_lifecycle "$id")" ;; esac
  if [ "$lifecycle" = active ]; then
    printf 'ready\t%s\t%s\t%s\t%s\tverified\n' "$id" "$current" "$available" "$label"
  else
    printf 'manual\t%s\t%s\t%s\t%s\t%s lifecycle\n' "$id" "$current" "$available" "$label" "$lifecycle"
  fi
}

order_verified_update_tools() {
  local tool dep seen='|' selected='|'
  local -a ordered=()
  for tool in "$@"; do selected="${selected}${tool}|"; done
  for tool in "$@"; do
    while IFS= read -r dep; do
      case "$selected" in *"|$dep|"*) ;; *) continue ;; esac
      case "$seen" in *"|$dep|"*) continue ;; esac
      seen="${seen}${dep}|"; ordered+=("$dep")
    done < <(catalog_dep_closure "$tool" | awk 'NF && !seen[$0]++')
    case "$seen" in *"|$tool|"*) ;; *) seen="${seen}${tool}|"; ordered+=("$tool") ;; esac
  done
  printf '%s\n' "${ordered[@]}"
}

apply_verified_update_selection() {
  local id candidate_id expected line status current available label reason names='' before_completed before_current before_failed old_synthetic old_verified
  local -a ordered=() ready=() successful=() failed=() skipped=() no_longer=()
  while IFS= read -r id; do [ -n "$id" ] && ordered+=("$id"); done < <(order_verified_update_tools "${PICK_TOOLS[@]}")
  for id in "${ordered[@]}"; do
    expected="$(printf '%s\n' "${PICK_UPDATE_SNAPSHOT[@]}" | awk -F '\t' -v wanted="$id" '$1==wanted {print $2; exit}')"
    line="$(update_candidate_live_revalidate "$id" "$expected")"
    IFS=$'\t' read -r status id current available label reason <<< "$line"
    case "$status" in
      ready) ready+=("$line") ;;
      manual)
        if confirm_tty "Manual review: update ${label} (${id}) from ${current} to ${available}? [y/N] "; then ready+=("$line"); else skipped+=("$id"); fi
        ;;
      no-longer) no_longer+=("$id") ;;
      *) skipped+=("$id") ;;
    esac
  done
  if [ "$PICK_UPDATE_ALL" -eq 1 ] && [ "${#ready[@]}" -gt 0 ]; then
    for line in "${ready[@]}"; do
      IFS=$'\t' read -r status id current available label reason <<< "$line"
      [ -z "$names" ] || names="${names}, "
      names="${names}${label} (${id})"
    done
    if ! confirm_tty "Update all ${#ready[@]} verified items: ${names}? [y/N] "; then
      info "Update all cancelled; no mutations performed"
      result_record cancelled "Update all ${#ready[@]} verified items"
      return 0
    fi
  fi
  old_synthetic="$PICK_UPDATE_SYNTHETIC"
  old_verified="${AIUP_VERIFIED_SELECTION_ONLY:-0}"
  PICK_UPDATE_SYNTHETIC=0
  AIUP_VERIFIED_SELECTION_ONLY=1
  for line in "${ready[@]}"; do
    IFS=$'\t' read -r status id current available label reason <<< "$line"
    candidate_id="$id"
    line="$(update_candidate_live_revalidate "$id" "$current")"
    IFS=$'\t' read -r status id current available label reason <<< "$line"
    case "$status" in
      ready|manual) ;;
      no-longer) no_longer+=("$id"); continue ;;
      *) skipped+=("$id"); continue ;;
    esac
    before_completed="${#RESULT_COMPLETED[@]}"; before_current="${#RESULT_CURRENT[@]}"; before_failed="${#RESULT_FAILED[@]}"
    apply_catalog_action update "$candidate_id" || true
    if [ "${#RESULT_FAILED[@]}" -gt "$before_failed" ]; then
      failed+=("$candidate_id")
    elif [ "${#RESULT_COMPLETED[@]}" -gt "$before_completed" ]; then
      successful+=("$candidate_id")
    elif [ "${#RESULT_CURRENT[@]}" -gt "$before_current" ]; then
      no_longer+=("$candidate_id")
    else
      skipped+=("$candidate_id")
    fi
    rm -f "$(available_cache_file "$candidate_id")"
  done
  PICK_UPDATE_SYNTHETIC="$old_synthetic"
  AIUP_VERIFIED_SELECTION_ONLY="$old_verified"
  printf '\n=== verified update batch ===\n'
  print_result_group successful ${successful[@]+"${successful[@]}"}
  print_result_group failed ${failed[@]+"${failed[@]}"}
  print_result_group skipped ${skipped[@]+"${skipped[@]}"}
  print_result_group no-longer-applicable ${no_longer[@]+"${no_longer[@]}"}
  [ "${#failed[@]}" -eq 0 ]
}

apply_catalog_action() {
  local action="$1"
  shift
  local -a tools=("$@")
  local tool
  [ "${#tools[@]}" -gt 0 ] || return 0
  if [ "$action" = update ] && [ "$PICK_UPDATE_SYNTHETIC" -eq 1 ]; then
    apply_verified_update_selection
    return $?
  fi
  for tool in "${tools[@]}"; do
    case "$tool" in __update:*|__updates:*) error "Synthetic Updates identity reached action dispatch: $tool"; return 1 ;; esac
  done
  case "$action" in
    apply)
      NO_INSTALL=0
      local t life
      local -a catalog_tools=() brew_extras=()
      for t in "${tools[@]}"; do
        case "$t" in
          __cat:*) continue ;;
          bc:*|bf:*) brew_extras+=("$t") ;;
          di:*) warn "Detected-only item '$t' has no verified updater/remover contract; aiup will not guess how to change it"; result_record detected "$t" ;;
          *) catalog_tools+=("$t") ;;
        esac
      done
      if [ "${#brew_extras[@]}" -gt 0 ]; then
        ensure_catalog_deps brew || return 1
        apply_brew_extras apply "${brew_extras[@]}"
      fi
      [ "${#catalog_tools[@]}" -gt 0 ] || return 0
      tools=("${catalog_tools[@]}")
      for t in "${tools[@]}"; do
        life="$(catalog_lifecycle "$t")"
        if [ "$life" != 'active' ]; then
          warn "$(catalog_label "$t")"
          warn "$(catalog_lifecycle_note "$t")"
          if [ "${AIUP_KEEP_UI:-0}" = 1 ]; then
            confirm_tty "Install/update sunset tool '$t' anyway? [y/N] " || { tui_cache_invalidate; return 0; }
          fi
        fi
      done
      info "Install/update: ${tools[*]}"
      main_update "${tools[@]}"
      ;;
    update)
      NO_INSTALL=1
      local -a catalog_tools=() brew_extras=()
      local t
      for t in "${tools[@]}"; do
        case "$t" in
          __cat:*) continue ;;
          bc:*|bf:*) brew_extras+=("$t") ;;
          di:*) warn "Detected-only item '$t' has no verified updater contract; use its owning package manager"; result_record detected "$t" ;;
          *) catalog_tools+=("$t") ;;
        esac
      done
      if [ "${#brew_extras[@]}" -gt 0 ]; then
        apply_brew_extras update "${brew_extras[@]}"
      fi
      [ "${#catalog_tools[@]}" -gt 0 ] || return 0
      info "Update: ${catalog_tools[*]}"
      main_update "${catalog_tools[@]}"
      ;;
    remove)
      local -a to_remove=() brew_extras=()
      for tool in "${tools[@]}"; do
        case "$tool" in
          __cat:*) continue ;;
          bc:*|bf:*) brew_extras+=("$tool"); continue ;;
          di:app:*) cmd_cleanup "$tool" 1 || true; result_record detected "$tool"; continue ;;
          di:*) warn "Detected item '$tool' has no reviewed generic remover; use ctrl-o or its owning package manager"; result_record detected "$tool"; continue ;;
        esac
        if [ "$tool" = 'npm' ] || [ "$tool" = 'brew' ]; then
          warn "$tool is not removable via aiup"
          continue
        fi
        if ! tool_is_present "$tool"; then
          warn "Skip uninstall (not installed): $tool"
          continue
        fi
        to_remove+=("$tool")
      done
      if [ "${#brew_extras[@]}" -gt 0 ]; then
        if confirm_tty "Uninstall Homebrew extras ${brew_extras[*]}? [y/N] "; then
          apply_brew_extras remove "${brew_extras[@]}"
        fi
      fi
      [ "${#to_remove[@]}" -gt 0 ] || return 0
      if ! confirm_tty "Uninstall ${to_remove[*]}? [y/N] "; then
        info "Uninstall cancelled"
        tui_cache_invalidate
        return 0
      fi
      info "Removing: ${to_remove[*]}"
      ensure_managed_paths
      for tool in "${to_remove[@]}"; do
        run_tool_remove "$tool" || true
      done
      brew_cache_invalidate
      if [ "${AIUP_KEEP_UI:-0}" != 1 ]; then
        print_summary_versions
      fi
      ;;
    *)
      error "Unknown picker action: $action"
      return 1
      ;;
  esac
}

cmd_install_interactive() {
  ensure_fzf_for_interactive || return 1
  collapse_all_categories
  PICK_ACTION=""
  PICK_TOOLS=()
  pick_catalog_tools install || return 1
  [ "${#PICK_TOOLS[@]}" -eq 0 ] && return 1
  apply_catalog_action "${PICK_ACTION:-apply}" "${PICK_TOOLS[@]}"
}

cmd_remove_interactive() {
  ensure_fzf_for_interactive || return 1
  collapse_all_categories
  PICK_ACTION=""
  PICK_TOOLS=()
  pick_catalog_tools remove || return 1
  [ "${#PICK_TOOLS[@]}" -eq 0 ] && return 1
  apply_catalog_action "${PICK_ACTION:-remove}" "${PICK_TOOLS[@]}"
}

cmd_catalog_browse() {
  ensure_fzf_for_interactive || return 1
  AIUP_KEEP_UI=1
  collapse_all_categories
  while true; do
    restore_tty
    clear_terminal_screen
    brew_cache_invalidate
    PICK_ACTION=""
    PICK_TOOLS=()
    if ! pick_catalog_tools browse; then
      result_record cancelled "catalog picker"
      restore_tty
      clear_terminal_screen
      print_result_summary
      AIUP_KEEP_UI=0
      restore_tty
      return 0
    fi
    [ "${#PICK_TOOLS[@]}" -gt 0 ] || continue
    restore_tty
    clear_terminal_screen
    apply_catalog_action "${PICK_ACTION:-apply}" "${PICK_TOOLS[@]}" || true
    tui_incremental_post_action_refresh "${PICK_ACTION:-apply}" "${PICK_TOOLS[@]}" || \
      profile_note "post-action refresh=authoritative-wide action=${PICK_ACTION:-apply} items=${PICK_TOOLS[*]}"
    restore_tty
    clear_terminal_screen
  done
}

# Read-only provider status. Empty output is not enough to prove current;
# the cache records transport/parser failures separately from valid responses.
check_tool_status() {
  local tool="$1" current="$2" kind method cache stamp cached_current state value extra candidate policy
  CHECK_STATUS=unverified
  CHECK_AVAILABLE="$current"
  CHECK_NOTE='No read-only provider contract; the normal updater remains available.'
  policy="$(policy_reason "$tool")" || { CHECK_NOTE='Preferences could not be read; resolve before updating.'; return 1; }
  if [ -n "$policy" ]; then CHECK_STATUS=skipped; CHECK_NOTE="$policy"; return 0; fi
  if brew_missing_app_for_tool "$tool" >/dev/null; then
    CHECK_STATUS=skipped; CHECK_NOTE='App removed; only its Homebrew installation record remains.'; return 0
  fi
  kind="$(catalog_kind "$tool")"
  method="$(install_method_of "$tool")"
  if [ "$current" = 'not installed' ]; then
    CHECK_STATUS=absent; CHECK_NOTE="Install explicitly with: aiup only $tool"; return 0
  fi
  if [ "$kind" = brew-cask ] && [ "$method" = app ]; then
    CHECK_STATUS=skipped; CHECK_NOTE='Installed outside Homebrew; normal runs preserve its existing manager.'; return 0
  fi
  if [ "$INVENTORY_REFRESH" -eq 1 ]; then
    if candidate="$(available_version_uncached "$tool" "$current")"; then
      if [ -n "$candidate" ]; then state=newer; else state=current; fi
      available_cache_write "$tool" "$current" "$state" "$candidate"
    else
      available_cache_write "$tool" "$current" failure ''
    fi
  else
    available_version_of_tool "$tool" "$current" >/dev/null
  fi
  cache="$(available_cache_file "$tool")"
  if available_cache_read "$tool" "$current" >/dev/null; then
    IFS=$'\t' read -r stamp cached_current state value extra < "$cache"
    case "$state" in
      newer) CHECK_STATUS=update; CHECK_AVAILABLE="$value"; CHECK_NOTE='' ;;
      current) CHECK_STATUS=current; CHECK_NOTE='' ;;
      failure) CHECK_NOTE='Provider unavailable, unsupported, or returned invalid metadata; not confirmed current.' ;;
    esac
  fi
}

# One provider snapshot feeds all selected Homebrew tools. Invalid/missing
# records deliberately fall back to the existing per-tool provider contract.
check_brew_snapshot() {
  local raw tool current kind target i=0 state available
  CHECK_BREW_REFRESHED="|"
  ensure_dir "$AVAILABLE_VERSION_CACHE_DIR"
  raw="$(mktemp "$AVAILABLE_VERSION_CACHE_DIR/.check-brew.XXXXXX")" || return 1
  for tool in "$@"; do
    current="${UPDATE_REPORT_BEFORE[$i]}"; i=$((i+1))
    [ "$current" != 'not installed' ] || continue
    if [ "$INVENTORY_REFRESH" -eq 0 ] && available_cache_read "$tool" "$current" >/dev/null; then continue; fi
    kind="$(catalog_kind "$tool")"
    case "$kind" in
      brew-formula) target="$(catalog_brew_formula "$tool")" ;;
      brew-cask) brew_cask_installed "$(catalog_brew_cask "$tool")" || continue; target="$(catalog_brew_cask "$tool")" ;;
      *) continue ;;
    esac
    printf '%s\t%s\t%s\t%s\n' "$tool" "$current" "$kind" "$target" >> "${raw}.targets"
  done
  if [ -s "${raw}.targets" ] && bounded_provider_capture "$raw" "$AVAILABLE_VERSION_PROVIDER_TIMEOUT" env HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew info --json=v2 --installed; then
    python3 - "$raw" "${raw}.targets" > "${raw}.parsed" 2>/dev/null <<'PYBREWCHECK'
import json,sys
from pathlib import Path
data=json.loads(Path(sys.argv[1]).read_text()); found={}
for group,kind in [('formulae','brew-formula'),('casks','brew-cask')]:
    if not isinstance(data.get(group),list): raise SystemExit(1)
    for r in data[group]:
        if not isinstance(r,dict): raise SystemExit(1)
        name=r.get('name') if kind=='brew-formula' else r.get('token')
        if isinstance(name,str): found[kind,name]=r
for line in Path(sys.argv[2]).read_text().splitlines():
    tool,current,kind,target=line.split('\t');r=found.get((kind,target)) or found.get((kind,target.rsplit('/',1)[-1]))
    if not r or not isinstance(r.get('outdated'),bool): continue
    version=(r.get('versions') or {}).get('stable') if kind=='brew-formula' else r.get('version')
    if not isinstance(version,str) or not version: continue
    print(tool,current,'newer' if r['outdated'] else 'current',version if r['outdated'] else '',sep='\t')
PYBREWCHECK
    if [ $? -eq 0 ]; then
      while IFS=$'\t' read -r tool current state available; do
        if [ "$state" = newer ] && [ "$(version_is_greater "$available" "$current")" != yes ]; then continue; fi
        available_cache_write "$tool" "$current" "$state" "$available"
        CHECK_BREW_REFRESHED="${CHECK_BREW_REFRESHED}${tool}|"
      done < "${raw}.parsed"
    fi
  fi
  rm -f "$raw" "${raw}.targets" "${raw}.parsed"
}

cmd_check() {
  local tool current shade i=0 resolved offset pid job row
  local -a selected=() workers=()
  if [ "$#" -gt 0 ]; then
    resolved="$(resolve_tools "$@")" || return 1
    while IFS= read -r tool; do [ -z "$tool" ] || selected+=("$tool"); done <<< "$resolved"
  else
    brew_cache_load
    ensure_system_npm_prefix
    while IFS= read -r tool; do [ -z "$tool" ] || selected+=("$tool"); done < <(installed_update_tools)
  fi
  [ "${#selected[@]}" -gt 0 ] || { printf 'No installed catalog tools found.\n'; return 0; }
  UPDATE_REPORT_MODE=check
  update_report_begin "${selected[@]}" || return 1
  local CHECK_REQUEST_REFRESH="$INVENTORY_REFRESH"
  # Refresh once, then workers reuse the installed-version-bound responses.
  check_brew_snapshot "${selected[@]}"
  profile_mark "batched Homebrew metadata"
  for ((offset=0; offset<TUI_PREFETCH_WORKERS; offset++)); do
    (
      for ((i=offset; i<${#selected[@]}; i+=TUI_PREFETCH_WORKERS)); do
        tool="${selected[$i]}"; current="${UPDATE_REPORT_BEFORE[$i]}"
        if [ "$INVENTORY_REFRESH" -eq 1 ]; then
          # Only Homebrew records refreshed above bypass a second request.
          case "$CHECK_BREW_REFRESHED" in *"|$tool|"*) INVENTORY_REFRESH=0 ;; esac
        fi
        check_tool_status "$tool" "$current"
        INVENTORY_REFRESH="$CHECK_REQUEST_REFRESH"
        shade="$(catalog_ansi "$(catalog_category "$tool")")"; shade="${shade#$'\033['}"; shade="${shade%m}"
        printf '%s\t%s\t%s\t%s\t%s\t%s\t0\t0\t0\n' "$tool" "$CHECK_STATUS" "$current" "$CHECK_AVAILABLE" "$shade" "$CHECK_NOTE" > "${UPDATE_REPORT_LOG}.check.$i"
      done
    ) & workers+=("$!")
  done
  trap 'for pid in "${workers[@]}"; do kill "$pid" 2>/dev/null || true; done; wait 2>/dev/null || true; rm -f "${UPDATE_REPORT_LOG}".check.* "${UPDATE_REPORT_LOG}.active" "$UPDATE_REPORT_LOG"; exit 130' INT TERM HUP
  for pid in "${workers[@]}"; do wait "$pid" || true; done
  trap - INT TERM HUP
  for ((i=0; i<${#selected[@]}; i++)); do
    job="${UPDATE_REPORT_LOG}.check.$i"
    if [ -f "$job" ]; then row="$(cat "$job")"; UPDATE_REPORT_ROWS+=("$row"); rm -f "$job"
    else UPDATE_REPORT_ROWS+=("$(printf '%s\tunverified\tunknown\tunknown\t38;5;203\tCheck worker did not finish' "${selected[$i]}")"); fi
  done
  profile_mark "parallel provider checks"
  print_update_report
}

cmd_explain() {
  local tool="$1" resolved state method current location pkg shade='' reset=''
  brew_cache_load
  ensure_system_npm_prefix
  case "$tool" in
    di:*)
      scan_inventory_index || return 1
      print_catalog_preview "$tool"
      return $?
      ;;
  esac
  resolved="$(resolve_tools "$tool" 2>/dev/null)" || {
    printf '%s is not in the managed catalog.\n' "$tool"
    printf 'aiup inventory --refresh shows detected-only apps, global npm packages, uv tools, and PATH commands.\n'
    printf 'Project-local dependencies, temporary npx downloads, and agent skills are not global installed tools.\n'
    return 1
  }
  tool="$resolved"
  state="$(catalog_state_for_tool "$tool")"
  method="$(install_method_of "$tool")"
  current="$(version_of_tool "$tool")"
  location="$(resolved_path_of "$tool")"
  pkg="$(catalog_npm_pkg "$tool")"
  if [ "$location" = n/a ]; then
    location="$(catalog_app_path "$tool")"
    if [ -n "$pkg" ] && aiup_npm_pkg_installed "$pkg"; then location="$AIUP_NPM_NODE_MODULES/$pkg"; fi
  fi
  [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && { shade="$(catalog_ansi "$(catalog_category "$tool")")"; reset=$'\033[0m'; }
  printf '\n%s%s%s\n' "$shade" "$(catalog_label "$tool")" "$reset"
  printf '  %-12s %s\n' 'State' "$state" 'Version' "$current" 'Manager' "$method" 'Location' "${location:-not found}"
  [ -z "$pkg" ] || printf '  %-12s %s\n' 'Package' "$pkg"
  check_tool_status "$tool" "$current"
  printf '  %-12s %s\n' 'Next action' "$CHECK_STATUS" 'Reason' "$CHECK_NOTE" 'Docs' "$(catalog_docs_url "$tool")"
  if [ "$CHECK_STATUS" = skipped ]; then printf '\n  aiup only %s offers an explicit manager switch.\n' "$tool"; fi
  printf '\n  Recent run details: aiup history %s · aiup logs %s\n' "$tool" "$tool"
}

cmd_remove_named() {
  local resolved tool
  resolved="$(resolve_tools "$@")" || return 1
  ensure_managed_paths
  while IFS= read -r tool; do
    [ -n "$tool" ] || continue
    if [ "$tool" = 'npm' ]; then
      remove_npm
      continue
    fi
    run_tool_remove "$tool" || true
  done <<< "$resolved"
  print_summary_versions
}

