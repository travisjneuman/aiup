brew_review_installed_taps() {
  command_exists brew || return 0
  case "${_AIUP_BREW_TRUST_REVIEWED:-}" in
    1) return 0 ;;
  esac

  local taps tap remote
  taps="$(brew_untrusted_installed_taps)"
  _AIUP_BREW_TRUST_REVIEWED=1
  [ -n "$taps" ] || return 0

  if [ "$DRY_RUN" -eq 1 ]; then
    while IFS= read -r tap; do
      [ -n "$tap" ] || continue
      warn "DRY-RUN: would trust already-installed Homebrew tap $tap"
    done <<< "$taps"
    return 0
  fi

  while IFS= read -r tap; do
    [ -n "$tap" ] || continue
    remote="$(brew_tap_remote "$tap")"
    info "Trusting already-installed Homebrew tap $tap as prior user approval"
    [ -n "$remote" ] && info "Tap remote: $remote"
    run_with_heartbeat "brew trust --tap $tap" env HOMEBREW_NO_ENV_HINTS=1 brew trust --tap "$tap" || return 1
    info "Trusted installed Homebrew tap: $tap"
  done <<< "$taps"
  return 0
}

