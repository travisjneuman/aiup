catalog_validate() {
  local tool kind category lifecycle bin seen="|"
  local failures=0
  catalog_manifest_load || return 1
  for tool in "${TOOLS_CATALOG[@]}"; do
    kind="$(catalog_kind "$tool")"
    category="$(catalog_category "$tool")"
    lifecycle="$(catalog_lifecycle "$tool")"
    case "$tool" in
      ''|*[!a-z0-9-]*|-*|*-) error "Catalog entry has an unstable id: '$tool'"; failures=$((failures + 1)) ;;
    esac
    case "$seen" in
      *"|$tool|"*) error "Catalog entry '$tool' is duplicated"; failures=$((failures + 1)) ;;
      *) seen="${seen}${tool}|" ;;
    esac
    case "$lifecycle" in
      active|maintenance|sunset|archived) ;;
      *) error "Catalog entry '$tool' has invalid lifecycle '$lifecycle'"; failures=$((failures + 1)) ;;
    esac
    case " ${CATEGORY_ORDER[*]} " in
      *" $category "*) ;;
      *)
        error "Catalog entry '$tool' has no valid category '$category'"
        failures=$((failures + 1))
        ;;
    esac
    if [ -z "$(catalog_label "$tool")" ]; then
      error "Catalog entry '$tool' has no label"
      failures=$((failures + 1))
    fi
    if [ -z "$(catalog_docs_url "$tool")" ]; then
      error "Catalog entry '$tool' has no documentation URL"
      failures=$((failures + 1))
    fi

    case "$kind" in
      aiup-npm)
        if [ -z "$(catalog_npm_pkg "$tool")" ]; then
          error "Catalog entry '$tool' has no npm package"
          failures=$((failures + 1))
        fi
        ;;
      brew-formula)
        if [ -z "$(catalog_brew_formula "$tool")" ]; then
          error "Catalog entry '$tool' has no Homebrew formula"
          failures=$((failures + 1))
        fi
        ;;
      brew-cask)
        if [ -z "$(catalog_brew_cask "$tool")" ]; then
          error "Catalog entry '$tool' has no Homebrew cask"
          failures=$((failures + 1))
        fi
        ;;
      curl-installer)
        if [ -z "$(catalog_curl_url "$tool")" ]; then
          error "Catalog entry '$tool' has no installer URL"
          failures=$((failures + 1))
        fi
        ;;
      uv-tool)
        if [ -z "$(catalog_uv_pkg "$tool")" ]; then
          error "Catalog entry '$tool' has no uv package"
          failures=$((failures + 1))
        fi
        ;;
      app|special)
        if ! type "update_$tool" >/dev/null 2>&1; then
          error "Catalog entry '$tool' has no dedicated updater"
          failures=$((failures + 1))
        fi
        if [ "$kind" = 'app' ] && [ -z "$(catalog_app_path "$tool")" ]; then
          error "Catalog entry '$tool' has no app path for version/removal handling"
          failures=$((failures + 1))
        fi
        ;;
      unknown)
        error "Catalog entry '$tool' has unsupported installer kind '$kind'"
        failures=$((failures + 1))
        ;;
    esac

    case "$kind" in
      special|unknown)
        if ! type "remove_$tool" >/dev/null 2>&1; then
          error "Catalog entry '$tool' has no dedicated remover"
          failures=$((failures + 1))
        fi
        ;;
    esac
    case "$kind" in
      special|curl-installer)
        bin="$(binary_of_tool "$tool")"
        if [ -z "$bin" ]; then
          error "Catalog entry '$tool' has no version-detection binary"
          failures=$((failures + 1))
        fi
        ;;
    esac
  done
  [ "$failures" -eq 0 ]
}

