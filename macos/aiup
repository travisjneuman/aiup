tui_session_create() {
  local nonce token session_id staging final saved_expand saved_query saved_category saved_selected
  local runtime now snapshot
  ensure_dir "$TUI_SESSIONS_ROOT"
  [ -d "$TUI_SESSIONS_ROOT" ] && [ ! -L "$TUI_SESSIONS_ROOT" ] || return 1
  chmod 700 "$TUI_SESSIONS_ROOT" 2>/dev/null || true
  tui_stale_sessions_cleanup
  nonce="$(python3 -c 'import secrets; print(secrets.token_hex(8))')"
  token="$(python3 -c 'import secrets; print(secrets.token_hex(24))')"
