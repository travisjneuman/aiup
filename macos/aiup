    data = path.read_bytes(); combined.update(len(data).to_bytes(8, "big")); combined.update(data)
rows = [
    ("marker", "aiup-tui-session-v1"), ("schema", schema),
    ("runtime_version", runtime_version), ("runtime_hash", digest(runtime)),
    ("manifest_version", manifest_version), ("manifest_hash", digest(manifest)),
    ("snapshot_generation", snapshot), ("owner_pid", owner_pid), ("nonce", nonce), ("created", created),
    ("view", view), ("category_filter", category_filter), ("sort", sort_mode),
    ("catalog_hash", digest(root / "catalog-index.tsv")), ("brew_hash", digest(root / "brew-index.tsv")),
    ("inventory_hash", digest(root / "inventory-index.tsv")), ("versions_hash", digest(root / "versions-index.tsv")),
    ("preview_hash", digest(root / "preview-local.tsv")), ("helper_hash", digest(root / "fast-helper.py")),
