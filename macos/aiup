# Read Homebrew's explicit app destinations once; receipts alone do not prove
# an app still exists. No receipt removal or implicit reinstall is performed.
brew_missing_apps_load() {
  [ "${AIUP_MISSING_APPS_READY:-0}" -eq 0 ] || return 0
