scan_versions_index() {
  local next tool state installed fixture_versions brew_formula_versions brew_cask_versions
  if capture_fixture_enabled; then
    fixture_versions="${VERSIONS_INDEX}.fixture.$$"
    awk -F '\t' 'NF >= 2 {print $1 "\t" $2}' "$AIUP_CAPTURE_FIXTURE_DIR/versions.tsv" > "$fixture_versions"
    if ! cmp -s "$fixture_versions" "$VERSIONS_INDEX"; then
      mv "$fixture_versions" "$VERSIONS_INDEX"
      AIUP_VERSIONS_REBUILT=1
    else
      rm -f "$fixture_versions"
    fi
    profile_mark "installed-version snapshot"
    return 0
  fi
  [ -f "$VERSIONS_INDEX" ] || : > "$VERSIONS_INDEX"
  next="${VERSIONS_INDEX}.local.$$"
  cp "$VERSIONS_INDEX" "$next" 2>/dev/null || : > "$next"
  while IFS=$'\t' read -r _ state tool; do
    case "$state" in installed|on-disk) ;; *) continue ;; esac
    installed="$(awk -F '\t' -v id="$tool" '$1==id {print $2; exit}' "$next")"
    [ -n "$installed" ] && continue
    installed="$(version_of_tool "$tool" || true)"
    [ -n "$installed" ] || installed='unknown'
    printf '%s\t%s\n' "$tool" "$installed" >> "$next"
    AIUP_VERSIONS_REBUILT=1
  done < "$CATALOG_INDEX"
  if command_exists brew && [ -s "$BREW_INDEX" ]; then
    brew_formula_versions="${VERSIONS_INDEX}.brew-formula.$$"
    brew_cask_versions="${VERSIONS_INDEX}.brew-cask.$$"
    env HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew list --formula --versions > "$brew_formula_versions" 2>/dev/null || : > "$brew_formula_versions"
    env HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew list --cask --versions > "$brew_cask_versions" 2>/dev/null || : > "$brew_cask_versions"
    awk -F '\t' -v formulae="$brew_formula_versions" -v casks="$brew_cask_versions" -v existing="$next" '
      BEGIN {
        while ((getline line < existing) > 0) { split(line, e, "\t"); if (e[1]) seen[e[1]]=1 }
        close(existing)
        while ((getline line < formulae) > 0) { split(line, f, /[[:space:]]+/); if (f[1] && f[2]) versions["bf:" f[1]]=f[2] }
        while ((getline line < casks) > 0) { split(line, f, /[[:space:]]+/); if (f[1] && f[2]) versions["bc:" f[1]]=f[2] }
        close(formulae); close(casks)
      }
      ($2 == "installed") && !seen[$3] && versions[$3] { print $3 "\t" versions[$3] }
    ' "$BREW_INDEX" >> "$next"
    rm -f "$brew_formula_versions" "$brew_cask_versions"
  fi
  mv "$next" "$VERSIONS_INDEX"
  profile_mark "installed-version snapshot"
}

tui_preview_static_render() {
  manual_media_load
  local policies
  policies="$(preferences reasons)" || return 1
  local fixture_apps="${AIUP_CAPTURE_FIXTURE_DIR:-}/apps.tsv"
  [ -f "$fixture_apps" ] || fixture_apps=/dev/null
  python3 - "$CATALOG_MANIFEST" "$CATALOG_INDEX" "$BREW_INDEX" "$INVENTORY_INDEX" "$VERSIONS_INDEX" "$1" "$2" "$3" "$fixture_apps" "$policies" "$MANUAL_MEDIA_ROWS" "$(path_insights "$INVENTORY_INDEX")" <<'PY'
import csv, pathlib, sys
from urllib.parse import quote_plus
manifest_path, state_path, brew_path, inventory_path, versions_path, output_path, remote_path, docs_path, apps_path = map(pathlib.Path, sys.argv[1:10])
policies=dict(line.split("\t",1) for line in sys.argv[10].splitlines() if "\t" in line)
manual={r[0]:r for r in csv.reader(sys.argv[11].splitlines(),delimiter="\t") if len(r)==7}
path_info={r[0]:r for r in csv.reader(sys.argv[12].splitlines(),delimiter="\t") if len(r)==7}
states = {}
with state_path.open(encoding="utf-8") as handle:
    for row in csv.reader(handle, delimiter="\t"):
        if len(row) >= 3:
            states[row[2]] = row[1]
rows = []
with manifest_path.open(encoding="utf-8") as handle:
    for row in csv.reader((line for line in handle if not line.startswith("#")), delimiter="\t"):
        if len(row) >= 6:
            row += [""] * (8 - len(row))
            rows.append(row[:8])
by_id = {row[0]: row for row in rows}
versions = {}
with versions_path.open(encoding="utf-8") as handle:
    for row in csv.reader(handle, delimiter="\t"):
        if len(row) >= 2:
            versions[row[0]] = row[1]
def direct_deps(item_id, kind):
    if item_id == "npm": return ["brew"]
    if item_id in ("brew", "uv"): return []
    if kind == "aiup-npm": return ["npm"]
    if kind in ("brew-formula", "brew-cask"): return ["brew"]
    if kind == "uv-tool": return ["uv"]
    if kind == "special" and item_id in {"pi", "kilo", "gsd2", "gemini", "copilot", "qwen", "codex"}: return ["npm"]
    return []
def closure(item_id):
    result = []
    def visit(current):
        row = by_id.get(current)
        for dep in direct_deps(current, row[2] if row else ""):
            visit(dep)
            if dep not in result: result.append(dep)
    visit(item_id)
    return result
notes = {
    "mods": "Charm archived the mods repository. Still installable via Homebrew.",
    "openhands": "The official OpenHands CLI repository says this CLI is no longer actively maintained and points users toward Agent Canvas.",
    "gpt4all": "The official repository has not published a release since February 2025; Homebrew still provides the vendor installer cask.",
}
preview = {}
remote = []
docs_rows = []
fixture_apps = {}
with apps_path.open(encoding="utf-8") as handle:
    for row in csv.reader(handle, delimiter="\t"):
        if len(row) >= 2: fixture_apps[row[0]] = row[1]
def add(item_id, *lines):
    preview[item_id] = [str(line).replace("\t", " ").replace("\n", " ") for line in lines if line != ""]
for item_id, category, kind, lifecycle, label, docs, target, endpoint in rows:
    state = states.get(item_id, "absent")
    if state == "installed": action = "update" if lifecycle == "active" else lifecycle
    elif state == "on-disk": action = "switch to Homebrew"
    elif state == "absent": action = "install"
    else: action = "inspect"
    doc_label = "GitHub " if docs.startswith("https://github.com/") else "website "
    lines = [f"{item_id} · {category} · {state} · {lifecycle}", label, notes.get(item_id, ""), f"{doc_label} {docs}"]
    current = versions.get(item_id, "")
    if state in {"installed", "on-disk"}:
        lines.append(f"installed {current or 'unknown'}")
        remote.append((item_id, current or "unknown"))
    if item_id in policies: action="skipped"; lines.append("preference " + policies[item_id])
    lines.append(f"action   {action}")
    for dep in closure(item_id):
        dep_state = "ready" if states.get(dep) in {"installed", "on-disk"} else "missing"
        lines.append(f"needs    {dep} [{dep_state}]")
    lines.append("keys     enter act · ctrl-r update · ctrl-d remove · ctrl-o docs · ctrl-/ hide")
    add(item_id, *lines)
    docs_rows.append((item_id, docs))
with brew_path.open(encoding="utf-8") as handle:
    for row in csv.reader(handle, delimiter="\t"):
        if len(row) < 4: continue
        category, state, item_id, label = row[:4]
        found_path = row[4] if len(row) > 4 else ""
        kind = "cask" if item_id.startswith("bc:") else "formula"
        name = item_id[3:]
        if not found_path and kind == "cask": found_path = fixture_apps.get(name, "")
        action = "update" if state == "installed" else "switch to Homebrew" if state == "on-disk" else "install"
        lines = [f"{item_id} · {category} · {state}", label, f"action   {action}"]
        current = versions.get(item_id, "")
        if state == "installed":
            lines.insert(2, f"installed {current or 'unknown'}")
            remote.append((item_id, current or "unknown"))
        if state == "on-disk":
            if found_path: lines.append(f"found    {found_path}")
            lines.append("safety   Homebrew adoption; aiup passes no --zap and does not directly delete ~/Library")
        lines += [f"website  https://formulae.brew.sh/{kind}/{name}", "needs    brew [ready]", "keys     enter act · ctrl-r update · ctrl-d remove · ctrl-o docs · ctrl-/ hide"]
        add(item_id, *lines)
        docs_rows.append((item_id, f"https://formulae.brew.sh/{kind}/{name}"))
with inventory_path.open(encoding="utf-8") as handle:
    for row in csv.reader(handle, delimiter="\t"):
        if len(row) < 7: continue
        category, state, item_id, label, version, source, item_path = row[:7]
        name = label.split("] ", 1)[-1] if "] " in label else label
        add(item_id, f"{item_id} · updates handled elsewhere", f"item     {name} · {version or 'unknown'}",
            "action   View details; use the owning app or package manager to update", f"found via {source}", f"location {item_path}",
            "keys     ctrl-o guidance · ctrl-y copy URL · ctrl-/ hide")
        query = f"{name} {version or 'unknown'} {source} {item_path}"
        if item_id in manual:
            m=manual[item_id]
            preview[item_id] += ["coverage manual update · media · "+m[4], "next     "+m[5], "docs     "+m[6]]
        if item_id in path_info:
            m=path_info[item_id]
            preview[item_id] += ["owner    "+m[2], "about    "+m[3], "next     "+m[4], "docs     "+m[5], "resolves "+m[6]]
        docs_rows.append((item_id, path_info[item_id][5] if item_id in path_info and path_info[item_id][5] else manual[item_id][6] if item_id in manual else "https://www.google.com/search?q=" + quote_plus(query)))
with output_path.open("w", encoding="utf-8", newline="") as handle:
    writer = csv.writer(handle, delimiter="\t", lineterminator="\n")
    for item_id, lines in preview.items():
        for number, line in enumerate(lines): writer.writerow([item_id, number, line])
with remote_path.open("w", encoding="utf-8", newline="") as handle:
    csv.writer(handle, delimiter="\t", lineterminator="\n").writerows(remote)
with docs_path.open("w", encoding="utf-8", newline="") as handle:
    csv.writer(handle, delimiter="\t", lineterminator="\n").writerows(docs_rows)
PY
}

tui_fast_helper_render() {
