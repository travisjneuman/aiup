update_npm() {
  if ! command_exists brew; then
    error "Homebrew is required to manage Node/npm"
    return 1
  fi
  brew_update_once || return 1
  if ! brew_formula_installed node; then
    info "Installing Homebrew formula node (provides npm)"
    brew_ensure_target_tap npm node formula || return 1
    run_with_heartbeat "brew install node" env HOMEBREW_NO_ENV_HINTS=1 brew install --yes node || return 1
    brew_cache_invalidate
    hash_refresh
    set_state_method npm homebrew-node
    return 0
  fi

  info "npm is managed by Homebrew's node formula"
  info "Current node: $(node --version 2>/dev/null || printf 'unknown') at $(command_path node)"
  info "Current npm: $(npm --version 2>/dev/null || printf 'unknown') at $(command_path npm)"
  info "Current npm prefix: $(npm config get prefix 2>/dev/null || printf 'unknown')"
  info "Homebrew node stable: $(brew_node_stable_version)"
  brew_ensure_target_tap npm node formula || return 1

  if ! run_with_heartbeat "brew upgrade node" env HOMEBREW_NO_ENV_HINTS=1 brew upgrade --yes node; then
    if command_exists node && command_exists npm && ! brew_node_outdated; then
      warn "brew upgrade node exited nonzero, but Homebrew reports node is current and node/npm are available"
    else
      return 1
    fi
  fi

  [ "$DRY_RUN" -eq 1 ] && return 0
  hash_refresh
  info "Updated node: $(node --version 2>/dev/null || printf 'unknown') at $(command_path node)"
  info "Updated npm: $(npm --version 2>/dev/null || printf 'unknown') at $(command_path npm)"
  info "Updated npx: $(command_path npx)"
  info "Updated npm prefix: $(npm config get prefix 2>/dev/null || printf 'unknown')"
  set_state_method npm homebrew-node
}

