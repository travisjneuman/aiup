# Switch an existing .app to Homebrew without asking Homebrew to zap data.
# aiup does not pass --zap or directly delete ~/Library in this path.
# 1) --adopt if the bundle matches what Homebrew would install
# 2) otherwise replace the .app only (--force), after confirm
brew_cask_adopt() {
  local name="$1"
  local app="${2:-}"
  command_exists brew || { error "Homebrew required"; return 1; }
  brew_ensure_target_tap "" "$name" cask || return 1
  if brew_cask_installed "$name"; then
    run_with_heartbeat "brew upgrade --cask $name" env HOMEBREW_NO_ENV_HINTS=1 brew upgrade --cask --yes "$name"
    return $?
  fi
  info "Letting Homebrew manage $name. aiup will not pass --zap or directly delete ~/Library."
  warn "Homebrew and vendor-specific installer behavior may vary."
  if [ -n "$app" ]; then
    info "Current app: $app"
  fi
  if [ "${AIUP_KEEP_UI:-0}" = 1 ] || tty_usable; then
    if ! confirm_tty "Switch $name to Homebrew without requesting a data zap? [y/N] "; then
      info "Left $name as-is (still not Homebrew-managed)"
      return 0
    fi
  fi
  if run_with_heartbeat "brew install --cask --adopt $name" env HOMEBREW_NO_ENV_HINTS=1 brew install --cask --adopt --yes "$name"; then
    info "Homebrew now manages $name. aiup did not request a data zap."
    return 0
  fi
  warn "Homebrew could not adopt the existing copy (usually a version mismatch)."
  warn "Next step asks Homebrew to replace the app bundle without --zap; vendor-specific installer behavior may vary."
  if [ "${AIUP_KEEP_UI:-0}" = 1 ] || tty_usable; then
    if ! confirm_tty "Replace the $name app bundle via Homebrew without --zap? [y/N] "; then
      info "Cancelled. $name is unchanged."
      return 0
    fi
  fi
  run_with_heartbeat "brew install --cask --force $name" env HOMEBREW_NO_ENV_HINTS=1 brew install --cask --force --yes "$name" || return 1
  info "Homebrew now manages $name. aiup did not request a data zap."
}

# Install a formula next to whatever is already on PATH. Never uninstall
# Apple's /usr/bin copy or a non-Homebrew binary.
brew_formula_install_alongside() {
  local name="$1"
  command_exists brew || { error "Homebrew required"; return 1; }
  brew_ensure_target_tap "" "$name" formula || return 1
  if brew_formula_installed "$name"; then
    run_with_heartbeat "brew upgrade $name" env HOMEBREW_NO_ENV_HINTS=1 brew upgrade --yes "$name"
    return $?
  fi
  if formula_present_outside_brew "$name"; then
    info "$name is already on PATH outside Homebrew. Installing the Homebrew copy alongside it."
    info "The existing command is not uninstalled or modified."
    if [ "${AIUP_KEEP_UI:-0}" = 1 ] || tty_usable; then
      if ! confirm_tty "Install Homebrew $name alongside the copy already on PATH? [y/N] "; then
        info "Left $name as-is"
        return 0
      fi
    fi
  fi
  run_with_heartbeat "brew install $name" env HOMEBREW_NO_ENV_HINTS=1 brew install --yes "$name"
}

apply_brew_extras() {
  local action="$1"
  shift
  local id name app
  command_exists brew || { error "Homebrew required"; return 1; }
  for id in "$@"; do
    case "$id" in
      bc:*)
        name="${id#bc:}"
        case "$action" in
          remove)
            if brew_cask_installed "$name"; then
              run_with_heartbeat "brew uninstall --cask $name" env HOMEBREW_NO_ENV_HINTS=1 brew uninstall --cask "$name" || true
            else
              app="$(app_path_for_cask "$name" || true)"
              warn "$name is not Homebrew-managed. aiup will not delete ${app:-the app}. Remove it in Finder if you want it gone."
            fi
            ;;
          update)
            if brew_cask_installed "$name"; then
              brew_ensure_target_tap "" "$name" cask || return 1
              run_with_heartbeat "brew upgrade --cask $name" env HOMEBREW_NO_ENV_HINTS=1 brew upgrade --cask --yes "$name" || true
            else
              warn "$name is on your Mac outside Homebrew; skip brew upgrade. Press enter to switch it to Homebrew without --zap."
            fi
            ;;
          *)
            if brew_cask_installed "$name"; then
              run_with_heartbeat "brew upgrade --cask $name" env HOMEBREW_NO_ENV_HINTS=1 brew upgrade --cask --yes "$name" || true
            elif app="$(app_path_for_cask "$name")"; then
              brew_cask_adopt "$name" "$app" || true
            else
              run_with_heartbeat "brew install --cask $name" env HOMEBREW_NO_ENV_HINTS=1 brew install --cask --yes "$name" || true
            fi
            ;;
        esac
        ;;
      bf:*)
        name="${id#bf:}"
        case "$action" in
          remove)
            if brew_formula_installed "$name"; then
              run_with_heartbeat "brew uninstall $name" env HOMEBREW_NO_ENV_HINTS=1 brew uninstall "$name" || true
            else
              warn "$name is not a Homebrew formula on your Mac; aiup will not delete the existing command"
            fi
            ;;
          update)
            if brew_formula_installed "$name"; then
              brew_ensure_target_tap "" "$name" formula || return 1
              run_with_heartbeat "brew upgrade $name" env HOMEBREW_NO_ENV_HINTS=1 brew upgrade --yes "$name" || true
            else
              warn "$name is on PATH outside Homebrew; skip brew upgrade. Press enter to install a Homebrew copy alongside it."
            fi
            ;;
          *)
            brew_formula_install_alongside "$name" || true
            ;;
        esac
        ;;
    esac
  done
  brew_cache_invalidate
  scan_brew_index
}

open_url() {
  local url="$1"
  if command_exists open; then
    open "$url"
  elif command_exists xdg-open; then
    xdg-open "$url" >/dev/null 2>&1 &
  elif command_exists wslview; then
    wslview "$url"
  else
    error "No browser opener found (open / xdg-open / wslview). URL: $url"
    return 1
  fi
}

cmd_docs() {
  local print_only=0
  local tool=""
  local arg
  for arg in "$@"; do
    case "$arg" in
      --print|-p) print_only=1 ;;
      *) tool="$arg" ;;
    esac
  done
  if [ -z "$tool" ]; then
    error "usage: aiup docs [--print] <tool>"
    return 1
  fi
  local resolved url
  case "$tool" in
    __cat:*) return 0 ;;
    di:*)
      url="$(detected_search_url "$tool")"
      if [ "$print_only" -eq 1 ]; then printf '%s\n' "$url"; return 0; fi
      printf 'Opened Google search: %s\n' "$url" >/dev/tty
      open_url "$url"
      return 0
      ;;
    bc:*)
      url="https://formulae.brew.sh/cask/${tool#bc:}"
      if [ "$print_only" -eq 1 ]; then printf '%s\n' "$url"; return 0; fi
      printf 'Opened website: %s\n' "$url" >/dev/tty
      open_url "$url"
      return 0
      ;;
    bf:*)
      url="https://formulae.brew.sh/formula/${tool#bf:}"
      if [ "$print_only" -eq 1 ]; then printf '%s\n' "$url"; return 0; fi
      printf 'Opened website: %s\n' "$url" >/dev/tty
      open_url "$url"
      return 0
      ;;
  esac
  resolved="$(resolve_tools "$tool")" || return 1
  tool="$(printf '%s\n' "$resolved" | first_line)"
  url="$(catalog_docs_url "$tool")"
  if [ -z "$url" ]; then
    error "No docs URL for $tool"
    return 1
  fi
  if [ "$print_only" -eq 1 ]; then
    printf '%s\n' "$url"
    return 0
  fi
  printf 'Opened %s: %s\n' "$(catalog_docs_kind "$tool")" "$url" >/dev/tty
  open_url "$url"
}

