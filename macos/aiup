tool_is_present() {
  local tool="$1"
  local bin cmd expected
  bin="$(binary_of_tool "$tool")"
  cmd="$(command_path "$bin")"
  if [ -n "$cmd" ] && [ -e "$cmd" ]; then
    return 0
  fi
  expected="$(expected_direct_path "$tool")"
  if [ -n "$expected" ] && [ -x "$expected" ]; then
    return 0
  fi
  case "$tool" in
    brew) { command_exists brew || [ -x /opt/homebrew/bin/brew ] || [ -x /usr/local/bin/brew ]; } && return 0 ;;
    npm) command_exists npm && return 0 ;;
    grok) [ -x "$HOME/.grok/bin/grok" ] && return 0 ;;
    warp) [ -x "$HOME/.warp/tui/current/warp-tui-stable" ] && return 0 ;;
    copilot)
      { aiup_npm_pkg_installed @github/copilot || system_npm_pkg_installed @github/copilot; } && return 0
      ;;
    qwen)
      { aiup_npm_pkg_installed @qwen-code/qwen-code || system_npm_pkg_installed @qwen-code/qwen-code; } && return 0
      ;;
    cursor)
      { command_exists cursor-agent || [ -x "$LOCAL_BIN/cursor-agent" ]; } && return 0
      ;;
    gemini)
      { aiup_npm_pkg_installed @google/gemini-cli || system_npm_pkg_installed @google/gemini-cli; } && return 0
      ;;
    kilo)
      aiup_npm_pkg_installed @kilocode/cli && return 0
      system_npm_pkg_installed @kilocode/cli && return 0
      ;;
    gsd2)
      { aiup_npm_pkg_installed @opengsd/gsd-pi || aiup_npm_pkg_installed gsd-pi; } && return 0
      ;;
    pi)
      { aiup_npm_pkg_installed @earendil-works/pi-coding-agent || aiup_npm_pkg_installed @mariozechner/pi-coding-agent; } && return 0
      ;;
    codex)
      aiup_npm_pkg_installed @openai/codex && return 0
      ;;
  esac
  local pkg formula cask app
  pkg="$(catalog_npm_pkg "$tool")"
  [ -n "$pkg" ] && aiup_npm_pkg_installed "$pkg" && return 0
  [ -n "$pkg" ] && system_npm_pkg_installed "$pkg" && return 0
  formula="$(catalog_brew_formula "$tool")"
  [ -n "$formula" ] && brew_formula_installed "$formula" && return 0
  cask="$(catalog_brew_cask "$tool")"
  [ -n "$cask" ] && brew_cask_installed "$cask" && return 0
  app="$(catalog_app_path "$tool")"
  [ -n "$app" ] && [ -d "$app" ] && return 0
  return 1
}
inventory_index_init() {
  [ "${INVENTORY_INDEX_READY:-0}" -eq 1 ] && return 0
  catalog_manifest_load || return 1
  local tool binary app
  for tool in "${TOOLS_CATALOG[@]}"; do
    binary="$(binary_of_tool "$tool")"
    [ -n "$binary" ] && INVENTORY_MANAGED_BINARIES="${INVENTORY_MANAGED_BINARIES}${binary}|"
    app="$(catalog_app_path "$tool")"
    [ -n "$app" ] && INVENTORY_MANAGED_APPS="${INVENTORY_MANAGED_APPS}${app}|"
  done
  for tool in "${HOMEBREW_RECOMMENDED_CASKS[@]}"; do
    app="$(app_path_for_cask "$tool" 2>/dev/null || true)"
    [ -n "$app" ] && INVENTORY_MANAGED_APPS="${INVENTORY_MANAGED_APPS}${app}|"
  done
  INVENTORY_INDEX_READY=1
}

inventory_append() {
  local category="$1"
  local source="$2"
  local id="$3"
  local label="$4"
  local version="$5"
  local path="$6"
  inventory_index_init || return 1
  [ -n "$id" ] || return 0
  label="$(printf '%s' "$label" | tr '\t\r\n' '   ')"
  version="$(printf '%s' "$version" | tr '\t\r\n' '   ')"
  source="$(printf '%s' "$source" | tr '\t\r\n' '   ')"
  path="$(printf '%s' "$path" | tr '\t\r\n' '   ')"
  case "$INVENTORY_SEEN_IDS" in *"|$id|"*) return 0 ;; esac
  INVENTORY_SEEN_IDS="${INVENTORY_SEEN_IDS}${id}|"
  printf '%s\tdetected\t%s\t%s\t%s\t%s\t%s\n' "$category" "$id" "$label" "$version" "$source" "$path" >> "$INVENTORY_INDEX"
}

inventory_managed_binary() {
  local binary="$1"
  inventory_index_init || return 1
  case "$INVENTORY_MANAGED_BINARIES" in *"|$binary|"*) return 0 ;; esac
  return 1
}

inventory_managed_app() {
  local app="$1"
  inventory_index_init || return 1
  case "$INVENTORY_MANAGED_APPS" in *"|$app|"*) return 0 ;; esac
  return 1
}

inventory_plist_value() {
  local key="$1"
  local plist="$2"
  if command_exists plutil; then
    plutil -extract "$key" raw -o - "$plist" 2>/dev/null && return 0
  fi
  if [ -x /usr/libexec/PlistBuddy ]; then
    /usr/libexec/PlistBuddy -c "Print :$key" "$plist" 2>/dev/null | first_line && return 0
  fi
  return 1
}

inventory_scan_apps() {
  local root app plist bundle_id name version label id
  for root in /Applications "$HOME/Applications"; do
    [ -d "$root" ] || continue
    for app in "$root"/*.app; do
      [ -d "$app" ] || continue
      inventory_managed_app "$app" && continue
      plist="$app/Contents/Info.plist"
      [ -f "$plist" ] || continue
      bundle_id="$(inventory_plist_value CFBundleIdentifier "$plist" || true)"
      name="$(inventory_plist_value CFBundleDisplayName "$plist" || inventory_plist_value CFBundleName "$plist" || true)"
      version="$(inventory_plist_value CFBundleShortVersionString "$plist" || inventory_plist_value CFBundleVersion "$plist" || printf 'unknown')"
      [ -n "$name" ] || name="$(basename "$app" .app)"
      [ -n "$bundle_id" ] || bundle_id="name:$(basename "$app" .app | tr ' ' '-')"
      id="di:app:$bundle_id"
      label="[app] $name"
      inventory_append detected "app bundle" "$id" "$label" "$version" "$app"
    done
  done
}

inventory_scan_npm() {
  local prefix package_rows source suffix
  local -a prefixes=()
  [ -d "$AIUP_NPM_NODE_MODULES" ] && prefixes+=("$AIUP_NPM_PREFIX")
  if [ -n "${SYSTEM_NPM_PREFIX:-}" ] && [ "$SYSTEM_NPM_PREFIX" != "$AIUP_NPM_PREFIX" ] && [ -d "$SYSTEM_NPM_PREFIX/lib/node_modules" ]; then
    prefixes+=("$SYSTEM_NPM_PREFIX")
  fi
  for prefix in "${prefixes[@]}"; do
    package_rows="$(npm --prefix "$prefix" list --global --depth=0 --json 2>/dev/null | python3 -c 'import json,sys
try:
    data=json.load(sys.stdin)
except Exception:
    raise SystemExit(0)
for name, meta in sorted((data.get("dependencies") or {}).items()):
    print(name + "\t" + str((meta or {}).get("version") or "unknown"))' 2>/dev/null || true)"
    case "$prefix" in
      "$AIUP_NPM_PREFIX") source='npm (aiup)' ; suffix=aiup ;;
      *) source='npm (system)' ; suffix=system ;;
    esac
    while IFS=$'\t' read -r package version; do
      [ -n "$package" ] || continue
      inventory_append detected npm "di:npm:$package:$suffix" "[npm] $package" "${version:-unknown}" "$prefix"
    done <<< "$package_rows"
  done
}

inventory_scan_uv() {
  local row package version tool_dir
  command_exists uv || return 0
  tool_dir="$(uv tool dir 2>/dev/null || printf 'uv tool directory unavailable')"
  while IFS= read -r row; do
    case "$row" in
      *' v'*)
        package="${row%% v*}"
        version="${row#* v}"
        [ -n "$package" ] || continue
        inventory_append detected "uv tool" "di:uv:$package" "[uv] $package" "${version%% *}" "$tool_dir"
        ;;
    esac
  done < <(uv tool list 2>/dev/null || true)
}

inventory_scan_path_bins() {
  local dir path binary seen_dirs='|'
  local -a path_dirs=()
  local old_ifs="$IFS"
  IFS=:
  read -r -a path_dirs <<< "$PATH"
  IFS="$old_ifs"
  for dir in "$LOCAL_BIN" "$AIUP_NPM_BIN" "$HOME/.cargo/bin" "$HOME/.grok/bin" /usr/local/bin "${path_dirs[@]}"; do
    [ -d "$dir" ] || continue
    case "$seen_dirs" in *"|$dir|"*) continue ;; esac
    seen_dirs="${seen_dirs}$dir|"
    case "$dir" in
      /bin|/sbin|/usr/bin|/usr/sbin|/System/*|/Library/*|/opt/homebrew/*) continue ;;
    esac
    for path in "$dir"/*; do
      [ -f "$path" ] && [ -x "$path" ] || continue
      binary="$(basename "$path")"
      inventory_managed_binary "$binary" && continue
      inventory_append detected "PATH executable" "di:path:$binary" "[path] $binary" unknown "$path"
    done
  done
}

scan_inventory_index() {
  local final_index="$INVENTORY_INDEX"
  local temp_index="${INVENTORY_INDEX}.tmp.$$"
  if capture_fixture_enabled; then
    ensure_dir "$STATE_DIR"
    capture_fixture_copy inventory-index.tsv "$final_index"
    return 0
  fi
  if inventory_cache_valid; then
    return 0
  fi
  ensure_dir "$STATE_DIR"
  : > "$temp_index"
  INVENTORY_INDEX="$temp_index"
  INVENTORY_SEEN_IDS='|'
  catalog_manifest_load || {
    rm -f "$temp_index"
    INVENTORY_INDEX="$final_index"
    return 1
  }
  inventory_scan_apps
  inventory_scan_npm
  inventory_scan_uv
  inventory_scan_path_bins
  mv "$temp_index" "$final_index" || {
    rm -f "$temp_index"
    INVENTORY_INDEX="$final_index"
    return 1
  }
  INVENTORY_INDEX="$final_index"
  inventory_cache_write || true
}

inventory_stat_mtime() {
  local path="$1"
  [ -e "$path" ] || { printf 'missing\n'; return 0; }
  stat -f '%m' "$path" 2>/dev/null || stat -c '%Y' "$path" 2>/dev/null || printf 'unknown\n'
}

inventory_source_fingerprint() {
  local npm_root uv_root
  npm_root="$(npm root -g 2>/dev/null || true)"
  uv_root="$(uv tool dir 2>/dev/null || true)"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$PATH" \
    "$(inventory_stat_mtime /Applications)" \
    "$(inventory_stat_mtime "$HOME/Applications")" \
    "$(inventory_stat_mtime "$AIUP_NPM_NODE_MODULES")" \
    "$(inventory_stat_mtime "$SYSTEM_NPM_PREFIX/lib/node_modules")" \
    "$(inventory_stat_mtime "${uv_root:-$HOME/.local/share/uv/tools}")" \
    "$(command_path npm)" \
    "$(command_path uv)"
}

inventory_cache_valid() {
  local cached_at cached_key now age current_key
  [ "$INVENTORY_REFRESH" -eq 0 ] || return 1
  [ -s "$INVENTORY_CACHE_META" ] || return 1
  [ -f "$INVENTORY_INDEX" ] || return 1
  IFS=$'\t' read -r cached_at cached_key < "$INVENTORY_CACHE_META" || return 1
  case "$cached_at" in ''|*[!0-9]*) return 1 ;; esac
  now="$(date +%s)"
  age=$((now - cached_at))
  [ "$age" -ge 0 ] && [ "$age" -lt "$INVENTORY_CACHE_TTL" ] || return 1
  current_key="$(inventory_source_fingerprint)"
  [ "$cached_key" = "$current_key" ]
}

inventory_cache_write() {
  local temp_meta="${INVENTORY_CACHE_META}.tmp.$$"
  ensure_dir "$STATE_DIR"
  printf '%s\t%s\n' "$(date +%s)" "$(inventory_source_fingerprint)" > "$temp_meta" || return 1
  mv "$temp_meta" "$INVENTORY_CACHE_META"
}

inventory_record() {
  local id="$1"
  [ -f "$INVENTORY_INDEX" ] || return 1
  awk -F '\t' -v id="$id" '$3==id {print; exit}' "$INVENTORY_INDEX"
}

