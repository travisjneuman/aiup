  AIUP_TUI_SESSION_TOKEN="$token"
  export AIUP_TUI_SESSION_DIR AIUP_TUI_SESSION_TOKEN
  tui_session_activate || return 1
  trap 'restore_tty; tui_session_cleanup' EXIT
  trap 'restore_tty; tui_session_cleanup; exit 130' HUP INT TERM
  profile_mark "row generation"
}

