require_runtime_environment() {
  local macos_version macos_major
  [ "$(uname -s 2>/dev/null || true)" = 'Darwin' ] || {
    error "aiup currently supports macOS only"
    return 1
  }
  [ "${BASH_VERSINFO[0]:-0}" -ge 3 ] || {
    error "aiup requires Bash 3 or newer"
    return 1
  }
  command_exists python3 || {
    error "python3 is required; install a supported Python 3 before running aiup"
    return 1
  }
  command_exists curl || {
    error "curl is required for runtime and vendor refresh requests"
    return 1
  }
  command_exists sw_vers || {
    error "sw_vers is required to verify the macOS version"
    return 1
  }
  macos_version="$(sw_vers -productVersion 2>/dev/null || true)"
  macos_major="${macos_version%%.*}"
  case "$macos_major" in
    ''|*[!0-9]*) error "could not determine the macOS version"; return 1 ;;
  esac
  [ "$macos_major" -ge 14 ] || {
    error "aiup supports macOS 14 Sonoma or newer, matching Homebrew's supported installation baseline"
    return 1
  }
}

require_tool_macos_major() {
  local tool="$1"
  local minimum="$2"
  local current
  current="$(sw_vers -productVersion 2>/dev/null | cut -d. -f1)"
  case "$current" in
    ''|*[!0-9]*) error "could not determine the macOS version for $tool"; return 1 ;;
  esac
  [ "$current" -ge "$minimum" ] || {
    error "$tool requires macOS $minimum or newer according to its official support policy"
    return 1
  }
}

