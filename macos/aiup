status_of() {
  local tool="$1"
  local method preferred duplicates path_active persistent ver
  method="$(install_method_of "$tool")"
  preferred="$(preferred_method_of "$tool")"
  duplicates="$(duplicates_of "$tool")"
  path_active="$(current_path_active_of "$tool")"
  persistent="$(persistent_path_likely_of "$tool")"
  ver="$(version_of_tool "$tool")"

  if ! tool_is_present "$tool"; then
    printf 'ABSENT\n'
    return 0
  fi

  if [ "$ver" = 'not installed' ]; then
    printf 'BROKEN\n'
    return 0
  fi

  if [ "$(catalog_kind "$tool")" = 'app' ]; then
    if { [ "$method" = "$preferred" ] || [ "$method" = 'app' ]; } && [ -d "$(catalog_app_path "$tool")" ] && [ "$ver" != 'app present' ]; then
      printf 'GOOD\n'
    else
      printf 'WARN\n'
    fi
    return 0
  fi

  case "$tool" in
    fzf|npm|claude|codex|antigravity|gemini|opencode|kilo|gsd2|hermes|pi|grok|warp|copilot|aider|goose|cursor|qwen|crush|amp|kiro|droid|kimi|openclaw|cline|continue|pi-acp|uv|gh|wrangler|deno|llm|mods|aichat|fabric|sgpt|ollama|chatgpt|cursor-ide|zed|cmux|ollama-app)
      if [ "$method" = "$preferred" ] && [ "$duplicates" = 'no' ] && [ "$path_active" = 'yes' ] && [ "$persistent" != 'no' ]; then
        printf 'GOOD\n'
      elif [ "$method" = 'missing' ]; then
        printf 'BROKEN\n'
      elif expected_binary_exists "$tool" && [ "$path_active" = 'no' ]; then
        printf 'BROKEN\n'
      else
        printf 'WARN\n'
      fi
      ;;
    *) printf 'WARN\n' ;;
  esac
}

