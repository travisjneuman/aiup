print_list() {
  local cat child tool id state label n_inst n_abs extra_kind extra_name display_cat
  scan_catalog_index all
  for cat in "${CATEGORY_ORDER[@]}"; do
    category_visible "$cat" || continue
    if [ "$cat" = 'homebrew' ]; then
      n_inst="$(awk -F '\t' '$2=="installed" || $2=="on-disk" {n++} END {print n+0}' "$BREW_INDEX" 2>/dev/null)"
      [ "$LIST_VIEW_MODE" = 'installed' ] && [ "$n_inst" -eq 0 ] && continue
    elif [ "$cat" = 'detected' ]; then
      n_inst="$(visible_detected_count)"
      [ "$n_inst" -eq 0 ] && continue
    else
      n_inst="$(awk -F '\t' -v c="$cat" '$1==c && ($2=="installed" || $2=="on-disk") {n++} END {print n+0}' "$CATALOG_INDEX" 2>/dev/null)"
      n_abs="$(awk -F '\t' -v c="$cat" '$1==c && $2=="absent" {n++} END {print n+0}' "$CATALOG_INDEX" 2>/dev/null)"
      [ "$LIST_VIEW_MODE" = 'installed' ] && [ "$n_inst" -eq 0 ] && continue
      [ "$n_inst" -eq 0 ] && [ "$n_abs" -eq 0 ] && continue
    fi
    display_cat="$cat"
    [ "$cat" = 'detected' ] && display_cat='detected software'
    printf '\n== %s ==\n' "$display_cat"
    if [ "$cat" != 'detected' ]; then
      printf '%-18s %-18s %s\n' 'tool' 'state/action' 'label'
    fi
    if [ "$cat" = 'homebrew' ]; then
      printf '%s\n' "casks/fonts/formulae/libraries = Homebrew extras outside the managed catalog; available = non-managed items from local taps, loaded only when requested."
      printf '%s\n' "recommended = a short popular list, not all of Homebrew. on-disk = the same app/command installed some other way."
      for child in "${HOMEBREW_CHILD_ORDER[@]}"; do
        if [ "$LIST_VIEW_MODE" = 'available' ] && [ "$child" != 'available' ] && [ "$child" != 'fonts' ]; then
          continue
        fi
        if [ "$LIST_VIEW_MODE" = 'installed' ] && [ "$child" = 'available' ]; then
          continue
        fi
        printf '\n-- homebrew/%s --\n' "$child"
        if [ "$child" = 'fonts' ] && ! homebrew_available_loaded; then
          printf '%s\n' "Installed font casks are shown here. Full available font catalog loads with: aiup list --view available"
        fi
        if [ "$child" = 'available' ]; then
          if homebrew_available_loaded; then
            awk -F '\t' '$1=="homebrew/available" {printf "%-18s %-18s %s\n", $3, "install", $4}' "$BREW_INDEX"
          else
            printf '%s\n' "Full Homebrew formula/cask catalog not loaded in overview. Run: aiup list --view available"
          fi
          continue
        fi
        while IFS=$'\t' read -r _ state id label _found_path; do
          [ -n "$id" ] || continue
          row_visible_state "$state" || continue
          case "$id" in
            bc:*) extra_kind=cask; extra_name="${id#bc:}" ;;
            bf:*) extra_kind=formula; extra_name="${id#bf:}" ;;
            *) extra_kind=formula; extra_name="$id" ;;
          esac
          printf '%-18s %-18s %s\n' "$id" "$(brew_extra_action "$extra_kind" "$extra_name" "$state")" "$label"
        done < <(awk -F '\t' -v c="homebrew/${child}" '$1==c {print}' "$BREW_INDEX" | LC_ALL=C sort -t $'\t' -k2,2 -k3,3)
      done
      continue
    fi
    if [ "$cat" = 'detected' ]; then
      printf '%s\n' "Detected-only inventory · $(detected_source_summary)."
      printf '%s\n' "aiup will not change these without a verified updater/remover contract; use ctrl-o or aiup docs for a web search."
      printf '%-26s %-12s %-18s %s\n' 'item' 'version' 'found via' 'location'
      while IFS=$'\t' read -r _ state id label version source path; do
        [ -n "$id" ] || continue
        if manual_media_in_category && [ -n "$(manual_media_record "$id")" ]; then continue; fi
        printf '%-26s %-12s %-18s %s\n' "$(inventory_item_name "$label")" "${version:-unknown}" "$source" "$path"
      done < <(LC_ALL=C sort -t $'\t' -k4,4 -k3,3 "$INVENTORY_INDEX" 2>/dev/null)
      continue
    fi
    if [ "$cat" = media ]; then
      state="$(awk -F '\t' '$3=="remotion" {print $2; exit}' "$CATALOG_INDEX")"
      if [ -n "$state" ] && row_visible_state "$state"; then
        printf '%-18s %-18s %s\n' remotion "$(catalog_action_for_state remotion "$state")" "$(catalog_label remotion)"
      fi
    fi
    while IFS=$'\t' read -r _ state tool; do
      [ -n "$tool" ] || continue
      [ "$cat:$tool" != media:remotion ] || continue
      row_visible_state "$state" || continue
        printf '%-18s %-18s %s\n' "$tool" "$(catalog_action_for_state "$tool" "$state")" "$(catalog_label "$tool")"
    done < <(awk -F '\t' -v c="$cat" '$1==c && ($2=="installed" || $2=="on-disk") {print}' "$CATALOG_INDEX" | LC_ALL=C sort -t $'\t' -k3,3)
    while IFS= read -r tool; do
      [ -n "$tool" ] || continue
      [ "$cat:$tool" != media:remotion ] || continue
      row_visible_state absent || continue
      printf '%-18s %-18s %s\n' "$tool" 'install' "$(catalog_label "$tool")"
    done < <(awk -F '\t' -v c="$cat" '$1==c && $2=="absent" {print $3}' "$CATALOG_INDEX" | LC_ALL=C sort)
    [ "$cat" != media ] || emit_manual_media_rows plain
  done
}

print_inventory_definition() {
  local mode="${1:---json}"
  scan_inventory_index || return 1
  if [ "$mode" = '--plain' ] || [ "$mode" = 'plain' ]; then
    printf '%-26s %-12s %-18s %s\n' 'item' 'version' 'found via' 'location'
    while IFS=$'\t' read -r _ state id label version source path; do
      [ -n "$id" ] || continue
      printf '%-26s %-12s %-18s %s\n' "$(inventory_item_name "$label")" "${version:-unknown}" "$source" "$path"
    done < <(LC_ALL=C sort -t $'\t' -k4,4 -k3,3 "$INVENTORY_INDEX" 2>/dev/null)
    return 0
  fi
  manual_media_load
  python3 - "$INVENTORY_INDEX" "$MANUAL_MEDIA_ROWS" "$(path_insights "$INVENTORY_INDEX")" <<'PY'
import json, sys, csv
from urllib.parse import quote_plus
items = []
manual={r[0]:r for r in csv.reader(sys.argv[2].splitlines(),delimiter="\t") if len(r)==7}
path_info={r[0]:r for r in csv.reader(sys.argv[3].splitlines(),delimiter="\t") if len(r)==7}
with open(sys.argv[1], encoding="utf-8") as handle:
    for line in handle:
        parts = line.rstrip("\n").split("\t")
        if len(parts) < 7:
            continue
        category, state, item_id, label, version, source, path = parts[:7]
        name = label.split("] ", 1)[-1] if "] " in label else label
        version = version or "unknown"
        if source == "app bundle":
            query = f"{name} {version} macOS app"
        elif source.startswith("npm "):
            query = f"{name} npm package {version}"
        elif source == "uv tool":
            query = f"{name} uv tool {version}"
        elif source == "PATH executable":
            query = f"{name} macOS command {version}"
        else:
            query = f"{name} {version} {source} {path}"
        items.append({
            "category": category,
            "state": state,
            "id": item_id,
            "label": label,
            "version": version,
            "source": source,
            "path": path,
            "search": "https://www.google.com/search?q=" + quote_plus(query),
            "management": "manual" if item_id in manual else "detected-only",
            "category_hint": "media" if item_id in manual else None,
            "update_guidance": path_info[item_id][4] if item_id in path_info else manual[item_id][5] if item_id in manual else None,
            "docs": path_info[item_id][5] if item_id in path_info else manual[item_id][6] if item_id in manual else None,
            "owner": path_info[item_id][2] if item_id in path_info else None,
            "description": path_info[item_id][3] if item_id in path_info else None,
        })
json.dump({"name": "aiup", "items": items}, sys.stdout, indent=2, ensure_ascii=False)
sys.stdout.write("\n")
PY
}

print_catalog_contracts() {
  local tool kind target deps version install update remove
  printf 'id\tkind\ttarget\tdependencies\tversion\tinstall\tupdate\tremove\n'
  for tool in "${TOOLS_CATALOG[@]}"; do
    kind="$(catalog_kind "$tool")"
    target=""
    case "$kind" in
      aiup-npm) target="$(catalog_npm_pkg "$tool")"; version='npm-package-json'; install='npm-prefix'; update='npm-prefix'; remove='npm-prefix' ;;
      brew-formula) target="$(catalog_brew_formula "$tool")"; version='brew-formula-record'; install='brew-formula'; update='brew-formula'; remove='brew-formula' ;;
      brew-cask) target="$(catalog_brew_cask "$tool")"; version='brew-cask-or-app'; install='brew-cask'; update='brew-cask'; remove='brew-cask' ;;
      curl-installer) target="$(catalog_curl_url "$tool")"; version='cli-version'; install='official-installer'; update='official-installer'; remove='bounded-user-path' ;;
      uv-tool) target="$(catalog_uv_pkg "$tool")"; version='uv-package-or-cli'; install='uv-tool'; update='uv-tool'; remove='uv-tool' ;;
      app) target="$(catalog_app_path "$tool")"; version='app-bundle'; install='dedicated-verified-app'; update='dedicated-verified-app'; remove='exact-app-bundle' ;;
      special) target="$(binary_of_tool "$tool")"; version='dedicated-or-cli'; install='dedicated'; update='dedicated'; remove='dedicated' ;;
      *) target=''; version=''; install=''; update=''; remove='' ;;
    esac
    deps="$(catalog_deps "$tool" | paste -sd, -)"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$tool" "$kind" "$target" "$deps" "$version" "$install" "$update" "$remove"
  done
}

# Catalog definition only — no scan of your Mac. Used by the public site/README.
print_catalog_definition() {
  local mode="${1:---json}"
  local tmp tool cat rec
  tmp="$(mktemp "${TMPDIR:-/tmp}/aiup-catdef.XXXXXX")"
  {
    printf 'VERSION\t%s\n' "$AIUP_VERSION"
    for cat in "${CATEGORY_ORDER[@]}"; do
      [ "$cat" = 'detected' ] && continue
      printf 'CAT\t%s\t%s\t%s\n' "$cat" "$(catalog_category_emoji "$cat")" "$(catalog_category_blurb "$cat")"
    done
    for cat in "${HOMEBREW_CHILD_ORDER[@]}"; do
      printf 'CAT\thomebrew/%s\t%s\t%s\n' "$cat" "$(catalog_category_emoji "homebrew/${cat}")" "$(catalog_category_blurb "homebrew/${cat}")"
    done
    for tool in "${TOOLS_CATALOG[@]}"; do
      printf 'TOOL\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$tool" \
        "$(catalog_category "$tool")" \
        "$(catalog_kind "$tool")" \
        "$(catalog_lifecycle "$tool")" \
        "$(catalog_docs_url "$tool")" \
        "$(catalog_label "$tool")"
    done
    for rec in "${HOMEBREW_RECOMMENDED_CASKS[@]}"; do
      printf 'REC\tcask\t%s\t%s\n' "$rec" "$(brew_extra_label cask "$rec")"
    done
    for rec in "${HOMEBREW_RECOMMENDED_FORMULAE[@]}"; do
      printf 'REC\tformula\t%s\t%s\n' "$rec" "$(brew_extra_label formula "$rec")"
    done
  } > "$tmp"
  python3 - "$mode" "$tmp" <<'PY'
import json, sys
mode, path = sys.argv[1], sys.argv[2]
version = ""
cats = []
cat_index = {}
tools = []
recs = []
with open(path, encoding="utf-8") as f:
    for line in f:
        line = line.rstrip("\n")
        parts = line.split("\t")
        kind = parts[0]
        if kind == "VERSION":
            version = parts[1]
        elif kind == "CAT":
            item = {"id": parts[1], "emoji": parts[2], "blurb": parts[3] if len(parts) > 3 else ""}
            cats.append(item)
            cat_index[item["id"]] = item
            item["tools"] = []
        elif kind == "TOOL":
            tool = {
                "id": parts[1],
                "category": parts[2],
                "kind": parts[3],
                "lifecycle": parts[4],
                "docs": parts[5],
                "label": parts[6] if len(parts) > 6 else parts[1],
            }
            tools.append(tool)
            cat_index.setdefault(tool["category"], {"id": tool["category"], "emoji": "", "blurb": "", "tools": []})
            cat_index[tool["category"]]["tools"].append(tool)
        elif kind == "REC":
            recs.append({"kind": parts[1], "id": parts[2], "label": parts[3] if len(parts) > 3 else parts[2]})
data = {
    "name": "aiup",
    "version": version,
    "categories": cats,
    "tools": tools,
    "recommended": recs,
}
if mode in ("--markdown", "markdown", "--md"):
    print(f"# Catalog ({version})\n")
    print("Generated from `macos/aiup` via `aiup catalog --markdown`.\n")
    for cat in cats:
        if cat["id"].startswith("homebrew/"):
            continue
        emoji = cat.get("emoji") or ""
        print(f"## {emoji} {cat['id']}\n")
        print(f"{cat.get('blurb','')}\n")
        if cat["id"] == "homebrew":
            print("| Child | What |\n|---|---|")
            for child in cats:
                if child["id"].startswith("homebrew/"):
                    print(f"| `{child['id'].split('/',1)[1]}` | {child.get('blurb','')} |")
            print("\nRecommended extras:\n")
            print("| Type | Id | Label |\n|---|---|---|")
            for rec in recs:
                print(f"| {rec['kind']} | `{rec['id']}` | {rec['label']} |")
            print()
            continue
        print("| Id | Label |\n|---|---|")
        for t in cat.get("tools") or []:
            print(f"| `{t['id']}` | {t['label']} |")
        print()
else:
    json.dump(data, sys.stdout, indent=2, ensure_ascii=False)
    sys.stdout.write("\n")
PY
  rm -f "$tmp"
}

remove_dir_if_exists() {
  local p
  for p in "$@"; do
    if [ -e "$p" ]; then
      if [ "$DRY_RUN" -eq 1 ]; then
        info "DRY-RUN: rm -rf $p"
      else
        rm -rf "$p"
        info "Removed $p"
      fi
    fi
  done
}

remove_file_if_exists() {
  local p
  for p in "$@"; do
    if [ -e "$p" ] || [ -L "$p" ]; then
      if [ "$DRY_RUN" -eq 1 ]; then
        info "DRY-RUN: rm -f $p"
      else
        rm -f "$p"
        info "Removed $p"
      fi
    fi
  done
}

DETECTED_CLEANUP_SEEN='|'

detected_cleanup_add() {
  local path="$1"
  [ -e "$path" ] || [ -L "$path" ] || return 0
  case "$DETECTED_CLEANUP_SEEN" in
    *"|$path|"*) return 0 ;;
  esac
  DETECTED_CLEANUP_SEEN="${DETECTED_CLEANUP_SEEN}${path}|"
  printf '%s\n' "$path"
}

detected_cleanup_paths() {
  local id="$1" record label app bundle_id app_leaf
  local support_name
  record="$(inventory_record "$id" 2>/dev/null || true)"
  [ -n "$record" ] || return 1
  IFS=$'\t' read -r _ _ _ label _ _ app <<< "$record"
  case "$id" in
    di:app:*) bundle_id="${id#di:app:}" ;;
    *) return 1 ;;
  esac
  case "$app" in
    /Applications/*.app|"$HOME"/Applications/*.app) ;;
    *) return 1 ;;
  esac
  [ -d "$app" ] || return 1
  app_leaf="$(basename "$app" .app)"
  DETECTED_CLEANUP_SEEN='|'
  detected_cleanup_add "$app"
  for support_name in "$app_leaf" "$(inventory_item_name "$label")"; do
    [ -n "$support_name" ] || continue
    detected_cleanup_add "$HOME/Library/Application Support/$support_name"
    detected_cleanup_add "$HOME/Library/Caches/$support_name"
    detected_cleanup_add "$HOME/Library/Logs/$support_name"
  done
  detected_cleanup_add "$HOME/Library/Application Support/$bundle_id"
  detected_cleanup_add "$HOME/Library/Caches/$bundle_id"
  detected_cleanup_add "$HOME/Library/Logs/$bundle_id"
  detected_cleanup_add "$HOME/Library/Preferences/$bundle_id.plist"
  detected_cleanup_add "$HOME/Library/Saved Application State/$bundle_id.savedState"
  detected_cleanup_add "$HOME/Library/Containers/$bundle_id"
}

# Reconcile missing app bundles through Homebrew's own uninstall contract.
# Never delete Caskroom metadata directly or infer candidates from a name alone.
cleanup_missing_homebrew_app() {
  local id="$1" path token
  mutation_authoritative_preflight "$id cleanup" || return 1
  AIUP_MISSING_APPS_READY=0
  brew_missing_apps_load
  path="$(brew_missing_app_for_tool "$id")" || { error 'App state changed or could not be verified; cleanup stopped'; return 1; }
  [ ! -e "$path" ] || { error 'App is present; cleanup stopped'; return 1; }
  token="${id#bc:}"
  run_with_heartbeat "Finish Homebrew uninstall: $token" env HOMEBREW_NO_AUTO_UPDATE=1 brew uninstall --cask --force "$token"
  local rc=$?
  brew_cache_invalidate
  AIUP_MISSING_APPS_READY=0
  tui_cache_invalidate
  return "$rc"
}

cmd_cleanup_homebrew() {
  local id="$1" apply="${2:-0}" token path found=0
  command_exists brew || { error 'Homebrew is not installed'; return 1; }
  AIUP_MISSING_APPS_READY=0
  brew_missing_apps_load
  printf '\nHomebrew cleanup · apps removed outside Homebrew\n'
  while IFS=$'\t' read -r token path; do
    [ -n "$token" ] || continue
    [ "$id" = homebrew ] || [ "$id" = "bc:$token" ] || continue
    found=1
    printf '  %s · app missing: %s\n' "$token" "$path"
    printf '  Finish uninstall: aiup cleanup bc:%s --apply\n' "$token"
  done <<< "${AIUP_MISSING_APPS:-}"
  [ "$found" -eq 1 ] || { printf 'No confirmed missing apps found for this selection. Nothing changed.\n'; return 0; }
  printf 'Uses Homebrew uninstall hooks; preferences are not deliberately purged (--zap is never used).\n'
  [ "$apply" -eq 1 ] || { printf 'Preview only. Nothing changed.\n'; return 0; }
  [ "$id" != homebrew ] || { error 'Choose one bc:<name> from the preview to apply cleanup'; return 1; }
  cleanup_missing_homebrew_app "$id"

}

cmd_cleanup() {
  local id="${1:-}" apply="${2:-0}" record label version source app name path leaf target
  local -a paths=()
  if [ -z "$id" ]; then
    error "usage: aiup cleanup <detected-app-id> [--apply]"
    return 1
  fi
  case "$id" in
    homebrew|bc:*) cmd_cleanup_homebrew "$id" "$apply"; return $? ;;
    di:app:*) ;;
    di:*)
      scan_inventory_index >/dev/null 2>&1 || true
      record="$(inventory_record "$id" 2>/dev/null || true)"
      if [ -n "$record" ]; then
        IFS=$'\t' read -r _ _ _ label version source app <<< "$record"
        printf '%s is detected via %s, but aiup has no reviewed generic remover for it.\n' "$(inventory_item_name "$label")" "$source"
        printf 'Use ctrl-o in aiup list or: aiup docs --print %s\n' "$id"
        return 0
      fi
      error "Detected inventory row is not available: $id"
      return 1
      ;;
    *)
      error "cleanup accepts a detected app id such as di:app:com.example.App"
      return 1
      ;;
  esac
  scan_inventory_index >/dev/null 2>&1 || true
  record="$(inventory_record "$id" 2>/dev/null || true)"
  [ -n "$record" ] || { error "Detected inventory row is not available: $id"; return 1; }
  IFS=$'\t' read -r _ _ _ label version source app <<< "$record"
  name="$(inventory_item_name "$label")"
  while IFS= read -r path; do
    [ -n "$path" ] && paths+=("$path")
  done < <(detected_cleanup_paths "$id")
  printf 'Cleanup preview: %s (%s, %s)\n' "$name" "${version:-unknown}" "$id"
  printf 'Only exact paths associated with this app bundle are candidates; group containers and unrelated files are excluded.\n'
  if [ "${#paths[@]}" -eq 0 ]; then
    printf 'No cleanup candidates found. Nothing changed.\n'
    return 0
  fi
  for path in "${paths[@]}"; do
    printf '  %s\t%s\n' "$(du -sh "$path" 2>/dev/null | awk '{print $1}' || printf '?')" "$path"
  done
  if [ "$apply" -ne 1 ]; then
    printf 'Nothing changed. Re-run with: aiup cleanup %s --apply\n' "$id"
    return 0
  fi
  mutation_authoritative_preflight "$id cleanup" || return 1
  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'DRY-RUN: these paths would be moved to %s\n' "$HOME/.Trash"
    return 0
  fi
  confirm_tty "Move these ${#paths[@]} exact paths to Trash? [y/N] " || {
    info "Cleanup cancelled"
    tui_cache_invalidate
    return 0
  }
  ensure_dir "$HOME/.Trash"
  for path in "${paths[@]}"; do
    leaf="$(basename "$path")"
    target="$HOME/.Trash/aiup-$(date +%Y%m%d%H%M%S)-$leaf"
    while [ -e "$target" ] || [ -L "$target" ]; do
      target="$HOME/.Trash/aiup-$(date +%Y%m%d%H%M%S)-$$-$leaf"
    done
    if mv "$path" "$target"; then
      info "Moved to Trash: $path"
    else
      error "Could not move to Trash: $path"
    fi
  done
  tui_cache_invalidate
  printf 'Cleanup complete. Files remain recoverable in %s.\n' "$HOME/.Trash"
}

