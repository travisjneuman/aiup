inventory_scan_path_bins() {
  local dir path binary seen_dirs='|'
  local -a path_dirs=()
  local old_ifs="$IFS"
  IFS=:
  read -r -a path_dirs <<< "$PATH"
  IFS="$old_ifs"
  for dir in "$LOCAL_BIN" "$AIUP_NPM_BIN" "$HOME/.cargo/bin" "$HOME/.grok/bin" /usr/local/bin "${path_dirs[@]}"; do
    [ -d "$dir" ] || continue
    case "$seen_dirs" in *"|$dir|"*) continue ;; esac
    seen_dirs="${seen_dirs}$dir|"
    case "$dir" in
      /bin|/sbin|/usr/bin|/usr/sbin|/System/*|/Library/*|/opt/homebrew/*) continue ;;
    esac
    for path in "$dir"/*; do
      [ -f "$path" ] && [ -x "$path" ] || continue
      binary="$(basename "$path")"
      inventory_managed_binary "$binary" && continue
      case "$INVENTORY_MANAGED_ALIAS_PATHS" in *"|$path|"*) continue ;; esac
      inventory_append detected "PATH executable" "di:path:$binary" "[path] $binary" unknown "$path"
    done
  done
}

scan_inventory_index() {
  local final_index="$INVENTORY_INDEX"
  local temp_index="${INVENTORY_INDEX}.tmp.$$"
  if capture_fixture_enabled; then
    ensure_dir "$STATE_DIR"
    capture_fixture_copy inventory-index.tsv "$final_index"
    return 0
  fi
  if inventory_cache_valid; then
    return 0
  fi
  ensure_dir "$STATE_DIR"
  : > "$temp_index"
  INVENTORY_INDEX="$temp_index"
  INVENTORY_SEEN_IDS='|'
  catalog_manifest_load || {
    rm -f "$temp_index"
    INVENTORY_INDEX="$final_index"
    return 1
  }
  inventory_scan_apps
  inventory_scan_npm
  inventory_scan_uv
  inventory_scan_path_bins
  path_insights "$INVENTORY_INDEX" enrich
  mv "$temp_index" "$final_index" || {
    rm -f "$temp_index"
    INVENTORY_INDEX="$final_index"
    return 1
  }
  INVENTORY_INDEX="$final_index"
  inventory_cache_write || true
}

inventory_stat_mtime() {
  local path="$1"
  [ -e "$path" ] || { printf 'missing\n'; return 0; }
  stat -f '%m' "$path" 2>/dev/null || stat -c '%Y' "$path" 2>/dev/null || printf 'unknown\n'
}

npm_inventory_stamp() {
  python3 - "$AIUP_NPM_NODE_MODULES" "${SYSTEM_NPM_PREFIX:-}/lib/node_modules" <<'PYSTAMP'
import hashlib, os, sys
from pathlib import Path
parts = []
for name in sys.argv[1:]:
    root = Path(name)
    try:
        candidates = [root]
        for child in root.iterdir():
            if child.name.startswith("@") and child.is_dir():
                candidates.append(child)
                candidates.extend(p / "package.json" for p in child.iterdir())
            else:
                candidates.append(child / "package.json")
        for path in sorted(candidates):
            try:
                stat = path.stat()
                parts.append((str(path),stat.st_mtime_ns,stat.st_size))
            except OSError: parts.append((str(path),None))
    except OSError: parts.append((str(root),None))
print(hashlib.sha256(repr(parts).encode()).hexdigest())
PYSTAMP
}

inventory_source_fingerprint() {
  local uv_root
  ensure_system_npm_prefix
  uv_root="$(uv tool dir 2>/dev/null || true)"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$AIUP_VERSION:$PATH" \
    "$(inventory_stat_mtime /Applications)" \
    "$(inventory_stat_mtime "$HOME/Applications")" \
    "$(npm_inventory_stamp)" \
    "$(inventory_stat_mtime "$SYSTEM_NPM_PREFIX/lib/node_modules")" \
    "$(inventory_stat_mtime "${uv_root:-$HOME/.local/share/uv/tools}")" \
    "$(command_path npm)" \
    "$(command_path uv)"
}

inventory_cache_valid() {
  local cached_at cached_key now age current_key
  [ "$INVENTORY_REFRESH" -eq 0 ] || return 1
  [ -s "$INVENTORY_CACHE_META" ] || return 1
  [ -f "$INVENTORY_INDEX" ] || return 1
  IFS=$'\t' read -r cached_at cached_key < "$INVENTORY_CACHE_META" || return 1
  case "$cached_at" in ''|*[!0-9]*) return 1 ;; esac
  now="$(date +%s)"
  age=$((now - cached_at))
  [ "$age" -ge 0 ] && [ "$age" -lt "$INVENTORY_CACHE_TTL" ] || return 1
  current_key="$(inventory_source_fingerprint)"
  [ "$cached_key" = "$current_key" ]
}

inventory_cache_write() {
  local temp_meta="${INVENTORY_CACHE_META}.tmp.$$"
  ensure_dir "$STATE_DIR"
  printf '%s\t%s\n' "$(date +%s)" "$(inventory_source_fingerprint)" > "$temp_meta" || return 1
  mv "$temp_meta" "$INVENTORY_CACHE_META"
}

sha256_stream() {
  if command_exists shasum; then
    shasum -a 256 | awk '{print $1}'
  else
    sha256sum | awk '{print $1}'
  fi
}

tui_runtime_path() {
  if [ -n "${AIUP_ACTIVE_RUNTIME:-}" ]; then
    printf '%s\n' "$AIUP_ACTIVE_RUNTIME"
  else
    printf '%s/aiup\n' "$AIUP_SCRIPT_DIR"
  fi
}

tui_source_fingerprint() {
  local fixture_fingerprint="" item
  ensure_system_npm_prefix
  if capture_fixture_enabled; then
    for item in PUBLIC-SAFE catalog-index.tsv brew-index.tsv inventory-index.tsv versions.tsv apps.tsv; do
      fixture_fingerprint="${fixture_fingerprint}${item}:$(sha256_file "$AIUP_CAPTURE_FIXTURE_DIR/$item" 2>/dev/null || printf missing);"
    done
  fi
  {
    printf 'runtime=%s\n' "$AIUP_RUNTIME_HASH"
    printf 'manifest=%s\n' "$CATALOG_MANIFEST_HASH"
    printf 'path=%s\n' "$PATH"
    printf 'apps=%s\n' "$(inventory_stat_mtime /Applications)"
    printf 'user_apps=%s\n' "$(inventory_stat_mtime "$HOME/Applications")"
    printf 'brew_cellar=%s\n' "$(inventory_stat_mtime /opt/homebrew/Cellar)"
    printf 'brew_caskroom=%s\n' "$(inventory_stat_mtime /opt/homebrew/Caskroom)"
    printf 'local_cellar=%s\n' "$(inventory_stat_mtime /usr/local/Cellar)"
    printf 'local_caskroom=%s\n' "$(inventory_stat_mtime /usr/local/Caskroom)"
    printf 'npm_inventory=%s\n' "$(npm_inventory_stamp)"
    printf 'homebrew_npm=%s\n' "$(inventory_stat_mtime /opt/homebrew/lib/node_modules)"
    printf 'local_npm=%s\n' "$(inventory_stat_mtime /usr/local/lib/node_modules)"
    printf 'uv=%s\n' "$(inventory_stat_mtime "$HOME/.local/share/uv/tools")"
    printf 'commands=%s|%s|%s|%s\n' "$(command_path brew)" "$(command_path fzf)" "$(command_path npm)" "$(command_path uv)"
    printf 'fixture=%s\n' "$fixture_fingerprint"
  } | sha256_stream
}

tui_cache_key() {
  printf '%s|%s|%s|%s|%s\n' "$1" "$LIST_VIEW_MODE" "$LIST_CATEGORY_FILTER" "$LIST_SORT_MODE" "${AIUP_CAPTURE_FIXTURE_DIR:-live}" | sha256_stream
}

tui_snapshot_files_valid() {
  local dir="$1" name
  [ -d "$dir" ] && [ ! -L "$dir" ] || return 1
  for name in meta.tsv catalog-index.tsv brew-index.tsv inventory-index.tsv versions-index.tsv rows-expanded.tsv; do
    [ -f "$dir/$name" ] && [ ! -L "$dir/$name" ] || return 1
  done
  awk -F '\t' 'NF != 3 {exit 1}' "$dir/catalog-index.tsv" || return 1
  awk -F '\t' 'NF && NF < 4 {exit 1}' "$dir/brew-index.tsv" || return 1
  awk -F '\t' 'NF && NF < 7 {exit 1}' "$dir/inventory-index.tsv" || return 1
}

tui_cache_generation_valid() {
  local dir="$1" wanted_key="$2"
  local schema="" runtime_version="" runtime_hash="" manifest_version="" manifest_hash=""
  local created="" fingerprint="" cache_key="" catalog_hash="" brew_hash="" inventory_hash="" versions_hash="" rows_hash="" now
  tui_snapshot_files_valid "$dir" || return 1
  while IFS=$'\t' read -r key value extra; do
    [ -z "${extra:-}" ] || return 1
    case "$key" in
      schema) schema="$value" ;;
      runtime_version) runtime_version="$value" ;;
      runtime_hash) runtime_hash="$value" ;;
      manifest_version) manifest_version="$value" ;;
      manifest_hash) manifest_hash="$value" ;;
      created) created="$value" ;;
      fingerprint) fingerprint="$value" ;;
      cache_key) cache_key="$value" ;;
      catalog_hash) catalog_hash="$value" ;;
      brew_hash) brew_hash="$value" ;;
      inventory_hash) inventory_hash="$value" ;;
      versions_hash) versions_hash="$value" ;;
      rows_hash) rows_hash="$value" ;;
      *) return 1 ;;
    esac
  done < "$dir/meta.tsv"
  [ "$schema" = "$AIUP_TUI_CACHE_SCHEMA" ] || return 1
  [ "$runtime_version" = "$AIUP_VERSION" ] && [ "$runtime_hash" = "$AIUP_RUNTIME_HASH" ] || return 1
  [ "$manifest_version" = "$CATALOG_MANIFEST_VERSION" ] && [ "$manifest_hash" = "$CATALOG_MANIFEST_HASH" ] || return 1
  [ "$cache_key" = "$wanted_key" ] || return 1
  case "$created" in ''|*[!0-9]*) return 1 ;; esac
  now="$(date +%s)"
  [ $((now - created)) -ge 0 ] && [ $((now - created)) -lt "$TUI_CACHE_TTL" ] || return 1
  [ "$fingerprint" = "$(tui_source_fingerprint)" ] || return 1
  [ "$catalog_hash" = "$(sha256_file "$dir/catalog-index.tsv")" ] || return 1
  [ "$brew_hash" = "$(sha256_file "$dir/brew-index.tsv")" ] || return 1
  [ "$inventory_hash" = "$(sha256_file "$dir/inventory-index.tsv")" ] || return 1
  [ "$versions_hash" = "$(sha256_file "$dir/versions-index.tsv")" ] || return 1
  [ "$rows_hash" = "$(sha256_file "$dir/rows-expanded.tsv")" ] || return 1
}

tui_cache_restore() {
  local filter="$1" generation dir cache_key created now
  [ "$INVENTORY_REFRESH" -eq 0 ] || return 1
  [ -f "$TUI_CACHE_POINTER" ] && [ ! -L "$TUI_CACHE_POINTER" ] || return 1
  generation="$(sed -n '1p' "$TUI_CACHE_POINTER")"
  case "$generation" in snapshot-[A-Za-z0-9._-]*) ;; *) return 1 ;; esac
  dir="$TUI_CACHE_GENERATIONS/$generation"
  cache_key="$(tui_cache_key "$filter")"
  tui_cache_generation_valid "$dir" "$cache_key" || return 1
  cp "$dir/catalog-index.tsv" "${CATALOG_INDEX}.tmp.$$" || return 1
  cp "$dir/brew-index.tsv" "${BREW_INDEX}.tmp.$$" || return 1
  cp "$dir/inventory-index.tsv" "${INVENTORY_INDEX}.tmp.$$" || return 1
  cp "$dir/versions-index.tsv" "${VERSIONS_INDEX}.tmp.$$" || return 1
  mv "${CATALOG_INDEX}.tmp.$$" "$CATALOG_INDEX" || return 1
  mv "${BREW_INDEX}.tmp.$$" "$BREW_INDEX" || return 1
  mv "${INVENTORY_INDEX}.tmp.$$" "$INVENTORY_INDEX" || return 1
  mv "${VERSIONS_INDEX}.tmp.$$" "$VERSIONS_INDEX" || return 1
  AIUP_TUI_SNAPSHOT_GENERATION="$generation"
  AIUP_TUI_CACHED_ROWS="$dir/rows-expanded.tsv"
  created="$(awk -F '\t' '$1=="created" {print $2; exit}' "$dir/meta.tsv")"
  now="$(date +%s)"
  profile_note "snapshot hit generation=$generation schema=$AIUP_TUI_CACHE_SCHEMA age=$((now - created))s ttl=${TUI_CACHE_TTL}s source=fingerprint-bound"
  profile_mark "Homebrew inventory (cache)"
  profile_mark "detected inventory (cache)"
  profile_mark "catalog state scan (cache)"
  return 0
}

tui_cache_prune() {
  local current candidate name seen=0 entries created now
  current="$(sed -n '1p' "$TUI_CACHE_POINTER" 2>/dev/null || true)"
  now="$(date +%s)"
  for candidate in $(find "$TUI_CACHE_GENERATIONS" -mindepth 1 -maxdepth 1 -type d -name 'snapshot-*' -print 2>/dev/null | LC_ALL=C sort -r); do
    name="${candidate##*/}"
    [ "$name" = "$current" ] && continue
    seen=$((seen + 1))
    [ "$seen" -gt 3 ] || continue
    [ ! -L "$candidate" ] || continue
    tui_snapshot_files_valid "$candidate" || continue
    created="$(awk -F '\t' '$1=="created" {print $2; exit}' "$candidate/meta.tsv")"
    case "$created" in ''|*[!0-9]*) continue ;; esac
    [ $((now - created)) -ge 60 ] || continue
    entries="$(find "$candidate" -mindepth 1 -maxdepth 1 -print | wc -l | tr -d ' ')"
    [ "$entries" -eq 6 ] || continue
    rm -f "$candidate/meta.tsv" "$candidate/catalog-index.tsv" "$candidate/brew-index.tsv" "$candidate/inventory-index.tsv" "$candidate/versions-index.tsv" "$candidate/rows-expanded.tsv"
    rmdir "$candidate" 2>/dev/null || true
  done
}

tui_cache_publish() {
  local filter="$1" nonce generation staging final pointer_tmp now fingerprint cache_key saved_expand saved_query
  ensure_dir "$TUI_CACHE_GENERATIONS"
  [ -d "$TUI_CACHE_ROOT" ] && [ ! -L "$TUI_CACHE_ROOT" ] || return 1
  [ -d "$TUI_CACHE_GENERATIONS" ] && [ ! -L "$TUI_CACHE_GENERATIONS" ] || return 1
  [ ! -L "$TUI_CACHE_POINTER" ] || return 1
  nonce="$(python3 -c 'import secrets; print(secrets.token_hex(8))')"
  generation="snapshot-$(date +%s)-$$-$nonce"
  staging="$TUI_CACHE_GENERATIONS/.staging-$generation"
  final="$TUI_CACHE_GENERATIONS/$generation"
  mkdir "$staging" || return 1
  cp "$CATALOG_INDEX" "$staging/catalog-index.tsv" || return 1
  cp "$BREW_INDEX" "$staging/brew-index.tsv" || return 1
  cp "$INVENTORY_INDEX" "$staging/inventory-index.tsv" || return 1
  cp "$VERSIONS_INDEX" "$staging/versions-index.tsv" || return 1
  saved_expand="$EXPAND_FILE"; saved_query="$LIST_QUERY_FILE"
  EXPAND_FILE="$staging/.expanded-render"; LIST_QUERY_FILE="$staging/.query-render"
  expand_all_categories
  : > "$LIST_QUERY_FILE"
  if ! emit_fzf_rows_from_index | sort_fzf_rows > "$staging/rows-expanded.tsv"; then
    EXPAND_FILE="$saved_expand"; LIST_QUERY_FILE="$saved_query"
    return 1
  fi
  rm -f "$EXPAND_FILE" "$LIST_QUERY_FILE"
  EXPAND_FILE="$saved_expand"; LIST_QUERY_FILE="$saved_query"
  now="$(date +%s)"
  fingerprint="$(tui_source_fingerprint)"
  cache_key="$(tui_cache_key "$filter")"
  {
    printf 'schema\t%s\n' "$AIUP_TUI_CACHE_SCHEMA"
    printf 'runtime_version\t%s\n' "$AIUP_VERSION"
    printf 'runtime_hash\t%s\n' "$AIUP_RUNTIME_HASH"
    printf 'manifest_version\t%s\n' "$CATALOG_MANIFEST_VERSION"
    printf 'manifest_hash\t%s\n' "$CATALOG_MANIFEST_HASH"
    printf 'created\t%s\n' "$now"
    printf 'fingerprint\t%s\n' "$fingerprint"
    printf 'cache_key\t%s\n' "$cache_key"
    printf 'catalog_hash\t%s\n' "$(sha256_file "$staging/catalog-index.tsv")"
    printf 'brew_hash\t%s\n' "$(sha256_file "$staging/brew-index.tsv")"
    printf 'inventory_hash\t%s\n' "$(sha256_file "$staging/inventory-index.tsv")"
    printf 'versions_hash\t%s\n' "$(sha256_file "$staging/versions-index.tsv")"
    printf 'rows_hash\t%s\n' "$(sha256_file "$staging/rows-expanded.tsv")"
  } > "$staging/meta.tsv" || return 1
  tui_cache_generation_valid "$staging" "$cache_key" || return 1
  mv "$staging" "$final" || return 1
  pointer_tmp="$(mktemp "$TUI_CACHE_ROOT/.current.XXXXXX")" || return 1
  printf '%s\n' "$generation" > "$pointer_tmp" || return 1
  mv "$pointer_tmp" "$TUI_CACHE_POINTER" || return 1
  AIUP_TUI_SNAPSHOT_GENERATION="$generation"
  AIUP_TUI_CACHED_ROWS="$final/rows-expanded.tsv"
  profile_note "snapshot publish generation=$generation schema=$AIUP_TUI_CACHE_SCHEMA source=fingerprint-bound"
  tui_cache_prune
}

tui_cache_invalidate() {
  [ ! -L "$TUI_CACHE_POINTER" ] || return 0
  rm -f "$TUI_CACHE_POINTER"
  AIUP_TUI_SNAPSHOT_GENERATION=""
  AIUP_TUI_CACHED_ROWS=""
}

