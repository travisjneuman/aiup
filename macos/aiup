_now() {
  date '+%Y-%m-%d %I:%M:%S %p'
}

log() {
  local level="$1"
  shift
  if [ "$UPDATE_REPORT_ACTIVE" -eq 1 ]; then
    if [ "$AIUP_VERBOSE" -eq 0 ] || [ "$UPDATE_REPORT_CAPTURING" -eq 0 ]; then
      printf '[%s] [%s] %s\n' "$(_now)" "$level" "$*" >> "$UPDATE_REPORT_LOG"
    fi
    if [ "$AIUP_VERBOSE" -eq 1 ]; then
      printf '[%s] [%s] %s\n' "$(_now)" "$level" "$*"
    elif [ "$level" = ERROR ]; then
      local message="$*"
      message="${message//==========/}"
      printf '  ! %s\n' "$message" >&4
    fi
    return 0
  fi
  printf '[%s] [%s] %s\n' "$(_now)" "$level" "$*"
}

info() { log INFO "$@"; }
warn() { UPDATE_REPORT_NOTE="$*"; log WARN "$@"; }
error() { log ERROR "$@" >&2; }

command_exists() {
