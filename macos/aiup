  if bounded_provider_capture "$raw" "$AVAILABLE_VERSION_PROVIDER_TIMEOUT" env HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew info --cask --json=v2 --installed; then
    AIUP_MISSING_APPS="$(python3 - "$raw" <<'PYMISSING'
import json,sys
from pathlib import Path
try:
    data=json.loads(Path(sys.argv[1]).read_text())
    for cask in data.get("casks",[]):
        if not cask.get("installed"): continue
        apps=[a for a in cask.get("artifacts",[]) if "app" in a]
        targets=[Path(a["target"]) for a in apps if isinstance(a.get("target"),str)]
        # A partially present multi-app cask is not an abandoned installation.
        if apps and len(targets)==len(apps) and all(
            p.is_absolute() and p.suffix==".app" and not p.exists() and not p.is_symlink()
            for p in targets
        ):
            print(cask["token"],str(targets[0]),sep="\t")
except (ValueError,TypeError,KeyError,OSError): pass
PYMISSING
)"
  fi
  rm -f "$raw"
}

