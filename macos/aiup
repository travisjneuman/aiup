print_result_group() {
  local label="$1"
  shift
  [ "$#" -gt 0 ] || return 0
  printf '%-13s %s\n' "$label" "$*"
}

print_result_summary() {
  if [ "${#RESULT_COMPLETED[@]}" -eq 0 ] && [ "${#RESULT_REMOVED[@]}" -eq 0 ] && \
    [ "${#RESULT_CURRENT[@]}" -eq 0 ] && \
    [ "${#RESULT_SKIPPED[@]}" -eq 0 ] && [ "${#RESULT_DETECTED[@]}" -eq 0 ] && \
    [ "${#RESULT_FAILED[@]}" -eq 0 ] && [ "${#RESULT_CANCELLED[@]}" -eq 0 ]; then
    return 0
  fi
  printf '\n=== aiup result ===\n'
  print_result_group completed ${RESULT_COMPLETED[@]+"${RESULT_COMPLETED[@]}"}
  print_result_group current ${RESULT_CURRENT[@]+"${RESULT_CURRENT[@]}"}
  print_result_group removed ${RESULT_REMOVED[@]+"${RESULT_REMOVED[@]}"}
  print_result_group skipped ${RESULT_SKIPPED[@]+"${RESULT_SKIPPED[@]}"}
  print_result_group detected-only ${RESULT_DETECTED[@]+"${RESULT_DETECTED[@]}"}
  print_result_group failed ${RESULT_FAILED[@]+"${RESULT_FAILED[@]}"}
  print_result_group cancelled ${RESULT_CANCELLED[@]+"${RESULT_CANCELLED[@]}"}
}

run_with_heartbeat() {
  local label="$1"
  shift

  if [ "$DRY_RUN" -eq 1 ]; then
    info "DRY-RUN: $label"
    return 0
  fi

  local start_ts pid rc elapsed hb_pid
  start_ts="$(date +%s)"
  info "START: $label"
  "$@" </dev/null &
  pid=$!

  (
    while kill -0 "$pid" 2>/dev/null; do
      sleep "$HEARTBEAT_SECONDS"
      if kill -0 "$pid" 2>/dev/null; then
        elapsed=$(( $(date +%s) - start_ts ))
        info "still working: $label (${elapsed}s elapsed)"
      fi
    done
  ) &
  hb_pid=$!

  wait "$pid"
  rc=$?
  kill "$hb_pid" 2>/dev/null || true
  wait "$hb_pid" 2>/dev/null || true

  if [ "$rc" -eq 0 ]; then
    info "DONE: $label"
  else
    error "FAILED: $label (exit $rc)"
  fi
  return "$rc"
}

run_shell_with_heartbeat() {
  local cmd="$1"
  run_with_heartbeat "$cmd" bash -lc "$cmd"
}

which_all_unique_list() {
  local cmd="$1"
  local out=""
  local seen="|"
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$seen" in
      *"|$line|"*) ;;
      *)
        if [ -n "$out" ]; then
          out="$out, $line"
        else
          out="$line"
        fi
        seen="${seen}${line}|"
        ;;
    esac
  done <<EOF_AW
$(which -a "$cmd" 2>/dev/null || true)
EOF_AW
  printf '%s
' "$out"
}

which_all_unique_count() {
  local list count oldifs item
  list="$(which_all_unique_list "$1")"
  if [ -z "$list" ]; then
    printf '0
'
    return 0
  fi
  count=0
  oldifs="$IFS"
  IFS=','
  for item in $list; do
    count=$((count+1))
  done
  IFS="$oldifs"
  printf '%s
' "$count"
}

hash_refresh() {
  hash -r 2>/dev/null || true
}

zsh_block_present() {
  grep -Fq '# >>> aiup PATH >>>' "$HOME/.zshrc" 2>/dev/null
}

ensure_zsh_path_block() {
  ensure_dir "$HOME"
  local file="$HOME/.zshrc"
  touch "$file"

  python3 - <<'PYEOF' "$file" "$LOCAL_BIN" "$AIUP_NPM_BIN"
from pathlib import Path
import re, sys
file_path, local_bin, npm_bin = sys.argv[1:4]
p = Path(file_path)
text = p.read_text() if p.exists() else ""
start = "# >>> aiup PATH >>>"
end = "# <<< aiup PATH <<<"
legacy_lines = {
    f'export PATH="{npm_bin}:$PATH"',
}
legacy_patterns = [
    re.compile(r'^export PATH="(?:/opt/homebrew|/usr/local)/Cellar/node/[^\"]+/bin:\$PATH"$'),
]
lines = text.splitlines()
out = []
in_block = False
for line in lines:
    if line == start:
        in_block = True
        continue
    if line == end:
        in_block = False
        continue
    if in_block:
        continue
    if line in legacy_lines:
        continue
    if any(pat.match(line) for pat in legacy_patterns):
        continue
    out.append(line)
block = [start, f'export PATH="{local_bin}:{npm_bin}:$PATH"', end]
while out and out[-1] == "":
    out.pop()
out.extend(["", *block, ""])
new_text = "\n".join(out)
p.write_text(new_text)
PYEOF
}

remove_legacy_path_lines() {
  local file
  for file in "$HOME/.zprofile" "$HOME/.zshrc"; do
    [ -f "$file" ] || continue
    python3 - <<'PYEOF' "$file" "$AIUP_NPM_BIN"
from pathlib import Path
import re, sys
file_path, npm_bin = sys.argv[1:3]
p = Path(file_path)
text = p.read_text() if p.exists() else ""
lines = text.splitlines()
legacy_exact = {
    f'export PATH="{npm_bin}:$PATH"',
}
patterns = [
    re.compile(r'^export PATH="(?:/opt/homebrew|/usr/local)/Cellar/node/[^\"]+/bin:\$PATH"$'),
]
new_lines = []
changed = False
for line in lines:
    if line in legacy_exact or any(pat.match(line) for pat in patterns):
        changed = True
        continue
    new_lines.append(line)
if changed:
    while new_lines and new_lines[-1] == "":
        new_lines.pop()
    p.write_text("\n".join(new_lines) + ("\n" if new_lines else ""))
    print("changed")
else:
    print("unchanged")
PYEOF
  done
}

ensure_path_active() {
  local dir="$1"
  if ! path_contains_dir "$dir"; then
    export PATH="$dir:$PATH"
    hash_refresh
    info "Added to current PATH: $dir"
  fi
}

ensure_managed_paths() {
  ensure_dir "$LOCAL_BIN"
  ensure_dir "$AIUP_NPM_BIN"
  ensure_dir "$AIUP_NPM_NODE_MODULES"
  remove_legacy_path_lines >/dev/null 2>&1 || true
  ensure_zsh_path_block
  ensure_path_active "$AIUP_NPM_BIN"
  ensure_path_active "$LOCAL_BIN"
}

persistent_path_likely() {
  local dir="$1"
  if [ "$dir" = "$AIUP_NPM_BIN" ] || [ "$dir" = "$LOCAL_BIN" ]; then
    if zsh_block_present; then
      printf 'yes\n'
    else
      printf 'no\n'
    fi
    return 0
  fi
  if [ "$dir" = "$OPENCODE_BIN_DIR" ]; then
    if grep -Fq "$OPENCODE_BIN_DIR" "$HOME/.zshrc" 2>/dev/null || grep -Fq "$OPENCODE_BIN_DIR" "$HOME/.zprofile" 2>/dev/null; then
      printf 'yes\n'
    else
      printf 'no\n'
    fi
    return 0
  fi
  if [ "$dir" = "/opt/homebrew/bin" ] || [ "$dir" = "/usr/local/bin" ]; then
    printf 'yes\n'
    return 0
  fi
  if [ "$dir" = "$HOME/.grok/bin" ]; then
    printf 'yes\n'
    return 0
  fi
  printf 'no\n'
}

