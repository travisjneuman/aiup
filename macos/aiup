        if str(p.resolve()) not in shown: print('    shadowed: '+str(p)); shown.add(str(p.resolve()))
    print('    Review aiup explain before choosing one manager or changing PATH.')
for p in broken: print('  ! Broken executable link: '+p+'; review its owner before repair.')
PYDIAG
  done
  printf '\nSetup warnings from the latest run:\n'
  run_history warnings
  printf 'No profiles or packages changed. Full inventory: aiup doctor --details\n'
}

# Local run history uses exact generated names and never follows symlinks.
run_history() {
  python3 - "$STATE_DIR/logs" "$1" "$AIUP_LOG_LIMIT" "${2:-}" <<'PYHISTORY'
import json, os, re, sys, time
from pathlib import Path
from collections import Counter
root, action, limit, tool = Path(sys.argv[1]), sys.argv[2], int(sys.argv[3]), sys.argv[4]
if root.is_symlink(): raise SystemExit("Refusing a symbolic-link log directory")
def ink(value, code="38;5;141"):
    return "\033["+code+"m"+value+"\033[0m" if sys.stdout.isatty() and not os.environ.get("NO_COLOR") else value
if not root.is_dir():
    if action not in ("prune", "retry"): print("No saved runs yet.")
    raise SystemExit(0)
def plain(value):
    return re.sub(r"[\x00-\x1f\x7f-\x9f]", "", re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", str(value)))
records = []
for log in root.iterdir():
    if not re.fullmatch(r"update-\d{8}-\d{6}\.[A-Za-z0-9]+", log.name) or log.is_symlink() or not log.is_file(): continue
    meta, active = Path(str(log)+".json"), Path(str(log)+".active")
    if meta.is_symlink() or active.is_symlink(): continue
    alive = False
    if active.is_file():
        try:
            pid = int(active.read_text().strip())
            if pid > 0: os.kill(pid, 0); alive = True
        except ProcessLookupError: pass
        except (OSError, ValueError): alive = True  # ambiguity preserves the log
    data = None
    if meta.is_file():
        try:
            data = json.loads(meta.read_text())
            if data.get("schema") != "aiup-run-v1" or data.get("log") != log.name: continue
            rows = data.get("tools")
            if not isinstance(rows, list) or any(not isinstance(row, dict) or not isinstance(row.get("tool"), str) for row in rows): continue
        except (OSError, ValueError, AttributeError): continue
    # Older runtimes did not write active markers. Protect recent legacy logs.
    if data is None and time.time()-log.stat().st_mtime < 86400: alive = True
    records.append((log.stat().st_mtime, log, meta, active, alive, data))
records.sort(key=lambda r: (r[0],r[1].name), reverse=True)
if action == "prune":
    completed = 0
    for _, log, meta, active, alive, data in records:
        if alive: continue
        completed += 1
        if completed <= limit: continue
        for path in (meta, active, log):
            if path.is_file() and not path.is_symlink(): path.unlink()
    raise SystemExit(0)
selected = [(log, data, alive) for _,log,_,_,alive,data in records
            if not tool or (data and any(r.get("tool")==tool for r in data.get("tools",[])))]
if action == "warnings":
    data=selected[0][1] if selected else None
    warnings=[r for r in data['tools'] if r.get('warning')] if data else []
    for r in warnings: print('  ! '+plain(r['tool'])+': '+plain(r.get('note',''))+' · aiup logs '+plain(r['tool']))
    if not warnings: print('  No recorded setup warnings in the latest run.')
    raise SystemExit(0)
if action == "retry":
    if not selected: raise SystemExit(0)
    log,data,alive=selected[0]
    if alive: raise SystemExit("Latest run is still active; wait for it to finish")
    if not data: raise SystemExit("Latest run has no structured results; inspect aiup logs")
    for row in data['tools']:
        if row.get('result')=='failed': print(row['tool'])
    raise SystemExit(0)
if action == "logs":
    if not selected: print("No saved log for " + (tool or "an update run") + "."); raise SystemExit(1)
    log, data, _ = selected[0]
    start, end = 0, log.stat().st_size
    if tool:
        row = next(r for r in data["tools"] if r.get("tool")==tool)
        start, end = int(row.get("start",0)), int(row.get("end",0))
    print(ink("Run log: " + str(log)))
    with log.open("rb") as handle:
        handle.seek(max(0,start))
        remaining = max(0,end-start)
        while remaining:
            raw = handle.read(min(65536,remaining))
            if not raw: break
            remaining -= len(raw)
            # Display output as text, not terminal control sequences.
            text = raw.decode("utf-8", "replace")
            text = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", text)
            print("".join(c for c in text if c in "\n\t" or (ord(c)>=32 and not 127<=ord(c)<=159)),end="")
    raise SystemExit(0)
print(ink("\naiup · history\n"))
if not selected: print("No matching saved runs.")
for log, data, alive in selected[:limit]:
    print(ink(plain(log.name), "38;5;81"))
    if not data: print("  Legacy log · aiup logs to read the latest run"); continue
    rows = [r for r in data.get("tools",[]) if not tool or r.get("tool")==tool]
    counts = Counter(r.get("result","unknown") for r in rows)
    status = "running" if alive else ("interrupted" if data.get("status")=="running" else "complete")
    print("  " + status + " · " + str(data.get("duration",0)) + "s · " + " · ".join(str(n)+" "+plain(k) for k,n in counts.items()))
    for row in rows if tool else []:
        before, after = row.get("before","unknown"),row.get("after","unknown")
        value = str(before)+" → "+str(after) if before!=after else str(after)
        print("  " + plain(row.get("tool", "")) + " · " + plain(value) + " · " + str(row.get("duration",0)) + "s" + (" · ! warning" if row.get("warning") else ""))
PYHISTORY
}

update_report_warnings() {
  local warning
  warning="$(python3 - "$UPDATE_REPORT_LOG" "$UPDATE_REPORT_LOG_START" "$UPDATE_REPORT_LOG_END" "$UPDATE_REPORT_CURRENT_TOOL" <<'PYWARN'
import re, sys
with open(sys.argv[1], "rb") as handle:
    handle.seek(int(sys.argv[2]))
    text = handle.read(max(0,int(sys.argv[3])-int(sys.argv[2]))).decode("utf-8", "replace")
text = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", text)
lines = [line.strip() for line in text.splitlines() if re.search(r"\b(?:warn(?:ing)?|error)\b", line, re.I)
         and not line.startswith("[") and not re.search("already installed|not upgrading",line,re.I)]
if lines:
    if "install-scripts" in text or "blocked" in text.lower() and "script" in text.lower():
        print("Setup scripts need review; installation may be incomplete. Run aiup logs " + sys.argv[4] + " for details.")
    else:
        print("; ".join(dict.fromkeys(lines))[:400])
PYWARN
)"
  if [ -n "$warning" ]; then
    UPDATE_REPORT_WARNING=1
    UPDATE_REPORT_NOTE="${UPDATE_REPORT_NOTE:+$UPDATE_REPORT_NOTE; }$warning"
  fi
}

# Snapshot before any required-tool update: fzf may refresh Homebrew itself.
update_report_begin() {
  [ "$UPDATE_REPORT_ACTIVE" -eq 0 ] || return 0
  local tool version
  [ "$UPDATE_REPORT_MODE" != update ] || preferences reasons >/dev/null || return 1
  [ "$UPDATE_REPORT_MODE" != update ] || ensure_managed_paths
  [ ! -L "$STATE_DIR/logs" ] || { error "Refusing a symbolic-link log directory"; return 1; }
  ensure_dir "$STATE_DIR/logs"
  [ "$UPDATE_REPORT_MODE" != update ] || run_history prune || return 1
  UPDATE_REPORT_LOG="$(mktemp "$STATE_DIR/logs/update-$(date +%Y%m%d-%H%M%S).XXXXXX")" || return 1
  chmod 600 "$UPDATE_REPORT_LOG"
  printf '%s\n' "$$" > "${UPDATE_REPORT_LOG}.active"
  chmod 600 "${UPDATE_REPORT_LOG}.active"
  exec 4>&1
  UPDATE_REPORT_ACTIVE=1
  UPDATE_REPORT_STARTED="$(date +%s)"
  if [ -t 4 ] && [ -z "${NO_COLOR:-}" ]; then
    printf '\n\033[1;38;5;141m  aiup\033[0m \033[38;5;81m· tool operations\033[0m\n\n' >&4
  else
    printf '\naiup · tool operations\n\n' >&4
  fi
  printf '  Reading installed versions…\n' >&4
  brew_missing_apps_load
  brew_cache_load
  ensure_system_npm_prefix
  profile_mark "inventory providers"
  # Read-only workers inherit one provider inventory; deterministic merge order.
  local -a selected=("$@") workers=()
  local offset i pid file saved_traps
  saved_traps="$(trap -p INT TERM HUP)"
  trap 'for pid in "${workers[@]}"; do kill "$pid" 2>/dev/null || true; done; wait 2>/dev/null || true; rm -f "${UPDATE_REPORT_LOG}".version.* "${UPDATE_REPORT_LOG}.active"; exit 130' INT TERM HUP
  for ((offset=0; offset<TUI_PREFETCH_WORKERS; offset++)); do
    (
      for ((i=offset; i<${#selected[@]}; i+=TUI_PREFETCH_WORKERS)); do
        tool="${selected[$i]}"; version='not installed'
        if tool_is_present "$tool"; then version="$(version_of_tool "$tool")"; fi
        printf '%s\n' "${version:-unknown}" > "${UPDATE_REPORT_LOG}.version.$i"
      done
    ) & workers+=("$!")
  done
  for pid in "${workers[@]}"; do wait "$pid" || true; done
  trap - INT TERM HUP
  [ -z "$saved_traps" ] || eval "$saved_traps"
  for ((i=0; i<${#selected[@]}; i++)); do
    file="${UPDATE_REPORT_LOG}.version.$i"
    version=unknown
    if [ -f "$file" ]; then version="$(cat "$file")"; rm -f "$file"; fi
    UPDATE_REPORT_TOOLS+=("${selected[$i]}")
    UPDATE_REPORT_BEFORE+=("$version")
  done
  profile_mark "installed versions"
}

update_report_record() {
  local tool="$1" status="$2" before='not installed' after candidate shade i=0
  for candidate in "${UPDATE_REPORT_TOOLS[@]}"; do
    if [ "$candidate" = "$tool" ]; then before="${UPDATE_REPORT_BEFORE[$i]}"; break; fi
    i=$((i + 1))
  done
  after='not installed'
  if tool_is_present "$tool"; then after="$(version_of_tool "$tool")"; fi
  if [ "$DRY_RUN" -eq 1 ]; then status=planned; UPDATE_REPORT_WARNING=0; fi
  before="$(printf '%s' "$before" | tr '\t\r\n' '   ')"
  after="$(printf '%s' "$after" | tr '\t\r\n' '   ')"
  UPDATE_REPORT_NOTE="$(printf '%s' "$UPDATE_REPORT_NOTE" | tr '\t\r\n' '   ')"
  shade="$(catalog_ansi "$(catalog_category "$tool")")"
  shade="${shade#$'\033['}"
  shade="${shade%m}"
  UPDATE_REPORT_ROWS+=("$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$tool" "$status" "$before" "${after:-unknown}" "$shade" "$UPDATE_REPORT_NOTE" "$UPDATE_REPORT_LOG_START" "$UPDATE_REPORT_LOG_END" "$UPDATE_REPORT_WARNING" "$UPDATE_REPORT_TOOL_SECONDS")")
  print_update_report --save-only
}

run_tool_update() {
  local tool="$1" rc=0 sink live=0 tool_started
  tool_started="$(date +%s)"
  if [ "$UPDATE_REPORT_ACTIVE" -eq 0 ]; then run_tool_update_impl "$tool"; return $?; fi
  UPDATE_REPORT_NOTE=''
  UPDATE_REPORT_WARNING=0
  UPDATE_REPORT_CURRENT_TOOL="$tool"
  UPDATE_REPORT_LOG_START="$(wc -c < "$UPDATE_REPORT_LOG")"
  if [ -t 4 ] && [ "$AIUP_VERBOSE" -eq 0 ]; then
    printf '\r\033[2K  › %.20s · %s done · checking…' "$tool" "$UPDATE_REPORT_COMPLETED" >&4
  else
    printf '  › %s\n' "$tool" >&4
  fi
  if [ "$AIUP_VERBOSE" -eq 1 ] || { [ "$tool" = brew ] && ! command_exists brew; }; then live=1; fi
  if [ "$live" -eq 1 ]; then
    [ ! -t 4 ] || printf '\r\033[2K' >&4
    exec 5> >(tee -a "$UPDATE_REPORT_LOG")
    sink=$!
    UPDATE_REPORT_CAPTURING=1
    run_tool_update_impl "$tool" >&5 2>&1 || rc=$?
    exec 5>&-
    wait "$sink" 2>/dev/null || true
    UPDATE_REPORT_CAPTURING=0
  else
    run_tool_update_impl "$tool" >> "$UPDATE_REPORT_LOG" 2>&1 || rc=$?
  fi
  if [ -t 4 ] && [ "$AIUP_VERBOSE" -eq 0 ]; then printf '\r\033[2K' >&4; fi
  UPDATE_REPORT_LOG_END="$(wc -c < "$UPDATE_REPORT_LOG")"
  UPDATE_REPORT_TOOL_SECONDS=$(( $(date +%s) - tool_started ))
  UPDATE_REPORT_COMPLETED=$((UPDATE_REPORT_COMPLETED + 1))
  profile_mark "update $tool"
  update_report_warnings
  UPDATE_REPORT_WARNINGS=$((UPDATE_REPORT_WARNINGS + UPDATE_REPORT_WARNING))
  if [ "$rc" -ne 0 ] || [ "$AIUP_LAST_UPDATE_STATUS" != current ]; then
    brew_cache_invalidate
    brew_cache_load
  fi
  if [ "$rc" -eq 0 ]; then
    update_report_record "$tool" "$AIUP_LAST_UPDATE_STATUS"
  else
    update_report_record "$tool" failed
  fi
  return "$rc"
}

print_update_report() {
  local color=0 width=80
  if [ -t 4 ]; then
    [ -n "${NO_COLOR:-}" ] || color=1
    width="$(stty size </dev/tty 2>/dev/null | awk '{print $2}')"
  fi
  printf '%s\n' ${UPDATE_REPORT_ROWS[@]+"${UPDATE_REPORT_ROWS[@]}"} | python3 -c '
import sys, re, textwrap, json, os, time
from pathlib import Path
from collections import Counter
color, width, seconds, logfile, mode, save_only, show_all = sys.argv[1:]
color = color == "1"
width = max(30, min(int(width or 80), 140))
def ink(text, code):
    return "\033[" + code + "m" + text + "\033[0m" if color else text
def clean(text):
    return re.sub(r"[\x00-\x1f\x7f-\x9f]", "", re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", text))
def version(text):
    text = clean(text)
    match = re.search(r"\d+\.\d+[^\s]*", text)
    return match.group(0) if match else text
rows = {}
for line in sys.stdin:
    fields = line.rstrip("\n").split("\t")
    if len(fields) < 6: continue
    tool, status, before, after, category, note = map(clean, fields[:6])
    start, end, warning = map(int, fields[6:9]) if len(fields) >= 9 else (0, 0, 0)
    before, after = version(before), version(after)
    known = lambda v: bool(re.fullmatch(r"(?:v?\d[0-9A-Za-z._,+-]*|r\d+)", v))
    if mode == "update" and status in ("completed", "current"):
        if before == "not installed" and known(after): status = "installed"
        elif known(before) and known(after): status = "unchanged" if before == after else "updated"
        else: status = "unverified"
    versions = before + " → " + after if before != after else after
    if status == "planned": versions = before
    rows[tool] = (status, versions, category, note, before, after, start, end, warning, int(fields[9]) if len(fields)>9 else 0)
counts = Counter(row[0] for row in rows.values())
warning_count = sum(bool(row[8]) for row in rows.values())
if mode == "update":
    data = {"schema": "aiup-run-v1", "started": time.time()-int(seconds), "duration": int(seconds),
            "status": "running" if save_only else "complete", "log": Path(logfile).name,
            "tools": [{"tool": tool, "result": row[0], "before": row[4], "after": row[5],
                       "note": row[3], "start": row[6], "end": row[7], "warning": bool(row[8]), "duration": row[9]}
                      for tool,row in rows.items()]}
    target = Path(logfile + ".json")
    temp = Path(logfile + ".json.next")
    with temp.open("x") as handle:
        os.chmod(temp, 0o600)
        json.dump(data, handle, indent=2)
    os.replace(temp, target)
if save_only: raise SystemExit(0)
hidden = 0
if mode == "update" and show_all != "1":
    visible = {t:r for t,r in rows.items() if r[0] != "unchanged" or r[8] or r[3]}
    hidden = len(rows) - len(visible)
else: visible = rows
if warning_count: counts["with warnings"] = warning_count
print("\n" + ink("  aiup · " + ("update check" if mode == "check" else "results"), "1;38;5;141"))
for part in textwrap.wrap(" · ".join(str(n)+" "+state for state,n in counts.items()) + " · " + seconds + "s", width-4):
    print(ink("  " + part, "38;5;245"))
print(ink("  " + "─" * (width-4), "38;5;60"))
tool_width = min(32, max(19, max((len(t)+2 for t in rows), default=19)))
if width >= 76:
    print(ink("  " + "TOOL".ljust(tool_width) + "RESULT".ljust(13) + "VERSION", "38;5;81"))
for tool, (status, versions, category, note, before, after, start, end, warning, duration) in visible.items():
    code = "38;2;57;255;20" if status in ("updated", "installed", "update", "cleaned") else "38;5;245"
    if status in ("failed", "unverified"): code = "38;5;203"
    elif status in ("skipped", "planned"): code = "38;5;220"
    if mode == "update": versions += " · " + str(duration) + "s"
    if warning: status += " !"
    name_code = category if re.fullmatch(r"[0-9;]+", category) else "38;5;250"
    display_tool = tool
    if width >= 76 and len(tool) >= tool_width:
        for part in textwrap.wrap(tool, width-4): print("  " + ink(part, name_code))
        display_tool = ""
    name = ink(display_tool.ljust(tool_width) if width >= 76 else tool, name_code)
    if width >= 76:
        parts = textwrap.wrap(versions, max(12,width-tool_width-17)) or ["unknown"]
        print("  " + name + ink(status.ljust(13), code) + parts[0])
        for part in parts[1:]: print(" "*(tool_width+15) + part)
    else:
        print("  " + name + "  " + ink(status,code))
        for part in textwrap.wrap(versions, width-6): print("      " + part)
    if note:
        for part in textwrap.wrap(note, width-6): print(ink("      " + part, "38;5;220"))
print(ink("  " + "─" * (width-4), "38;5;60"))
if hidden: print(ink(f"  {hidden} unchanged tools hidden · use --show-unchanged for the full list", "38;5;245"))
if mode == "update":
    print(ink("  Run log: " + logfile, "38;5;245"))
else:
    print(ink("  Read-only check · no tools changed", "38;5;245"))
' "$color" "$width" "$(( $(date +%s) - UPDATE_REPORT_STARTED ))" "$UPDATE_REPORT_LOG" "$UPDATE_REPORT_MODE" "${1:-}" "${AIUP_SHOW_UNCHANGED:-0}"
  [ -z "${1:-}" ] || return 0
  rm -f "${UPDATE_REPORT_LOG}.active"
  if [ "$UPDATE_REPORT_MODE" = check ]; then rm -f "$UPDATE_REPORT_LOG"; fi
  [ "$UPDATE_REPORT_MODE" != update ] || run_history prune
}

run_tool_update_impl() {
  local tool="$1"
  local result_kind policy missing_app
  policy="$(policy_reason "$tool")" || { append_failure "$tool"; return 1; }
  if [ -n "$policy" ]; then
    UPDATE_REPORT_NOTE="$policy"
    update_status_set skipped
    result_record skipped "$tool"
    info "$tool: $policy"
    tool_is_present "$tool" || { append_failure "$tool"; return 1; }
    return 0
  fi
  if missing_app="$(brew_missing_app_for_tool "$tool")"; then
    local cleanup_id="$tool"
    case "$tool" in bc:*) ;; *) cleanup_id="bc:$(catalog_brew_cask "$tool")" ;; esac
    if cleanup_missing_homebrew_app "$cleanup_id"; then
      if [ "$DRY_RUN" -eq 1 ]; then
        update_status_set planned
        UPDATE_REPORT_NOTE="Would clean Homebrew record for removed app: $missing_app"
      else
        update_status_set cleaned
        UPDATE_REPORT_NOTE="App removed: $missing_app. Finished Homebrew uninstall; no reinstall or preference purge."
      fi
      result_record "$AIUP_LAST_UPDATE_STATUS" "$tool"
      return 0
    fi
    UPDATE_REPORT_NOTE="Could not finish Homebrew cleanup for $missing_app; inspect the run log."
    append_failure "$tool"
    return 1
  fi
  if update_tool_confirmed_current "$tool"; then
    update_status_set current
    result_record current "$tool"
    info "$tool is current in this run's Homebrew snapshot"
    return 0
  fi
  mutation_authoritative_preflight "$tool update" || return 1
  brew_cache_load
  ensure_system_npm_prefix
  info "========== TOOL START: $tool =========="
  AIUP_LAST_UPDATE_STATUS=completed
  if [ "${AIUP_TUI_TESTING:-0}" = 1 ] && capture_fixture_enabled && [ -n "${AIUP_TUI_TEST_MUTATION_COMMAND:-}" ]; then
    if "$AIUP_TUI_TEST_MUTATION_COMMAND" "$tool" update; then
      result_record completed "$tool"
      info "========== TOOL DONE: $tool =========="
      tui_cache_invalidate
      return 0
    fi
    error "========== TOOL FAILED: $tool =========="
    append_failure "$tool"
    tui_cache_invalidate
    return 1
  fi
  case "$tool" in
    bf:*|bc:*)
      if update_installed_brew_extra "$tool"; then
        result_record "${AIUP_LAST_UPDATE_STATUS:-completed}" "$tool"
        return 0
      fi
      append_failure "$tool"; return 1 ;;
  esac
  if type "update_$tool" >/dev/null 2>&1; then
    if "update_$tool"; then
      result_kind="${AIUP_LAST_UPDATE_STATUS:-completed}"
      case "$result_kind" in
        current|skipped) result_record "$result_kind" "$tool" ;;
        *) result_record completed "$tool" ;;
      esac
      info "========== TOOL DONE: $tool =========="
      tui_cache_invalidate
      return 0
    fi
  elif update_by_kind "$tool"; then
    result_kind="${AIUP_LAST_UPDATE_STATUS:-completed}"
    case "$result_kind" in
      current|skipped) result_record "$result_kind" "$tool" ;;
      *) result_record completed "$tool" ;;
    esac
    info "========== TOOL DONE: $tool =========="
    tui_cache_invalidate
    return 0
  fi
  error "========== TOOL FAILED: $tool =========="
  append_failure "$tool"
  tui_cache_invalidate
  return 1
}

mutation_authoritative_preflight() {
  local operation="$1" runtime current_runtime_hash
  tui_cache_invalidate
  brew_cache_invalidate
  runtime="$(tui_runtime_path)"
  require_runtime_environment || return 1
  bash -n "$runtime" || { error "Runtime revalidation failed before $operation"; return 1; }
  current_runtime_hash="$(sha256_file "$runtime")" || return 1
  CATALOG_MANIFEST_LOADED=0
  catalog_manifest_load || { error "Manifest revalidation failed before $operation"; return 1; }
  catalog_validate || { error "Catalog revalidation failed before $operation"; return 1; }
  AIUP_RUNTIME_HASH="$current_runtime_hash"
  return 0
}

print_summary_versions() {
  local tool version
  printf '\n=== Detected tool versions ===\n'
  for tool in "${TOOLS_CATALOG[@]}"; do
    if tool_is_present "$tool"; then
      version="$(version_of_tool "$tool")"
      [ -n "$version" ] || version='version unavailable'
      printf '%-12s %s\n' "$tool" "$version"
    fi
  done
}

print_doctor() {
  ensure_system_npm_prefix
  progress_start 1 "Looking for tools on your Mac"
  progress_tick "Reading your Homebrew inventory"
  brew_cache_load
  progress_end
  local node_path node_ver npm_path npm_ver sys_npm_prefix sys_npm_bin fragile brew_node_versions brew_node_stable brew_node_outdated_status
  node_path="$(command_path node)"
  npm_path="$(command_path npm)"
  node_ver="$(node --version 2>/dev/null || printf 'not found\n')"
  npm_ver="$(npm --version 2>/dev/null || printf 'not found\n')"
  sys_npm_prefix="$(system_npm_prefix)"
  sys_npm_bin="$(system_npm_bin)"
  brew_node_versions="$(brew list --versions node 2>/dev/null || printf 'not installed\n')"
  brew_node_stable="$(brew_node_stable_version)"
  if brew_node_outdated; then
    brew_node_outdated_status="yes"
  else
    brew_node_outdated_status="no"
  fi
  fragile="no"
  if grep -Eq '^export PATH="(?:/opt/homebrew|/usr/local)/Cellar/node/.*/bin:\$PATH"$' "$HOME/.zshrc" 2>/dev/null || grep -Eq '^export PATH="(?:/opt/homebrew|/usr/local)/Cellar/node/.*/bin:\$PATH"$' "$HOME/.zprofile" 2>/dev/null; then
    fragile="yes"
