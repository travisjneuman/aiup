  : > "$staging/expanded"
  [ -f "$DEFAULT_LIST_QUERY_FILE" ] && cp "$DEFAULT_LIST_QUERY_FILE" "$staging/query" || : > "$staging/query"
  [ -f "$DEFAULT_LIST_CATEGORY_FILE" ] && cp "$DEFAULT_LIST_CATEGORY_FILE" "$staging/category" || : > "$staging/category"
  [ -f "$DEFAULT_LIST_SELECTED_FILE" ] && cp "$DEFAULT_LIST_SELECTED_FILE" "$staging/selected" || : > "$staging/selected"
  printf '%s\n' "$token" > "$staging/token"
  chmod 600 "$staging/token"
  runtime="$(tui_runtime_path)"
  now="$(date +%s)"
  snapshot="${AIUP_TUI_SNAPSHOT_GENERATION:-uncached-$now-$nonce}"
  AIUP_TUI_SNAPSHOT_GENERATION="$snapshot"
  saved_expand="$EXPAND_FILE"; saved_query="$LIST_QUERY_FILE"; saved_category="$LIST_CATEGORY_FILE"; saved_selected="$LIST_SELECTED_FILE"
  EXPAND_FILE="$staging/expanded"; LIST_QUERY_FILE="$staging/query"; LIST_CATEGORY_FILE="$staging/category"; LIST_SELECTED_FILE="$staging/selected"
  expand_all_categories
  : > "$LIST_QUERY_FILE"
  if [ -n "$AIUP_TUI_CACHED_ROWS" ] && [ -f "$AIUP_TUI_CACHED_ROWS" ] && [ ! -L "$AIUP_TUI_CACHED_ROWS" ]; then
    cp "$AIUP_TUI_CACHED_ROWS" "$staging/rows-base.tsv" || return 1
  else
    emit_fzf_rows_from_index | sort_fzf_rows > "$staging/rows-base.tsv" || return 1
  fi
  profile_mark "session base rows"
  # Final activation below validates the complete session once. Avoid a second
  # full hash pass over the still-private staging directory.
  tui_updates_publish "$staging" "$token" "$snapshot" 1 || return 1
  profile_mark "session Updates snapshot"
  : > "$EXPAND_FILE"
  awk -F '\t' '$1 ~ /^__cat:/ {print}' "$staging/rows-expanded.tsv" > "$staging/rows-collapsed.tsv" || return 1
  [ -f "$DEFAULT_LIST_QUERY_FILE" ] && cp "$DEFAULT_LIST_QUERY_FILE" "$staging/query" || : > "$staging/query"
  EXPAND_FILE="$saved_expand"; LIST_QUERY_FILE="$saved_query"; LIST_CATEGORY_FILE="$saved_category"; LIST_SELECTED_FILE="$saved_selected"
  python3 - "$staging/meta.tsv" "$runtime" "$CATALOG_MANIFEST" "$snapshot" "$$" "$nonce" "$now" \
    "$LIST_VIEW_MODE" "$LIST_CATEGORY_FILTER" "$LIST_SORT_MODE" "$AIUP_TUI_CACHE_SCHEMA" "$AIUP_VERSION" "$CATALOG_MANIFEST_VERSION" <<'PY'
