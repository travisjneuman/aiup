format_category_header() {
  local cat="$1"
  local n_inst="$2"
  local n_abs="$3"
  local indent="${4:-0}"
  local reset arrow bar name extra pad shown
  reset=$'\033[0m'
  if category_expanded "$cat"; then
    arrow='▾'
  else
    arrow='▸'
  fi
  bar="$(catalog_ansi "$cat")▌${reset}"
  shown="${cat##*/}"
  [ "$cat" = 'detected' ] && shown='detected software'
  if [ "$indent" -gt 0 ]; then
    pad="$(printf '%*s' $((indent * 4)) '')"
    name="$(catalog_ansi "$cat")${pad}$(printf '%-14s' "$shown")${reset}"
  else
    name="$(catalog_ansi "$cat")$(printf '%-16s' "$shown")${reset}"
  fi
  case "$cat" in
    detected)
      extra="$(detected_source_summary)"
      ;;
    homebrew)
      if homebrew_available_loaded; then
        extra="${n_inst} extra rows / ${n_abs} available Homebrew extras"
      else
        extra="${n_inst} extra rows / ${n_abs} curated recommendations"
      fi
      ;;
    homebrew/recommended)
      extra="${n_inst} already on your Mac / ${n_abs} curated recommendations"
      ;;
    homebrew/fonts)
      if homebrew_available_loaded; then
        extra="${n_inst} installed via Homebrew / ${n_abs} available font casks"
      else
        extra="${n_inst} installed via Homebrew / full font catalog in --view available"
      fi
      ;;
    homebrew/available)
      if homebrew_available_loaded; then
        extra="${n_abs} non-managed Homebrew extras (excluding font casks)"
      else
        extra="full Homebrew catalog not loaded · use --view available"
      fi
      ;;
    homebrew/*)
      extra="${n_inst} already on your Mac via Homebrew"
      ;;
    *)
      extra="${n_inst} installed / ${n_abs} absent"
      ;;
  esac
  printf '%s\t%s %s %s  %s' "__cat:${cat}" "$bar" "$arrow" "$name" "$extra"
}

detected_source_summary() {
