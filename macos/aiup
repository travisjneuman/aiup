# The managed catalog is declarative. Installer actions remain in this file,
# but ids, categories, lifecycle, labels, and official docs live in the TSV so
# catalog presentation does not require editing a large switch statement.
catalog_manifest_load() {
  local id category kind lifecycle label docs target endpoint
  [ "${CATALOG_MANIFEST_LOADED:-0}" -eq 1 ] && return 0
  [ -f "$CATALOG_MANIFEST" ] || {
    error "Catalog manifest not found: $CATALOG_MANIFEST"
    return 1
  }
  TOOLS_CATALOG=()
  CATALOG_IDS=()
  CATALOG_CATEGORIES=()
  CATALOG_KINDS=()
  CATALOG_LIFECYCLES=()
  CATALOG_LABELS=()
  CATALOG_DOCS=()
  CATALOG_TARGETS=()
  CATALOG_ENDPOINTS=()
  CATALOG_MANIFEST_VERSION="$(sed -n 's/^# aiup-runtime-version: //p' "$CATALOG_MANIFEST" | head -n 1)"
  [ "$CATALOG_MANIFEST_VERSION" = "$AIUP_VERSION" ] || {
    error "Catalog manifest version '$CATALOG_MANIFEST_VERSION' does not match aiup '$AIUP_VERSION'"
    return 1
  }
  while IFS=$'\t' read -r id category kind lifecycle label docs target endpoint; do
    case "$id" in
      ''|'#'*) continue ;;
    esac
    [ -n "$category" ] && [ -n "$kind" ] && [ -n "$label" ] && [ -n "$docs" ] || {
      error "Invalid catalog manifest row for '$id'"
      return 1
    }
    TOOLS_CATALOG+=("$id")
    CATALOG_IDS+=("$id")
    CATALOG_CATEGORIES+=("$category")
    CATALOG_KINDS+=("$kind")
    CATALOG_LIFECYCLES+=("$lifecycle")
    CATALOG_LABELS+=("$label")
    CATALOG_DOCS+=("$docs")
    CATALOG_TARGETS+=("${target:-}")
    CATALOG_ENDPOINTS+=("${endpoint:-}")
  done < "$CATALOG_MANIFEST"
  CATALOG_MANIFEST_HASH="$(sha256_file "$CATALOG_MANIFEST")" || return 1
  CATALOG_MANIFEST_LOADED=1
  profile_mark "manifest parsing"
}

catalog_manifest_field() {
  local id="$1"
  local field="$2"
  local i=0 value=""
  catalog_manifest_load || return 1
  while [ "$i" -lt "${#CATALOG_IDS[@]}" ]; do
    if [ "${CATALOG_IDS[$i]}" = "$id" ]; then
      case "$field" in
        1) value="${CATALOG_IDS[$i]}" ;;
        2) value="${CATALOG_CATEGORIES[$i]}" ;;
        3) value="${CATALOG_KINDS[$i]}" ;;
