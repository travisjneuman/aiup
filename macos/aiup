npm_install_aiup_latest() {
  local pkg="$1" name current latest raw
  ensure_managed_paths
  name="${pkg%@*}"
  # Only skip a healthy install in the target prefix, on a fresh exact match.
  # Native/system-to-aiup migration and explicit repair keep their normal path.
  if [ "$AIUP_FORCE" -eq 0 ] && [ "$DRY_RUN" -eq 0 ] && [ "${pkg##*@}" = latest ] && [ -f "$AIUP_NPM_NODE_MODULES/$name/package.json" ]; then
    current="$(python3 - "$AIUP_NPM_NODE_MODULES/$name" "$AIUP_NPM_BIN" <<'PYCODE'
import json, os, sys
from pathlib import Path
try:
    root, binroot = map(Path, sys.argv[1:])
    data = json.loads((root / "package.json").read_text())
    bins = data.get("bin") or {}
    if isinstance(bins, str): bins = {data["name"].split("/")[-1]: bins}
    if bins and all((root / path).is_file() and os.access(binroot / name, os.X_OK) and (binroot / name).resolve() == (root / path).resolve() for name,path in bins.items()):
        print(data.get("version", ""))
except (OSError, ValueError, KeyError, TypeError):
    pass
PYCODE
)"
    if [ -n "$current" ]; then
      ensure_dir "$AVAILABLE_VERSION_CACHE_DIR"
      raw="$(mktemp "$AVAILABLE_VERSION_CACHE_DIR/.npm-check.XXXXXX")" || return 1
      if bounded_provider_capture "$raw" "$AVAILABLE_VERSION_PROVIDER_TIMEOUT" env npm view "$pkg" version --fetch-retries=0 --fetch-timeout=3000; then
        latest="$(cat "$raw")"
        if [ "$latest" = "$current" ]; then
          rm -f "$raw"
          update_status_set current
          info "$name is current ($current); no reinstall needed"
          return 0
        fi
      fi
      rm -f "$raw"
    fi
  fi
  run_with_heartbeat "npm install -g --prefix $AIUP_NPM_PREFIX $pkg" npm install -g --prefix "$AIUP_NPM_PREFIX" "$pkg"
}

npm_uninstall_system_pkg_if_distinct() {
  local pkg="$1"
  local sys_prefix
  sys_prefix="$(system_npm_prefix)"
  if [ -n "$sys_prefix" ] && [ "$sys_prefix" = "$AIUP_NPM_PREFIX" ]; then
    return 0
  fi
  if system_npm_pkg_installed "$pkg"; then
    run_with_heartbeat "npm uninstall -g $pkg (system prefix $sys_prefix)" env NPM_CONFIG_PREFIX="$sys_prefix" npm uninstall -g "$pkg" || true
  fi
}

