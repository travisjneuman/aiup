generic_method() {
  local tool="$1"
  local kind bin formula cask pkg app
  kind="$(catalog_kind "$tool")"
  bin="$(binary_of_tool "$tool")"
  formula="$(catalog_brew_formula "$tool")"
  cask="$(catalog_brew_cask "$tool")"
  pkg="$(catalog_npm_pkg "$tool")"
  app="$(catalog_app_path "$tool")"
  case "$kind" in
    aiup-npm)
      if [ -n "$pkg" ] && aiup_npm_pkg_installed "$pkg"; then printf 'aiup-npm\n'; return 0; fi
      if [ -n "$pkg" ] && system_npm_pkg_installed "$pkg"; then printf 'npm-global\n'; return 0; fi
      ;;
    brew-formula)
      if [ -n "$formula" ] && brew_formula_installed "$formula"; then printf 'brew-formula\n'; return 0; fi
      ;;
    brew-cask)
      if [ -n "$cask" ] && brew_cask_installed "$cask"; then printf 'brew-cask\n'; return 0; fi
      if [ -n "$app" ] && [ -d "$app" ]; then printf 'app\n'; return 0; fi
      ;;
    app)
      if [ -n "$app" ] && [ -d "$app" ]; then printf 'app\n'; return 0; fi
      ;;
    curl-installer|uv-tool)
      ;;
  esac
  if [ -n "$bin" ] && command_exists "$bin"; then
    printf 'manual\n'
  else
    printf 'missing\n'
  fi
}

