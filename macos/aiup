resolve_tools() {
  local arg
  local out=()
  for arg in "$@"; do
    case "$arg" in
      brew|homebrew) out+=("brew") ;;
      npm|uv|fzf|gh|wrangler|deno|bun|pnpm|jq|yq|ripgrep|fd|just|shellcheck|actionlint|claude|codex|antigravity|opencode|kilo|gsd2|hermes|pi|grok|warp|gemini|copilot|aider|goose|cursor|qwen|crush|amp|kiro|droid|kimi|openclaw|cline|continue|interpreter|pi-acp|llm|mods|aichat|fabric|sgpt|vibe|openhands|llama-cpp|llama-app|whisper-cpp|ollama|lm-studio|jan|gpt4all|anythingllm|mlx|mlx-lm|chatgpt|cursor-ide|zed|cmux|ollama-app|t3-code|t3-nightly|grokbot|hermes-desktop|vscode|vscode-insiders|claude-app|copilot-app|opencode-desktop|antigravity-ide|perplexity|macwhisper|screenpipe|n8n|remotion|warp-app|ghostty|iterm2) out+=("$arg") ;;
      vscode-code|code) out+=("vscode") ;;
      t3) out+=("t3-code") ;;
      grok-bot) out+=("grokbot") ;;
      claude-desktop) out+=("claude-app") ;;
      warp-terminal) out+=("warp-app") ;;
      agy|antigravity-cli) out+=("antigravity") ;;
      node) out+=("npm") ;;
      gsd|gsd-pi) out+=("gsd2") ;;
      oz) out+=("warp") ;;
      cursor-agent) out+=("cursor") ;;
      cn) out+=("continue") ;;
      fabric-ai) out+=("fabric") ;;
      kiro-cli) out+=("kiro") ;;
      kimi-code) out+=("kimi") ;;
      shell-gpt) out+=("sgpt") ;;
      bf:*|bc:*)
        local name="${arg#*:}"
        case "$name" in ''|-*|*[!A-Za-z0-9@+._/-]*) error "Invalid Homebrew identity: $arg"; return 1 ;; esac
        [ "$arg" != bf:node ] || { out+=(npm); continue; }
        catalog_covers_brew "$name" && { error "Use the catalog ID for $name"; return 1; }
        tool_is_present "$arg" || { error "Homebrew package is not installed: $arg"; return 1; }
        out+=("$arg") ;;
      *)
        if catalog_manifest_field "$arg" 1 >/dev/null 2>&1; then out+=("$arg")
        else error "Unknown tool: $arg"; return 1; fi ;;
    esac
  done
  printf '%s\n' "${out[@]}"
}

should_skip_install_for_missing() {
  local tool="$1"
  if capture_fixture_enabled; then
    if [ "$NO_INSTALL" -eq 1 ] && [ "$(catalog_state_for_tool "$tool")" != installed ]; then
      warn "Skipping missing tool: $tool"
      return 0
    fi
    return 1
  fi
  if [ "$NO_INSTALL" -eq 1 ] && ! tool_is_present "$tool"; then
    warn "Skipping missing tool: $tool"
    return 0
  fi
  return 1
}

# Only manager-owned installed extras enter the normal run. Keep catalog aliases
# canonical so holds/exclusions cannot be bypassed by a second Homebrew identity.
installed_update_tools() {
  local tool name
  for tool in "${TOOLS_CATALOG[@]}"; do tool_is_present "$tool" && printf '%s\n' "$tool"; done
  catalog_brew_index_init
  # node is owned by the npm updater, not a separate catalog formula.
  for name in $(printf '%s\n' "$AIUP_BREW_FORMULA_VERSIONS" | awk 'NF {print $1}'); do
    [ "$name" = node ] && continue
    catalog_covers_brew "$name" || printf 'bf:%s\n' "$name"
  done
  for name in $(printf '%s\n' "$AIUP_BREW_CASK_VERSIONS" | awk 'NF {print $1}'); do
    catalog_covers_brew "$name" || printf 'bc:%s\n' "$name"
  done
}

cmd_update_installed() {
  local tool
  local -a selected=()
  brew_cache_load
  ensure_system_npm_prefix
  while IFS= read -r tool; do [ -z "$tool" ] || selected+=("$tool"); done < <(installed_update_tools)
  update_report_begin "${AIUP_REQUIRED_TOOLS[@]}" "${selected[@]}" || return 1
  main_update "${selected[@]}"
}

update_tool_confirmed_current() {
  local tool="$1" kind target
  [ "$UPDATE_REPORT_ACTIVE" -eq 1 ] && [ -n "${_AIUP_BREW_UPDATED:-}" ] || return 1
  [ "${AIUP_BREW_OUTDATED_READY:-0}" -eq 1 ] || return 1
  kind="$(catalog_kind "$tool")"
  case "$tool:$kind" in
    npm:*) kind=brew-formula; target=node ;;
    *:brew-formula) target="$(catalog_brew_formula "$tool")" ;;
    *:brew-cask) target="$(catalog_brew_cask "$tool")" ;;
    *) return 1 ;;
  esac
  case "$kind" in
    brew-formula) brew_formula_installed "$target" || return 1; brew_target_current formula "$target" ;;
    brew-cask) brew_cask_installed "$target" || return 1; brew_target_current cask "$target" ;;
  esac
}

update_installed_brew_extra() {
  local tool="$1" name="${1#*:}"
  tool_is_present "$tool" || { update_status_set skipped; UPDATE_REPORT_NOTE='No longer installed through Homebrew'; return 0; }
  brew_update_once || return 1
  case "$tool" in
    bf:*)
      if brew_target_current formula "$name"; then update_status_set current; return 0; fi
      brew_ensure_target_tap "" "$name" formula || return 1
      run_with_heartbeat "brew upgrade $name" env HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew upgrade --formula --yes "$name" ;;
    bc:*)
      if brew_target_current cask "$name"; then update_status_set current; return 0; fi
      brew_ensure_target_tap "" "$name" cask || return 1
      run_with_heartbeat "brew upgrade --cask $name" env HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew upgrade --cask --greedy --yes "$name" ;;
  esac
}

main_update() {
  [ "$UPDATE_REPORT_ACTIVE" -eq 1 ] || AIUP_BREW_OUTDATED_READY=0
  local tools=("$@")
  local tool required
  ensure_managed_paths
  if [ "${AIUP_VERIFIED_SELECTION_ONLY:-0}" != 1 ]; then
    ensure_required_tools_present || return 1
  else
    for required in "${AIUP_REQUIRED_TOOLS[@]}"; do
      tool_is_present "$required" || { error "Required infrastructure '$required' disappeared before the verified update"; return 1; }
    done
  fi
  if [ "${AIUP_VERIFIED_SELECTION_ONLY:-0}" != 1 ]; then
    for required in "${AIUP_REQUIRED_TOOLS[@]}"; do
      case " ${tools[*]} " in
        *" $required "*) ;;
        *) tools=("$required" "${tools[@]}") ;;
      esac
    done
  fi
  ensure_catalog_deps "${tools[@]}" || return 1
  for tool in "${tools[@]}"; do
    case "$AIUP_REQUIRED_UPDATED" in
      *"|$tool|"*) continue ;;
    esac
    if should_skip_install_for_missing "$tool"; then
      result_record skipped "$tool"
      if [ "$UPDATE_REPORT_ACTIVE" -eq 1 ]; then update_report_record "$tool" skipped; fi
      continue
    fi
    run_tool_update "$tool" || true
  done
  brew_cache_invalidate
  if [ "${AIUP_KEEP_UI:-0}" != 1 ]; then
    if [ "$UPDATE_REPORT_ACTIVE" -eq 1 ]; then print_update_report
    else print_result_summary; print_summary_versions; fi
  fi
  if [ "${#FAILED_TOOLS[@]}" -gt 0 ]; then
    printf '\nFailed tools: %s\n' "${FAILED_TOOLS[*]}" >&2
    return 1
  fi
  info "========== AIUP COMPLETE =========="
  return 0
}

parse_args() {
  local args=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --timings)
        AIUP_PROFILE_ENABLED=1
        profile_begin
        shift
        ;;
      --force)
        AIUP_FORCE=1
        shift
        ;;
      --show-unchanged)
        AIUP_SHOW_UNCHANGED=1
        shift
        ;;
      --verbose)
        AIUP_VERBOSE=1
        shift
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      --no-install)
        NO_INSTALL=1
        NO_INSTALL_EXPLICIT=1
        shift
        ;;
      --heartbeat-seconds)
        HEARTBEAT_SECONDS="$2"
        shift 2
        ;;
      --category)
        LIST_CATEGORY_FILTER="$2"
        shift 2
        ;;
      --view)
        LIST_VIEW_MODE="$2"
        shift 2
        ;;
      --sort)
        LIST_SORT_MODE="$2"
        shift 2
        ;;
      --refresh)
        INVENTORY_REFRESH=1
        shift
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done

  require_runtime_environment || return 1
  AIUP_RUNTIME_HASH="$(sha256_file "$(tui_runtime_path)")" || return 1
  profile_mark "runtime validation"
  catalog_validate || return 1

  case "$LIST_VIEW_MODE" in
    overview|all|installed|managed|detected|available) ;;
    *) error "Unknown list view: $LIST_VIEW_MODE"; return 1 ;;
  esac

  case "$LIST_SORT_MODE" in
    id|label) ;;
    *) error "Unknown list sort: $LIST_SORT_MODE"; return 1 ;;
  esac

  if [ -n "$LIST_CATEGORY_FILTER" ]; then
    case " ${CATEGORY_ORDER[*]} homebrew/casks homebrew/fonts homebrew/formulae homebrew/libraries homebrew/recommended homebrew/available " in
      *" $LIST_CATEGORY_FILTER "*) ;;
      *) error "Unknown category: $LIST_CATEGORY_FILTER"; return 1 ;;
    esac
  fi

  if [ "${#args[@]}" -eq 0 ]; then
    cmd_update_installed
    return $?
  fi

  case "${args[0]}" in
    full|core)
      cmd_update_installed
      ;;
    only)
      if [ "${#args[@]}" -lt 2 ]; then
        error "No tools specified for 'only'"
        return 1
      fi
      if [ "$NO_INSTALL_EXPLICIT" -eq 0 ]; then
        NO_INSTALL=0
      fi
      local resolved
      resolved="$(resolve_tools "${args[@]:1}")" || return 1
      local -a selected=()
      local line
      while IFS= read -r line; do
        [ -n "$line" ] && selected+=("$line")
      done <<< "$resolved"
      update_report_begin "${AIUP_REQUIRED_TOOLS[@]}" "${selected[@]}" || return 1
      main_update "${selected[@]}"
      ;;
    __fzf-rows)
      emit_fzf_rows_from_index | sort_fzf_rows
      ;;
    __search-query)
      ensure_dir "$STATE_DIR"
      printf '%s' "${args[*]:1}" > "$LIST_QUERY_FILE"
      ;;
    __fzf-header)
      catalog_header_text "${FZF_COLUMNS:-}"
      ;;
    __cat-toggle)
      toggle_category "${args[1]:-}"
      refresh_fzf_listfile "${args[2]:-}"
      ;;
    __cat-expand)
      expand_category "${args[1]:-}"
      refresh_fzf_listfile "${args[2]:-}"
      ;;
    __cat-collapse)
      collapse_category "${args[1]:-}"
      refresh_fzf_listfile "${args[2]:-}"
      ;;
    __cat-nav)
      category_nav_action "${args[1]:-}" "${args[2]:-}" "${args[3]:-}"
      ;;
    __cat-jump)
      category_jump_action "${args[1]:-}" "${args[2]:-}"
      ;;
    __cat-expand-all)
      expand_all_categories
      refresh_fzf_listfile "${args[1]:-}"
      ;;
    __cat-collapse-all)
      collapse_all_categories
      refresh_fzf_listfile "${args[1]:-}"
      ;;
    __enter-action)
      enter_action_for "${args[1]:-}" "${args[2]:-}"
      ;;
    __tui-test-context)
      [ "${AIUP_TUI_TESTING:-0}" = 1 ] && capture_fixture_enabled || {
        error "private TUI test command is unavailable"
        return 1
      }
      scan_catalog_index all || return 1
      tui_session_create || return 1
      {
        printf 'session\t%s\n' "$AIUP_TUI_SESSION_DIR"
        printf 'token\t%s\n' "$AIUP_TUI_SESSION_TOKEN"
        printf 'runtime\t%s\n' "$(tui_runtime_path)"
        printf 'manifest\t%s\n' "$CATALOG_MANIFEST"
      } > "$STATE_DIR/test-session-context.tsv"
      local test_wait=0 test_wait_limit="${AIUP_TUI_TEST_SESSION_WAIT_STEPS:-400}"
      case "$test_wait_limit" in ''|*[!0-9]*) test_wait_limit=400 ;; esac
      [ "$test_wait_limit" -le 2400 ] || test_wait_limit=2400
      while [ ! -f "$STATE_DIR/test-session-release" ] && [ "$test_wait" -lt "$test_wait_limit" ]; do
        sleep 0.05
        test_wait=$((test_wait + 1))
      done
      [ -f "$STATE_DIR/test-session-release" ] || return 1
      ;;
    __tui-test-fzf-require)
      [ "${AIUP_TUI_TESTING:-0}" = 1 ] && capture_fixture_enabled || {
        error "private TUI test command is unavailable"
        return 1
      }
      ensure_fzf_for_interactive
      ;;
    __tui-test-available)
      [ "${AIUP_TUI_TESTING:-0}" = 1 ] && [ -n "${AIUP_FAKE_PROVIDER_COMMAND:-}" ] || {
        error "private available-version test command is unavailable"
        return 1
      }
      available_version_of_tool "${args[1]:-}" "${args[2]:-}"
      ;;
    coverage)
      cmd_coverage "${args[1]:-}"
      ;;
    project)
      [ "${#args[@]}" -eq 2 ] || { error 'Usage: aiup project <directory>'; return 1; }
      cmd_project "${args[1]}"
      ;;
    preferences)
      preferences show
      ;;
    exclude|include|unhold)
      [ "${#args[@]}" -eq 2 ] || { error 'Specify one managed tool ID'; return 1; }
      preferences "${args[0]}" "${args[1]}"
      ;;
    hold)
      [ "${#args[@]}" -eq 3 ] || { error 'Usage: aiup hold TOOL YYYY-MM-DD'; return 1; }
      preferences hold "${args[1]}" "${args[2]}"
      ;;
    group)
      case "${args[1]:-}" in
        set) preferences group-set "${args[@]:2}" ;;
        remove) preferences group-remove "${args[2]:-}" ;;
        run|check)
          local members member
          local -a group_tools=()
          members="$(preferences group-read "${args[2]:-}")" || return 1
          while IFS= read -r member; do [ -z "$member" ] || group_tools+=("$member"); done <<< "$members"
          [ "${#group_tools[@]}" -gt 0 ] || { error 'Group is empty'; return 1; }
          if [ "${args[1]}" = check ]; then cmd_check "${group_tools[@]}"
          else update_report_begin "${AIUP_REQUIRED_TOOLS[@]}" "${group_tools[@]}" && main_update "${group_tools[@]}"; fi
          ;;
        *) error 'Usage: aiup group set NAME TOOLS… | run NAME | check NAME | remove NAME'; return 1 ;;
      esac
      ;;
    retry)
      local retry_tools retry_tool
      local -a retry_selected=()
      retry_tools="$(run_history retry)" || return 1
      while IFS= read -r retry_tool; do [ -z "$retry_tool" ] || retry_selected+=("$retry_tool"); done <<< "$retry_tools"
      [ "${#retry_selected[@]}" -gt 0 ] || { printf 'No failed tools in the latest saved run.\n'; return 0; }
      resolve_tools "${retry_selected[@]}" >/dev/null || return 1
      [ "$NO_INSTALL_EXPLICIT" -eq 1 ] || NO_INSTALL=0
      update_report_begin "${AIUP_REQUIRED_TOOLS[@]}" "${retry_selected[@]}" && main_update "${retry_selected[@]}"
      ;;
    check)
      cmd_check "${args[@]:1}"
      ;;
    explain)
      [ "${#args[@]}" -eq 2 ] || { error 'Usage: aiup explain <tool>'; return 1; }
      cmd_explain "${args[1]}"
      ;;
    history|logs)
      [ "${#args[@]}" -le 2 ] || { error 'Usage: aiup history|logs [tool]'; return 1; }
      run_history "${args[0]}" "${args[1]:-}"
      ;;
    doctor)
      if [ "${args[1]:-}" = --details ]; then print_doctor; else cmd_diagnostics; fi
      ;;
    catalog)
      if [ "${args[1]:-}" = '--contracts' ]; then
        print_catalog_contracts
      else
        print_catalog_definition "${args[1]:---json}"
      fi
      ;;
    inventory)
      print_inventory_definition "${args[1]:---json}"
      ;;
    cleanup)
      [ "${#args[@]}" -le 3 ] && { [ "${#args[@]}" -lt 3 ] || [ "${args[2]}" = --apply ]; } || { error "Usage: aiup cleanup homebrew|bc:<name>|<detected-app-id> [--apply]"; return 1; }
      local cleanup_apply=0
      [ "${args[2]:-}" = '--apply' ] && cleanup_apply=1
      cmd_cleanup "${args[1]:-}" "$cleanup_apply"
      ;;
    list)
      if [ "${args[1]:-}" = '--plain' ] || [ "${args[1]:-}" = '--detected' ] || ! tty_usable; then
        if [ "${args[1]:-}" = '--detected' ]; then
          print_inventory_definition --plain
        else
          print_list
          profile_mark "row generation"
        fi
      else
        cmd_catalog_browse
      fi
      ;;
    preview)
      if [ "${#args[@]}" -lt 2 ]; then
        error "usage: aiup preview <tool>"
        return 1
      fi
      print_catalog_preview "${args[1]}"
      profile_mark "preview generation"
      ;;
    docs|home|open)
      cmd_docs "${args[@]:1}"
      ;;
    install)
      cmd_install_interactive
      ;;
    remove|uninstall)
      if [ "${#args[@]}" -ge 2 ]; then
        cmd_remove_named "${args[@]:1}"
      else
        cmd_remove_interactive
      fi
      ;;
    version)
      printf '%s\n' "$AIUP_VERSION"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      error "Unknown command: ${args[0]}"
      usage >&2
      return 1
      ;;
  esac
}

profile_begin
if tui_internal_command "${1:-}"; then
  if [ -n "${AIUP_TUI_SESSION_DIR:-}${AIUP_TUI_SESSION_TOKEN:-}" ]; then
    tui_session_activate || { error "Private TUI session validation failed"; exit 1; }
    tui_fast_dispatch "$@"
    exit $?
  fi
fi
parse_args "$@"
AIUP_EXIT_STATUS=$?
if [ "$UPDATE_REPORT_ACTIVE" -eq 1 ] && [ -f "${UPDATE_REPORT_LOG}.active" ]; then
  print_update_report || true
fi
exit "$AIUP_EXIT_STATUS"
