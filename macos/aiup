scan_brew_index() {
  local name rec child found_path
  if capture_fixture_enabled; then
    capture_fixture_copy brew-index.tsv "$BREW_INDEX"
    rm -f "$BREW_AVAILABLE_MARKER"
    return 0
  fi
  : > "$BREW_INDEX"
  brew_cache_load
  if homebrew_available_mode; then
    ensure_dir "$STATE_DIR"
    : > "$BREW_AVAILABLE_MARKER"
    progress_tick "Listing every Homebrew formula available from local taps"
    brew formulae 2>/dev/null | awk -v catalog="$BREW_CATALOG_NAMES" '
      NF && index(catalog, "|" $0 "|") == 0 {
        printf "homebrew/available\tabsent\tbf:%s\tHomebrew formula %s\n", $0, $0
      }
    ' >> "$BREW_INDEX" || true
    progress_tick "Listing every Homebrew cask available from local taps"
    brew casks 2>/dev/null | awk -v catalog="$BREW_CATALOG_NAMES" '
      NF && index(catalog, "|" $0 "|") == 0 {
        child = ($0 ~ /^font-/ ? "homebrew/fonts" : "homebrew/available")
        printf "%s\tabsent\tbc:%s\tHomebrew cask %s\n", child, $0, $0
      }
    ' >> "$BREW_INDEX" || true
    return 0
  fi
  rm -f "$BREW_AVAILABLE_MARKER"
  brew_missing_apps_load
  progress_tick "Listing Homebrew apps you already have"
  for name in $AIUP_BREW_CASKS; do
    [ -n "$name" ] || continue
    catalog_covers_brew "$name" && continue
    brew_missing_app_for_tool "bc:$name" >/dev/null && continue
    child="$(brew_child_for cask "$name" 0)"
    printf '%s\tinstalled\tbc:%s\t%s\n' "$child" "$name" "$(brew_extra_label cask "$name")" >> "$BREW_INDEX"
  done
  progress_tick "Listing command-line tools Homebrew knows about"
  for name in $AIUP_BREW_FORMULAE; do
    [ -n "$name" ] || continue
    catalog_covers_brew "$name" && continue
    child="$(brew_child_for formula "$name" 0)"
    printf '%s\tinstalled\tbf:%s\t%s\n' "$child" "$name" "$(brew_extra_label formula "$name")" >> "$BREW_INDEX"
  done
  progress_tick "Finding popular tools you don't have yet"
  for rec in "${HOMEBREW_RECOMMENDED_CASKS[@]}"; do
    catalog_covers_brew "$rec" && continue
    brew_cask_installed "$rec" && continue
    if found_path="$(app_path_for_cask "$rec")"; then
      printf 'homebrew/recommended\ton-disk\tbc:%s\t%s\t%s\n' "$rec" "$(brew_extra_label cask "$rec")" "$found_path" >> "$BREW_INDEX"
    else
      printf 'homebrew/recommended\tabsent\tbc:%s\t%s\n' "$rec" "$(brew_extra_label cask "$rec")" >> "$BREW_INDEX"
    fi
  done
  for rec in "${HOMEBREW_RECOMMENDED_FORMULAE[@]}"; do
    catalog_covers_brew "$rec" && continue
    brew_formula_installed "$rec" && continue
    if formula_present_outside_brew "$rec"; then
      found_path="$(command_path "$(formula_cmd_name "$rec")")"
      printf 'homebrew/recommended\ton-disk\tbf:%s\t%s\t%s\n' "$rec" "$(brew_extra_label formula "$rec")" "$found_path" >> "$BREW_INDEX"
    else
      printf 'homebrew/recommended\tabsent\tbf:%s\t%s\n' "$rec" "$(brew_extra_label formula "$rec")" >> "$BREW_INDEX"
    fi
  done
}

