    return 0
  fi
  if command_exists brew; then
    AIUP_BREW_FORMULAE=" $(env HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew list --formula 2>/dev/null | tr '\n' ' ') "
    AIUP_BREW_CASKS=" $(env HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew list --cask 2>/dev/null | tr '\n' ' ') "
  else
    AIUP_BREW_FORMULAE=" "
    AIUP_BREW_CASKS=" "
  fi
