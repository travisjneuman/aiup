sort_fzf_rows() {
  [ "$LIST_SORT_MODE" = 'id' ] && cat && return 0
  awk -F '\t' -v mode="$LIST_SORT_MODE" '
    $1 ~ /^__cat:/ {
      group++
      printf "%08d\t0\t\t%s\n", group, $0
      next
    }
    NF >= 2 {
      key = (mode == "label" ? $2 : $1)
      gsub(/\033\[[0-9;]*m/, "", key)
      printf "%08d\t1\t%s\t%s\n", group, key, $0
    }
  ' | LC_ALL=C sort -t $'\t' -k1,1n -k2,2n -k3,3 | cut -f4-
}

