# The managed catalog is declarative. Installer actions remain in this file,
# but ids, categories, lifecycle, labels, and official docs live in the TSV so
# catalog presentation does not require editing a large switch statement.
catalog_manifest_load() {
  [ "${CATALOG_MANIFEST_LOADED:-0}" -eq 1 ] && return 0
  [ -f "$CATALOG_MANIFEST" ] || {
    error "Catalog manifest not found: $CATALOG_MANIFEST"
    return 1
  }
  TOOLS_CATALOG=()
  while IFS=$'\t' read -r id category kind lifecycle label docs target; do
    case "$id" in
      ''|'#'*) continue ;;
    esac
    [ -n "$category" ] && [ -n "$kind" ] && [ -n "$label" ] && [ -n "$docs" ] || {
      error "Invalid catalog manifest row for '$id'"
      return 1
    }
    TOOLS_CATALOG+=("$id")
  done < "$CATALOG_MANIFEST"
  CATALOG_MANIFEST_LOADED=1
}

catalog_manifest_field() {
  local id="$1"
  local field="$2"
  catalog_manifest_load || return 1
  awk -F '\t' -v id="$id" -v field="$field" '$1==id {print $field; exit}' "$CATALOG_MANIFEST"
}

