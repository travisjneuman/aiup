progress_start() {
  PROGRESS_N="$1"
  PROGRESS_I=0
  PROGRESS_TITLE="${2:-Looking for tools on your Mac}"
  if ! tty_usable || [ "${PROGRESS_N:-0}" -lt 1 ]; then
    PROGRESS_N=0
    return 0
  fi
  printf '\033[?25l' >/dev/tty
}

progress_tick() {
  local detail="$1"
  local pct filled empty barw i c left right
  [ "${PROGRESS_N:-0}" -gt 0 ] || return 0
  PROGRESS_I=$((PROGRESS_I + 1))
  pct=$((PROGRESS_I * 100 / PROGRESS_N))
  [ "$pct" -gt 100 ] && pct=100
  c="$(tty_cols)"
  left="$(printf '  %s   %3d%%  %s/%s  ' "$PROGRESS_TITLE" "$pct" "$PROGRESS_I" "$PROGRESS_N")"
  right="  ${detail}"
  barw=$((c - ${#left} - ${#right} - 2))
  [ "$barw" -lt 10 ] && barw=10
  [ "$barw" -gt 40 ] && barw=40
  filled=$((barw * PROGRESS_I / PROGRESS_N))
  [ "$filled" -gt "$barw" ] && filled=$barw
  [ "$filled" -lt 0 ] && filled=0
  empty=$((barw - filled))
  printf '\r\033[K%s' "$left" >/dev/tty
  printf '\033[38;2;57;255;20m' >/dev/tty
  i=0
  while [ "$i" -lt "$filled" ]; do printf '━' >/dev/tty; i=$((i + 1)); done
  printf '\033[38;5;238m' >/dev/tty
  i=0
  while [ "$i" -lt "$empty" ]; do printf '─' >/dev/tty; i=$((i + 1)); done
  printf '\033[0m%s' "$right" >/dev/tty
}

progress_end() {
  [ "${PROGRESS_N:-0}" -gt 0 ] || return 0
  PROGRESS_N=0
  printf '\r\033[K\033[?25h\n' >/dev/tty
}

