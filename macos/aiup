format_category_header() {
  local cat="$1"
  local n_inst="$2"
  local n_abs="$3"
  local indent="${4:-0}"
  local reset arrow bar name extra pad shown
  reset=$'\033[0m'
  if category_expanded "$cat"; then
    arrow='▾'
  else
    arrow='▸'
  fi
  bar="$(catalog_ansi "$cat")▌${reset}"
  shown="${cat##*/}"
  case "$cat" in
    infra) shown='Essentials' ;; coding-agents) shown='Coding assistants' ;;
    workspaces) shown='Workspaces' ;; editors) shown='Code editors' ;; terminals) shown='Terminals' ;;
    chat) shown='Chat assistants' ;; media) shown='Media' ;; local-ai) shown='On-device AI' ;;
    automation) shown='Automation' ;; llm-utils) shown='AI utilities' ;; dev-utils) shown='Developer tools' ;;
    adapters) shown='Integrations' ;; homebrew) shown='Other packages' ;;
    homebrew/casks) shown='Apps' ;; homebrew/formulae) shown='Commands' ;; homebrew/libraries) shown='Support libraries' ;;
    homebrew/fonts) shown='Fonts' ;; homebrew/recommended) shown='Suggestions' ;; homebrew/available) shown='More packages' ;;
  esac
  [ "$cat" = 'detected' ] && shown='Other software'
  if [ "$indent" -gt 0 ]; then
    pad="$(printf '%*s' $((indent * 4)) '')"
    name="$(catalog_ansi "$cat")${pad}$(printf '%-14s' "$shown")${reset}"
  else
    name="$(catalog_ansi "$cat")$(printf '%-16s' "$shown")${reset}"
  fi
  case "$cat" in
    detected)
      extra="$(detected_source_summary)"
      ;;
    homebrew)
      if homebrew_available_loaded; then
        extra="${n_inst} listed / ${n_abs} available to install"
      else
        extra="${n_inst} listed / ${n_abs} suggestions"
      fi
      ;;
    media)
      extra="${n_inst} installed / ${n_abs} available to install"
      ;;
    homebrew/recommended)
      extra="${n_inst} already on your Mac / ${n_abs} curated recommendations"
      ;;
    homebrew/fonts)
      if homebrew_available_loaded; then
        extra="${n_inst} installed via Homebrew / ${n_abs} available font casks"
      else
        extra="${n_inst} installed via Homebrew / full font catalog in --view available"
      fi
      ;;
    homebrew/available)
      if homebrew_available_loaded; then
        extra="${n_abs} non-managed Homebrew extras (excluding font casks)"
      else
        extra="full Homebrew catalog not loaded · use --view available"
      fi
      ;;
    homebrew/*)
      extra="${n_inst} already on your Mac via Homebrew"
      ;;
    *)
      extra="${n_inst} installed / ${n_abs} available to install"
      ;;
  esac
  printf '%s\t%s %s %s  %s' "__cat:${cat}" "$bar" "$arrow" "$name" "$extra"
}

detected_source_summary() {
  local total apps npm uv path
  total="$(awk -F '\t' '$2=="detected" {n++} END {print n+0}' "$INVENTORY_INDEX" 2>/dev/null)"
  apps="$(awk -F '\t' '$2=="detected" && $6=="app bundle" {n++} END {print n+0}' "$INVENTORY_INDEX" 2>/dev/null)"
  npm="$(awk -F '\t' '$2=="detected" && $6 ~ /^npm( |$)/ {n++} END {print n+0}' "$INVENTORY_INDEX" 2>/dev/null)"
  uv="$(awk -F '\t' '$2=="detected" && $6=="uv tool" {n++} END {print n+0}' "$INVENTORY_INDEX" 2>/dev/null)"
  path="$(awk -F '\t' '$2=="detected" && $6=="PATH executable" {n++} END {print n+0}' "$INVENTORY_INDEX" 2>/dev/null)"
  printf '%s found · %s apps · %s JavaScript packages · %s Python tools · %s commands' "$total" "$apps" "$npm" "$uv" "$path"
}

