        printf '  ~/.grok/bin/grok exists: %s\n' "$([ -x "$HOME/.grok/bin/grok" ] && printf yes || printf no)"
        ;;
      warp)
        printf '  ~/.local/bin/warp exists: %s\n' "$([ -x "$LOCAL_BIN/warp" ] && printf yes || printf no)"
        printf '  ~/.warp/tui current exists: %s\n' "$([ -e "$HOME/.warp/tui/current/warp-tui-stable" ] && printf yes || printf no)"
        printf '  Homebrew cask warp-agent-cli: %s\n' "$(brew_cask_installed warp-agent-cli && printf yes || printf no)"
