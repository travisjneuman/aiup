ensure_zsh_path_block() {
  ensure_dir "$HOME"
  local file="$HOME/.zshrc"
  touch "$file"

  python3 - <<'PYEOF' "$file" "$LOCAL_BIN" "$AIUP_NPM_BIN"
from pathlib import Path
import re, sys
file_path, local_bin, npm_bin = sys.argv[1:4]
p = Path(file_path)
text = p.read_text() if p.exists() else ""
start = "# >>> aiup PATH >>>"
end = "# <<< aiup PATH <<<"
legacy_lines = {
    f'export PATH="{npm_bin}:$PATH"',
}
legacy_patterns = [
    re.compile(r'^export PATH="(?:/opt/homebrew|/usr/local)/Cellar/node/[^\"]+/bin:\$PATH"$'),
]
lines = text.splitlines()
out = []
in_block = False
for line in lines:
    if line == start:
        in_block = True
        continue
    if line == end:
        in_block = False
        continue
    if in_block:
        continue
    if line in legacy_lines:
        continue
    if any(pat.match(line) for pat in legacy_patterns):
        continue
    out.append(line)
block = [start, f'export PATH="{local_bin}:{npm_bin}:$PATH"', end]
while out and out[-1] == "":
    out.pop()
out.extend(["", *block, ""])
new_text = "\n".join(out)
p.write_text(new_text)
PYEOF
}

remove_legacy_path_lines() {
  local file
  for file in "$HOME/.zprofile" "$HOME/.zshrc"; do
    [ -f "$file" ] || continue
    python3 - <<'PYEOF' "$file" "$AIUP_NPM_BIN"
from pathlib import Path
import re, sys
file_path, npm_bin = sys.argv[1:3]
p = Path(file_path)
text = p.read_text() if p.exists() else ""
lines = text.splitlines()
legacy_exact = {
    f'export PATH="{npm_bin}:$PATH"',
}
patterns = [
    re.compile(r'^export PATH="(?:/opt/homebrew|/usr/local)/Cellar/node/[^\"]+/bin:\$PATH"$'),
]
new_lines = []
changed = False
for line in lines:
    if line in legacy_exact or any(pat.match(line) for pat in patterns):
        changed = True
        continue
    new_lines.append(line)
if changed:
    while new_lines and new_lines[-1] == "":
        new_lines.pop()
    p.write_text("\n".join(new_lines) + ("\n" if new_lines else ""))
    print("changed")
else:
    print("unchanged")
PYEOF
  done
}

