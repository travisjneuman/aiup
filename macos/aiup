detected_search_url() {
  local id="$1" record label version source path name query encoded
  record="$(inventory_record "$id" 2>/dev/null || true)"
  if [ -z "$record" ]; then
    scan_inventory_index >/dev/null 2>&1 || true
    record="$(inventory_record "$id" 2>/dev/null || true)"
  fi
  if [ -n "$record" ]; then
    IFS=$'\t' read -r _ _ _ label version source path <<< "$record"
    name="$(inventory_item_name "$label")"
  else
    name="$id"
    version=''
    source='detected software'
    path=''
  fi
  case "$source" in
    app\ bundle) query="$name ${version:-unknown} macOS app" ;;
    npm\ \(*) query="$name npm package ${version:-unknown}" ;;
    uv\ tool) query="$name uv tool ${version:-unknown}" ;;
    PATH\ executable) query="$name macOS command ${version:-unknown}" ;;
    *) query="$name ${version:-unknown} $source $path" ;;
  esac
  encoded="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote_plus(sys.argv[1]))' "$query")"
  printf 'https://www.google.com/search?q=%s\n' "$encoded"
}

