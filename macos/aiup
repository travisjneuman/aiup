duplicates_of() {
  local tool="$1"
  local count which_count
  if [ "$tool" = 'npm' ] && [ "$(command_path node)" = '/opt/homebrew/bin/node' ] && [ "$(command_path npm)" = '/opt/homebrew/bin/npm' ] && [ "$(command_path npx)" = '/opt/homebrew/bin/npx' ]; then
    printf 'no\n'
    return 0
  fi
  if [ "$tool" = 'codex' ] && aiup_npm_pkg_installed @openai/codex && [ -x "$LOCAL_BIN/codex" ]; then
    printf 'no\n'
    return 0
  fi
  if [ "$tool" = 'grok' ] && [ -x "$LOCAL_BIN/grok" ] && [ -x "$HOME/.grok/bin/grok" ]; then
    printf 'no\n'
    return 0
  fi
  count="$(source_count_of "$tool")"
  which_count="$(which_all_unique_count "$tool")"
  if [ "$count" -gt 1 ] || [ "$which_count" -gt 1 ]; then
    printf 'yes\n'
  else
    printf 'no\n'
  fi
}

expected_binary_exists() {
  local tool="$1"
  local path
  path="$(expected_direct_path "$tool")"
  [ -n "$path" ] && [ -x "$path" ]
}

current_path_active_of() {
  local tool="$1"
  local bin
  bin="$(binary_of_tool "$tool")"
  if command_exists "$bin"; then
    printf 'yes\n'
  else
    printf 'no\n'
  fi
}

persistent_path_likely_of() {
  local tool="$1"
  local bin cmd dir expected
  bin="$(binary_of_tool "$tool")"
  cmd="$(command_path "$bin")"
  if [ -n "$cmd" ]; then
    dir="$(dirname "$cmd")"
    persistent_path_likely "$dir"
    return 0
  fi
  expected="$(expected_direct_path "$tool")"
  if [ -n "$expected" ] && [ -x "$expected" ]; then
    dir="$(dirname "$expected")"
    persistent_path_likely "$dir"
    return 0
  fi
  printf 'n/a\n'
}

resolved_path_of() {
  local tool="$1"
  local bin cmd expected
  bin="$(binary_of_tool "$tool")"
  cmd="$(command_path "$bin")"
  if [ -n "$cmd" ]; then
    realpath_safe "$cmd"
    return 0
  fi
  expected="$(expected_direct_path "$tool")"
  if [ -n "$expected" ] && [ -x "$expected" ]; then
    realpath_safe "$expected"
    return 0
  fi
  printf 'n/a\n'
}

command_path_of() {
  local tool="$1"
  local bin cmd expected
  bin="$(binary_of_tool "$tool")"
  cmd="$(command_path "$bin")"
  if [ -n "$cmd" ]; then
    printf '%s\n' "$cmd"
    return 0
  fi
  expected="$(expected_direct_path "$tool")"
  if [ -n "$expected" ] && [ -x "$expected" ]; then
    printf '%s\n' "$expected"
    return 0
  fi
  printf 'not found\n'
}

status_of() {
  local tool="$1"
  local method preferred duplicates path_active persistent ver
  method="$(install_method_of "$tool")"
  preferred="$(preferred_method_of "$tool")"
  duplicates="$(duplicates_of "$tool")"
  path_active="$(current_path_active_of "$tool")"
  persistent="$(persistent_path_likely_of "$tool")"
  ver="$(version_of_tool "$tool")"

  if ! tool_is_present "$tool"; then
    printf 'ABSENT\n'
    return 0
  fi

  if [ "$ver" = 'not installed' ]; then
    printf 'BROKEN\n'
    return 0
  fi

  if [ "$(catalog_kind "$tool")" = 'app' ]; then
    if { [ "$method" = "$preferred" ] || [ "$method" = 'app' ]; } && [ -d "$(catalog_app_path "$tool")" ] && [ "$ver" != 'app present' ]; then
      printf 'GOOD\n'
    else
      printf 'WARN\n'
    fi
    return 0
  fi

  case "$tool" in
    fzf|npm|claude|codex|antigravity|gemini|opencode|kilo|gsd2|hermes|pi|grok|warp|copilot|aider|goose|cursor|qwen|crush|amp|kiro|droid|kimi|openclaw|cline|continue|pi-acp|uv|gh|wrangler|deno|llm|mods|aichat|fabric|sgpt|ollama|chatgpt|cursor-ide|zed|cmux|ollama-app)
      if [ "$method" = "$preferred" ] && [ "$duplicates" = 'no' ] && [ "$path_active" = 'yes' ] && [ "$persistent" != 'no' ]; then
        printf 'GOOD\n'
      elif [ "$method" = 'missing' ]; then
        printf 'BROKEN\n'
      elif expected_binary_exists "$tool" && [ "$path_active" = 'no' ]; then
        printf 'BROKEN\n'
      else
        printf 'WARN\n'
      fi
      ;;
    *) printf 'WARN\n' ;;
  esac
}

