tty_cols() {
  local c="${COLUMNS:-0}"
  if [ "$c" -lt 20 ] 2>/dev/null; then
    c=80
  fi
  printf '%s\n' "$c"
}

restore_tty() {
  tty_usable || return 0
  printf '\033[?25h\033[?1049l\033[0m' >/dev/tty 2>/dev/null || true
  stty sane echo icanon </dev/tty 2>/dev/null || true
}

clear_terminal_screen() {
  tty_usable || return 0
  printf '\033[2J\033[H' >/dev/tty 2>/dev/null || true
}

# macOS/BSD stty maps ^O to "discard" and ^Y to "dsusp", so those chords
# never reach fzf unless we undefine them for the picker.
prepare_tty_for_fzf() {
  tty_usable || return 0
  restore_tty
  stty discard undef dsusp undef </dev/tty 2>/dev/null || true
}

scan_friendly_name() {
  local tool="$1"
