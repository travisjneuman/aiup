}

capture_fixture_enabled() {
  [ -n "$AIUP_CAPTURE_FIXTURE_DIR" ]
}

capture_fixture_require() {
  capture_fixture_enabled || return 1
  [ -d "$AIUP_CAPTURE_FIXTURE_DIR" ] && \
    [ -f "$AIUP_CAPTURE_FIXTURE_DIR/PUBLIC-SAFE" ] && \
    grep -Fxq 'aiup public-safe capture fixture' "$AIUP_CAPTURE_FIXTURE_DIR/PUBLIC-SAFE" || {
      error "AIUP_CAPTURE_FIXTURE_DIR is not a marked public-safe capture fixture"
      return 1
    }
  local fixture_name
  for fixture_name in catalog-index.tsv brew-index.tsv inventory-index.tsv versions.tsv apps.tsv; do
    [ -f "$AIUP_CAPTURE_FIXTURE_DIR/$fixture_name" ] || {
      error "capture fixture is missing $fixture_name"
      return 1
    }
  done
}

capture_fixture_copy() {
  local fixture_name="$1"
  local destination="$2"
  capture_fixture_require || return 1
  cp "$AIUP_CAPTURE_FIXTURE_DIR/$fixture_name" "$destination"
}

tty_usable() {
  [ -c /dev/tty ] || return 1
  { exec 3<>/dev/tty; } 2>/dev/null || return 1
  stty -g <&3 >/dev/null 2>&1
  local rc=$?
  exec 3>&-
  return "$rc"
}

realpath_safe() {
  local p="$1"
  python3 - <<'PYEOF' "$p" 2>/dev/null || printf '%s\n' "$p"
import os, sys
print(os.path.realpath(sys.argv[1]))
PYEOF
}

first_line() {
  awk 'NF && $0 !~ /^WARNING:/{print; exit}'
}

ensure_dir() {
  mkdir -p "$1"
}

path_contains_dir() {
  local dir="$1"
  case ":$PATH:" in
    *":$dir:"*) return 0 ;;
    *) return 1 ;;
  esac
}

append_failure() {
  local tool="$1"
  FAILED_TOOLS+=("$tool")
  RESULT_FAILED+=("$tool")
}

result_record() {
  local kind="$1"
  local item="$2"
  [ -n "$item" ] || return 0
  case "$kind" in
    completed) RESULT_COMPLETED+=("$item") ;;
    current) RESULT_CURRENT+=("$item") ;;
    removed) RESULT_REMOVED+=("$item") ;;
    skipped) RESULT_SKIPPED+=("$item") ;;
    detected) RESULT_DETECTED+=("$item") ;;
    failed) RESULT_FAILED+=("$item") ;;
    cancelled) RESULT_CANCELLED+=("$item") ;;
  esac
}

update_status_set() {
