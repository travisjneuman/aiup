# Switch an existing .app to Homebrew without asking Homebrew to zap data.
# aiup does not pass --zap or directly delete ~/Library in this path.
# 1) --adopt if the bundle matches what Homebrew would install
# 2) otherwise replace the .app only (--force), after confirm
brew_cask_adopt() {
  local name="$1"
  local app="${2:-}"
  command_exists brew || { error "Homebrew required"; return 1; }
  brew_ensure_target_tap "" "$name" cask || return 1
  if brew_cask_installed "$name"; then
    run_with_heartbeat "brew upgrade --cask $name" env HOMEBREW_NO_ENV_HINTS=1 brew upgrade --cask --yes "$name"
    return $?
  fi
  info "Letting Homebrew manage $name. aiup will not pass --zap or directly delete ~/Library."
  warn "Homebrew and vendor-specific installer behavior may vary."
  if [ -n "$app" ]; then
    info "Current app: $app"
  fi
  if [ "${AIUP_KEEP_UI:-0}" = 1 ] || tty_usable; then
    if ! confirm_tty "Switch $name to Homebrew without requesting a data zap? [y/N] "; then
      info "Left $name as-is (still not Homebrew-managed)"
      return 0
    fi
  fi
  if run_with_heartbeat "brew install --cask --adopt $name" env HOMEBREW_NO_ENV_HINTS=1 brew install --cask --adopt --yes "$name"; then
    info "Homebrew now manages $name. aiup did not request a data zap."
    return 0
  fi
  warn "Homebrew could not adopt the existing copy (usually a version mismatch)."
  warn "Next step asks Homebrew to replace the app bundle without --zap; vendor-specific installer behavior may vary."
  if [ "${AIUP_KEEP_UI:-0}" = 1 ] || tty_usable; then
    if ! confirm_tty "Replace the $name app bundle via Homebrew without --zap? [y/N] "; then
      info "Cancelled. $name is unchanged."
      return 0
    fi
  fi
  run_with_heartbeat "brew install --cask --force $name" env HOMEBREW_NO_ENV_HINTS=1 brew install --cask --force --yes "$name" || return 1
  info "Homebrew now manages $name. aiup did not request a data zap."
}

# Install a formula next to whatever is already on PATH. Never uninstall
# Apple's /usr/bin copy or a non-Homebrew binary.
brew_formula_install_alongside() {
  local name="$1"
  command_exists brew || { error "Homebrew required"; return 1; }
  brew_ensure_target_tap "" "$name" formula || return 1
  if brew_formula_installed "$name"; then
    run_with_heartbeat "brew upgrade $name" env HOMEBREW_NO_ENV_HINTS=1 brew upgrade --yes "$name"
    return $?
  fi
  if formula_present_outside_brew "$name"; then
    info "$name is already on PATH outside Homebrew. Installing the Homebrew copy alongside it."
    info "The existing command is not uninstalled or modified."
    if [ "${AIUP_KEEP_UI:-0}" = 1 ] || tty_usable; then
      if ! confirm_tty "Install Homebrew $name alongside the copy already on PATH? [y/N] "; then
        info "Left $name as-is"
        return 0
      fi
    fi
  fi
  run_with_heartbeat "brew install $name" env HOMEBREW_NO_ENV_HINTS=1 brew install --yes "$name"
}

apply_brew_extras() {
  local action="$1"
  shift
  local id name app failures=0
  mutation_authoritative_preflight "Homebrew extra $action" || return 1
  command_exists brew || { error "Homebrew required"; return 1; }
  for id in "$@"; do
    case "$id" in
      bc:*)
        name="${id#bc:}"
        case "$action" in
          remove)
            if brew_cask_installed "$name"; then
              run_with_heartbeat "brew uninstall --cask $name" env HOMEBREW_NO_ENV_HINTS=1 brew uninstall --cask "$name" || true
            else
              app="$(app_path_for_cask "$name" || true)"
              warn "$name is not Homebrew-managed. aiup will not delete ${app:-the app}. Remove it in Finder if you want it gone."
            fi
            ;;
          update)
            if brew_cask_installed "$name"; then
              brew_ensure_target_tap "" "$name" cask || return 1
              if run_with_heartbeat "brew upgrade --cask $name" env HOMEBREW_NO_ENV_HINTS=1 brew upgrade --cask --yes "$name"; then
                result_record completed "$id"
              else
                append_failure "$id"; failures=$((failures + 1))
              fi
            else
              warn "$name is on your Mac outside Homebrew; skip brew upgrade. Press enter to switch it to Homebrew without --zap."
              result_record skipped "$id"
            fi
            ;;
          *)
            if brew_cask_installed "$name"; then
              run_with_heartbeat "brew upgrade --cask $name" env HOMEBREW_NO_ENV_HINTS=1 brew upgrade --cask --yes "$name" || true
            elif app="$(app_path_for_cask "$name")"; then
              brew_cask_adopt "$name" "$app" || true
            else
              run_with_heartbeat "brew install --cask $name" env HOMEBREW_NO_ENV_HINTS=1 brew install --cask --yes "$name" || true
            fi
            ;;
        esac
        ;;
      bf:*)
        name="${id#bf:}"
        case "$action" in
          remove)
            if brew_formula_installed "$name"; then
              run_with_heartbeat "brew uninstall $name" env HOMEBREW_NO_ENV_HINTS=1 brew uninstall "$name" || true
            else
              warn "$name is not a Homebrew formula on your Mac; aiup will not delete the existing command"
            fi
            ;;
          update)
            if brew_formula_installed "$name"; then
              brew_ensure_target_tap "" "$name" formula || return 1
              if run_with_heartbeat "brew upgrade $name" env HOMEBREW_NO_ENV_HINTS=1 brew upgrade --yes "$name"; then
                result_record completed "$id"
              else
                append_failure "$id"; failures=$((failures + 1))
              fi
            else
              warn "$name is on PATH outside Homebrew; skip brew upgrade. Press enter to install a Homebrew copy alongside it."
              result_record skipped "$id"
            fi
            ;;
          *)
            brew_formula_install_alongside "$name" || true
            ;;
        esac
        ;;
    esac
  done
  brew_cache_invalidate
  scan_brew_index
  tui_cache_invalidate
  [ "$failures" -eq 0 ]
}

open_url() {
  local url="$1"
  if command_exists open; then
    open "$url"
  elif command_exists xdg-open; then
    xdg-open "$url" >/dev/null 2>&1 &
  elif command_exists wslview; then
    wslview "$url"
  else
    error "No browser opener found (open / xdg-open / wslview). URL: $url"
    return 1
  fi
}

cmd_docs() {
  local print_only=0
  local tool=""
  local arg
  for arg in "$@"; do
    case "$arg" in
      --print|-p) print_only=1 ;;
      *) tool="$arg" ;;
    esac
  done
  if [ -z "$tool" ]; then
    error "usage: aiup docs [--print] <tool>"
    return 1
  fi
  local resolved url
  case "$tool" in
    __cat:*) return 0 ;;
    __updates:all|__updates:status:*) return 0 ;;
    __update:*)
      resolved="${tool#__update:}"
      [ -n "$resolved" ] && [ "$resolved" != "$tool" ] || return 1
      if [ "$AIUP_TUI_SESSION_ACTIVE" -eq 1 ]; then
        awk -F '\t' -v id="$resolved" '$1==id && $4=="newer" {found=1} END {exit found ? 0 : 1}' "$AIUP_TUI_SESSION_DIR/updates-index.tsv" || return 1
      fi
      tool="$resolved"
      ;;
    di:*)
      url="$(manual_media_record "$tool" | cut -f7)"
      if [[ "$tool" == di:path:* ]]; then url="$(path_insights "$INVENTORY_INDEX" | awk -F '\t' -v id="$tool" '$1==id {print $6}')"; fi
      [ -n "$url" ] || url="$(detected_search_url "$tool")"
      if [ "$print_only" -eq 1 ]; then printf '%s\n' "$url"; return 0; fi
      printf 'Opened guidance/search: %s\n' "$url" >/dev/tty
      open_url "$url"
      return 0
      ;;
    bc:*)
      url="https://formulae.brew.sh/cask/${tool#bc:}"
      if [ "$print_only" -eq 1 ]; then printf '%s\n' "$url"; return 0; fi
      printf 'Opened website: %s\n' "$url" >/dev/tty
      open_url "$url"
      return 0
      ;;
    bf:*)
      url="https://formulae.brew.sh/formula/${tool#bf:}"
      if [ "$print_only" -eq 1 ]; then printf '%s\n' "$url"; return 0; fi
      printf 'Opened website: %s\n' "$url" >/dev/tty
      open_url "$url"
      return 0
      ;;
  esac
  if [ "$AIUP_TUI_SESSION_ACTIVE" -eq 1 ]; then
    url="$(awk -F '\t' -v id="$tool" '$1==id {print $2; exit}' "$AIUP_TUI_SESSION_DIR/preview-docs.tsv")"
    if [ -n "$url" ]; then
      if [ "$print_only" -eq 1 ]; then
        printf '%s\n' "$url"
        return 0
      fi
      case "$url" in https://github.com/*) resolved='GitHub' ;; *) resolved='website' ;; esac
      printf 'Opened %s: %s\n' "$resolved" "$url" >/dev/tty
      open_url "$url"
      return $?
    fi
  fi
  resolved="$(resolve_tools "$tool")" || return 1
  tool="$(printf '%s\n' "$resolved" | first_line)"
  url="$(catalog_docs_url "$tool")"
  if [ -z "$url" ]; then
    error "No docs URL for $tool"
    return 1
  fi
  if [ "$print_only" -eq 1 ]; then
    printf '%s\n' "$url"
    return 0
  fi
  printf 'Opened %s: %s\n' "$(catalog_docs_kind "$tool")" "$url" >/dev/tty
  open_url "$url"
}

version_of_path() {
  local path="$1"
  [ -x "$path" ] || return 1
  "$path" --version </dev/null 2>&1 | first_line
}

app_bundle_version() {
  local app="$1"
  [ -f "$app/Contents/Info.plist" ] || return 1
  /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$app/Contents/Info.plist" 2>/dev/null | first_line
}

version_of_tool() {
  local tool="$1"
  local kind cask app formula bin cmd expected version pkg
  if capture_fixture_enabled; then
    capture_fixture_require || return 1
    version="$(awk -F '\t' -v tool="$tool" '$1==tool {print $2; exit}' "$AIUP_CAPTURE_FIXTURE_DIR/versions.tsv")"
    [ -n "$version" ] && { printf '%s\n' "$version"; return 0; }
  fi
  ensure_system_npm_prefix
  if [ "$tool" = 'npm' ]; then
    if command_exists npm; then
      npm --version </dev/null 2>&1 | first_line
    else
      printf 'not installed\n'
    fi
    return 0
  fi
  kind="$(catalog_kind "$tool")"
  if [ "$kind" = 'brew-cask' ]; then
    cask="$(catalog_brew_cask "$tool")"
    if [ -n "$cask" ] && brew_cask_installed "$cask"; then
      printf '%s\n' "$AIUP_BREW_CASK_VERSIONS" | awk -v name="$cask" '$1==name {$1=""; sub(/^ /, ""); print; exit}'
      return 0
    fi
    app="$(catalog_app_path "$tool")"
    if [ -n "$app" ] && [ -d "$app" ]; then
      app_bundle_version "$app" || printf 'app present\n'
      return 0
    fi
  fi
  if [ "$kind" = 'app' ]; then
    app="$(catalog_app_path "$tool")"
    if [ -n "$app" ] && [ -d "$app" ]; then
      app_bundle_version "$app" || printf 'app present\n'
      return 0
    fi
  fi
  if [ "$kind" = 'brew-formula' ]; then
    formula="$(catalog_brew_formula "$tool")"
    if [ -n "$formula" ] && brew_formula_installed "$formula"; then
      printf '%s\n' "$AIUP_BREW_FORMULA_VERSIONS" | awk -v name="$formula" '$1==name {$1=""; sub(/^ /, ""); print; exit}'
      return 0
    fi
  fi
  pkg="$(catalog_npm_pkg "$tool")"
  if [ -n "$pkg" ]; then
    if [ -n "$pkg" ] && [ -f "$(npm_pkg_dir_from_prefix "$AIUP_NPM_PREFIX" "$pkg")/package.json" ]; then
      version="$(python3 - "$(npm_pkg_dir_from_prefix "$AIUP_NPM_PREFIX" "$pkg")/package.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    value = json.load(handle).get("version", "")
if value:
    print(value)
PY
      )"
      if [ -n "$version" ]; then
        printf '%s\n' "$version"
        return 0
      fi
    fi
    if [ -n "$pkg" ] && [ -n "$SYSTEM_NPM_PREFIX" ] && [ -f "$(npm_pkg_dir_from_prefix "$SYSTEM_NPM_PREFIX" "$pkg")/package.json" ]; then
      version="$(python3 - "$(npm_pkg_dir_from_prefix "$SYSTEM_NPM_PREFIX" "$pkg")/package.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    value = json.load(handle).get("version", "")
if value:
    print(value)
PY
      )"
      if [ -n "$version" ]; then
        printf '%s\n' "$version"
        return 0
      fi
    fi
  fi
  bin="$(binary_of_tool "$tool")"
  cmd="$(command_path "$bin")"
  if [ -n "$cmd" ] && [ -x "$cmd" ]; then
    version="$("$bin" --version </dev/null 2>&1 | first_line || true)"
    if [ -n "$version" ]; then
      printf '%s\n' "$version"
      return 0
    fi
  fi
  expected="$(expected_direct_path "$tool")"
  if [ -n "$expected" ] && [ -x "$expected" ]; then
    version="$("$expected" --version </dev/null 2>&1 | first_line || true)"
    if [ -n "$version" ]; then
      printf '%s\n' "$version"
      return 0
    fi
  fi
  printf 'not installed\n'
}

bounded_provider_capture() {
  local output="$1" timeout="$2"
  shift 2
  local provider_pid watchdog_pid rc bytes
  : > "$output" || return 1
  (ulimit -f 1024; "$@") > "$output" 2>/dev/null &
  provider_pid=$!
  AIUP_PROVIDER_PID="$provider_pid"
  (sleep "$timeout"; kill -TERM "$provider_pid" 2>/dev/null || true; sleep 0.2; kill -KILL "$provider_pid" 2>/dev/null || true) &
  watchdog_pid=$!
  AIUP_PROVIDER_WATCHDOG_PID="$watchdog_pid"
  trap 'kill "$provider_pid" "$watchdog_pid" 2>/dev/null || true; if [ -n "${AIUP_ACTIVE_AVAILABLE_LOCK:-}" ]; then rm -f "$AIUP_ACTIVE_AVAILABLE_LOCK/meta"; rmdir "$AIUP_ACTIVE_AVAILABLE_LOCK" 2>/dev/null || true; fi; exit 130' HUP INT TERM
  wait "$provider_pid" || rc=$?
  AIUP_PROVIDER_PID=""
  rc="${rc:-0}"
  kill "$watchdog_pid" 2>/dev/null || true
  wait "$watchdog_pid" 2>/dev/null || true
  AIUP_PROVIDER_WATCHDOG_PID=""
  trap - HUP INT TERM
  if [ "$rc" -eq 0 ]; then
    bytes="$(wc -c < "$output" | tr -d ' ')"
    case "$bytes" in ''|*[!0-9]*) rc=1 ;; *) [ "$bytes" -le 1048576 ] || rc=1 ;; esac
  fi
  [ "$rc" -eq 0 ]
}

available_candidate_result() {
  local current="$1" candidate="$2"
  candidate="$(printf '%s\n' "$candidate" | sed -n '1p')"
  [ -n "$candidate" ] || return 0
  printf '%s' "$candidate" | grep -Eq '^[A-Za-z0-9._+-]+$' || return 1
  printf '%s' "$candidate" | grep -Eq '[0-9]' || return 1
  if [ "$(version_is_greater "$candidate" "$current")" = 'yes' ]; then
    printf '%s\n' "$candidate"
  fi
}

# Return 0 for a valid provider response (including already-current), and 1 for
# timeout, transport failure, or malformed metadata. stdout contains only a
# strictly newer supported version.
available_version_uncached() {
  local tool="$1" current="$2"
  local kind pkg formula cask endpoint latest target arch raw parsed rc provider_key
  ensure_dir "$AVAILABLE_VERSION_CACHE_DIR" || return 1
  provider_key="$(available_cache_key "$tool")"
  raw="$(mktemp "$AVAILABLE_VERSION_CACHE_DIR/.provider-${provider_key}.XXXXXX")" || return 1
  if [ "${AIUP_TUI_TESTING:-0}" = 1 ] && [ -n "${AIUP_FAKE_PROVIDER_COMMAND:-}" ]; then
    [ -x "$AIUP_FAKE_PROVIDER_COMMAND" ] || { rm -f "$raw"; return 1; }
    bounded_provider_capture "$raw" "$AVAILABLE_VERSION_PROVIDER_TIMEOUT" "$AIUP_FAKE_PROVIDER_COMMAND" "$tool" "$current" || { rm -f "$raw"; return 1; }
    latest="$(sed -n '1p' "$raw")"
    [ "$(wc -l < "$raw" | tr -d ' ')" -le 1 ] || { rm -f "$raw"; return 1; }
    rm -f "$raw"
    available_candidate_result "$current" "$latest"
    return $?
  fi
  if capture_fixture_enabled; then
    capture_fixture_require || { rm -f "$raw"; return 1; }
    latest="$(awk -F '\t' -v tool="$tool" '$1==tool {print $3; exit}' "$AIUP_CAPTURE_FIXTURE_DIR/versions.tsv")"
    rm -f "$raw"
    available_candidate_result "$current" "$latest"
    return $?
  fi
  case "$tool" in
    bf:*) kind='brew-formula'; formula="${tool#bf:}" ;;
    bc:*) kind='brew-cask'; cask="${tool#bc:}" ;;
    *) kind="$(catalog_kind "$tool")" ;;
  esac
  pkg="$(catalog_npm_pkg "$tool")"
  if { [ "$kind" = 'aiup-npm' ] || [ -n "$pkg" ]; } && [ -n "$pkg" ] && command_exists npm; then
    bounded_provider_capture "$raw" "$AVAILABLE_VERSION_PROVIDER_TIMEOUT" env npm view "$pkg" version --fetch-retries=0 --fetch-timeout=3000 || { rm -f "$raw"; return 1; }
    latest="$(cat "$raw")"; rm -f "$raw"
    printf '%s' "$latest" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$' || return 1
    [[ "$latest" != *$'\n'* ]] || return 1
    available_candidate_result "$current" "$latest"
    return $?
  fi
  if [ "$kind" = 'brew-formula' ] && command_exists brew; then
    [ -n "${formula:-}" ] || formula="$(catalog_brew_formula "$tool")"
    bounded_provider_capture "$raw" "$AVAILABLE_VERSION_PROVIDER_TIMEOUT" env HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew info --json=v2 --formula "$formula" || { rm -f "$raw"; return 1; }
    parsed="${raw}.parsed"
    python3 - "$raw" > "$parsed" 2>/dev/null <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as handle:
    items = json.load(handle).get("formulae")
if not isinstance(items, list) or len(items) != 1: raise ValueError("invalid formula metadata")
item = items[0]
if not isinstance(item.get("outdated"), bool): raise ValueError("missing outdated status")
if item.get("outdated"):
    print((item.get("versions") or {}).get("stable", ""))
PY
    rc=$?; latest="$(sed -n '1p' "$parsed" 2>/dev/null)"; rm -f "$raw" "$parsed"
    [ "$rc" -eq 0 ] || return 1
    available_candidate_result "$current" "$latest"
    return $?
  fi
  if [ "$kind" = 'brew-cask' ] && command_exists brew; then
    [ -n "${cask:-}" ] || cask="$(catalog_brew_cask "$tool")"
    bounded_provider_capture "$raw" "$AVAILABLE_VERSION_PROVIDER_TIMEOUT" env HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew info --json=v2 --cask "$cask" || { rm -f "$raw"; return 1; }
    parsed="${raw}.parsed"
    python3 - "$raw" > "$parsed" 2>/dev/null <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as handle:
    items = json.load(handle).get("casks")
if not isinstance(items, list) or len(items) != 1: raise ValueError("invalid cask metadata")
item = items[0]
if not isinstance(item.get("outdated"), bool): raise ValueError("missing outdated status")
if item.get("outdated"):
    print(item.get("version", ""))
PY
    rc=$?; latest="$(sed -n '1p' "$parsed" 2>/dev/null)"; rm -f "$raw" "$parsed"
    [ "$rc" -eq 0 ] || return 1
    available_candidate_result "$current" "$latest"
    return $?
  fi
  if [ "$kind" = 'uv-tool' ] && command_exists curl; then
    pkg="$(catalog_uv_pkg "$tool")"
    bounded_provider_capture "$raw" "$AVAILABLE_VERSION_PROVIDER_TIMEOUT" curl -fsSL --retry 1 --connect-timeout 3 --max-time "$AVAILABLE_VERSION_PROVIDER_TIMEOUT" "https://pypi.org/pypi/${pkg}/json" || { rm -f "$raw"; return 1; }
    parsed="${raw}.parsed"
    python3 - "$raw" > "$parsed" 2>/dev/null <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as handle:
    version = (json.load(handle).get("info") or {}).get("version", "")
    if not version: raise ValueError("missing package version")
    print(version)
PY
    rc=$?; latest="$(sed -n '1p' "$parsed" 2>/dev/null)"; rm -f "$raw" "$parsed"
    [ "$rc" -eq 0 ] || return 1
    available_candidate_result "$current" "$latest"
    return $?
  fi
  rm -f "$raw"
  if [ "$tool" = 'screenpipe' ] && [ -n "$current" ]; then
    case "$(uname -m)" in
      arm64) target='darwin'; arch='aarch64' ;;
      x86_64) target='darwin'; arch='x86_64' ;;
      *) return 1 ;;
    esac
    endpoint="$(official_app_update_endpoint screenpipe "$target" "$arch" "$current" 2>/dev/null || true)"
    [ -n "$endpoint" ] || return 1
    if latest="$(official_app_latest_version "$endpoint" 2>/dev/null)"; then
      available_candidate_result "$current" "$latest"
      return $?
    else
      rc=$?
    fi
    [ "$rc" -eq 2 ] && return 0
    return 1
  fi
  # A missing provider contract is unavailable to verify, never proof that the
  # installed item is current.
  return 1
}

available_cache_file() {
  printf '%s/%s.tsv\n' "$AVAILABLE_VERSION_CACHE_DIR" "$(available_cache_key "$1")"
}

available_cache_key() {
  local key="$1"
  printf '%s\n' "${key//\//%2F}"
}

available_cache_read() {
  local tool="$1" current="$2" cache_file now cached_at cached_current cached_status cached_version cached_extra ttl age validated_version
  cache_file="$(available_cache_file "$tool")"
  [ -f "$cache_file" ] && [ ! -L "$cache_file" ] || return 1
  [ "$(wc -l < "$cache_file" | tr -d ' ')" -eq 1 ] || return 1
  IFS=$'\t' read -r cached_at cached_current cached_status cached_version cached_extra < "$cache_file" || return 1
  [ -z "${cached_extra:-}" ] || return 1
  case "$cached_at" in ''|*[!0-9]*) return 1 ;; esac
  [ "$cached_current" = "$current" ] || return 1
  case "$cached_status" in
    newer)
      ttl="$AVAILABLE_VERSION_CACHE_TTL"
      validated_version="$(available_candidate_result "$current" "$cached_version")" || return 1
      [ -n "$validated_version" ] && [ "$validated_version" = "$cached_version" ] || return 1
      ;;
    current) ttl="$AVAILABLE_VERSION_CACHE_TTL"; [ -z "${cached_version:-}" ] || return 1 ;;
    failure) ttl="$AVAILABLE_VERSION_FAILURE_TTL"; [ -z "${cached_version:-}" ] || return 1 ;;
    *) return 1 ;;
  esac
  now="$(date +%s)"; age=$((now - cached_at))
  [ "$age" -ge 0 ] && [ "$age" -lt "$ttl" ] || return 1
  profile_note "available-cache hit tool=$tool status=$cached_status age=${age}s ttl=${ttl}s"
  [ "$cached_status" = 'newer' ] && [ -n "${cached_version:-}" ] && printf '%s\n' "$cached_version"
  return 0
}

available_cache_prune() {
  local count file
  count="$(find "$AVAILABLE_VERSION_CACHE_DIR" -maxdepth 1 -type f -name '*.tsv' | wc -l | tr -d ' ')"
  [ "$count" -le "$AVAILABLE_VERSION_CACHE_LIMIT" ] && return 0
  while IFS= read -r file; do
    [ "$count" -le "$AVAILABLE_VERSION_CACHE_LIMIT" ] && break
    case "$file" in "$AVAILABLE_VERSION_CACHE_DIR"/*.tsv) rm -f "$file"; count=$((count - 1)) ;; esac
  done < <(find "$AVAILABLE_VERSION_CACHE_DIR" -maxdepth 1 -type f -name '*.tsv' -print0 | xargs -0 stat -f '%m %N' | LC_ALL=C sort -n | cut -d' ' -f2-)
}

available_cache_write() {
  local tool="$1" current="$2" status="$3" version="${4:-}" temp_file cache_key
  ensure_dir "$AVAILABLE_VERSION_CACHE_DIR" || return 1
  cache_key="$(available_cache_key "$tool")"
  temp_file="$(mktemp "$AVAILABLE_VERSION_CACHE_DIR/.${cache_key}.XXXXXX")" || return 1
  printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "$current" "$status" "$version" > "$temp_file" || { rm -f "$temp_file"; return 1; }
  mv "$temp_file" "$(available_cache_file "$tool")" || { rm -f "$temp_file"; return 1; }
  available_cache_prune || true
}

available_lock_recover() {
  local lock_dir="$1" owner="" created="" now
  [ -d "$lock_dir" ] && [ ! -L "$lock_dir" ] && [ -f "$lock_dir/meta" ] && [ ! -L "$lock_dir/meta" ] || return 1
  IFS=$'\t' read -r owner created < "$lock_dir/meta" || return 1
  case "$owner:$created" in *[!0-9:]*) return 1 ;; esac
  now="$(date +%s)"
  if ! kill -0 "$owner" 2>/dev/null || [ $((now - created)) -gt $((AVAILABLE_VERSION_PROVIDER_TIMEOUT + 3)) ]; then
    rm -f "$lock_dir/meta"
    rmdir "$lock_dir" 2>/dev/null || true
    return 0
  fi
  return 1
}

available_version_of_tool() {
  local tool="$1" current="$2" lock_dir available rc tries=0 kind brew_lock cache_key
  ensure_dir "$AVAILABLE_VERSION_CACHE_DIR" || return 0
  if available_cache_read "$tool" "$current"; then return 0; fi
  profile_note "available-cache miss tool=$tool current=$current"
  kind="$(catalog_kind "$tool")"
  case "$kind" in
    brew-formula|brew-cask)
      brew_lock="$AVAILABLE_VERSION_CACHE_DIR/.brew-snapshot.lock"
      while [ -d "$brew_lock" ] && [ "$tries" -lt 100 ]; do
        available_lock_recover "$brew_lock" || true
        if available_cache_read "$tool" "$current"; then return 0; fi
        tries=$((tries + 1)); sleep 0.05
      done
      ;;
  esac
  tries=0
  cache_key="$(available_cache_key "$tool")"
  lock_dir="$AVAILABLE_VERSION_CACHE_DIR/.${cache_key}.lock"
  while ! mkdir "$lock_dir" 2>/dev/null; do
    available_lock_recover "$lock_dir" || true
    tries=$((tries + 1))
    [ "$tries" -lt 100 ] || return 0
    sleep 0.05
    if available_cache_read "$tool" "$current"; then return 0; fi
  done
  printf '%s\t%s\n' "$(current_shell_pid)" "$(date +%s)" > "$lock_dir/meta"
  AIUP_ACTIVE_AVAILABLE_LOCK="$lock_dir"
  trap '[ -z "${AIUP_PROVIDER_PID:-}" ] || kill "$AIUP_PROVIDER_PID" 2>/dev/null || true; [ -z "${AIUP_PROVIDER_WATCHDOG_PID:-}" ] || kill "$AIUP_PROVIDER_WATCHDOG_PID" 2>/dev/null || true; rm -f "$lock_dir/meta"; rmdir "$lock_dir" 2>/dev/null || true; exit 130' HUP INT TERM
  if available_cache_read "$tool" "$current"; then
    rm -f "$lock_dir/meta"; rmdir "$lock_dir" 2>/dev/null || true
    AIUP_ACTIVE_AVAILABLE_LOCK=""
    trap - HUP INT TERM
    return 0
  fi
  if available="$(available_version_uncached "$tool" "$current")"; then
    if [ -n "$available" ]; then
      available_cache_write "$tool" "$current" newer "$available" || true
      printf '%s\n' "$available"
    else
      available_cache_write "$tool" "$current" current '' || true
    fi
    rc=0
  else
    available_cache_write "$tool" "$current" failure '' || true
    rc=0
  fi
  rm -f "$lock_dir/meta"; rmdir "$lock_dir" 2>/dev/null || true
  AIUP_ACTIVE_AVAILABLE_LOCK=""
  trap - HUP INT TERM
  return "$rc"
}

available_version_preview() {
  local tool="$1" current="$2" available
  if available="$(available_cache_read "$tool" "$current")"; then
    [ -n "$available" ] && printf 'available %s\n' "$available"
    return 0
  fi
  sleep "$AVAILABLE_VERSION_DEBOUNCE_SECONDS"
  available="$(available_version_of_tool "$tool" "$current" || true)"
  [ -n "$available" ] && printf 'available %s\n' "$available"
}

tui_updates_index_valid() {
  local dir="${1:-$AIUP_TUI_SESSION_DIR}" marker="" schema="" runtime_version="" runtime_hash=""
  local manifest_version="" manifest_hash="" token_hash="" owner_pid="" snapshot="" index_hash="" base_hash="" rows_hash=""
  local runtime session_snapshot="" published="" seen='|'
  [ -n "$dir" ] && [ -d "$dir" ] && [ ! -L "$dir" ] || return 1
  for name in updates-meta.tsv updates-index.tsv rows-base.tsv rows-expanded.tsv token; do
    [ -f "$dir/$name" ] && [ ! -L "$dir/$name" ] || return 1
  done
  while IFS=$'\t' read -r key value extra; do
    [ -z "${extra:-}" ] || return 1
    case "$seen" in *"|$key|"*) return 1 ;; esac
    seen="${seen}${key}|"
    case "$key" in
      marker) marker="$value" ;; schema) schema="$value" ;;
      runtime_version) runtime_version="$value" ;; runtime_hash) runtime_hash="$value" ;;
      manifest_version) manifest_version="$value" ;; manifest_hash) manifest_hash="$value" ;;
      token_hash) token_hash="$value" ;; owner_pid) owner_pid="$value" ;; snapshot_generation) snapshot="$value" ;;
      index_hash) index_hash="$value" ;; base_hash) base_hash="$value" ;; rows_hash) rows_hash="$value" ;;
      published) published="$value" ;;
      *) return 1 ;;
    esac
  done < "$dir/updates-meta.tsv"
  runtime="$(tui_runtime_path)"
  case "$published" in ''|*[!0-9]*) return 1 ;; esac
  [ "$marker" = 'aiup-tui-updates-v1' ] && [ "$schema" = "$AIUP_TUI_UPDATE_SCHEMA" ] || return 1
  [ "$runtime_version" = "$AIUP_VERSION" ] && [ "$runtime_hash" = "$(sha256_file "$runtime")" ] || return 1
  [ "$manifest_version" = "$CATALOG_MANIFEST_VERSION" ] && [ "$manifest_hash" = "$CATALOG_MANIFEST_HASH" ] || return 1
  [ "$token_hash" = "$(sha256_file "$dir/token")" ] || return 1
  case "${dir##*/}" in "$owner_pid"-*|.staging-"$owner_pid"-*) ;; *) return 1 ;; esac
  kill -0 "$owner_pid" 2>/dev/null || return 1
  session_snapshot="$(awk -F '\t' '$1=="snapshot_generation" {print $2; exit}' "$dir/meta.tsv" 2>/dev/null || true)"
  if [ -n "$session_snapshot" ]; then
    [ "$snapshot" = "$session_snapshot" ] || return 1
  else
    [ "$snapshot" = "${AIUP_TUI_SNAPSHOT_GENERATION:-$snapshot}" ] || return 1
  fi
  [ "$index_hash" = "$(sha256_file "$dir/updates-index.tsv")" ] || return 1
  [ "$base_hash" = "$(sha256_file "$dir/rows-base.tsv")" ] || return 1
  [ "$rows_hash" = "$(sha256_file "$dir/rows-expanded.tsv")" ] || return 1
  awk -F '\t' '
    NF != 9 {exit 1}
    $1 !~ /^([a-z0-9-]+|b[cf]:[A-Za-z0-9@+._\/-]+)$/ {exit 1}
    $4 !~ /^(newer|current|checking|unavailable)$/ {exit 1}
    $5 !~ /^(eligible|manual-review)$/ {exit 1}
    $9 !~ /^(none|[0-9]+:(newer|current|failure))$/ {exit 1}
    {if (seen[$1]++) exit 1}
  ' "$dir/updates-index.tsv" || return 1
}

tui_updates_publish() {
  local dir="${1:-$AIUP_TUI_SESSION_DIR}" token="${2:-$AIUP_TUI_SESSION_TOKEN}" snapshot="${3:-$AIUP_TUI_SNAPSHOT_GENERATION}"
  local defer_validation="${4:-0}"
  local lock index_tmp rows_tmp meta_tmp runtime now owner_pid policies
  policies="$(preferences reasons)" || return 1
  [ -n "$dir" ] && [ -d "$dir" ] && [ ! -L "$dir" ] || return 1
  [ -f "$dir/rows-base.tsv" ] && [ ! -L "$dir/rows-base.tsv" ] || return 1
  lock="$dir/.updates-publish.lock"
  mkdir "$lock" 2>/dev/null || return 0
  index_tmp="$dir/updates-index.tsv.next.$(current_shell_pid)"
  rows_tmp="$dir/rows-expanded.tsv.next.$(current_shell_pid)"
  meta_tmp="$dir/updates-meta.tsv.next.$(current_shell_pid)"
  runtime="$(tui_runtime_path)"
  now="$(date +%s)"
  owner_pid="$(awk -F '\t' '$1=="owner_pid" {print $2; exit}' "$dir/meta.tsv" 2>/dev/null || true)"
  [ -n "$owner_pid" ] || owner_pid="$$"
  if ! python3 - "$CATALOG_MANIFEST" "$dir/catalog-index.tsv" "$dir/brew-index.tsv" "$dir/versions-index.tsv" \
    "$AVAILABLE_VERSION_CACHE_DIR" "$dir/rows-base.tsv" "$index_tmp" "$rows_tmp" "$now" \
    "$AVAILABLE_VERSION_CACHE_TTL" "$AVAILABLE_VERSION_FAILURE_TTL" "$meta_tmp" "$runtime" "$dir/token" \
    "$owner_pid" "$snapshot" "$AIUP_TUI_UPDATE_SCHEMA" "$AIUP_VERSION" "$CATALOG_MANIFEST_VERSION" "$policies" <<'PY'
import csv, hashlib, os, pathlib, re, sys

(manifest_path, catalog_path, brew_path, versions_path, cache_path, base_path,
 index_path, rows_path) = map(pathlib.Path, sys.argv[1:9])
now, good_ttl, failure_ttl = map(int, sys.argv[9:12])
meta_path, runtime_path, token_path = map(pathlib.Path, sys.argv[12:15])
owner_pid, snapshot, schema, runtime_version, manifest_version = sys.argv[15:20]
policies=dict(line.split("\t",1) for line in sys.argv[20].splitlines() if "\t" in line)

def version_parts(value):
    return tuple(int(part) for part in re.findall(r"\d+", value or ""))

def greater(left, right):
    a, b = version_parts(left), version_parts(right)
    width = max(len(a), len(b))
    return a + (0,) * (width - len(a)) > b + (0,) * (width - len(b))

def valid_version(value):
    return bool(value and re.fullmatch(r"[A-Za-z0-9._+-]+", value) and re.search(r"\d", value))

manifest = {}
with manifest_path.open(encoding="utf-8") as handle:
    for row in csv.reader((line for line in handle if not line.startswith("#")), delimiter="\t"):
        if len(row) >= 6:
            row += [""] * (8 - len(row))
            manifest[row[0]] = {"kind": row[2], "lifecycle": row[3], "label": row[4]}
versions = {}
with versions_path.open(encoding="utf-8") as handle:
    for row in csv.reader(handle, delimiter="\t"):
        if len(row) >= 2 and row[0] not in versions: versions[row[0]] = row[1]
candidates = []
with catalog_path.open(encoding="utf-8") as handle:
    for row in csv.reader(handle, delimiter="\t"):
        if len(row) >= 3 and row[1] == "installed" and row[2] in manifest:
            item = manifest[row[2]]
            candidates.append((row[2], versions.get(row[2], "unknown"), item["lifecycle"], item["label"]))
with brew_path.open(encoding="utf-8") as handle:
    for row in csv.reader(handle, delimiter="\t"):
        if len(row) >= 4 and row[1] == "installed" and row[2].startswith(("bc:", "bf:")):
            candidates.append((row[2], versions.get(row[2], "unknown"), "active", row[3]))

records = []
for canonical, installed, lifecycle, label in candidates:
    status, available, cache_identity = "checking", "", "none"
    eligibility = "eligible" if lifecycle == "active" else "manual-review"
    if not installed or installed in {"unknown", "not installed", "app present"}:
        status = "unavailable"
    else:
        cache_file = cache_path / f"{canonical.replace('/', '%2F')}.tsv"
        try:
            if cache_file.is_symlink() or not cache_file.is_file(): raise ValueError
            raw = cache_file.read_text(encoding="utf-8")
            rows = list(csv.reader(raw.splitlines(), delimiter="\t"))
            if len(rows) != 1 or len(rows[0]) != 4: raise ValueError
            cached_at, cached_current, cached_status, cached_available = rows[0]
            if not cached_at.isdigit() or cached_current != installed: raise ValueError
            age = now - int(cached_at)
            ttl = failure_ttl if cached_status == "failure" else good_ttl
            if age < 0 or age >= ttl or cached_status not in {"newer", "current", "failure"}: raise ValueError
            cache_identity = f"{cached_at}:{cached_status}"
            if cached_status == "failure": status = "unavailable"
            elif cached_status == "current": status = "current"
            elif cached_status == "newer" and valid_version(cached_available) and greater(cached_available, installed):
                status, available = "newer", cached_available
            else: status = "unavailable"
        except (OSError, UnicodeError, ValueError):
            status, available = "checking", ""
    if canonical in policies: eligibility="manual-review"; label += " · " + policies[canonical]
    records.append((canonical, installed, available, status, eligibility, lifecycle, "update", label.replace("\t", " ").replace("\n", " "), cache_identity))

with index_path.open("w", encoding="utf-8", newline="") as handle:
    csv.writer(handle, delimiter="\t", lineterminator="\n").writerows(records)

newer = [row for row in records if row[3] == "newer"]
eligible = [row for row in newer if row[4] == "eligible"]
checking = sum(row[3] == "checking" for row in records)
unavailable = sum(row[3] == "unavailable" for row in records)
if newer and not checking and not unavailable:
    title = f"Updates available · {len(newer)}"
elif newer:
    parts = [f"Updates · {len(newer)} verified"]
    if checking: parts.append(f"{checking} checking")
    if unavailable: parts.append(f"{unavailable} unavailable to verify")
    title = " · ".join(parts)
elif checking:
    title = "Updates · checking…"
    if unavailable: title += f" · {unavailable} unavailable to verify"
elif unavailable:
    title = f"Updates · {unavailable} need checking"
else:
    title = "Updates · all verified items current"

reset = "\033[0m"; green = "\033[38;5;82m"; dim = "\033[38;5;245m"
rendered = [f"__cat:updates\t{green}▌{reset} ▸ {green}{title}{reset}\n"]
if eligible:
    rendered.append(f"__updates:all\t{green}▌{reset}     {green}Update all verified items · {len(eligible)}{reset}\n")
for canonical, installed, available, status, eligibility, lifecycle, action, label, cache_identity in newer:
    review = " · manual review" if eligibility != "eligible" else ""
    rendered.append(f"__update:{canonical}\t{green}▌{reset} {canonical:<18.18} {installed} → {available} · update{review} · {label}\n")
for canonical, installed, available, status, eligibility, lifecycle, action, label, cache_identity in records:
    if status not in {"unavailable", "checking"}: continue
    text = "Could not check for updates" if status == "unavailable" else "Checking for updates…"
    if status == "unavailable" and canonical in {"brew", "npm", "uv", "grok", "antigravity"}: text = "Checked during a normal update"
    rendered.append(f"__updates:status:{canonical}\t{dim}▌{reset}     {canonical} · {text}\n")
if not newer and not checking and not unavailable:
    rendered.append(f"__updates:status:empty\t{dim}▌{reset}     No updates found in completed checks.\n")
rendered.append(base_path.read_text(encoding="utf-8"))
rows_path.write_text("".join(rendered), encoding="utf-8")

def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()
metadata = [
    ("marker", "aiup-tui-updates-v1"), ("schema", schema),
    ("runtime_version", runtime_version), ("runtime_hash", digest(runtime_path)),
    ("manifest_version", manifest_version), ("manifest_hash", digest(manifest_path)),
    ("token_hash", digest(token_path)), ("owner_pid", owner_pid),
    ("snapshot_generation", snapshot), ("published", str(now)),
    ("index_hash", digest(index_path)), ("base_hash", digest(base_path)), ("rows_hash", digest(rows_path)),
]
meta_path.write_text("".join(f"{key}\t{value}\n" for key, value in metadata), encoding="utf-8")
PY
  then
    rm -f "$index_tmp" "$rows_tmp" "$meta_tmp"
    rmdir "$lock" 2>/dev/null || true
    return 1
  fi
  if ! mv "$index_tmp" "$dir/updates-index.tsv" || ! mv "$rows_tmp" "$dir/rows-expanded.tsv"; then
    rm -f "$index_tmp" "$rows_tmp" "$meta_tmp"
    rmdir "$lock" 2>/dev/null || true
    return 1
  fi
  if ! mv "$meta_tmp" "$dir/updates-meta.tsv"; then
    rm -f "$meta_tmp"
    rmdir "$lock" 2>/dev/null || true
    return 1
  fi
  rmdir "$lock" 2>/dev/null || true
  [ "$defer_validation" -eq 1 ] && return 0
  tui_updates_index_valid "$dir"
}

