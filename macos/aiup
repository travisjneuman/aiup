tui_prefetch_brew_consolidated() {
  local raw parsed tool current status available has_brew=0 brew_lock
  capture_fixture_enabled && return 0
  command_exists brew || return 0
  while IFS=$'\t' read -r tool current; do
    case "$(catalog_kind "$tool")" in brew-formula|brew-cask) has_brew=1; break ;; esac
  done < "$AIUP_TUI_SESSION_DIR/preview-remote.tsv"
  [ "$has_brew" -eq 1 ] || return 0
  brew_lock="$AVAILABLE_VERSION_CACHE_DIR/.brew-snapshot.lock"
  mkdir "$brew_lock" 2>/dev/null || return 0
  printf '%s\t%s\n' "$(current_shell_pid)" "$(date +%s)" > "$brew_lock/meta"
  AIUP_ACTIVE_AVAILABLE_LOCK="$brew_lock"
  raw="$(mktemp "$AVAILABLE_VERSION_CACHE_DIR/.brew-outdated.XXXXXX")" || { rm -f "$brew_lock/meta"; rmdir "$brew_lock" 2>/dev/null || true; AIUP_ACTIVE_AVAILABLE_LOCK=""; return 0; }
  if ! bounded_provider_capture "$raw" "$AVAILABLE_VERSION_PROVIDER_TIMEOUT" env HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew outdated --json=v2; then
    while IFS=$'\t' read -r tool current; do
      case "$tool:$(catalog_kind "$tool")" in bf:*|bc:*|*:brew-formula|*:brew-cask) available_cache_write "$tool" "$current" failure '' || true ;; esac
    done < "$AIUP_TUI_SESSION_DIR/preview-remote.tsv"
    rm -f "$raw" "$brew_lock/meta"; rmdir "$brew_lock" 2>/dev/null || true; AIUP_ACTIVE_AVAILABLE_LOCK=""
    return 0
  fi
  parsed="${raw}.parsed"
  python3 - "$CATALOG_MANIFEST" "$AIUP_TUI_SESSION_DIR/catalog-index.tsv" "$AIUP_TUI_SESSION_DIR/brew-index.tsv" "$AIUP_TUI_SESSION_DIR/versions-index.tsv" "$raw" > "$parsed" 2>/dev/null <<'PY'
import csv, json, sys
manifest, states_path, brew_path, versions_path, raw_path = sys.argv[1:]
targets = {}
with open(manifest, encoding="utf-8") as handle:
    for row in csv.reader((line for line in handle if not line.startswith("#")), delimiter="\t"):
        if len(row) >= 7 and row[2] in {"brew-formula", "brew-cask"}: targets[row[0]] = (row[2], row[6])
states = {}
with open(states_path, encoding="utf-8") as handle:
    for row in csv.reader(handle, delimiter="\t"):
        if len(row) >= 3: states[row[2]] = row[1]
with open(brew_path, encoding="utf-8") as handle:
    for row in csv.reader(handle, delimiter="\t"):
        if len(row) >= 3 and row[1] == "installed" and row[2].startswith(("bc:", "bf:")):
            kind = "brew-cask" if row[2].startswith("bc:") else "brew-formula"
            targets[row[2]] = (kind, row[2][3:])
            states[row[2]] = row[1]
versions = {}
with open(versions_path, encoding="utf-8") as handle:
    for row in csv.reader(handle, delimiter="\t"):
        if len(row) >= 2: versions[row[0]] = row[1]
with open(raw_path, encoding="utf-8") as handle: data = json.load(handle)
outdated = {}
if not isinstance(data.get("formulae"), list) or not isinstance(data.get("casks"), list): raise ValueError("invalid brew snapshot")
for item in data["formulae"]:
    name = item.get("name", ""); value = item.get("current_version", "")
    if not isinstance(name,str) or not name or not isinstance(value,str) or not value: raise ValueError("invalid formula record")
    outdated[("brew-formula", name)] = value
for item in data["casks"]:
    name = item.get("name", "") or item.get("token", ""); value = item.get("current_version", "")
    if not isinstance(name,str) or not name or not isinstance(value,str) or not value: raise ValueError("invalid cask record")
    outdated[("brew-cask", name)] = value
for tool, (kind, target) in targets.items():
    if states.get(tool) not in {"installed", "on-disk"}: continue
    print(tool, versions.get(tool, "unknown"), outdated.get((kind, target), ""), sep="\t")
PY
  if [ $? -eq 0 ]; then
    while IFS=$'\t' read -r tool current available; do
      [ -n "$tool" ] || continue
      if [ -n "$available" ] && [ "$(version_is_greater "$available" "$current")" = yes ]; then status=newer; else status=current; available=''; fi
      available_cache_write "$tool" "$current" "$status" "$available" || true
    done < "$parsed"
  else
    while IFS=$'\t' read -r tool current; do
      case "$tool:$(catalog_kind "$tool")" in bf:*|bc:*|*:brew-formula|*:brew-cask) available_cache_write "$tool" "$current" failure '' || true ;; esac
    done < "$AIUP_TUI_SESSION_DIR/preview-remote.tsv"
  fi
  rm -f "$raw" "$parsed"
  rm -f "$brew_lock/meta"; rmdir "$brew_lock" 2>/dev/null || true
  AIUP_ACTIVE_AVAILABLE_LOCK=""
}

tui_prefetch_worker() {
  local offset="$1" tool current kind index=0
  while IFS=$'\t' read -r tool current; do
    [ -n "$tool" ] && [ -n "$current" ] || continue
    case "$tool" in bf:*) kind=brew-formula ;; bc:*) kind=brew-cask ;; *) kind="$(catalog_kind "$tool")" ;; esac
    case "$kind" in brew-formula|brew-cask) continue ;; esac
    if [ $((index % TUI_PREFETCH_WORKERS)) -eq "$offset" ]; then
      available_version_of_tool "$tool" "$current" >/dev/null 2>&1 || true
    fi
    index=$((index + 1))
  done < "$AIUP_TUI_SESSION_DIR/preview-remote.tsv"
}

tui_prefetch_supervisor() {
  local index pid
  local -a children=()
  trap 'for pid in "${children[@]}"; do kill "$pid" 2>/dev/null || true; done; wait 2>/dev/null || true; exit 0' TERM INT HUP
  sleep 0.35
  tui_prefetch_brew_consolidated || true
  index=0
  while [ "$index" -lt "$TUI_PREFETCH_WORKERS" ]; do
    tui_prefetch_worker "$index" & children+=("$!")
    index=$((index + 1))
  done
  for pid in "${children[@]}"; do wait "$pid" 2>/dev/null || true; done
  # Coalesce all installed-only enrichment into one atomic session publication
  # and one fzf reload. Per-item reload storms can delay or swallow local input.
  tui_updates_refresh_session
}

tui_prefetch_start() {
  [ -n "$AIUP_TUI_PREFETCH_PID" ] && return 0
  tui_prefetch_supervisor >/dev/null 2>&1 &
  AIUP_TUI_PREFETCH_PID=$!
  profile_note "available-prefetch workers=$TUI_PREFETCH_WORKERS installed-only=yes debounce=350ms"
}

tui_prefetch_stop() {
  [ -n "${AIUP_TUI_PREFETCH_PID:-}" ] || return 0
  kill "$AIUP_TUI_PREFETCH_PID" 2>/dev/null || true
  wait "$AIUP_TUI_PREFETCH_PID" 2>/dev/null || true
  AIUP_TUI_PREFETCH_PID=""
}

catalog_version_preview() {
  local tool="$1"
  local state="$2"
  local installed available
  case "$state" in
    installed|on-disk) ;;
    *) return 0 ;;
  esac
  installed="$(version_of_tool "$tool" || true)"
  [ -n "$installed" ] || installed='unknown'
  printf 'installed %s\n' "$installed"
  available="$(available_version_of_tool "$tool" "$installed" || true)"
  [ -n "$available" ] && printf 'available %s\n' "$available"
}

