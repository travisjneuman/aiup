}

run_with_heartbeat() {
  local label="$1"
  shift

  if [ "$DRY_RUN" -eq 1 ]; then
    info "DRY-RUN: $label"
    return 0
  fi

  local start_ts pid rc elapsed hb_pid
  start_ts="$(date +%s)"
  info "START: $label"
  "$@" </dev/null &
  pid=$!

  (
    while kill -0 "$pid" 2>/dev/null; do
      sleep "$HEARTBEAT_SECONDS"
      if kill -0 "$pid" 2>/dev/null; then
        elapsed=$(( $(date +%s) - start_ts ))
        if [ "$UPDATE_REPORT_ACTIVE" -eq 1 ] && [ "$AIUP_VERBOSE" -eq 0 ] && [ -t 4 ]; then
          printf '\r\033[2K  › %.20s · %s done · !%s · %ss' "$UPDATE_REPORT_CURRENT_TOOL" "$UPDATE_REPORT_COMPLETED" "$UPDATE_REPORT_WARNINGS" "$elapsed" >&4
        fi
        info "still working: $label (${elapsed}s elapsed)"
      fi
    done
  ) &
  hb_pid=$!

  wait "$pid"
  rc=$?
  kill "$hb_pid" 2>/dev/null || true
  wait "$hb_pid" 2>/dev/null || true

  if [ "$rc" -eq 0 ]; then
    info "DONE: $label ($(( $(date +%s) - start_ts ))s)"
  else
    error "FAILED: $label (exit $rc; $(( $(date +%s) - start_ts ))s)"
  fi
  return "$rc"
}

run_shell_with_heartbeat() {
  local cmd="$1"
  run_with_heartbeat "$cmd" bash -lc "$cmd"
}

which_all_unique_list() {
  local cmd="$1"
  local out=""
  local seen="|"
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$seen" in
      *"|$line|"*) ;;
      *)
        if [ -n "$out" ]; then
          out="$out, $line"
        else
          out="$line"
        fi
        seen="${seen}${line}|"
        ;;
    esac
  done <<EOF_AW
$(which -a "$cmd" 2>/dev/null || true)
EOF_AW
  printf '%s
' "$out"
}

which_all_unique_count() {
  local list count oldifs item
  list="$(which_all_unique_list "$1")"
  if [ -z "$list" ]; then
    printf '0
'
    return 0
  fi
  count=0
  oldifs="$IFS"
  IFS=','
  for item in $list; do
    count=$((count+1))
  done
  IFS="$oldifs"
  printf '%s
' "$count"
}

