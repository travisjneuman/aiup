path_insights() {
  python3 - "$1" "${2:-}" "$AIUP_VERSION" "$HOME" <<'PYPATHINFO'
import csv,json,os,plistlib,re,sys
from pathlib import Path
index=Path(sys.argv[1]); mode=sys.argv[2]; home=Path(sys.argv[4])
def text(path,limit=1048576):
    try:
        if path.stat().st_size>limit:return ''
        return path.read_text(errors='replace')
    except OSError:return ''
def plist(path):
    try:
        if path.stat().st_size>1048576:return {}
        return plistlib.loads(path.read_bytes())
    except (OSError,ValueError):return {}
def clean(v):return re.sub(r'[\x00-\x1f\x7f-\x9f]',' ',str(v))[:600]
def info(raw):
    p=Path(raw)
    try:r=p.resolve()
    except (OSError,RuntimeError):r=p
    n=p.name; rs=str(r)
    v='not reported';owner='Local command';desc='Command available in your terminal';docs='';guide='Its owner has not been identified; inspect its location before changing it.'
    # Package ancestry, not executable name, establishes npm ownership.
    for parent in list(r.parents)[:6]:
        try:d=json.loads(text(parent/'package.json'))
        except ValueError:continue
        if not isinstance(d,dict):continue
        bins=d.get('bin',{});bins=[bins] if isinstance(bins,str) else list(bins.values()) if isinstance(bins,dict) else []
        if not any(isinstance(b,str) and (parent/b).resolve()==r for b in bins):continue
        owner=d.get('name','npm package');v=d.get('version',v);desc=d.get('description') or 'JavaScript package-manager helper'
        docs=d.get('homepage','');docs=docs if isinstance(docs,str) and docs.startswith('https://') else ''
        guide='Update through the package manager that owns '+str(parent)+'. This may be a different copy from the one AIUP manages.'
        if owner=='nativefier':guide='Nativefier is archived. Review the project before replacing or reinstalling it.'
        return v,owner,desc,guide,docs,str(r)
    # Helpers inside an app share the app version, not an invented CLI version.
    app=next((a for a in r.parents if a.suffix=='.app'),None)
