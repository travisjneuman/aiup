# One authoritative post-refresh snapshot avoids a no-op upgrade per package.
# Greedy includes auto-updating/latest casks; unsupported metadata never skips work.
brew_target_current() {
  local kind="$1" target="${2##*/}" raw
  [ "$AIUP_FORCE" -eq 0 ] && [ "$DRY_RUN" -eq 0 ] && [ "${AIUP_VERIFIED_SELECTION_ONLY:-0}" != 1 ] || return 1
  if [ "${AIUP_BREW_OUTDATED_READY:-0}" -eq 0 ]; then
    AIUP_BREW_OUTDATED_READY=1
    AIUP_BREW_OUTDATED_TARGETS='unknown'
    ensure_dir "$AVAILABLE_VERSION_CACHE_DIR"
    raw="$(mktemp "$AVAILABLE_VERSION_CACHE_DIR/.brew-outdated.XXXXXX")" || return 1
    if bounded_provider_capture "$raw" "$AVAILABLE_VERSION_PROVIDER_TIMEOUT" env HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew outdated --greedy --json=v2; then
      AIUP_BREW_OUTDATED_TARGETS="$(python3 - "$raw" <<'PYOUTDATED'
import json, sys
try:
    data = json.load(open(sys.argv[1]))
    targets = []
    for kind, field in (("formula", "formulae"), ("cask", "casks")):
        if not isinstance(data.get(field), list): raise ValueError()
        for item in data[field]:
            name = item.get("name") or item.get("token")
            if not isinstance(name, str) or not name: raise ValueError()
            targets.append(kind+":"+name.split("/")[-1])
    print("|"+"|".join(targets)+"|")
except (OSError, ValueError, AttributeError, TypeError):
    print("unknown")
PYOUTDATED
)"
    fi
    rm -f "$raw"
  fi
  [ "$AIUP_BREW_OUTDATED_TARGETS" != unknown ] || return 1
  case "$AIUP_BREW_OUTDATED_TARGETS" in *"|$kind:$target|"*) return 1 ;; esac
  return 0
}

