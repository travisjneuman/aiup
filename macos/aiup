npm_uninstall_system_pkg_if_distinct() {
  local pkg="$1"
  local sys_prefix
  sys_prefix="$(system_npm_prefix)"
  if [ -n "$sys_prefix" ] && [ "$sys_prefix" = "$AIUP_NPM_PREFIX" ]; then
    return 0
  fi
  if system_npm_pkg_installed "$pkg"; then
    run_with_heartbeat "npm uninstall -g $pkg (system prefix $sys_prefix)" env NPM_CONFIG_PREFIX="$sys_prefix" npm uninstall -g "$pkg" || true
  fi
}

