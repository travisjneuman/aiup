tui_stale_sessions_cleanup() {
  local dir base created="" owner_pid="" marker="" now entry unfamiliar
  [ -d "$TUI_SESSIONS_ROOT" ] && [ ! -L "$TUI_SESSIONS_ROOT" ] || return 0
  now="$(date +%s)"
  for dir in "$TUI_SESSIONS_ROOT"/*; do
    [ -e "$dir" ] || continue
    [ -d "$dir" ] && [ ! -L "$dir" ] || continue
    base="${dir##*/}"
    case "$base" in [0-9]*-[A-Fa-f0-9]*) ;; *) continue ;; esac
    [ -f "$dir/meta.tsv" ] && [ ! -L "$dir/meta.tsv" ] || continue
    while IFS=$'\t' read -r key value extra; do
      [ -z "${extra:-}" ] || { marker=""; break; }
      case "$key" in marker) marker="$value" ;; created) created="$value" ;; owner_pid) owner_pid="$value" ;; esac
    done < "$dir/meta.tsv"
    [ "$marker" = 'aiup-tui-session-v1' ] || continue
    [ -n "$created" ] && [ -n "$owner_pid" ] || continue
    case "$created:$owner_pid" in *[!0-9:]*) continue ;; esac
    [ "${base%%-*}" = "$owner_pid" ] || continue
    kill -0 "$owner_pid" 2>/dev/null && continue
    [ $((now - created)) -ge "$TUI_SESSION_TTL" ] || continue
    unfamiliar=0
    for entry in "$dir"/*; do
      [ -e "$entry" ] || continue
      [ ! -L "$entry" ] || { unfamiliar=1; break; }
      tui_session_known_entry "${entry##*/}" || { unfamiliar=1; break; }
    done
    [ "$unfamiliar" -eq 0 ] || continue
    rm -f "$dir/meta.tsv" "$dir/token" "$dir/catalog-index.tsv" "$dir/brew-index.tsv" "$dir/inventory-index.tsv" "$dir/versions-index.tsv" "$dir/preview-local.tsv" "$dir/preview-remote.tsv" "$dir/preview-docs.tsv" "$dir/fast-helper.py" \
      "$dir/rows-base.tsv" "$dir/rows-expanded.tsv" "$dir/rows-collapsed.tsv" "$dir/updates-meta.tsv" "$dir/updates-index.tsv" "$dir/fzf.sock" \
      "$dir/expanded" "$dir/expanded.next" "$dir/query" "$dir/category" "$dir/selected" "$dir/list.tsv" "$dir/list.tsv.next" \
      "$dir"/expanded.next.* "$dir"/list.tsv.next.* "$dir"/updates-meta.tsv.next.* "$dir"/updates-index.tsv.next.* "$dir"/rows-expanded.tsv.next.*
    rmdir "$dir/.updates-publish.lock" 2>/dev/null || true
    rmdir "$dir" 2>/dev/null || true
  done
}

tui_session_emit_rows() {
  local dir="${AIUP_TUI_SESSION_DIR:-}"
  [ "$AIUP_TUI_SESSION_ACTIVE" -eq 1 ] || return 1
  awk -F '\t' -v expanded="$dir/expanded" -v query="$dir/query" -v filter="$LIST_CATEGORY_FILTER" -v view="$LIST_VIEW_MODE" '
    BEGIN {
      while ((getline line < expanded) > 0) open[line] = 1
      close(expanded)
      search = ((getline line < query) > 0 && length(line) > 0)
      close(query)
    }
    $1 ~ /^__cat:/ {
      category = substr($1, 7)
      show = search || open[category]
      if ((filter == "homebrew" || filter ~ /^homebrew\// || view == "available") && category ~ /^homebrew/) show = 1
      print
      next
    }
    show { print }
  ' "$dir/rows-expanded.tsv"
}

tui_session_context_valid() {
  local dir="$AIUP_TUI_SESSION_DIR" token="$AIUP_TUI_SESSION_TOKEN"
  local marker="" schema="" runtime_version="" runtime_hash="" manifest_version="" manifest_hash=""
  local snapshot="" owner_pid="" nonce="" created="" catalog_hash="" brew_hash="" inventory_hash="" versions_hash="" preview_hash="" helper_hash="" rows_hash="" context_hash=""
  local session_view="" session_category="" session_sort=""
  local runtime
  [ -n "$dir" ] && [ -n "$token" ] || return 1
  [ -d "$dir" ] && [ ! -L "$dir" ] || return 1
  case "$dir" in "$TUI_SESSIONS_ROOT"/*) ;; *) return 1 ;; esac
  for name in meta.tsv token catalog-index.tsv brew-index.tsv inventory-index.tsv versions-index.tsv preview-local.tsv preview-remote.tsv preview-docs.tsv fast-helper.py rows-base.tsv rows-expanded.tsv rows-collapsed.tsv updates-meta.tsv updates-index.tsv expanded query category selected; do
    [ -f "$dir/$name" ] && [ ! -L "$dir/$name" ] || return 1
  done
  [ "$token" = "$(sed -n '1p' "$dir/token")" ] || return 1
  while IFS=$'\t' read -r key value extra; do
    [ -z "${extra:-}" ] || return 1
    case "$key" in
      marker) marker="$value" ;; schema) schema="$value" ;; runtime_version) runtime_version="$value" ;;
      runtime_hash) runtime_hash="$value" ;; manifest_version) manifest_version="$value" ;; manifest_hash) manifest_hash="$value" ;;
      snapshot_generation) snapshot="$value" ;; owner_pid) owner_pid="$value" ;; nonce) nonce="$value" ;; created) created="$value" ;;
      catalog_hash) catalog_hash="$value" ;; brew_hash) brew_hash="$value" ;; inventory_hash) inventory_hash="$value" ;; rows_hash) rows_hash="$value" ;;
      versions_hash) versions_hash="$value" ;; preview_hash) preview_hash="$value" ;;
      helper_hash) helper_hash="$value" ;;
      context_hash) context_hash="$value" ;;
      view) session_view="$value" ;; category_filter) session_category="$value" ;; sort) session_sort="$value" ;;
      *) return 1 ;;
    esac
  done < "$dir/meta.tsv"
  [ "$marker" = 'aiup-tui-session-v1' ] && [ "$schema" = "$AIUP_TUI_CACHE_SCHEMA" ] || return 1
  [ "$runtime_version" = "$AIUP_VERSION" ] && [ "$manifest_version" = "$CATALOG_MANIFEST_VERSION" ] || return 1
  runtime="$(tui_runtime_path)"
  [ -n "$runtime_hash" ] && [ -n "$manifest_hash" ] || return 1
  case "$snapshot:$owner_pid:$created:$nonce" in *[!A-Za-z0-9._:-]*) return 1 ;; esac
  [ "${dir##*/}" = "$owner_pid-$nonce" ] || return 1
  kill -0 "$owner_pid" 2>/dev/null || return 1
  [ "$session_view" = "$LIST_VIEW_MODE" ] && [ "$session_category" = "$LIST_CATEGORY_FILTER" ] && [ "$session_sort" = "$LIST_SORT_MODE" ] || return 1
  [ "$context_hash" = "$(files_content_hash "$runtime" "$CATALOG_MANIFEST" "$dir/catalog-index.tsv" "$dir/brew-index.tsv" \
    "$dir/inventory-index.tsv" "$dir/versions-index.tsv" "$dir/preview-local.tsv" "$dir/preview-remote.tsv" "$dir/preview-docs.tsv" "$dir/fast-helper.py" "$dir/rows-base.tsv" "$dir/rows-collapsed.tsv")" ] || return 1
  tui_updates_index_valid "$dir" || return 1
}

tui_session_activate() {
  CATALOG_MANIFEST_VERSION="$(sed -n 's/^# aiup-runtime-version: //p' "$CATALOG_MANIFEST" | head -n 1)"
  [ "$CATALOG_MANIFEST_VERSION" = "$AIUP_VERSION" ] || return 1
  CATALOG_MANIFEST_HASH="$(sha256_file "$CATALOG_MANIFEST")" || return 1
  AIUP_RUNTIME_HASH="$(sha256_file "$(tui_runtime_path)")" || return 1
  tui_session_context_valid || return 1
  AIUP_TUI_SESSION_ACTIVE=1
  AIUP_TUI_SNAPSHOT_GENERATION="$(awk -F '\t' '$1=="snapshot_generation" {print $2; exit}' "$AIUP_TUI_SESSION_DIR/meta.tsv")"
  CATALOG_INDEX="$AIUP_TUI_SESSION_DIR/catalog-index.tsv"
  BREW_INDEX="$AIUP_TUI_SESSION_DIR/brew-index.tsv"
  INVENTORY_INDEX="$AIUP_TUI_SESSION_DIR/inventory-index.tsv"
