  brew_review_installed_taps || return 1
  if [ -z "${_AIUP_BREW_UPDATED:-}" ]; then
    run_with_heartbeat "brew update" env HOMEBREW_NO_ENV_HINTS=1 brew update || return 1
    _AIUP_BREW_UPDATED=1
  fi
}

brew_untrusted_installed_taps() {
  command_exists brew || return 0
  brew tap-info --installed --json 2>/dev/null | python3 -c '
import json, sys
try:
    taps = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for tap in taps:
    if tap.get("installed") and not tap.get("trusted"):
        print(tap.get("name", ""))
' 2>/dev/null | awk 'NF'
}

brew_tap_remote() {
  local tap="$1"
  brew tap-info --json "$tap" 2>/dev/null | python3 -c '
import json, sys
try:
    items = json.load(sys.stdin)
    print((items[0] if items else {}).get("remote", ""))
except Exception:
    pass
' 2>/dev/null | first_line
}

brew_review_installed_taps() {
  command_exists brew || return 0
  case "${_AIUP_BREW_TRUST_REVIEWED:-}" in
    1) return 0 ;;
  esac

  local taps tap remote
  taps="$(brew_untrusted_installed_taps)"
  _AIUP_BREW_TRUST_REVIEWED=1
  [ -n "$taps" ] || return 0

  if [ "$DRY_RUN" -eq 1 ]; then
    while IFS= read -r tap; do
      [ -n "$tap" ] || continue
      warn "DRY-RUN: would trust already-installed Homebrew tap $tap"
    done <<< "$taps"
    return 0
  fi

  while IFS= read -r tap; do
    [ -n "$tap" ] || continue
    remote="$(brew_tap_remote "$tap")"
    info "Trusting already-installed Homebrew tap $tap as prior user approval"
    [ -n "$remote" ] && info "Tap remote: $remote"
    run_with_heartbeat "brew trust --tap $tap" env HOMEBREW_NO_ENV_HINTS=1 brew trust --tap "$tap" || return 1
    info "Trusted installed Homebrew tap: $tap"
  done <<< "$taps"
  return 0
}

brew_tap_installed() {
  local tap="$1"
  command_exists brew || return 1
  brew tap 2>/dev/null | awk -v wanted="$tap" '$0 == wanted {found=1} END {exit found ? 0 : 1}'
}

brew_tap_trusted() {
  local tap="$1"
  brew tap-info --json "$tap" 2>/dev/null | python3 -c '
import json, sys
try:
    items = json.load(sys.stdin)
    raise SystemExit(0 if items and items[0].get("trusted") else 1)
except Exception:
    raise SystemExit(1)
' 2>/dev/null
}

catalog_brew_tap() {
  case "$1" in
    # Add a fully-qualified third-party tap here when a catalog item requires
    # one. The installer will ask before adding or trusting it.
    *) printf '\n' ;;
  esac
}

brew_target_tap() {
  local tool="$1"
  local target="$2"
  local target_kind="$3"
  local explicit
  explicit="$(catalog_brew_tap "$tool")"
  if [ -n "$explicit" ]; then
    printf '%s\n' "$explicit"
    return 0
  fi
  case "$target" in
    */*/*) printf '%s/%s\n' "$(printf '%s' "$target" | cut -d/ -f1)" "$(printf '%s' "$target" | cut -d/ -f2)"; return 0 ;;
  esac
  if [ "$target_kind" = 'formula' ]; then
    brew info --json=v2 --formula "$target" 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); f=d.get("formulae") or []; print((f[0] if f else {}).get("tap", ""))' 2>/dev/null | first_line
  else
    brew info --json=v2 --cask "$target" 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); c=d.get("casks") or []; print((c[0] if c else {}).get("tap", ""))' 2>/dev/null | first_line
  fi
}

brew_ensure_target_tap() {
  local tool="$1"
  local target="$2"
  local target_kind="$3"
  local tap remote
  tap="$(brew_target_tap "$tool" "$target" "$target_kind")"
  case "$tap" in
    ''|homebrew/core|homebrew/cask|homebrew/bundle|homebrew/services) return 0 ;;
  esac
  remote="$(brew_tap_remote "$tap")"
  if ! brew_tap_installed "$tap"; then
    if [ "$DRY_RUN" -eq 1 ]; then
      warn "DRY-RUN: would ask whether to add and trust Homebrew tap $tap"
      return 0
    fi
    tty_usable || { error "Homebrew tap $tap is required for $target but is not installed; run aiup from a terminal to approve it"; return 1; }
    [ -n "$remote" ] && warn "Required tap remote: $remote"
    confirm_tty "Add and trust Homebrew tap $tap for $target? [y/N] " || { error "Declined required Homebrew tap $tap"; return 1; }
    run_with_heartbeat "brew tap $tap" env HOMEBREW_NO_ENV_HINTS=1 brew tap "$tap" || return 1
    run_with_heartbeat "brew trust --tap $tap" env HOMEBREW_NO_ENV_HINTS=1 brew trust --tap "$tap" || return 1
    return 0
  fi
  if brew_tap_trusted "$tap"; then
    return 0
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    warn "DRY-RUN: would trust already-installed Homebrew tap $tap"
    return 0
  fi
  [ -n "$remote" ] && info "Tap remote: $remote"
  info "Trusting already-installed Homebrew tap $tap as prior user approval"
  run_with_heartbeat "brew trust --tap $tap" env HOMEBREW_NO_ENV_HINTS=1 brew trust --tap "$tap"
}

