catalog_dep_closure() {
  local tool="$1"
  local dep
  for dep in $(catalog_deps "$tool"); do
    catalog_dep_closure "$dep"
    printf '%s\n' "$dep"
  done
}

ensure_catalog_deps() {
  local tool dep policy
  local -a ordered=()
  local seen="|"
  for tool in "$@"; do
    policy="$(policy_reason "$tool")" || return 1
    [ -z "$policy" ] || continue
    while IFS= read -r dep; do
      [ -n "$dep" ] || continue
      case "$seen" in
        *"|$dep|"*) continue ;;
      esac
      seen="${seen}${dep}|"
      ordered+=("$dep")
    done < <(catalog_dep_closure "$tool")
  done
  local saved_no_install="${NO_INSTALL:-0}"
  [ "${#ordered[@]}" -eq 0 ] && return 0
  for dep in "${ordered[@]}"; do
    if tool_is_present "$dep"; then
      continue
    fi
    if [ "$saved_no_install" -eq 1 ]; then
      error "Missing dependency '$dep' (needed for: $*). Re-run without --no-install, or: aiup only $dep"
      return 1
    fi
    info "Installing missing dependency: $dep"
    NO_INSTALL=0
    run_tool_update "$dep" || { NO_INSTALL="$saved_no_install"; return 1; }
  done
  NO_INSTALL="$saved_no_install"
  return 0
}

ensure_required_tools_present() {
  local saved_no_install="${NO_INSTALL:-0}"
  local required
  for required in "${AIUP_REQUIRED_TOOLS[@]}"; do
    case "$AIUP_REQUIRED_UPDATED" in
      *"|$required|"*) continue ;;
    esac
    if capture_fixture_enabled; then
      capture_fixture_require || { NO_INSTALL="$saved_no_install"; return 1; }
      tool_is_present "$required" || {
        error "Capture fixture requires the existing '$required' command and will not install it"
        NO_INSTALL="$saved_no_install"
        return 1
      }
      AIUP_REQUIRED_UPDATED="${AIUP_REQUIRED_UPDATED}${required}|"
      continue
    fi
    if [ "${NO_INSTALL_EXPLICIT:-0}" -eq 1 ]; then
      NO_INSTALL="$saved_no_install"
    else
      NO_INSTALL=0
    fi
    ensure_catalog_deps "$required" || { NO_INSTALL="$saved_no_install"; return 1; }
    if ! tool_is_present "$required"; then
      if [ "${NO_INSTALL_EXPLICIT:-0}" -eq 1 ]; then
        error "Required infrastructure '$required' is missing. Re-run without --no-install, or: aiup only $required"
        NO_INSTALL="$saved_no_install"
        return 1
      fi
      info "Required infrastructure missing: $required"
    fi
    run_tool_update "$required" || { NO_INSTALL="$saved_no_install"; return 1; }
    AIUP_REQUIRED_UPDATED="${AIUP_REQUIRED_UPDATED}${required}|"
    brew_cache_invalidate
  done
  NO_INSTALL="$saved_no_install"
  return 0
}

