  npm_uninstall_system_pkg_if_distinct @qwen-code/qwen-code || true
}

run_tool_remove() {
  local tool="$1"
  info "========== REMOVE START: $tool =========="
  if type "remove_$tool" >/dev/null 2>&1; then
    if "remove_$tool"; then
      result_record removed "$tool"
      rm -f "$STATE_DIR/methods/$tool"
      hash_refresh
      info "========== REMOVE DONE: $tool =========="
      return 0
    fi
  elif remove_by_kind "$tool"; then
    result_record removed "$tool"
    rm -f "$STATE_DIR/methods/$tool"
    hash_refresh
    info "========== REMOVE DONE: $tool =========="
    return 0
  fi
  error "========== REMOVE FAILED: $tool =========="
  append_failure "$tool"
  return 1
}

scan_catalog_index() {
  local filter="$1"
  local tool state cat
  local n="${#TOOLS_CATALOG[@]}"
  ensure_dir "$STATE_DIR"
  if capture_fixture_enabled; then
    capture_fixture_copy catalog-index.tsv "$CATALOG_INDEX"
    capture_fixture_copy brew-index.tsv "$BREW_INDEX"
    capture_fixture_copy inventory-index.tsv "$INVENTORY_INDEX"
    return 0
  fi
  : > "$CATALOG_INDEX"
  progress_start "$((n + 5))" "Looking for tools on your Mac"
  progress_tick "Reading your Homebrew inventory"
  brew_cache_load
  for tool in "${TOOLS_CATALOG[@]}"; do
    cat="$(catalog_category "$tool")"
    category_visible "$cat" || continue
    progress_tick "Checking $(scan_friendly_name "$tool")"
    if [ "$filter" != 'all' ] && { [ "$tool" = 'npm' ] || [ "$tool" = 'brew' ]; }; then
      continue
    fi
    state="$(catalog_state_for_tool "$tool")"
    case "$filter" in
      absent) [ "$state" = 'absent' ] || continue ;;
      installed) [ "$state" = 'installed' ] && [ "$tool" != 'npm' ] && [ "$tool" != 'brew' ] || continue ;;
    esac
    printf '%s\t%s\t%s\n' "$cat" "$state" "$tool" >> "$CATALOG_INDEX"
  done
  if [ "$filter" = 'all' ]; then
    if category_visible homebrew; then
      scan_brew_index
    else
      : > "$BREW_INDEX"
    fi
    if category_visible detected; then
      progress_tick "Discovering apps and user-installed CLIs"
      scan_inventory_index
    fi
  else
    progress_tick "Skipping extra Homebrew packages"
    progress_tick "Skipping extra Homebrew packages"
    progress_tick "Skipping extra Homebrew packages"
    : > "$BREW_INDEX"
  fi
  progress_end
}

emit_brew_available_rows() {
  local child="${1:-available}"
  awk -F '\t' -v wanted="homebrew/${child}" '
    $1 == wanted {
      id = $3
      if (substr(id, 1, 3) == "bc:") {
        kind = "cask"
        name = substr(id, 4)
      } else {
        kind = "formula"
        name = substr(id, 4)
      }
      color = "\033[38;5;250m"
      reset = "\033[0m"
      state = "\033[38;5;245m" sprintf("%-10s", "absent · install") reset
      category = color sprintf("%-16s", (wanted == "homebrew/fonts" ? "fonts" : "available")) reset
      printf "%s\t%s %s %s %s %s%s\n", id, color "▌" reset, category, state, sprintf("%-18s", kind ":" name), $4, ""
    }
  ' "$BREW_INDEX"
}

emit_fzf_rows_from_index() {
  local cat n_inst n_abs tool id state label search_active=0
  list_search_active && search_active=1
  for cat in "${CATEGORY_ORDER[@]}"; do
    category_visible "$cat" || continue
  if [ "$cat" = 'homebrew' ]; then
    n_inst="$(awk -F '\t' '$2=="installed" || $2=="on-disk" {c++} END {print c+0}' "$BREW_INDEX" 2>/dev/null)"
      n_abs="$(awk -F '\t' '$2=="absent" {c++} END {print c+0}' "$BREW_INDEX" 2>/dev/null)"
      [ "$LIST_VIEW_MODE" = 'installed' ] && n_abs=0
      [ "$LIST_VIEW_MODE" = 'installed' ] && [ "$n_inst" -eq 0 ] && continue
      format_category_header "$cat" "$n_inst" "$n_abs" 0
      printf '\n'
      if category_expanded "$cat" || [ "$search_active" -eq 1 ] || [ "$LIST_CATEGORY_FILTER" = 'homebrew' ] || [[ "$LIST_CATEGORY_FILTER" == homebrew/* ]] || [ "$LIST_VIEW_MODE" = 'available' ]; then
        local child c_inst c_abs
        for child in "${HOMEBREW_CHILD_ORDER[@]}"; do
          if [[ "$LIST_CATEGORY_FILTER" == homebrew/* ]] && [ "$LIST_CATEGORY_FILTER" != "homebrew/${child}" ]; then
            continue
          fi
          if [ "$LIST_VIEW_MODE" = 'available' ] && [ "$child" != 'available' ] && [ "$child" != 'fonts' ]; then
            continue
          fi
          c_inst="$(awk -F '\t' -v c="homebrew/${child}" '$1==c && ($2=="installed" || $2=="on-disk") {n++} END {print n+0}' "$BREW_INDEX" 2>/dev/null)"
          c_abs="$(awk -F '\t' -v c="homebrew/${child}" '$1==c && $2=="absent" {n++} END {print n+0}' "$BREW_INDEX" 2>/dev/null)"
          [ "$LIST_VIEW_MODE" = 'installed' ] && c_abs=0
          [ "$LIST_VIEW_MODE" = 'installed' ] && [ "$c_inst" -eq 0 ] && continue
          format_category_header "homebrew/${child}" "$c_inst" "$c_abs" 1
          printf '\n'
          if category_expanded "homebrew/${child}" || [ "$search_active" -eq 1 ] || [ "$LIST_CATEGORY_FILTER" = "homebrew/${child}" ]; then
            if [ "$child" = 'available' ] || [ "$child" = 'fonts' ]; then
              if homebrew_available_loaded; then
                emit_brew_available_rows "$child"
              fi
              continue
            fi
            while IFS=$'\t' read -r _ state id label; do
              [ "$state" = 'installed' ] || continue
              row_visible_state "$state" || continue
              printf '%s\t%s\n' "$id" "$(format_brew_extra_display "$id" installed "$label")"
            done < <(awk -F '\t' -v c="homebrew/${child}" '$1==c {print}' "$BREW_INDEX" | LC_ALL=C sort -t $'\t' -k3,3)
            while IFS=$'\t' read -r _ state id label; do
              [ "$state" = 'on-disk' ] || continue
              row_visible_state "$state" || continue
              printf '%s\t%s\n' "$id" "$(format_brew_extra_display "$id" on-disk "$label")"
            done < <(awk -F '\t' -v c="homebrew/${child}" '$1==c {print}' "$BREW_INDEX" | LC_ALL=C sort -t $'\t' -k3,3)
            while IFS=$'\t' read -r _ state id label; do
              [ "$state" = 'absent' ] || continue
              row_visible_state "$state" || continue
              printf '%s\t%s\n' "$id" "$(format_brew_extra_display "$id" absent "$label")"
            done < <(awk -F '\t' -v c="homebrew/${child}" '$1==c {print}' "$BREW_INDEX" | LC_ALL=C sort -t $'\t' -k3,3)
          fi
        done
      fi
      continue
    fi
    if [ "$cat" = 'detected' ]; then
      n_inst="$(awk -F '\t' '$2=="detected" {n++} END {print n+0}' "$INVENTORY_INDEX" 2>/dev/null)"
      n_abs=0
    else
      n_inst="$(awk -F '\t' -v c="$cat" '$1==c && ($2=="installed" || $2=="on-disk") {n++} END {print n+0}' "$CATALOG_INDEX" 2>/dev/null)"
      n_abs="$(awk -F '\t' -v c="$cat" '$1==c && $2=="absent" {n++} END {print n+0}' "$CATALOG_INDEX" 2>/dev/null)"
      [ "$LIST_VIEW_MODE" = 'installed' ] && n_abs=0
    fi
    [ "$LIST_VIEW_MODE" = 'installed' ] && [ "$n_inst" -eq 0 ] && continue
    format_category_header "$cat" "$n_inst" "$n_abs"
    printf '\n'
    if category_expanded "$cat" || [ "$search_active" -eq 1 ]; then
      if [ "$cat" = 'detected' ]; then
        while IFS=$'\t' read -r _ state id label version source path; do
          [ -n "$id" ] || continue
          printf '%s\t%s\n' "$id" "$(format_inventory_display "$id" "$state" "$label" "$version" "$source" "$path")"
        done < <(LC_ALL=C sort -t $'\t' -k4,4 -k3,3 "$INVENTORY_INDEX" 2>/dev/null)
        continue
      fi
      while IFS=$'\t' read -r _ state tool; do
        [ -n "$tool" ] || continue
        row_visible_state "$state" || continue
        printf '%s\t%s\n' "$tool" "$(format_catalog_display "$tool" "$state")"
      done < <(awk -F '\t' -v c="$cat" '$1==c && ($2=="installed" || $2=="on-disk") {print}' "$CATALOG_INDEX" | LC_ALL=C sort -t $'\t' -k3,3)
      while IFS= read -r tool; do
        [ -n "$tool" ] || continue
        row_visible_state absent || continue
        printf '%s\t%s\n' "$tool" "$(format_catalog_display "$tool" absent)"
      done < <(awk -F '\t' -v c="$cat" '$1==c && $2=="absent" {print $3}' "$CATALOG_INDEX" | LC_ALL=C sort)
    fi
  done
}

emit_catalog_rows() {
  local filter="$1"
  scan_catalog_index "$filter"
  emit_fzf_rows_from_index | sort_fzf_rows
}

sort_fzf_rows() {
  [ "$LIST_SORT_MODE" = 'id' ] && cat && return 0
  awk -F '\t' -v mode="$LIST_SORT_MODE" '
    $1 ~ /^__cat:/ {
      group++
      printf "%08d\t0\t\t%s\n", group, $0
      next
    }
    NF >= 2 {
      key = (mode == "label" ? $2 : $1)
      gsub(/\033\[[0-9;]*m/, "", key)
      printf "%08d\t1\t%s\t%s\n", group, key, $0
    }
  ' | LC_ALL=C sort -t $'\t' -k1,1n -k2,2n -k3,3 | cut -f4-
}

copy_to_clipboard() {
  local text="$1"
  if command_exists pbcopy; then
    printf '%s' "$text" | pbcopy
  elif command_exists wl-copy; then
    printf '%s' "$text" | wl-copy
  elif command_exists xclip; then
    printf '%s' "$text" | xclip -selection clipboard
  else
    return 1
  fi
}

confirm_tty() {
  local prompt="$1"
  local answer=""
  tty_usable || return 1
  printf '%s' "$prompt" >/dev/tty
  read -r answer </dev/tty || return 1
  case "$answer" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

pick_catalog_tools() {
  local mode="$1"
  local filter="all"
  export AIUP_CATEGORY_FILTER="$LIST_CATEGORY_FILTER"
  export AIUP_VIEW_MODE="$LIST_VIEW_MODE"
  ensure_dir "$STATE_DIR"
  [ -f "$EXPAND_FILE" ] || : > "$EXPAND_FILE"
  case "$mode" in
    install) filter='all' ;;
    remove) filter='installed' ;;
    browse) filter='all' ;;
  esac
  local -a rows=()
  local line
  while IFS= read -r line; do
    [ -n "$line" ] && rows+=("$line")
  done < <(emit_catalog_rows "$filter")
  if [ "${#rows[@]}" -eq 0 ]; then
    error "Nothing to $mode"
    return 1
  fi

  # Selection IDs go to stdout (often a pipe). The UI must use /dev/tty.
  # Do not test -t 1 — `aiup install` captures this function via process
  # substitution, so stdout is a pipe even in a real terminal.
  if ! tty_usable; then
    error "aiup $mode needs a controlling terminal (/dev/tty)"
    error "Use: aiup only <tools...> / aiup remove <tools...>"
    return 1
  fi

  prepare_tty_for_fzf

  local selected=""
  local key="enter"
  local query_line second_line selected_id initial_pos tty_columns header_text
  local self
  self="$(command_path aiup)"
  [ -n "$self" ] || self="${BASH_SOURCE[0]:-$0}"
  if command_exists fzf; then
    # --no-height overrides FZF_DEFAULT_OPTS --height=45% and uses the full
    # screen (height=100% is "below the cursor" and vanishes after brew output).
    local fzf_rc=0
    local listfile
    local last_query
    local -a fzf_state_args=()
    listfile="$(mktemp "${TMPDIR:-/tmp}/aiup-fzf.XXXXXX")"
    printf '%s\n' "${rows[@]}" > "$listfile"
    last_query="$(catalog_ui_state_read "$LIST_QUERY_FILE")"
    initial_pos="$(catalog_ui_state_position "$listfile")"
    tty_columns="$(stty size </dev/tty 2>/dev/null | awk '{print $2}')"
    header_text="$(catalog_header_text "$tty_columns")"
    [ -n "$last_query" ] && fzf_state_args+=(--query "$last_query")
    [ -n "$initial_pos" ] && fzf_state_args+=(--bind "start:pos($initial_pos)")
    selected="$(FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:-} --no-height" fzf --ansi --multi --delimiter=$'\t' --with-nth=2 \
      --no-height \
      --no-hscroll \
      --print-query \
      --prompt "aiup ${mode}> " \
      --header "$header_text" \
      --preview "$self preview {1}" \
      --preview-window "$(catalog_preview_window)" \
      --bind 'space:toggle' \
      --bind 'ctrl-a:toggle-all' \
      --bind 'ctrl-/:toggle-preview' \
      --bind "resize:refresh-preview+transform-header($self __fzf-header)" \
      --bind "change:execute-silent($self __search-query {q})+reload-sync($self __fzf-rows)+pos({n})" \
      --bind "enter:transform:$self __enter-action {1} $listfile" \
      --bind "left:execute-silent($self __cat-collapse {1} $listfile)+reload-sync($self __fzf-rows)+pos({n})" \
      --bind "right:execute-silent($self __cat-expand {1} $listfile)+reload-sync($self __fzf-rows)+pos({n})" \
      --bind "pgup:transform:$self __cat-nav previous {1} $listfile" \
      --bind "pgdn:transform:$self __cat-nav next {1} $listfile" \
      --bind "ctrl-g:transform:$self __cat-jump {1} $listfile" \
      --bind "ctrl-e:execute-silent($self __cat-toggle {1} $listfile)+reload-sync($self __fzf-rows)+pos({n})" \
      --bind "alt-e:execute-silent($self __cat-expand-all $listfile)+reload-sync($self __fzf-rows)+pos({n})" \
      --bind "alt-c:execute-silent($self __cat-collapse-all $listfile)+reload-sync($self __fzf-rows)+pos({n})" \
      --bind "ctrl-o:execute-silent($self docs {1})+clear-screen+reload-sync($self __fzf-rows)+pos({n})" \
      --bind "f3:execute-silent($self docs {1})+clear-screen+reload-sync($self __fzf-rows)+pos({n})" \
      --bind "alt-o:execute-silent($self docs {1})+clear-screen+reload-sync($self __fzf-rows)+pos({n})" \
      --bind "ctrl-y:execute-silent($self docs --print {1} | pbcopy)" \
      --expect=ctrl-d,ctrl-r \
      ${fzf_state_args[@]+"${fzf_state_args[@]}"} \
      < "$listfile")" || fzf_rc=$?
    rm -f "$listfile"
    if [ "$fzf_rc" -eq 130 ] || [ "$fzf_rc" -eq 1 ]; then
      return 130
    fi
    if [ "$fzf_rc" -ne 0 ]; then
      return 1
    fi
    query_line="$(printf '%s\n' "$selected" | awk 'NR==1{print; exit}')"
    second_line="$(printf '%s\n' "$selected" | awk 'NR==2{print; exit}')"
    case "$second_line" in
      ctrl-d|ctrl-r)
        key="$second_line"
        selected="$(printf '%s\n' "$selected" | awk 'NR>2')"
        ;;
      *)
        key='enter'
        selected="$(printf '%s\n' "$selected" | awk 'NR>1')"
        ;;
    esac
  else
    error "fzf is required for aiup $mode. Re-run without --no-install, or: aiup only fzf"
    return 1
  fi

  if [ -z "$selected" ]; then
    return 130
  fi
  case "$key" in
    ctrl-d) PICK_ACTION='remove' ;;
    ctrl-r) PICK_ACTION='update' ;;
    *) PICK_ACTION='apply' ;;
  esac
  PICK_TOOLS=()
  local id
  while IFS= read -r id; do
    [ -n "$id" ] && PICK_TOOLS+=("$id")
  done < <(printf '%s\n' "$selected" | awk -F '\t' '{print $1}')
  selected_id="${PICK_TOOLS[0]:-}"
  catalog_ui_state_save "$query_line" "$selected_id"
  return 0
}

read_pick_result() {
  PICK_ACTION=""
  PICK_TOOLS=()
  local line first=1
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    if [ "$first" -eq 1 ]; then
      PICK_ACTION="$line"
      first=0
      continue
    fi
    PICK_TOOLS+=("$line")
  done
}

apply_catalog_action() {
  local action="$1"
  shift
  local -a tools=("$@")
  local tool
  [ "${#tools[@]}" -gt 0 ] || return 0
  case "$action" in
    apply)
      NO_INSTALL=0
      local t life
      local -a catalog_tools=() brew_extras=()
      for t in "${tools[@]}"; do
        case "$t" in
          __cat:*) continue ;;
          bc:*|bf:*) brew_extras+=("$t") ;;
          di:*) warn "Detected-only item '$t' has no verified updater/remover contract; aiup will not guess how to change it"; result_record detected "$t" ;;
          *) catalog_tools+=("$t") ;;
        esac
      done
      if [ "${#brew_extras[@]}" -gt 0 ]; then
        ensure_catalog_deps brew || return 1
        apply_brew_extras apply "${brew_extras[@]}"
      fi
      [ "${#catalog_tools[@]}" -gt 0 ] || return 0
      tools=("${catalog_tools[@]}")
      for t in "${tools[@]}"; do
        life="$(catalog_lifecycle "$t")"
        if [ "$life" != 'active' ]; then
          warn "$(catalog_label "$t")"
          warn "$(catalog_lifecycle_note "$t")"
          if [ "${AIUP_KEEP_UI:-0}" = 1 ]; then
            confirm_tty "Install/update sunset tool '$t' anyway? [y/N] " || return 0
          fi
        fi
      done
      info "Install/update: ${tools[*]}"
      main_update "${tools[@]}"
      ;;
    update)
      NO_INSTALL=1
      local -a catalog_tools=() brew_extras=()
      local t
      for t in "${tools[@]}"; do
        case "$t" in
          __cat:*) continue ;;
          bc:*|bf:*) brew_extras+=("$t") ;;
          di:*) warn "Detected-only item '$t' has no verified updater contract; use its owning package manager"; result_record detected "$t" ;;
          *) catalog_tools+=("$t") ;;
        esac
      done
      if [ "${#brew_extras[@]}" -gt 0 ]; then
        apply_brew_extras update "${brew_extras[@]}"
      fi
      [ "${#catalog_tools[@]}" -gt 0 ] || return 0
      info "Update: ${catalog_tools[*]}"
      main_update "${catalog_tools[@]}"
      ;;
    remove)
      local -a to_remove=() brew_extras=()
      for tool in "${tools[@]}"; do
        case "$tool" in
          __cat:*) continue ;;
          bc:*|bf:*) brew_extras+=("$tool"); continue ;;
          di:app:*) cmd_cleanup "$tool" 1 || true; result_record detected "$tool"; continue ;;
          di:*) warn "Detected item '$tool' has no reviewed generic remover; use ctrl-o or its owning package manager"; result_record detected "$tool"; continue ;;
        esac
        if [ "$tool" = 'npm' ] || [ "$tool" = 'brew' ]; then
          warn "$tool is not removable via aiup"
          continue
        fi
        if ! tool_is_present "$tool"; then
          warn "Skip uninstall (not installed): $tool"
          continue
        fi
        to_remove+=("$tool")
      done
      if [ "${#brew_extras[@]}" -gt 0 ]; then
        if confirm_tty "Uninstall Homebrew extras ${brew_extras[*]}? [y/N] "; then
          apply_brew_extras remove "${brew_extras[@]}"
        fi
      fi
      [ "${#to_remove[@]}" -gt 0 ] || return 0
      if ! confirm_tty "Uninstall ${to_remove[*]}? [y/N] "; then
        info "Uninstall cancelled"
        return 0
      fi
      info "Removing: ${to_remove[*]}"
      ensure_managed_paths
      for tool in "${to_remove[@]}"; do
        run_tool_remove "$tool" || true
      done
      brew_cache_invalidate
      if [ "${AIUP_KEEP_UI:-0}" != 1 ]; then
        print_summary_versions
      fi
      ;;
    *)
      error "Unknown picker action: $action"
      return 1
      ;;
  esac
}

cmd_install_interactive() {
  ensure_required_tools_present || return 1
  collapse_all_categories
  PICK_ACTION=""
  PICK_TOOLS=()
  pick_catalog_tools install || return 1
  [ "${#PICK_TOOLS[@]}" -eq 0 ] && return 1
  apply_catalog_action "${PICK_ACTION:-apply}" "${PICK_TOOLS[@]}"
}

cmd_remove_interactive() {
  ensure_required_tools_present || return 1
  collapse_all_categories
  PICK_ACTION=""
  PICK_TOOLS=()
  pick_catalog_tools remove || return 1
  [ "${#PICK_TOOLS[@]}" -eq 0 ] && return 1
  apply_catalog_action "${PICK_ACTION:-remove}" "${PICK_TOOLS[@]}"
}

cmd_catalog_browse() {
  ensure_required_tools_present || return 1
  AIUP_KEEP_UI=1
  collapse_all_categories
  while true; do
    restore_tty
    clear_terminal_screen
    brew_cache_invalidate
    PICK_ACTION=""
    PICK_TOOLS=()
    if ! pick_catalog_tools browse; then
      result_record cancelled "catalog picker"
      restore_tty
      clear_terminal_screen
      print_result_summary
      AIUP_KEEP_UI=0
      restore_tty
      return 0
    fi
    [ "${#PICK_TOOLS[@]}" -gt 0 ] || continue
    restore_tty
    clear_terminal_screen
    apply_catalog_action "${PICK_ACTION:-apply}" "${PICK_TOOLS[@]}" || true
    restore_tty
    clear_terminal_screen
  done
}

cmd_remove_named() {
  local resolved tool
  resolved="$(resolve_tools "$@")" || return 1
  ensure_managed_paths
  while IFS= read -r tool; do
    [ -n "$tool" ] || continue
    if [ "$tool" = 'npm' ]; then
      remove_npm
      continue
    fi
    run_tool_remove "$tool" || true
  done <<< "$resolved"
  print_summary_versions
}

usage() {
  cat <<EOF2
aiup $AIUP_VERSION

Usage:
  aiup                     Scan your Mac and update whatever is already installed
  aiup full                Same as default
  aiup core                Same as default
  aiup only <tools...>     Update (or install, for supported tools) a subset
  aiup install             Interactive checkbox list — pick catalog tools to install
  aiup remove              Interactive checkbox list — pick installed tools to uninstall
  aiup remove <tools...>   Uninstall named catalog tools
  aiup cleanup <detected-app-id>  Preview app-bundle leftovers (no changes)
  aiup cleanup <detected-app-id> --apply  Move exact candidates to Trash after confirmation
  aiup docs <tool>         Open the official GitHub repo (or website) in a browser
  aiup docs --print <tool> Print that URL
  aiup preview <tool>      Print the picker preview (name, category, versions, docs URL)
  npm-update               Convenience wrapper for: aiup only npm
  aiup doctor              Print diagnostics for the catalog
  aiup list                Interactive catalog (install/update/uninstall/docs)
  aiup list --plain        Print the categorized table plus local detections
  aiup list --category CAT Focus the list on one category (or homebrew/detected)
  aiup list --view MODE    Use overview, installed, managed, detected, or available rows
  aiup list --sort MODE    Order rows by id (default) or label within each category
  aiup inventory            Print every locally detected app/CLI/package as JSON
  aiup inventory --plain   Print the local inventory as a readable table
  aiup inventory --refresh Rebuild the local inventory cache now
  aiup catalog             Print the catalog definition as JSON (no scan)
  aiup catalog --markdown  Print the catalog definition as Markdown
  aiup catalog --contracts Print version/install/update/remove contract coverage
  aiup version             Print aiup version
  aiup help                Show this help

Scan is local-only (PATH, app bundles, Homebrew inventory). Nothing is
uploaded. Package update/install runs are unattended: Homebrew package
confirmations are accepted and update subprocesses receive no terminal input.
The official initial Homebrew installer remains interactive and may request
administrator authentication. Runs ensure required infrastructure (currently
fzf), then update installed tools. Optional missing tools are only added by
\`aiup install\` or \`aiup only <tool>\`. Installing a tool that needs brew,
npm, or uv installs those missing dependencies first (brew → npm/uv → tool).

aiup supports macOS 14 or newer and requires Bash 3+, Python 3, and curl.
The public launcher refreshes the runtime and catalog from GitHub before every
run. Local inventory is never uploaded. Interactive \`aiup list\` requires fzf;
aiup installs Homebrew first when fzf or another brew-managed item is missing.
Homebrew's supported setup also requires current Xcode Command Line Tools.

Options:
  --dry-run                Print actions without executing them
  --no-install             Do not install missing tools; fails if required fzf is absent.
  --heartbeat-seconds N    Override heartbeat interval for this run
  --category CAT           Limit \`aiup list\` to one category
  --view MODE              Limit list rows: overview, installed, managed, detected, available
  --sort MODE              Order list rows by id (default) or label within each category
  --refresh                Rebuild local detected inventory instead of using its cache
EOF2
}

resolve_tools() {
  local arg
  local out=()
  for arg in "$@"; do
    case "$arg" in
      brew|homebrew) out+=("brew") ;;
      npm|uv|fzf|gh|wrangler|deno|bun|pnpm|jq|yq|ripgrep|fd|just|shellcheck|actionlint|claude|codex|antigravity|opencode|kilo|gsd2|hermes|pi|grok|warp|gemini|copilot|aider|goose|cursor|qwen|crush|amp|kiro|droid|kimi|openclaw|cline|continue|interpreter|pi-acp|llm|mods|aichat|fabric|sgpt|vibe|openhands|llama-cpp|llama-app|whisper-cpp|ollama|lm-studio|jan|gpt4all|anythingllm|mlx|mlx-lm|chatgpt|cursor-ide|zed|cmux|ollama-app|t3-code|t3-nightly|grokbot|hermes-desktop|vscode|vscode-insiders|claude-app|copilot-app|opencode-desktop|antigravity-ide|perplexity|macwhisper|screenpipe|n8n|warp-app|ghostty|iterm2) out+=("$arg") ;;
      vscode-code|code) out+=("vscode") ;;
      t3) out+=("t3-code") ;;
      grok-bot) out+=("grokbot") ;;
      claude-desktop) out+=("claude-app") ;;
      warp-terminal) out+=("warp-app") ;;
      agy|antigravity-cli) out+=("antigravity") ;;
      node) out+=("npm") ;;
      gsd|gsd-pi) out+=("gsd2") ;;
      oz) out+=("warp") ;;
      cursor-agent) out+=("cursor") ;;
      cn) out+=("continue") ;;
      fabric-ai) out+=("fabric") ;;
      kiro-cli) out+=("kiro") ;;
      kimi-code) out+=("kimi") ;;
      shell-gpt) out+=("sgpt") ;;
      *) error "Unknown tool: $arg"; return 1 ;;
    esac
  done
  printf '%s\n' "${out[@]}"
}

should_skip_install_for_missing() {
  local tool="$1"
  if [ "$NO_INSTALL" -eq 1 ] && ! tool_is_present "$tool"; then
    warn "Skipping missing tool: $tool"
    return 0
  fi
  return 1
}

main_update() {
  local tools=("$@")
  local tool required
  ensure_managed_paths
  ensure_required_tools_present || return 1
  for required in "${AIUP_REQUIRED_TOOLS[@]}"; do
    case " ${tools[*]} " in
      *" $required "*) ;;
      *) tools=("$required" "${tools[@]}") ;;
    esac
  done
  ensure_catalog_deps "${tools[@]}" || return 1
  for tool in "${tools[@]}"; do
    case "$AIUP_REQUIRED_UPDATED" in
      *"|$tool|"*) continue ;;
    esac
    if should_skip_install_for_missing "$tool"; then
      result_record skipped "$tool"
      continue
    fi
    run_tool_update "$tool" || true
  done
  brew_cache_invalidate
  if [ "${AIUP_KEEP_UI:-0}" != 1 ]; then
    print_result_summary
    print_summary_versions
  fi
  if [ "${#FAILED_TOOLS[@]}" -gt 0 ]; then
    printf '\nFailed tools: %s\n' "${FAILED_TOOLS[*]}" >&2
    return 1
  fi
  info "========== AIUP COMPLETE =========="
  return 0
}

parse_args() {
  local args=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      --no-install)
        NO_INSTALL=1
        NO_INSTALL_EXPLICIT=1
        shift
        ;;
      --heartbeat-seconds)
        HEARTBEAT_SECONDS="$2"
        shift 2
        ;;
      --category)
        LIST_CATEGORY_FILTER="$2"
        shift 2
        ;;
      --view)
        LIST_VIEW_MODE="$2"
        shift 2
        ;;
      --sort)
        LIST_SORT_MODE="$2"
        shift 2
        ;;
      --refresh)
        INVENTORY_REFRESH=1
        shift
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done

  require_runtime_environment || return 1
  catalog_validate || return 1

  case "$LIST_VIEW_MODE" in
    overview|all|installed|managed|detected|available) ;;
    *) error "Unknown list view: $LIST_VIEW_MODE"; return 1 ;;
  esac

  case "$LIST_SORT_MODE" in
    id|label) ;;
    *) error "Unknown list sort: $LIST_SORT_MODE"; return 1 ;;
  esac

  if [ -n "$LIST_CATEGORY_FILTER" ]; then
    case " ${CATEGORY_ORDER[*]} homebrew/casks homebrew/fonts homebrew/formulae homebrew/libraries homebrew/recommended homebrew/available " in
      *" $LIST_CATEGORY_FILTER "*) ;;
      *) error "Unknown category: $LIST_CATEGORY_FILTER"; return 1 ;;
    esac
  fi

  if [ "${#args[@]}" -eq 0 ]; then
    ensure_required_tools_present || return 1
    local -a present=()
    local line
    while IFS= read -r line; do
      [ -n "$line" ] && present+=("$line")
    done < <(scan_installed_tools)
    if [ "${#present[@]}" -eq 0 ]; then
      error "No catalog tools are installed"
      return 1
    fi
    info "Scan present: ${present[*]}"
    main_update "${present[@]}"
    return $?
  fi

  case "${args[0]}" in
    full|core)
      ensure_required_tools_present || return 1
      local -a present=()
      local line
      while IFS= read -r line; do
        [ -n "$line" ] && present+=("$line")
      done < <(scan_installed_tools)
      if [ "${#present[@]}" -eq 0 ]; then
        error "No catalog tools are installed"
        return 1
      fi
      info "Scan present: ${present[*]}"
      main_update "${present[@]}"
      ;;
    only)
      if [ "${#args[@]}" -lt 2 ]; then
        error "No tools specified for 'only'"
        return 1
      fi
      if [ "$NO_INSTALL_EXPLICIT" -eq 0 ]; then
        NO_INSTALL=0
      fi
      local resolved
      resolved="$(resolve_tools "${args[@]:1}")" || return 1
      local -a selected=()
      local line
      while IFS= read -r line; do
        [ -n "$line" ] && selected+=("$line")
      done <<< "$resolved"
      main_update "${selected[@]}"
      ;;
    __fzf-rows)
      emit_fzf_rows_from_index | sort_fzf_rows
      ;;
    __search-query)
      ensure_dir "$STATE_DIR"
      printf '%s' "${args[*]:1}" > "$LIST_QUERY_FILE"
      ;;
    __fzf-header)
      catalog_header_text "${FZF_COLUMNS:-}"
      ;;
    __cat-toggle)
      toggle_category "${args[1]:-}"
      refresh_fzf_listfile "${args[2]:-}"
      ;;
    __cat-expand)
      expand_category "${args[1]:-}"
      refresh_fzf_listfile "${args[2]:-}"
      ;;
    __cat-collapse)
      collapse_category "${args[1]:-}"
      refresh_fzf_listfile "${args[2]:-}"
      ;;
    __cat-nav)
      category_nav_action "${args[1]:-}" "${args[2]:-}" "${args[3]:-}"
      ;;
    __cat-jump)
      category_jump_action "${args[1]:-}" "${args[2]:-}"
      ;;
    __cat-expand-all)
      expand_all_categories
      refresh_fzf_listfile "${args[1]:-}"
      ;;
    __cat-collapse-all)
      collapse_all_categories
      refresh_fzf_listfile "${args[1]:-}"
      ;;
    __enter-action)
      enter_action_for "${args[1]:-}" "${args[2]:-}"
      ;;
    doctor)
      print_doctor
      ;;
    catalog)
      if [ "${args[1]:-}" = '--contracts' ]; then
        print_catalog_contracts
      else
        print_catalog_definition "${args[1]:---json}"
      fi
      ;;
    inventory)
      print_inventory_definition "${args[1]:---json}"
      ;;
    cleanup)
      local cleanup_apply=0
      [ "${args[2]:-}" = '--apply' ] && cleanup_apply=1
      cmd_cleanup "${args[1]:-}" "$cleanup_apply"
      ;;
    list)
      if [ "${args[1]:-}" = '--plain' ] || [ "${args[1]:-}" = '--detected' ] || ! tty_usable; then
        if [ "${args[1]:-}" = '--detected' ]; then
          print_inventory_definition --plain
        else
          print_list
        fi
      else
        cmd_catalog_browse
      fi
      ;;
    preview)
      if [ "${#args[@]}" -lt 2 ]; then
        error "usage: aiup preview <tool>"
        return 1
      fi
      print_catalog_preview "${args[1]}"
      ;;
    docs|home|open)
      cmd_docs "${args[@]:1}"
      ;;
    install)
      cmd_install_interactive
      ;;
    remove|uninstall)
      if [ "${#args[@]}" -ge 2 ]; then
        cmd_remove_named "${args[@]:1}"
      else
        cmd_remove_interactive
      fi
      ;;
    version)
      printf '%s\n' "$AIUP_VERSION"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      error "Unknown command: ${args[0]}"
      usage >&2
      return 1
      ;;
  esac
}

parse_args "$@"
