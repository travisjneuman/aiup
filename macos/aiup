}

# macOS/BSD stty maps ^O to "discard" and ^Y to "dsusp", so those chords
# never reach fzf unless we undefine them for the picker.
prepare_tty_for_fzf() {
  tty_usable || return 0
  restore_tty
  stty discard undef dsusp undef </dev/tty 2>/dev/null || true
}

