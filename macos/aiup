tool_is_present() {
  case "$1" in bf:*) brew_formula_installed "${1#bf:}"; return ;; bc:*) brew_cask_installed "${1#bc:}"; return ;; esac
  local tool="$1"
  local bin cmd expected
  bin="$(binary_of_tool "$tool")"
  cmd="$(command_path "$bin")"
  if [ -n "$cmd" ] && [ -e "$cmd" ]; then
    return 0
  fi
  expected="$(expected_direct_path "$tool")"
  if [ -n "$expected" ] && [ -x "$expected" ]; then
    return 0
  fi
  case "$tool" in
    brew) { command_exists brew || [ -x /opt/homebrew/bin/brew ] || [ -x /usr/local/bin/brew ]; } && return 0 ;;
    npm) command_exists npm && return 0 ;;
    grok) [ -x "$HOME/.grok/bin/grok" ] && return 0 ;;
    warp) [ -x "$HOME/.warp/tui/current/warp-tui-stable" ] && return 0 ;;
    copilot)
      { aiup_npm_pkg_installed @github/copilot || system_npm_pkg_installed @github/copilot; } && return 0
      ;;
    qwen)
      { aiup_npm_pkg_installed @qwen-code/qwen-code || system_npm_pkg_installed @qwen-code/qwen-code; } && return 0
      ;;
    cursor)
      { command_exists cursor-agent || [ -x "$LOCAL_BIN/cursor-agent" ]; } && return 0
      ;;
    gemini)
      { aiup_npm_pkg_installed @google/gemini-cli || system_npm_pkg_installed @google/gemini-cli; } && return 0
      ;;
    kilo)
      aiup_npm_pkg_installed @kilocode/cli && return 0
      system_npm_pkg_installed @kilocode/cli && return 0
      ;;
    gsd2)
      { aiup_npm_pkg_installed @opengsd/gsd-pi || aiup_npm_pkg_installed gsd-pi; } && return 0
      ;;
    pi)
      { aiup_npm_pkg_installed @earendil-works/pi-coding-agent || aiup_npm_pkg_installed @mariozechner/pi-coding-agent; } && return 0
      ;;
    codex)
      aiup_npm_pkg_installed @openai/codex && return 0
      ;;
  esac
  local pkg formula cask app
  pkg="$(catalog_npm_pkg "$tool")"
  [ -n "$pkg" ] && aiup_npm_pkg_installed "$pkg" && return 0
  [ -n "$pkg" ] && system_npm_pkg_installed "$pkg" && return 0
  formula="$(catalog_brew_formula "$tool")"
  [ -n "$formula" ] && brew_formula_installed "$formula" && return 0
  cask="$(catalog_brew_cask "$tool")"
  [ -n "$cask" ] && brew_cask_installed "$cask" && return 0
  app="$(catalog_app_path "$tool")"
  [ -n "$app" ] && [ -d "$app" ] && return 0
  return 1
}
# Recognized media apps remain detected-only: receipt presence guides the user,
# not AIUP mutation authority, purchase entitlement, or update availability.
manual_media_load() {
  [ "$MANUAL_MEDIA_READY" -eq 0 ] || return 0
  MANUAL_MEDIA_READY=1
  capture_fixture_enabled && return 0
  MANUAL_MEDIA_ROWS="$(python3 - "$HOME" <<'PYMEDIA'
import plistlib, sys
from pathlib import Path
apps=[('Final Cut Pro','com.apple.FinalCut'),('Motion','com.apple.motionapp'),
      ('Pixelmator Pro','com.pixelmatorteam.pixelmator.x'),('Darkroom','co.bergen.Darkroom'),
      ('Luminar AI','com.skylum.luminarAI')]
seen=set()
for root in (Path('/Applications'),Path(sys.argv[1])/'Applications'):
    for name,bundle in apps:
        path=root/(name+'.app'); info=path/'Contents/Info.plist'
        if bundle in seen or not info.is_file(): continue
        try:
            if info.stat().st_size>1048576: continue
            data=plistlib.loads(info.read_bytes())
            if not isinstance(data,dict): continue
            if data.get('CFBundleIdentifier')!=bundle: continue
        except (OSError,ValueError,plistlib.InvalidFileException): continue
        seen.add(bundle)
        receipt=(path/'Contents/_MASReceipt/receipt').is_file()
        channel='App Store' if receipt else 'vendor/manual'
        guidance='Use App Store > Updates for this installed copy; availability and entitlement are checked there.' if receipt else 'Review the installed app and its vendor support for this exact product; AIUP has no verified automated updater.'
        docs='https://support.apple.com/guide/app-store/update-apps-fir9b01adda3/mac' if receipt else ('https://skylum.com/luminar-ai' if name=='Luminar AI' else 'https://support.apple.com/apps')
        if name=='Luminar AI' and not receipt: guidance+=' Current vendor marketing is not proof of an upgrade path from Luminar AI.'
        fields=['di:app:'+bundle,name,str(data.get('CFBundleShortVersionString') or 'unknown'),str(path),channel,guidance,docs]
        print('\t'.join(''.join(c for c in v if ord(c)>=32 and ord(c)!=127) for v in fields))
PYMEDIA
)"
}

manual_media_record() {
  manual_media_load
  case "$MANUAL_MEDIA_ROWS" in *"$1"$'\t'*) ;; *) return 0 ;; esac
  printf '%s\n' "$MANUAL_MEDIA_ROWS" | awk -F '\t' -v id="$1" '$1==id {print; exit}'
}

manual_media_preview() {
  local row id name version path channel guidance docs
  row="$(manual_media_record "$1")"
  [ -n "$row" ] || return 1
  IFS=$'\t' read -r id name version path channel guidance docs <<< "$row"
  printf 'coverage manual update · media · %s\n' "$channel"
  printf 'next     %s\ndocs     %s\n' "$guidance" "$docs"
}

manual_media_in_category() {
  case "$LIST_VIEW_MODE" in managed|available|detected) return 1 ;; esac
  category_visible media
}

visible_detected_count() {
  local manual=''
  if manual_media_in_category; then manual="$MANUAL_MEDIA_ROWS"; fi
  awk -F '\t' -v manual="$manual" 'BEGIN {n=split(manual, rows, "\n"); for(i=1;i<=n;i++){split(rows[i],f,"\t"); seen[f[1]]=1}} $2=="detected" && !seen[$3] {count++} END {print count+0}' "$INVENTORY_INDEX"
}

emit_manual_media_rows() {
  manual_media_in_category || return 0
  manual_media_load
  local id name version path channel guidance docs
  while IFS=$'\t' read -r id name version path channel guidance docs; do
    [ -n "$id" ] || continue
    # Existing inventory identity is mandatory, preserving inspect-only dispatch.
    awk -F '\t' -v id="$id" '$3==id {found=1} END {exit !found}' "$INVENTORY_INDEX" || continue
    if [ "${1:-}" = plain ]; then
      printf '%-26s %-14s %-12s %s\n' "$name" 'manual update' "$version" "$channel"
    else
      printf '%s\t%s\n' "$id" "$(format_inventory_display "$id" detected "$name" "$version" "$channel" "$path")"
    fi
  done <<< "$MANUAL_MEDIA_ROWS"
}

inventory_index_init() {
  [ "${INVENTORY_INDEX_READY:-0}" -eq 1 ] && return 0
  catalog_manifest_load || return 1
  local tool binary app pkg packages='' alias_path
  ensure_system_npm_prefix
  for tool in "${TOOLS_CATALOG[@]}"; do
    pkg=''
    case "$(catalog_kind "$tool")" in aiup-npm|special) pkg="$(catalog_npm_pkg "$tool")" ;; esac
    [ -z "$pkg" ] || packages="${packages}${pkg}"$'\n'
    binary="$(binary_of_tool "$tool")"
    [ -n "$binary" ] && INVENTORY_MANAGED_BINARIES="${INVENTORY_MANAGED_BINARIES}${binary}|"
    app="$(catalog_app_path "$tool")"
    [ -n "$app" ] && INVENTORY_MANAGED_APPS="${INVENTORY_MANAGED_APPS}${app}|"
  done
  for tool in "${HOMEBREW_RECOMMENDED_CASKS[@]}"; do
    app="$(app_path_for_cask "$tool" 2>/dev/null || true)"
    [ -n "$app" ] && INVENTORY_MANAGED_APPS="${INVENTORY_MANAGED_APPS}${app}|"
  done
  while IFS= read -r alias_path; do
    [ -n "$alias_path" ] && INVENTORY_MANAGED_ALIAS_PATHS="${INVENTORY_MANAGED_ALIAS_PATHS}${alias_path}|"
  done < <(python3 - "$AIUP_NPM_PREFIX" "$SYSTEM_NPM_PREFIX" "$LOCAL_BIN" "$packages" <<'PYALIASES'
import json, os, sys
from pathlib import Path
prefixes=[Path(p) for p in dict.fromkeys(sys.argv[1:3]) if p]
for prefix in prefixes:
    for package in set(sys.argv[4].splitlines()):
        if not package or package.startswith('/') or '..' in package.split('/'): continue
        root=prefix/'lib/node_modules'/package; meta=root/'package.json'
        if not meta.is_file(): continue
        try:
            if meta.stat().st_size>1048576: continue
            data=json.loads(meta.read_text())
            if not isinstance(data,dict): continue
            bins=data.get('bin',{})
            if isinstance(bins,str): bins={package.rsplit('/',1)[-1]:bins}
            if not isinstance(bins,dict): continue
            for name,relative in bins.items():
                if not isinstance(relative,str) or not isinstance(name,str) or '/' in name or name in ('.','..'): continue
                expected=(root/relative).resolve()
                try: expected.relative_to(root.resolve())
                except ValueError: continue
                for directory in (prefix/'bin',Path(sys.argv[3])):
                    candidate=directory/name
                    if candidate.is_file() and os.access(candidate,os.X_OK) and candidate.resolve()==expected:
                        print(str(candidate))
        except (OSError,ValueError,TypeError): continue
PYALIASES
)
  INVENTORY_INDEX_READY=1
}

inventory_append() {
  local category="$1"
  local source="$2"
  local id="$3"
  local label="$4"
  local version="$5"
  local path="$6"
  inventory_index_init || return 1
  [ -n "$id" ] || return 0
  label="$(printf '%s' "$label" | tr '\t\r\n' '   ')"
  version="$(printf '%s' "$version" | tr '\t\r\n' '   ')"
  source="$(printf '%s' "$source" | tr '\t\r\n' '   ')"
  path="$(printf '%s' "$path" | tr '\t\r\n' '   ')"
  case "$INVENTORY_SEEN_IDS" in *"|$id|"*) return 0 ;; esac
  INVENTORY_SEEN_IDS="${INVENTORY_SEEN_IDS}${id}|"
  printf '%s\tdetected\t%s\t%s\t%s\t%s\t%s\n' "$category" "$id" "$label" "$version" "$source" "$path" >> "$INVENTORY_INDEX"
}

