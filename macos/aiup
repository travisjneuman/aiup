# Optional metadata-first update contract for official app installers.
# Template variables are expanded by official_app_update_endpoint so a future
# app can declare its own platform/architecture/current-version endpoint in the
# manifest without duplicating the version-check plumbing in this script.
catalog_update_endpoint() {
  local manifest_endpoint
  manifest_endpoint="$(catalog_manifest_field "$1" 8 2>/dev/null || true)"
  [ -n "$manifest_endpoint" ] && { printf '%s\n' "$manifest_endpoint"; return 0; }
  case "$1" in
    screenpipe) printf 'https://screenpipe.com/api/app-update/stable/{target}-{arch}/{current_version}\n' ;;
    *) printf '\n' ;;
  esac
}

catalog_docs_kind() {
