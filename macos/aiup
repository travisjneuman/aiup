      brew_cask_installed claude-code && count=$((count+1))
      brew_cask_installed claude-code@latest && count=$((count+1))
      system_npm_pkg_installed @anthropic-ai/claude-code && count=$((count+1))
      ;;
    codex)
      aiup_npm_pkg_installed @openai/codex && count=$((count+1))
      brew_cask_installed codex && count=$((count+1))
      brew_formula_installed codex && count=$((count+1))
      if ! aiup_npm_pkg_installed @openai/codex; then
