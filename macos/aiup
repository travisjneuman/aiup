print_catalog_preview() {
  local tool="$1"
  local url kind state note dep
  if [ -z "$tool" ]; then
    error "usage: aiup preview <tool>"
    return 1
  fi
  case "$tool" in
    __cat:*)
      local preview_category preview_state preview_action
      preview_category="${tool#__cat:}"
      if category_expanded "$preview_category"; then
        preview_state='expanded'
        preview_action='collapse this category'
      else
        preview_state='collapsed'
        preview_action='expand this category'
      fi
      printf 'category  %s\n' "$preview_category"
      printf 'state     %s\n' "$preview_state"
      printf 'action    %s\n' "$preview_action"
      catalog_preview_controls category
      return 0
      ;;
    di:*)
      local record inv_category inv_state inv_id inv_label inv_version inv_source inv_path
      record="$(inventory_record "$tool" || true)"
      [ -n "$record" ] || { error "Detected inventory row is not available: $tool"; return 1; }
      IFS=$'\t' read -r inv_category inv_state inv_id inv_label inv_version inv_source inv_path <<< "$record"
      printf '%s · updates handled elsewhere\n' "$inv_id"
      printf 'item     %s · %s\n' "$(inventory_item_name "$inv_label")" "${inv_version:-unknown}"
      printf 'action   View details; use the owning app or package manager to update\n'
      printf 'found via %s\n' "$inv_source"
      printf 'location %s\n' "$inv_path"
      manual_media_preview "$tool" || true
      if [[ "$tool" == di:path:* ]]; then
        path_insights "$INVENTORY_INDEX" | awk -F '\t' -v id="$tool" '$1==id {print "owner    " $3; print "about    " $4; print "next     " $5; print "docs     " $6; print "resolves " $7}'
      fi
      catalog_preview_controls detected
      printf 'search   %s\n' "$(detected_search_url "$tool")"
      if [[ "$tool" == di:app:* ]]; then
        printf 'cleanup  aiup cleanup %s --apply (preview first; moves exact candidates to Trash)\n' "$tool"
      fi
      return 0
      ;;
    bc:*|bf:*)
      local kind name extra_state extra_app
      case "$tool" in
        bc:*) kind=cask; name="${tool#bc:}" ;;
        bf:*) kind=formula; name="${tool#bf:}" ;;
      esac
      extra_state='absent'
      if [ -f "$BREW_INDEX" ]; then
        extra_state="$(awk -F '\t' -v id="$tool" '$3==id {print $2; exit}' "$BREW_INDEX")"
        [ -n "$extra_state" ] || extra_state='absent'
      fi
      printf '%s · %s · %s\n' "$tool" "$(catalog_category "$tool")" "$extra_state"
      printf '%s\n' "$(brew_extra_label "$kind" "$name")"
      printf 'action   %s\n' "$(brew_extra_action "$kind" "$name" "$extra_state")"
      if [ "$kind" = 'cask' ] && extra_app="$(app_path_for_cask "$name")"; then
        if [ "$extra_state" = 'on-disk' ]; then
          printf 'found    %s\n' "$extra_app"
          printf 'safety   Homebrew adoption; aiup passes no --zap and does not directly delete ~/Library\n'
        fi
      elif [ "$kind" = 'formula' ] && [ "$extra_state" = 'on-disk' ]; then
        printf 'found    %s on PATH outside Homebrew; install adds a Homebrew copy alongside it\n' "$(formula_cmd_name "$name")"
      fi
      catalog_preview_controls item
      printf 'website  https://formulae.brew.sh/%s/%s\n' "$kind" "$name"
      printf 'needs    brew [%s]\n' "$(tool_is_present brew && printf ready || printf missing)"
      return 0
      ;;
  esac
  url="$(catalog_docs_url "$tool")"
  if [ -z "$url" ]; then
    error "Unknown tool: $tool"
    return 1
  fi
  kind="$(catalog_docs_kind "$tool")"
  state="$(catalog_state_for_tool "$tool")"
  printf '%s · %s · %s · %s\n' "$tool" "$(catalog_category "$tool")" "$state" "$(catalog_lifecycle "$tool")"
  printf '%s\n' "$(catalog_label "$tool")"
  note="$(catalog_lifecycle_note "$tool")"
  if [ -n "$note" ]; then
    printf '%s\n' "$note"
  fi
  printf '%s  %s\n' "$kind" "$url"
  catalog_version_preview "$tool" "$state"
  printf 'action   %s\n' "$(catalog_action_for_state "$tool" "$state")"
  catalog_dependency_preview "$tool"
  catalog_preview_controls item
}

catalog_action_for_state() {
  local tool="$1"
  local state="$2"
  case "$state" in
    detected) printf 'detected-only\n' ;;
    on-disk) printf 'switch to Homebrew\n' ;;
    absent) printf 'install\n' ;;
    installed)
      if [ "$(catalog_lifecycle "$tool")" = 'active' ]; then
        printf 'update\n'
      else
        printf '%s\n' "$(catalog_lifecycle "$tool")"
      fi
      ;;
    *) printf 'inspect\n' ;;
  esac
}

catalog_state_for_tool() {
  local tool="$1"
  local cask app
  if capture_fixture_enabled; then
    capture_fixture_require || return 1
    awk -F '\t' -v tool="$tool" '$3==tool {print $2; found=1; exit} END {if (!found) print "absent"}' \
      "$AIUP_CAPTURE_FIXTURE_DIR/catalog-index.tsv"
    return 0
  fi
  if ! tool_is_present "$tool"; then
    printf 'absent\n'
    return 0
  fi
  if [ "$(catalog_kind "$tool")" = 'brew-cask' ]; then
    cask="$(catalog_brew_cask "$tool")"
    app="$(catalog_app_path "$tool")"
    if [ -n "$app" ] && [ -d "$app" ] && [ -n "$cask" ] && ! brew_cask_installed "$cask"; then
      printf 'on-disk\n'
      return 0
    fi
  fi
  printf 'installed\n'
}

brew_extra_action() {
  local kind="$1"
  local name="$2"
  local state="$3"
  case "$state" in
    installed) printf 'update\n' ;;
    on-disk) printf 'switch to Homebrew\n' ;;
    absent) printf 'install\n' ;;
    *) printf 'inspect\n' ;;
  esac
}

catalog_dependency_preview() {
  local tool="$1"
  local dep status
  while IFS= read -r dep; do
    [ -n "$dep" ] || continue
    if tool_is_present "$dep"; then
      status='ready'
    else
      status='missing'
    fi
    printf 'needs    %s [%s]\n' "$dep" "$status"
  done < <(catalog_dep_closure "$tool" | awk 'NF && !seen[$0]++')
}

format_catalog_display() {
  local tool="$1"
  local state="$2"
  local cat life tag action reset bar cat_txt state_txt id_txt
  reset=$'\033[0m'
  cat="$(catalog_category "$tool")"
  life="$(catalog_lifecycle "$tool")"
  action="$(catalog_action_for_state "$tool" "$state")"
  tag=""
  [ "$life" = 'active' ] || tag="[${life}] "
  bar="$(catalog_ansi "$cat")▌${reset}"
  cat_txt="$(catalog_ansi "$cat")$(printf '%-16s' "$cat")${reset}"
  if [ "$state" = 'installed' ]; then
    state_txt=$'\033[1;38;2;57;255;20m'"$(printf '%-10s' "installed · $action")"${reset}
  elif [ "$state" = 'on-disk' ]; then
    state_txt=$'\033[1;38;2;57;255;20m'"$(printf '%-10s' "on disk · $action")"${reset}
  else
    state_txt=$'\033[38;5;245m'"$(printf '%-10s' "available · $action")"${reset}
  fi
  id_txt="$(printf '%-18s' "$tool")"
  printf '%s %s %s %s %s%s' "$bar" "$cat_txt" "$state_txt" "$id_txt" "$tag" "$(catalog_label "$tool")"
}

inventory_item_name() {
  local label="$1"
  case "$label" in
    \[*\]\ *) printf '%s\n' "${label#*] }" ;;
    *) printf '%s\n' "$label" ;;
  esac
}

format_inventory_display() {
  local id="$1"
  local state="$2"
  local label="$3"
  local version="$4"
  local source="$5"
  local path="$6"
  local reset bar state_txt name_txt version_txt source_txt path_txt
  reset=$'\033[0m'
  bar="$(catalog_ansi detected)▌${reset}"
  state_txt=$'\033[38;5;250m'"$(printf '%-14s' 'details')""${reset}"
  if [ -n "$(manual_media_record "$id")" ]; then
    state_txt=$'\033[38;5;220m'"$(printf '%-14s' 'manual update')""${reset}"
    bar="$(catalog_ansi media)▌${reset}"
  fi
  if [[ "$id" == di:path:* ]]; then
    source="${label#* — }"
    label="${id#di:path:}"
    path=''
  fi
  name_txt="$(printf '%-26s' "$(inventory_item_name "$label")")"
  version_txt="$(printf '%-12s' "${version:-unknown}")"
  source_txt="$(printf '%-18s' "$source")"
  path_txt="$(printf '%s' "$path")"
  printf '%s %s %s %s %s %s' "$bar" "$state_txt" "$name_txt" "$version_txt" "$source_txt" "$path_txt"
}

category_expanded() {
  local cat="$1"
  [ -f "$EXPAND_FILE" ] || return 1
  grep -qx "$cat" "$EXPAND_FILE" 2>/dev/null
}

list_search_active() {
  [ -s "$LIST_QUERY_FILE" ]
}

category_for_row() {
  local raw="$1"
  case "$raw" in
    __cat:*) printf '%s\n' "${raw#__cat:}" ;;
    __update:*|__updates:all) printf 'updates\n' ;;
    bc:*|bf:*) catalog_category "$raw" ;;
    *) catalog_category "$raw" ;;
  esac
}

expand_category() {
  local raw="$1"
  local cat parent
  cat="$(category_for_row "$raw")"
  [ -n "$cat" ] || return 0
  ensure_dir "$STATE_DIR"
  touch "$EXPAND_FILE"
  if ! category_expanded "$cat"; then
    printf '%s\n' "$cat" >> "$EXPAND_FILE"
  fi
  case "$cat" in
    */*)
      parent="${cat%%/*}"
      if ! category_expanded "$parent"; then
        printf '%s\n' "$parent" >> "$EXPAND_FILE"
      fi
      ;;
  esac
}

collapse_category() {
  local raw="$1"
  local cat
  cat="$(category_for_row "$raw")"
  [ -n "$cat" ] || return 0
  ensure_dir "$STATE_DIR"
  touch "$EXPAND_FILE"
  if category_expanded "$cat"; then
    grep -vx "$cat" "$EXPAND_FILE" > "${EXPAND_FILE}.tmp" 2>/dev/null || true
    mv "${EXPAND_FILE}.tmp" "$EXPAND_FILE"
  fi
}

toggle_category() {
  local raw="$1"
  local cat
  cat="$(category_for_row "$raw")"
  [ -n "$cat" ] || return 0
  if category_expanded "$cat"; then
    collapse_category "$raw"
  else
    expand_category "$raw"
  fi
}

category_nav_action() {
  local direction="$1"
  local current="$2"
  local listfile="$3"
  local current_line target
  [ -f "$listfile" ] || return 0
  current_line="$(awk -F '\t' -v id="$current" '$1 == id {print NR; exit}' "$listfile")"
  [ -n "$current_line" ] || { printf 'pos(1)\n'; return 0; }
  case "$direction" in
    previous)
      target="$(awk -F '\t' -v start="$current_line" 'NR < start && $1 ~ /^__cat:/ {last=NR} END {if (last) print last}' "$listfile")"
      ;;
    next)
      target="$(awk -F '\t' -v start="$current_line" 'NR > start && $1 ~ /^__cat:/ {print NR; exit}' "$listfile")"
      ;;
  esac
  printf 'pos(%s)\n' "${target:-$current_line}"
}

category_jump_action() {
  local current="$1"
  local listfile="$2"
  local choice target
  [ -f "$listfile" ] || { printf 'ignore\n'; return 0; }
  command_exists fzf || { printf 'ignore\n'; return 0; }
  choice="$(awk -F '\t' '$1 ~ /^__cat:/ {print}' "$listfile" | \
    fzf --ansi --no-multi --height=45% --border --delimiter=$'\t' --with-nth=2 \
      --prompt 'category> ' \
      --header 'type to search · enter jump · esc cancel' 2>/dev/null || true)"
  [ -n "$choice" ] || { printf 'ignore\n'; return 0; }
  target="$(printf '%s\n' "$choice" | awk -F '\t' 'NR==1 {print $1}')"
  [ -n "$target" ] || { printf 'ignore\n'; return 0; }
  awk -F '\t' -v id="$target" '$1==id {print "pos(" NR ")"; found=1; exit} END {if (!found) print "ignore"}' "$listfile"
}

catalog_ui_state_read() {
  local path="$1"
  [ -f "$path" ] || return 0
  sed -n '1p' "$path"
}

catalog_ui_state_save() {
  local query="$1"
  local id="$2"
  local category=""
  ensure_dir "$STATE_DIR"
  printf '%s' "$query" > "$LIST_QUERY_FILE"
  [ -n "$id" ] && printf '%s' "$id" > "$LIST_SELECTED_FILE"
  case "$id" in
    __cat:*) category="${id#__cat:}" ;;
    __update:*|__updates:all) category='updates' ;;
    di:*) category='detected' ;;
    bc:*|bf:*) category="$(catalog_category "$id")" ;;
    *) category="$(catalog_category "$id")" ;;
  esac
  [ -n "$category" ] && printf '%s' "$category" > "$LIST_CATEGORY_FILE"
}

catalog_ui_state_position() {
  local listfile="$1"
  local category selected
  selected="$(catalog_ui_state_read "$LIST_SELECTED_FILE")"
  if [ -n "$selected" ]; then
    awk -F '\t' -v id="$selected" '$1==id {print NR; found=1; exit} END {if (found) exit 0; exit 1}' "$listfile" && return 0
  fi
  category="$(catalog_ui_state_read "$LIST_CATEGORY_FILE")"
  [ -n "$category" ] || return 0
  awk -F '\t' -v id="__cat:$category" '$1==id {print NR; exit}' "$listfile"
}

refresh_fzf_listfile() {
  local listfile="$1"
  local next_file
  [ -n "$listfile" ] || return 0
  [ -f "$listfile" ] || return 0
  next_file="${listfile}.next"
  if { if [ "$AIUP_TUI_SESSION_ACTIVE" -eq 1 ]; then tui_session_emit_rows; else emit_fzf_rows_from_index | sort_fzf_rows; fi; } > "$next_file"; then
    mv "$next_file" "$listfile"
  else
    rm -f "$next_file"
    return 1
  fi
}

tui_internal_command() {
  case "${1:-}" in
    __fzf-rows|__fzf-position|__search-query|__fzf-header|__cat-toggle|__cat-expand|__cat-collapse|__cat-nav|__cat-jump|__cat-expand-all|__cat-collapse-all|__enter-action|__available-preview|__tui-test-updates-refresh|__tui-test-updates-resolve|__tui-test-updates-apply|preview|docs|home|open) return 0 ;;
    *) return 1 ;;
  esac
}

tui_fast_dispatch() {
  local command="$1"
  shift
  case "$command" in
    __fzf-rows) tui_session_emit_rows ;;
    __fzf-position) catalog_ui_state_position "${1:-$AIUP_TUI_SESSION_DIR/list.tsv}" ;;
    __search-query)
      printf '%s' "$*" > "${LIST_QUERY_FILE}.next" && mv "${LIST_QUERY_FILE}.next" "$LIST_QUERY_FILE"
      ;;
    __fzf-header) catalog_header_text "${FZF_COLUMNS:-}" ;;
    __cat-toggle) toggle_category "${1:-}"; refresh_fzf_listfile "${2:-}" ;;
    __cat-expand) expand_category "${1:-}"; refresh_fzf_listfile "${2:-}" ;;
    __cat-collapse) collapse_category "${1:-}"; refresh_fzf_listfile "${2:-}" ;;
    __cat-nav) category_nav_action "${1:-}" "${2:-}" "${3:-}" ;;
    __cat-jump) category_jump_action "${1:-}" "${2:-}" ;;
    __cat-expand-all) expand_all_categories; refresh_fzf_listfile "${1:-}" ;;
    __cat-collapse-all) collapse_all_categories; refresh_fzf_listfile "${1:-}" ;;
    __enter-action) enter_action_for "${1:-}" "${2:-}" ;;
    __available-preview)
      [ -n "${1:-}" ] && [ -n "${2:-}" ] || return 1
      available_version_preview "$1" "$2"
      ;;
    __tui-test-updates-refresh)
      [ "${AIUP_TUI_TESTING:-0}" = 1 ] && capture_fixture_enabled || return 1
      tui_updates_publish "$AIUP_TUI_SESSION_DIR" "$AIUP_TUI_SESSION_TOKEN" "$AIUP_TUI_SNAPSHOT_GENERATION" || return 1
      cat "$AIUP_TUI_SESSION_DIR/updates-index.tsv"
      ;;
    __tui-test-updates-resolve|__tui-test-updates-apply)
      [ "${AIUP_TUI_TESTING:-0}" = 1 ] && capture_fixture_enabled || return 1
      PICK_ACTION=update; PICK_TOOLS=("$@"); PICK_UPDATE_ALL=0; PICK_UPDATE_SYNTHETIC=0; PICK_UPDATE_SNAPSHOT=()
      tui_resolve_update_selection || return 1
      if [ "$command" = '__tui-test-updates-apply' ]; then
        apply_catalog_action update "${PICK_TOOLS[@]}"
      else
        printf 'action\t%s\n' "$PICK_ACTION"
        printf 'all\t%s\n' "$PICK_UPDATE_ALL"
        printf 'tool\t%s\n' "${PICK_TOOLS[@]}"
        printf 'snapshot\t%s\n' "${PICK_UPDATE_SNAPSHOT[@]}"
      fi
      ;;
    preview)
      [ -n "${1:-}" ] || { error "usage: aiup preview <tool>"; return 1; }
      tui_session_print_preview "$1"
      profile_mark "preview generation"
      ;;
    docs|home|open) cmd_docs "$@" ;;
  esac
}

