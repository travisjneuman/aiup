version_of_tool() {
  local tool="$1"
  local kind cask app formula bin cmd expected version pkg
  if capture_fixture_enabled; then
    capture_fixture_require || return 1
    version="$(awk -F '\t' -v tool="$tool" '$1==tool {print $2; exit}' "$AIUP_CAPTURE_FIXTURE_DIR/versions.tsv")"
    [ -n "$version" ] && { printf '%s\n' "$version"; return 0; }
  fi
  if [ "$tool" = 'npm' ]; then
    if command_exists npm; then
      npm --version </dev/null 2>&1 | first_line
    else
      printf 'not installed\n'
    fi
    return 0
  fi
  kind="$(catalog_kind "$tool")"
  if [ "$kind" = 'brew-cask' ]; then
    cask="$(catalog_brew_cask "$tool")"
    if [ -n "$cask" ] && brew_cask_installed "$cask"; then
      brew list --cask --versions "$cask" 2>/dev/null | awk 'NF {$1=""; sub(/^ /, ""); print; exit}'
      return 0
    fi
    app="$(catalog_app_path "$tool")"
    if [ -n "$app" ] && [ -d "$app" ]; then
      app_bundle_version "$app" || printf 'app present\n'
      return 0
    fi
  fi
  if [ "$kind" = 'app' ]; then
    app="$(catalog_app_path "$tool")"
    if [ -n "$app" ] && [ -d "$app" ]; then
      app_bundle_version "$app" || printf 'app present\n'
      return 0
    fi
  fi
  if [ "$kind" = 'brew-formula' ]; then
    formula="$(catalog_brew_formula "$tool")"
    if [ -n "$formula" ] && brew_formula_installed "$formula"; then
      brew list --versions "$formula" 2>/dev/null | awk 'NF {$1=""; sub(/^ /, ""); print; exit}'
      return 0
    fi
  fi
  pkg="$(catalog_npm_pkg "$tool")"
  if [ -n "$pkg" ]; then
    if [ -n "$pkg" ] && [ -f "$(npm_pkg_dir_from_prefix "$AIUP_NPM_PREFIX" "$pkg")/package.json" ]; then
      version="$(python3 - "$(npm_pkg_dir_from_prefix "$AIUP_NPM_PREFIX" "$pkg")/package.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    value = json.load(handle).get("version", "")
if value:
    print(value)
PY
      )"
      if [ -n "$version" ]; then
        printf '%s\n' "$version"
        return 0
      fi
    fi
    if [ -n "$pkg" ] && [ -n "$SYSTEM_NPM_PREFIX" ] && [ -f "$(npm_pkg_dir_from_prefix "$SYSTEM_NPM_PREFIX" "$pkg")/package.json" ]; then
      version="$(python3 - "$(npm_pkg_dir_from_prefix "$SYSTEM_NPM_PREFIX" "$pkg")/package.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    value = json.load(handle).get("version", "")
if value:
    print(value)
PY
      )"
      if [ -n "$version" ]; then
        printf '%s\n' "$version"
        return 0
      fi
    fi
  fi
  bin="$(binary_of_tool "$tool")"
  cmd="$(command_path "$bin")"
  if [ -n "$cmd" ] && [ -x "$cmd" ]; then
    version="$("$bin" --version </dev/null 2>&1 | first_line || true)"
    if [ -n "$version" ]; then
      printf '%s\n' "$version"
      return 0
    fi
  fi
  expected="$(expected_direct_path "$tool")"
  if [ -n "$expected" ] && [ -x "$expected" ]; then
    version="$("$expected" --version </dev/null 2>&1 | first_line || true)"
    if [ -n "$version" ]; then
      printf '%s\n' "$version"
      return 0
    fi
  fi
  printf 'not installed\n'
}

available_version_uncached() {
  local tool="$1"
  local current="$2"
  local kind pkg formula cask endpoint latest target arch
  if capture_fixture_enabled; then
    capture_fixture_require || return 1
    awk -F '\t' -v tool="$tool" '$1==tool {print $3; exit}' "$AIUP_CAPTURE_FIXTURE_DIR/versions.tsv"
    return 0
  fi
  kind="$(catalog_kind "$tool")"
  pkg="$(catalog_npm_pkg "$tool")"
  if { [ "$kind" = 'aiup-npm' ] || [ -n "$pkg" ]; } && [ -n "$pkg" ] && command_exists npm; then
    latest="$(npm view "$pkg" version --fetch-retries=0 --fetch-timeout=3000 2>/dev/null | first_line || true)"
    if [ -n "$latest" ] && [ "$(version_is_greater "$latest" "$current")" = 'yes' ]; then
      printf '%s\n' "$latest"
    fi
    return 0
  fi
  if [ "$kind" = 'brew-formula' ] && command_exists brew; then
    formula="$(catalog_brew_formula "$tool")"
    env HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew info --json=v2 --formula "$formula" 2>/dev/null | python3 -c '
import json, sys
items = json.load(sys.stdin).get("formulae") or []
item = items[0] if items else {}
if item.get("outdated"):
    value = (item.get("versions") or {}).get("stable", "")
    if value:
        print(value)
' 2>/dev/null || true
    return 0
  fi
  if [ "$kind" = 'brew-cask' ] && command_exists brew; then
    cask="$(catalog_brew_cask "$tool")"
    env HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew info --json=v2 --cask "$cask" 2>/dev/null | python3 -c '
import json, sys
items = json.load(sys.stdin).get("casks") or []
item = items[0] if items else {}
if item.get("outdated"):
    value = item.get("version", "")
    if value:
        print(value)
' 2>/dev/null || true
    return 0
  fi
  if [ "$kind" = 'uv-tool' ] && command_exists curl; then
    pkg="$(catalog_uv_pkg "$tool")"
    latest="$(curl -fsSL --retry 1 --connect-timeout 3 --max-time 5 "https://pypi.org/pypi/${pkg}/json" 2>/dev/null | python3 -c '
import json, sys
print((json.load(sys.stdin).get("info") or {}).get("version", ""))
' 2>/dev/null || true)"
    if [ -n "$latest" ] && [ "$(version_is_greater "$latest" "$current")" = 'yes' ]; then
      printf '%s\n' "$latest"
    fi
    return 0
  fi
  if [ "$tool" = 'screenpipe' ] && [ -n "$current" ]; then
    case "$(uname -m)" in
      arm64) target='darwin'; arch='aarch64' ;;
      x86_64) target='darwin'; arch='x86_64' ;;
      *) return 0 ;;
    esac
    endpoint="$(official_app_update_endpoint screenpipe "$target" "$arch" "$current" 2>/dev/null || true)"
    [ -n "$endpoint" ] || return 0
    latest="$(official_app_latest_version "$endpoint" 2>/dev/null || true)"
    if [ -n "$latest" ] && [ "$(version_is_greater "$latest" "$current")" = 'yes' ]; then
      printf '%s\n' "$latest"
    fi
  fi
}

available_version_of_tool() {
  local tool="$1"
  local current="$2"
  local cache_file now cached_at cached_current cached_version temp_file
  if capture_fixture_enabled; then
    available_version_uncached "$tool" "$current"
    return 0
  fi
  ensure_dir "$AVAILABLE_VERSION_CACHE_DIR" || return 0
  cache_file="$AVAILABLE_VERSION_CACHE_DIR/$tool.tsv"
  now="$(date +%s)"
  if [ -f "$cache_file" ]; then
    IFS=$'\t' read -r cached_at cached_current cached_version < "$cache_file" || true
    case "$cached_at" in
      ''|*[!0-9]*) ;;
      *)
        if [ "${cached_current:-}" = "$current" ] && [ $((now - cached_at)) -lt "$AVAILABLE_VERSION_CACHE_TTL" ]; then
          [ -n "${cached_version:-}" ] && printf '%s\n' "$cached_version"
          return 0
        fi
        ;;
    esac
  fi
  cached_version="$(available_version_uncached "$tool" "$current" || true)"
  temp_file="$(mktemp "$AVAILABLE_VERSION_CACHE_DIR/.${tool}.XXXXXX")" || return 0
  printf '%s\t%s\t%s\n' "$now" "$current" "$cached_version" > "$temp_file"
  mv "$temp_file" "$cache_file"
  [ -n "$cached_version" ] && printf '%s\n' "$cached_version"
}

catalog_version_preview() {
  local tool="$1"
  local state="$2"
  local installed available
  case "$state" in
    installed|on-disk) ;;
    *) return 0 ;;
  esac
  installed="$(version_of_tool "$tool" || true)"
  [ -n "$installed" ] || installed='unknown'
  printf 'installed %s\n' "$installed"
  available="$(available_version_of_tool "$tool" "$installed" || true)"
  [ -n "$available" ] && printf 'available %s\n' "$available"
}

