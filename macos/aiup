current_shell_pid() {
  # In Bash 3, $$ does not change in a background subshell. A child shell's
  # PPID is the actual process that owns the lock.
  sh -c 'printf "%s\n" "$PPID"'
}

profile_now_ms() {
  [ "$AIUP_PROFILE_ENABLED" = 1 ] || return 0
  python3 -c 'import time; print(time.monotonic_ns() // 1000000)'
}

profile_begin() {
  [ "$AIUP_PROFILE_ENABLED" = 1 ] || return 0
  AIUP_PROFILE_START_MS="$(profile_now_ms)"
  AIUP_PROFILE_LAST_MS="$AIUP_PROFILE_START_MS"
}

profile_mark() {
  [ "$AIUP_PROFILE_ENABLED" = 1 ] || return 0
  local stage="$1" now elapsed total
  now="$(profile_now_ms)"
  elapsed=$((now - AIUP_PROFILE_LAST_MS))
  total=$((now - AIUP_PROFILE_START_MS))
  printf 'aiup profile: %s=%dms total=%dms\n' "$stage" "$elapsed" "$total" >&2
  AIUP_PROFILE_LAST_MS="$now"
}

profile_note() {
